// meters and level matching are only for the window (and its hold button)
c_uion ? (
  c_ei += c_r0 * c_r0 + c_r1 * c_r1; c_eo += spl0 * spl0 + spl1 * spl1;
  a_t = abs(c_x0); a_t > c_ip0 ? c_ip0 = a_t; a_t = abs(c_x1); a_t > c_ip1 ? c_ip1 = a_t;
);
// held Bypass (crossfaded; the raw input, delayed by the latency, at the plug-in's loudness)
(c_bpv > 0 || c_bph) ? (
  c_bpv = max(0, min(1, c_bpv + (c_bph ? c_bps : -c_bps)));
  spl0 = spl0 * (1 - c_bpv) + m_rd0 * c_bpg * c_bpv;
  spl1 = spl1 * (1 - c_bpv) + m_rd1 * c_bpg * c_bpv;
);
// audio key: hand this plug-in's output samples to a later plug-in that asked for them (the very last thing)
a_wr ? (gmem[a_wr0 + a_wp] = spl0; gmem[a_wr0 + AUD_R + a_wp] = spl1; a_wp = (a_wp + 1) & AUD_MASK;);

@gfx 1040 600
frame_begin(900);
fin_compute();
g_fin = MYSLOT >= 0 ? FIN[MYSLOT] : 0;
g_live_me = MYSLOT >= 0 && g_live(MYSLOT, g_now);

// IR files dropped on the window: the first into the slot under the pointer, a second into the other one
g_di = 0;
while (g_di < 2 && gfx_getdropfile(g_di, #g_drop)) (
  g_di == 0 ? (g_dsl = ((g_mx - g_ox) / g_sc) >= 450 ? 1 : 0;) : (g_dsl = 1 - g_dsl;);
  strcpy(502 + g_dsl, #g_drop); DRN[g_dsl] += 1;
  g_di += 1;
);
g_di > 0 ? gfx_getdropfile(-1);
// the helper's answer to a browse or folder request
g_fbpoll();

// ---- top bar (shared): title, finale, Presets, Bypass, Settings (no A/B: an IR loader's state is more than its settings) ----
top_bar("TWOSTORMS IR LOADER", 0);
MYSLOT >= 0 ? track_name(#g_tn, MYSLOT) : strcpy(#g_tn, "");
m_T > 0 ? sprintf(#g_lt, "latency %d samples (%.1f ms)", m_T, c_latms) : strcpy(#g_lt, "no latency");
sprintf(#g_sub, "%s    %s", #g_tn, #g_lt);
!g_script_ok ? strcat(#g_sub, "    (helper script not running)");
g_script_old ? strcat(#g_sub, "    (old helper script running: replace it)");
gfx_setfont(3); c_dim(); text(#g_sub, 12, 34, 876, 16, 4);
g_y = 56;

// ---- settings: meters, zoom, finale; where the IRs come from ----
g_cset ? (
  c_panel(); rect(6, g_y - 4, 888, 100, 1);
  label("Peak hold", 12, g_y, 64);
  dropdown(78, g_y, 86, 22, g_key(-1, P_HOLD), 320, 6, 1);
  label("Meter range", 178, g_y, 80);
  dropdown(260, g_y, 80, 22, g_key(-1, P_RANGE), 330, 6, 1);
  label("Zoom", 356, g_y, 40);
  dropdown(398, g_y, 80, 22, g_key(-1, P_ZOOM), 360, 6, 1);
  label("Finale", 494, g_y, 44);
  dropdown(540, g_y, 86, 22, g_key(-1, P_FINAL), 370, 3, 1);
  g_fm = floor(slider(si(P_FINAL)) + 0.5);
  g_fc = MYSLOT >= 0 ? fin_of_chain(MYSLOT) : -1;
  g_warn = 0;
  g_fm == FIN_NEVER ? strcpy(#g_fs, "Never on the Finales tab.") : (
    g_fin ? (
      fin_tail(MYSLOT) ? (strcpy(#g_fs, "Finale, but plug-ins after it change the output."); g_warn = 1;)
                       : strcpy(#g_fs, g_fin == 2 ? "Always on the Finales tab." : "The finale: the last Act in its chain.");
    ) : (
      g_fc >= 0 ? (point_title(#g_ft, g_fc); sprintf(#g_fs, "Not the finale: %s is.", #g_ft);) : strcpy(#g_fs, "Not the finale.");
    );
  );
  gfx_setfont(3); g_warn ? c_red() : (g_fin ? c_orange() : c_dim());
  text(#g_fs, 634, g_y, 254, 22, 4);
  c_faint();
  text("Drop .wav files on an IR panel, or click its name: Browse... (with the helper script), its folder's IRs, Clear. < and > step", 12, g_y + 30, 876, 16, 4);
  text("through the IR's own folder (REAPER's Data/TwoStorms IRs without the helper). IRs are saved with the project; up to 2.7 s at 48 kHz.", 12, g_y + 46, 876, 16, 4);
  text("Bypass (Lvl Match) plays the input at the same loudness: click to latch, Shift + click and hold to hear it only while held.", 12, g_y + 62, 876, 16, 4);
  sprintf(#g_idt, "Plugin ID %d", MYID); text(#g_idt, 12, g_y + 78, 876, 16, 6);
  g_y += 104;
);

// ---- the display: each IR's frequency response and both together (as they play), 20 Hz .. 20 kHz ----
g_ax = 12; g_ay = g_y; g_aw = 796; g_ah = 170;
c_well(); rect(g_ax, g_ay, g_aw, g_ah, 1);
gfx_setfont(3);
g_i = 0;
loop(8,
  g_f = g_i == 0 ? 50 : (g_i == 1 ? 100 : (g_i == 2 ? 200 : (g_i == 3 ? 500 : (g_i == 4 ? 1000 : (g_i == 5 ? 2000 : (g_i == 6 ? 5000 : 10000))))));
  setc(0.15, 0.15, 0.17); rect(an_x(g_f), g_ay, 1 / g_sc, g_ah, 1);
  g_f >= 1000 ? sprintf(#g_fl, "%dk", g_f / 1000) : sprintf(#g_fl, "%d", g_f);
  c_faint(); text(#g_fl, an_x(g_f) + 2, g_ay + g_ah - 13, 30, 12, 4);
  g_i += 1;
);
// the scale: 60 dB from +18 dB at the top, moved up in 6 dB steps when the curves are higher
g_rtop = 18;
g_rspj >= 3 ? (g_i = 0; loop(3 * RSN, (RSPV[floor(g_i / RSN)] && RSP[g_i] + 3 > g_rtop) ? g_rtop = 6 * ceil((RSP[g_i] + 3) / 6); g_i += 1;););
g_i = 0;
loop(5,
  g_db = g_rtop - 6 - 12 * g_i; setc(0.15, 0.15, 0.17); rect(g_ax, rs_y(g_db), g_aw, 1 / g_sc, 1);
  sprintf(#g_fl, "%+d", g_db); g_db == 0 ? strcpy(#g_fl, "0 dB");
  c_faint(); text(#g_fl, g_ax + g_aw - 34, rs_y(g_db) - 12, 30, 12, 6);
  g_i += 1;
);
// worked out again after each build (one curve per frame)
m_bkn !== g_rspk ? (g_rspk = m_bkn; g_rspj = 0;);
(g_rspj < 3 && bk_ph == 0 && m_bc >= 0) ? (g_rsp(g_rspj); g_rspj += 1;);
g_i = 0; loop(2, (RSPV[g_i] && g_rspj >= 3) ? (ir_col(g_i, 0.75); rs_draw(g_i, 0);); g_i += 1;);
(g_rspj >= 3 && (RSPV[0] || RSPV[1])) ? (c_orange(); rs_draw(2, 1););
gfx_a = 1;
// the key
gfx_setfont(3);
ir_col(0, 1); rect(g_ax + 8, g_ay + 10, 14, 2, 1); c_dim(); text("IR 1", g_ax + 26, g_ay + 4, 40, 14, 4);
ir_col(1, 1); rect(g_ax + 70, g_ay + 10, 14, 2, 1); c_dim(); text("IR 2", g_ax + 88, g_ay + 4, 40, 14, 4);
c_orange(); rect(g_ax + 132, g_ay + 10, 14, 2, 1); c_dim(); text("Both (as they play)", g_ax + 150, g_ay + 4, 140, 14, 4);
bk_ph > 0 ? (c_faint(); text("building...", g_ax + 300, g_ay + 4, 100, 14, 4););
c_border(); rect(g_ax, g_ay, g_aw, g_ah, 0);
// meters: input and output
gfx_setfont(3); c_dim();
text("IN", 816, g_ay, 34, 12, 5); text("OUT", 852, g_ay, 36, 12, 5);
vmeter(818, g_ay + 14, 12, g_ah - 14, c_mi0, g_live_me);
vmeter(832, g_ay + 14, 12, g_ah - 14, c_mi1, g_live_me);
g_b2 = SLOTBASE + MYSLOT * SLOTSZ;
vmeter(860, g_ay + 14, 12, g_ah - 14, MYSLOT >= 0 ? gmem[g_b2 + O_PKD] : -200, g_live_me);
vmeter(874, g_ay + 14, 12, g_ah - 14, MYSLOT >= 0 ? gmem[g_b2 + O_PKD + 1] : -200, g_live_me);
g_y = g_ay + g_ah + 8;

// ---- the two IRs ----
slot_panel(0, 6, g_y);
slot_panel(1, 454, g_y);
g_y += 180;

// ---- both: latency, input, stereo IRs, the tail trim, dry/wet ----
dropdown(12, g_y, 124, 20, g_key(-1, P_LAT), 480, 4, 1);
cdd(140, g_y, 120, 20, g_key(-1, P_INM), 486, 2, "Input:", 1);
ctog(264, g_y, 88, "Stereo IRs", P_STIR, 0);
ctog(356, g_y, 76, "Tail trim", P_TTON, 0);
cbox(436, g_y, 64, P_TTDB, 0, slider(P_TTON) >= 0.5);
cctlx("Dry/wet", 600, g_y, P_MIX, 0, 1, 50, 170, 56);
g_y += 28;
// ---- two IRs: line their starts up, match IR 2's timing and polarity to IR 1, match its loudness ----
(IRF[0] > 0 && IRF[1] > 0) ? (
  label("Two IRs", 12, g_y - 1, 54);
  ctog(70, g_y, 96, "Align starts", P_ALIGN, 0);
  ctog(170, g_y, 96, "Match phase", P_MATCH, 0);
  ctog(270, g_y, 90, "Auto level", P_ALVL, 0);
  strcpy(#g_al, "");
  (bk_ph == 0 && BKU[0] && BKU[1]) ? (
    slider(P_MATCH) >= 0.5 ? (
      sprintf(#g_al, "IR 2 %s %.2f ms", ALAG >= 0 ? "later by" : "earlier by", abs(ALAG) / srate * 1000);
      APOL < 0 ? strcat(#g_al, ", polarity flipped");
    );
    slider(P_ALVL) >= 0.5 ? (sprintf(#g_i2, "%sIR 2 %+.1f dB to match IR 1's loudness", strlen(#g_al) ? ";  " : "", ALVG); strcat(#g_al, #g_i2););
  ) : (BKU[0] && BKU[1]) ? strcpy(#g_al, "") : strcpy(#g_al, "(both IRs on to line them up and match them)");
  gfx_setfont(3); c_dim(); text(#g_al, 370, g_y, 518, 20, 4);
) : (
  gfx_setfont(3); c_faint(); text("Load a second IR to line the two up (start, timing, polarity) and match their loudness.", 12, g_y, 876, 20, 4);
);
g_y += 30;

// ---- output: the built-in Act, laid out like an Act card in the Gain Stage (the drive link where Auto all's tick and name are) ----
g_ch2 = 38 + 26;
c_card(); rect(6, g_y, 888, g_ch2, 1);
setc(0.20, 0.19, 0.18); rect(6, g_y, 888, g_ch2, 0);
drive_label(#g_dlb, -1);
g_dl = slider(si(P_DRIVE)) >= DRIVE_PARAM; g_don = slider(si(P_DRIVEON)) >= 0.5;
checkbox(16, g_y + 10, g_don && g_dl, g_dl) ? g_kset(g_key(-1, P_DRIVEON), !g_don, 1);
button(38, g_y + 6, 280, 22, #g_dlb, g_dl && g_don, MYSLOT >= 0, 1) ? drive_menu(-1, 38, g_y + 28);
// ... | mode | value | channels | Peak/RMS/LUFS | time | Auto
button(324, g_y + 6, 28, 22, "...", 0, 1, 0) ? act_menu(324, g_y + 28);
mode_ctl(356, g_y + 6, 96, -1, 1, 1);
value_ctl(456, g_y + 6, 130, -1, 1);
auto_mode(-1) != 0 ? src_ctl(590, g_y + 6, 76, 22, -1, 0, 1, 1);
dropdown(666, g_y + 6, 80, 22, g_key(-1, P_MEAS), 310, 3, 1);
auto_time_box(750, g_y + 6, 70, 22, -1, 1);
button(826, g_y + 6, 62, 22, auto_label(-1), auto_busy(-1), MYSLOT >= 0, 0) ? auto_click(-1);
// the gain group: meters, readouts, gain
g_tgt = aim_tick(-1);
gfx_setfont(3); c_dim(); text("1-2", 16, g_y + 36, 36, 20, 4);
meter(54, g_y + 36, 410, 9, MYSLOT, 0, g_tgt, g_live_me);
meter(54, g_y + 47, 410, 9, MYSLOT, 1, g_tgt, g_live_me);
readouts(472, g_y + 36, MYSLOT, 0, 2, g_live_me);
gain_ctl(630, g_y + 36, 168, g_key(-1, P_GAIN), 1);
g_y += g_ch2 + 8;
frame_end(g_y);
