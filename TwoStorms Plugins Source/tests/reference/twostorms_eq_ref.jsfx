// the dynamic bands' detectors (they hear the input without the delay)
e_nd > 0 ? (
  DSG[0] = (c_x0 + c_x1) * 0.5; DSG[1] = c_x0; DSG[2] = c_x1; DSG[3] = (c_x0 - c_x1) * 0.5;
