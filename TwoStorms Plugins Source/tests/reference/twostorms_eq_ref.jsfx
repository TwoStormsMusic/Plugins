) : (
  e_lin ? (
    e_lmode == 1 ? (e_u = (c_x0 + c_x1) * 0.5; e_v = (c_x0 - c_x1) * 0.5;) : (e_u = c_x0; e_v = c_x1;);
    LIB[e_lb + e_lpos] = e_u; LIB[4096 + e_lb + e_lpos] = e_v;
