// meters and level matching are only for the window (and its hold buttons)
c_uion ? (
  c_ei += c_r0 * c_r0 + c_r1 * c_r1; c_eo += spl0 * spl0 + spl1 * spl1;
  a_t = abs(c_x0); a_t > c_ip0 ? c_ip0 = a_t; a_t = abs(c_x1); a_t > c_ip1 ? c_ip1 = a_t;
);
// held Bypass (crossfaded) and held Swap (its level-matching trim, glided)
(c_bpv > 0 || c_bph || c_tr != 1 || c_trt != 1) ? (
  c_bpv = max(0, min(1, c_bpv + (c_bph ? c_bps : -c_bps)));
  c_tr += (c_trt - c_tr) * c_trk; abs(c_tr - c_trt) < 0.00001 ? c_tr = c_trt;
  spl0 = spl0 * c_tr * (1 - c_bpv) + c_q0 * c_bpg * c_bpv;
  spl1 = spl1 * c_tr * (1 - c_bpv) + c_q1 * c_bpg * c_bpv;
);
c_anw ? (ANI[c_ap] = (c_r0 + c_r1) * 0.5; ANO[c_ap] = (spl0 + spl1) * 0.5; ANS[c_ap] = (spl2 + spl3) * 0.5 * e_sct; c_ap = (c_ap + 1) & 8191;);
// audio key: hand this plug-in's output samples to a later plug-in that asked for them (the very last thing)
a_wr ? (gmem[a_wr0 + a_wp] = spl0; gmem[a_wr0 + AUD_R + a_wp] = spl1; a_wp = (a_wp + 1) & AUD_MASK;);

@gfx 1040 780
frame_begin(900);
fin_compute();
g_fin = MYSLOT >= 0 ? FIN[MYSLOT] : 0;
g_live_me = MYSLOT >= 0 && g_live(MYSLOT, g_now);
g_lin = floor(slider(P_LIN) + 0.5);
g_t = floor(slider(P_DRNG) + 0.5);
g_dr = g_t == 0 ? 6 : (g_t == 1 ? 12 : (g_t == 2 ? 18 : 30));

// ---- top bar (shared): title, finale, Presets, A/B, Swap, Bypass, Settings ----
top_bar("TWOSTORMS EQ", 1);
MYSLOT >= 0 ? track_name(#g_tn, MYSLOT) : strcpy(#g_tn, "");
e_dl > 0 ? sprintf(#g_lt, "latency %.1f ms (%s)", c_latms, e_lin ? (e_nat ? "natural phase" : "linear phase") : "lookahead") : strcpy(#g_lt, "no latency");
sprintf(#g_sub, "%s    %s    playing: %s", #g_tn, #g_lt, c_side ? "B" : "A");
!g_script_ok ? strcat(#g_sub, "    (helper script not running)");
g_script_old ? strcat(#g_sub, "    (old helper script running: replace it)");
gfx_setfont(3); c_dim(); text(#g_sub, 12, 34, 876, 16, 4);
g_y = 56;

// ---- settings: meters, zoom, finale ----
g_cset ? (
  c_panel(); rect(6, g_y - 4, 888, 104, 1);
  label("Peak hold", 12, g_y, 64);
  dropdown(78, g_y, 86, 22, g_key(-1, P_HOLD), 320, 6, 1);
  label("Meter range", 178, g_y, 80);
  dropdown(260, g_y, 80, 22, g_key(-1, P_RANGE), 330, 6, 1);
  label("Zoom", 356, g_y, 40);
  dropdown(398, g_y, 80, 22, g_key(-1, P_ZOOM), 360, 6, 1);
  label("Finale", 494, g_y, 44);
  dropdown(540, g_y, 86, 22, g_key(-1, P_FINAL), 370, 3, 1);
  g_fm = floor(slider(si(P_FINAL)) + 0.5);
  g_fc = MYSLOT >= 0 ? fin_of_chain(MYSLOT) : -1;
  g_warn = 0;
  g_fm == FIN_NEVER ? strcpy(#g_fs, "Never on the Finales tab.") : (
    g_fin ? (
      fin_tail(MYSLOT) ? (strcpy(#g_fs, "Finale, but plug-ins after it change the output."); g_warn = 1;)
                       : strcpy(#g_fs, g_fin == 2 ? "Always on the Finales tab." : "The finale: the last Act in its chain.");
    ) : (
      g_fc >= 0 ? (point_title(#g_ft, g_fc); sprintf(#g_fs, "Not the finale: %s is.", #g_ft);) : strcpy(#g_fs, "Not the finale.");
    );
  );
  gfx_setfont(3); g_warn ? c_red() : (g_fin ? c_orange() : c_dim());
  text(#g_fs, 634, g_y, 254, 22, 4);
  // Set dynamic thresholds: how much of the playing time a band spends at its full range (a compress band; an expand
  // band is back to 0 for that much of the time)
  label("Set dynamic thresholds: full range", 12, g_y + 28, 220);
  cfmt(#g_cv, P_DTP, slider(P_DTP));
  valbox(236, g_y + 28, 130, 22, g_key(-1, P_DTP), 0.02, 0.002, 6, #g_cv, 1);
  gfx_setfont(3); c_faint();
  text("(on the loudest moments: compress bands reach their range, expand bands are back to 0)", 376, g_y + 28, 512, 22, 4);
  text("Bypass (Lvl Match) plays the input at the same loudness; Swap (Lvl Match) plays the other A/B set at this one's loudness.", 12, g_y + 56, 876, 16, 4);
  text("Click to latch these, A/B, Delta and Auto gain; Shift + click and hold to use them only while the mouse is held.", 12, g_y + 72, 876, 16, 4);
  sprintf(#g_idt, "Plugin ID %d", MYID); text(#g_idt, 12, g_y + 72, 876, 16, 6);
  g_y += 108;
);

// ---- the display: spectrum behind, the summed curve, one node per band ----
g_ax = 12; g_ay = g_y; g_aw = 796; g_ah = 300;
g_dpy = g_ay;
c_well(); rect(g_ax, g_ay, g_aw, g_ah, 1);
gfx_setfont(3);
// frequency grid
g_i = 0;
loop(8,
  g_f = g_i == 0 ? 50 : (g_i == 1 ? 100 : (g_i == 2 ? 200 : (g_i == 3 ? 500 : (g_i == 4 ? 1000 : (g_i == 5 ? 2000 : (g_i == 6 ? 5000 : 10000))))));
  setc(0.15, 0.15, 0.17); rect(an_x(g_f), g_ay, 1 / g_sc, g_ah, 1);
  g_f >= 1000 ? sprintf(#g_fl, "%dk", g_f / 1000) : sprintf(#g_fl, "%d", g_f);
  c_faint(); text(#g_fl, an_x(g_f) + 2, g_ay + g_ah - 13, 30, 12, 4);
  g_i += 1;
);
// gain grid
g_stp = g_dr <= 6 ? 3 : (g_dr <= 18 ? 6 : 10);
g_nn = floor(g_dr / g_stp);
g_d = -g_stp * g_nn;
loop(2 * g_nn + 1,
  g_d == 0 ? setc(0.30, 0.30, 0.34) : setc(0.15, 0.15, 0.17);
  rect(g_ax, ey(g_d), g_aw, 1 / g_sc, 1);
  c_faint();
  g_d > 0 ? sprintf(#g_fl, "+%d", g_d) : sprintf(#g_fl, "%d", g_d);
  text(#g_fl, g_ax + 3, max(g_ay + 2, ey(g_d) - 13), 30, 12, 4);
  g_d += g_stp;
);
// the analyzer: pre = grey fill, post = orange line (post alone is filled dimly too)
g_an = floor(slider(P_AN) + 0.5);
(g_live_me && g_an > 0) ? (
  g_annorm = 20 * log10(4096 / 4);
  (g_an == 1 || g_an == 2) ? (an_fft(ANI, SPI, 4096); setc(0.21, 0.21, 0.25); an_draw(SPI, 4096, 1););
  (g_an == 1 || g_an == 3) ? (
    an_fft(ANO, SPO, 4096);
    g_an == 3 ? (setc(0.25, 0.15, 0.05); an_draw(SPO, 4096, 1););
    c_orange(); gfx_a = 0.75; an_draw(SPO, 4096, 0); gfx_a = 1;
  );
);
// the curve
eg_prep();
g_sel = max(0, min(NB - 1, floor(slider(P_SEL) + 0.5)));
g_y0 = ey(0);
g_cn = floor(g_aw / 2);
g_i = 0; g_lx = -1;
loop(g_cn + 1,
  g_px = g_ax + g_i * g_aw / g_cn;
  g_f = an_f(g_px); g_w = 2 * $pi * g_f / srate; g_cw = cos(g_w); g_c2 = cos(2 * g_w);
  g_tot = 0; g_sdb = 0; g_b = 0;
  loop(NB, GNS[g_b] > 0 ? (g_m = eg_db(g_b, g_cw, g_c2); g_tot += g_m; g_b == g_sel ? g_sdb = g_m;); g_b += 1;);
  g_py = ey(max(-g_dr, min(g_dr, g_tot)));
  GON[g_sel] ? (
    band_col(g_sel, 0.22);
    g_ys = ey(max(-g_dr, min(g_dr, g_sdb)));
    g_fx0 = floor(X(g_px)); g_fx1 = floor(X(g_px + g_aw / g_cn));
    gfx_rect(g_fx0, floor(Y(min(g_y0, g_ys))), max(1, g_fx1 - g_fx0), max(1, floor(abs(Y(g_ys) - Y(g_y0)))), 1);
    gfx_a = 1;
  );
  c_orange();
  g_lx >= 0 ? (gfx_line(g_lx, g_ly, X(g_px), Y(g_py), 1); gfx_line(g_lx, g_ly + 1, X(g_px), Y(g_py) + 1, 1););
  g_lx = X(g_px); g_ly = Y(g_py);
  g_i += 1;
);
// node positions
g_b = 0;
loop(NB,
  GON[g_b] ? (
    g_ty = floor(slider(ep(g_b, K_TYPE)) + 0.5);
    GNX[g_b] = an_x(slider(ep(g_b, K_FREQ)));
    GNY[g_b] = ey(g_ty <= 2 ? max(-g_dr, min(g_dr, slider(ep(g_b, K_GAIN)))) : 0);
    GIX[g_b] = min(g_ax + g_aw - 14, GNX[g_b] + 6);
    GIY[g_b] = max(g_ay + 2, GNY[g_b] - 19);
  );
  g_b += 1;
);
g_soloact = g_solo_m >= 0 ? g_solo_m : g_solo_l;
// which node / solo icon is under the mouse
g_mxd = (g_mx - g_ox) / g_sc; g_myd = (g_my - g_oy) / g_sc;
g_ind = g_mxd >= g_ax && g_mxd < g_ax + g_aw && g_myd >= g_ay && g_myd < g_ay + g_ah;
g_nh = -1; g_ih = -1; g_best = 1000000; g_b = 0;
loop(NB,
  GON[g_b] ? (
    (g_mxd >= GIX[g_b] && g_mxd < GIX[g_b] + 12 && g_myd >= GIY[g_b] && g_myd < GIY[g_b] + 12) ? g_ih = g_b;
    g_dd2 = sqrt(sqr(g_mxd - GNX[g_b]) + sqr(g_myd - GNY[g_b]));
    (g_dd2 < 9 && g_dd2 < g_best) ? (g_best = g_dd2; g_nh = g_b;);
  );
  g_b += 1;
);
// the Analyzer and Range boxes in the top right corner belong to themselves
g_inbox = g_myd >= g_ay && g_myd < g_ay + 26 && g_mxd >= g_ax + g_aw - 266;
(!g_ind || g_ndrag >= 0 || g_inbox) ? (g_nh = (g_ndrag >= 0 ? g_ndrag : -1); g_ih = -1;);
// draw the nodes (and the solo icons)
g_b = 0;
loop(NB,
  GON[g_b] ? (
    g_ty = floor(slider(ep(g_b, K_TYPE)) + 0.5);
    // a dynamic band: where its gain is right now
    (g_lin == 0 && g_ty <= 2 && pk_dm(slider(ep(g_b, K_DYN))) > 0) ? (
      band_col(g_b, 0.7);
      gfx_circle(X(GNX[g_b]), Y(ey(max(-g_dr, min(g_dr, GEG[g_b])))), 4 * g_sc, 0, 1);
      gfx_a = 1;
    );
    band_col(g_b, 1);
    gfx_circle(X(GNX[g_b]), Y(GNY[g_b]), (g_b == g_sel || g_b == g_nh ? 8 : 6.5) * g_sc, 1, 1);
    g_b == g_sel ? (setc(1, 1, 1); gfx_circle(X(GNX[g_b]), Y(GNY[g_b]), 8.5 * g_sc, 0, 1););
    gfx_setfont(3); setc(0.05, 0.04, 0.03);
    sprintf(#g_cvs, "%d", g_b + 1);
    text(#g_cvs, GNX[g_b] - 8, GNY[g_b] - 7, 16, 14, 5);
    // solo icon
    g_soloact == g_b ? band_col(g_b, 1) : (g_ih == g_b ? setc(0.30, 0.29, 0.28) : setc(0.16, 0.155, 0.15));
    rect(GIX[g_b], GIY[g_b], 12, 12, 1);
    g_soloact == g_b ? setc(0.05, 0.04, 0.03) : c_border();
    rect(GIX[g_b], GIY[g_b], 12, 12, 0);
    g_soloact == g_b ? setc(0.05, 0.04, 0.03) : c_dim();
    text("S", GIX[g_b], GIY[g_b] - 1, 12, 12, 5);
  );
  g_b += 1;
);
c_border(); rect(g_ax, g_ay, g_aw, g_ah, 0);
// the line of help (or the band under the mouse)
gfx_setfont(3); c_dim();
g_nh >= 0 ? (
  g_nf = slider(ep(g_nh, K_FREQ));
  g_nf >= 1000 ? sprintf(#g_hf, "%.2f kHz", g_nf / 1000) : sprintf(#g_hf, "%.0f Hz", g_nf);
  g_ty = floor(slider(ep(g_nh, K_TYPE)) + 0.5);
  g_ty >= 5 ? sprintf(#g_hint, "Band %d:  %s   %s", g_nh + 1, #g_hf, 430 + cut_s(g_ty))
            : sprintf(#g_hint, "Band %d:  %s   %+.1f dB   Q %.2f", g_nh + 1, #g_hf, slider(ep(g_nh, K_GAIN)), slider(ep(g_nh, K_Q)));
) : strcpy(#g_hint, "Double-click: add. Drag a node; wheel: Q or slope; right-click: more; Shift+hold: solo.");
text(#g_hint, g_ax + 36, g_ay + 4, g_aw - 310, 14, 4);
// the analyzer and the display range, in the top right corner
cdd(g_ax + g_aw - 262, g_ay + 4, 132, 20, g_key(-1, P_AN), 470, 4, "Analyzer:", 1);
cdd(g_ax + g_aw - 126, g_ay + 4, 122, 20, g_key(-1, P_DRNG), 480, 4, "Range:", 1);
// the meters, level of the output and what Auto gain is doing
gfx_setfont(3); c_dim();
text("IN", 816, g_ay, 24, 12, 5); text("AG", 840, g_ay, 28, 12, 5); text("OUT", 862, g_ay, 28, 12, 5);
vmeter(816, g_ay + 14, 10, g_ah - 30, c_mi0, g_live_me);
vmeter(828, g_ay + 14, 10, g_ah - 30, c_mi1, g_live_me);
g_b = SLOTBASE + MYSLOT * SLOTSZ;
vmeter(866, g_ay + 14, 10, g_ah - 30, MYSLOT >= 0 ? gmem[g_b + O_PKD] : -200, g_live_me);
vmeter(878, g_ay + 14, 10, g_ah - 30, MYSLOT >= 0 ? gmem[g_b + O_PKD + 1] : -200, g_live_me);
sprintf(#g_grt, "%+.1f", slider(P_AUTOG) >= 0.5 ? e_agdb : 0); c_orange(); text(#g_grt, 838, g_ay + g_ah / 2 - 7, 26, 14, 5);
text("dB", 838, g_ay + g_ah / 2 + 6, 26, 14, 5);

// mouse on the display: nodes, solo icons, double-click to add, right-click, wheel for Q
(g_ind && g_lclick && !g_used) ? (
  g_used = 1;
  g_ih >= 0 ? (
    g_selband(g_ih);
    (g_cap & 8) ? (g_solo_m = g_ih;) : (g_solo_l = (g_solo_l == g_ih ? -1 : g_ih););
  ) : (
    g_nh >= 0 ? (
      g_selband(g_nh);
      g_ndrag = g_nh; g_ndx = g_mxd - GNX[g_nh]; g_ndy = g_myd - GNY[g_nh];
      (g_cap & 8) ? (g_solo_m = g_nh;);
    ) : (
      (g_now - g_dclk_t < 0.35) ? (
        g_addnext(an_f(g_mxd), (g_ay + g_ah * 0.5 - g_myd) / (g_ah * 0.5) * g_dr);
        g_dclk_t = 0;
      ) : (g_dclk_t = g_now;);
    );
  );
);
(g_ind && g_rclick && !g_used) ? (
  g_used = 1;
  gfx_x = g_mx; gfx_y = g_my;
  g_nh >= 0 ? (
    g_selband(g_nh);
    g_r = gfx_showmenu("Solo this band|Bell|Low shelf|High shelf|Notch|Band pass|High pass|Low pass|Delete band");
    g_r == 1 ? g_solo_l = (g_solo_l == g_nh ? -1 : g_nh);
    (g_r >= 2 && g_r <= 8) ? band_set_type(g_nh, g_r - 2);
    g_r == 9 ? g_delband(g_nh);
  ) : (
    gfx_showmenu("Add a band here") == 1 ? g_addnext(an_f(g_mxd), (g_ay + g_ah * 0.5 - g_myd) / (g_ah * 0.5) * g_dr);
  );
);
(g_ind && g_wheel != 0 && !g_used && !(g_cap & 8) && g_nh >= 0) ? (
  g_used = 1;
  g_selband(g_nh);
  g_ty = floor(slider(ep(g_nh, K_TYPE)) + 0.5);
  // a high or low pass: the wheel steps its slope; any other band: its Q
  g_ty >= 5 ? g_kset(g_key(-1, ep(g_nh, K_TYPE)), cut_ty(cut_hp(g_ty), max(0, min(5, cut_s(g_ty) + (g_wheel > 0 ? 1 : -1)))), 1)
            : g_kset(g_key(-1, ep(g_nh, K_Q)), slider(ep(g_nh, K_Q)) * exp((g_wheel > 0 ? 1 : -1) * 0.12), 1);
);
(g_ndrag >= 0 && (g_cap & 1)) ? (
  g_ty = floor(slider(ep(g_ndrag, K_TYPE)) + 0.5);
  g_kset(g_key(-1, ep(g_ndrag, K_FREQ)), max(20, min(20000, an_f(g_mxd - g_ndx))), 0);
  g_ty <= 2 ? g_kset(g_key(-1, ep(g_ndrag, K_GAIN)),
    floor(max(-30, min(30, (g_ay + g_ah * 0.5 - (g_myd - g_ndy)) / (g_ah * 0.5) * g_dr)) * 10 + 0.5) / 10, 0);
);
(g_ndrag >= 0 && !(g_cap & 1)) ? (
  g_kset(g_key(-1, ep(g_ndrag, K_FREQ)), slider(ep(g_ndrag, K_FREQ)), 1);
  g_ndrag = -1;
);
!(g_cap & 1) ? g_solo_m = -1;
c_uisolo = g_solo_m >= 0 ? g_solo_m : g_solo_l;
g_y = g_dpy + 300 + 8;

// how many bands are dynamic, and how many of those the sidechain triggers (Sidechain view and trim only show then)
g_ndyn = 0; g_nsc = 0; g_b = 0;
loop(NB,
  (GON[g_b] && g_lin == 0 && floor(slider(ep(g_b, K_TYPE)) + 0.5) <= 2 && pk_dm(slider(ep(g_b, K_DYN))) > 0) ? (
    g_ndyn += 1; pk_src(slider(ep(g_b, K_DSRC))) ? g_nsc += 1;
  );
  g_b += 1;
);
c_scok = g_nsc > 0;

// ---- the sidechain view: looks like the compressor's trigger analyzer; takes no room when it is off ----
g_scv = slider(P_SCV) >= 0.5 && g_nsc > 0;
g_scv ? (
  g_ax = 12; g_ay = g_y; g_aw = 876; g_ah = 120;
  c_well(); rect(g_ax, g_ay, g_aw, g_ah, 1);
  gfx_setfont(3);
  g_i = 0;
  loop(8,
    g_f = g_i == 0 ? 50 : (g_i == 1 ? 100 : (g_i == 2 ? 200 : (g_i == 3 ? 500 : (g_i == 4 ? 1000 : (g_i == 5 ? 2000 : (g_i == 6 ? 5000 : 10000))))));
    setc(0.15, 0.15, 0.17); rect(an_x(g_f), g_ay, 1 / g_sc, g_ah, 1);
    g_f >= 1000 ? sprintf(#g_fl, "%dk", g_f / 1000) : sprintf(#g_fl, "%d", g_f);
    c_faint(); text(#g_fl, an_x(g_f) + 2, g_ay + g_ah - 13, 30, 12, 4);
    g_i += 1;
  );
  g_live_me ? (
    g_annorm = 20 * log10(4096 / 4);
    an_fft(ANS, SPS, 4096);
    setc(0.21, 0.21, 0.25); an_draw(SPS, 4096, 1);
    c_orange(); an_draw(SPS, 4096, 0);
  );
  // the bands that listen to the sidechain: what their detector hears
  g_nr = 0; g_b = 0;
  loop(NB,
    (GON[g_b] && g_lin == 0 && floor(slider(ep(g_b, K_TYPE)) + 0.5) <= 2 && pk_dm(slider(ep(g_b, K_DYN))) > 0 && pk_src(slider(ep(g_b, K_DSRC)) ) > 0) ? (
      g_nr += 1;
      g_bw2 = 2 ^ (0.5 / max(0.4, min(10, slider(ep(g_b, K_Q)))));
      g_f = slider(ep(g_b, K_FREQ));
      g_x1 = an_x(g_f / g_bw2); g_x2 = an_x(g_f * g_bw2);
      c_purple(); gfx_a = 0.16; rect(g_x1, g_ay, g_x2 - g_x1, g_ah, 1); gfx_a = 1;
      c_purple(); rect(g_x1, g_ay, 1 / g_sc, g_ah, 1); rect(g_x2, g_ay, 1 / g_sc, g_ah, 1);
      sprintf(#g_rl, "%d", g_b + 1); text(#g_rl, g_x1 + 3, g_ay + 3, 12, 12, 4);
    );
    g_b += 1;
  );
  c_border(); rect(g_ax, g_ay, g_aw, g_ah, 0);
  gfx_setfont(3); c_dim();
  text(g_nr ? "Sidechain input (3-4): the purple bands are what the sidechain bands' detectors hear." :
              "Sidechain input (3-4). Set a band to Dynamic with the Sidechain trigger and its detector range shows here.", g_ax + 6, g_ay + 4, 700, 14, 4);
  button(g_ax + g_aw - 48, g_ay + 3, 44, 16, "Hide", 0, 1, 0) ? g_kset(g_key(-1, P_SCV), 0, 1);
  g_y += g_ah + 8;
);

// ---- the bands: a numbered box each (4 to start; + adds one, right-click + adds several; - deletes the selected band,
// and the last box with it), then solo and delta ----
g_sb = max(0, min(NB - 1, floor(slider(P_SEL) + 0.5)));
g_son = slider(ep(g_sb, K_ON)) >= 0.5;
g_nbx = g_nbox();
label("Bands", 12, g_y - 1, 48);
g_b = 0;
loop(g_nbx, chip(60 + g_b * 34, g_y, 30, 22, g_b); g_b += 1;);
g_px = 60 + g_nbx * 34;
g_nbx < NB ? (
  button(g_px, g_y, 24, 22, "+", 0, 1, 0) ? g_addbox(1);
  (hit(g_px, g_y, 24, 22) && g_rclick && !g_used) ? (
    g_used = 1;
    strcpy(#g_menu, ""); g_i = 1;
    loop(NB - g_nbx, sprintf(#g_mi, "%sAdd %d band%s", g_i > 1 ? "|" : "", g_i, g_i > 1 ? "s" : ""); strcat(#g_menu, #g_mi); g_i += 1;);
    gfx_x = g_mx; gfx_y = g_my; g_r = gfx_showmenu(#g_menu); g_r > 0 ? g_addbox(g_r);
  );
  g_px += 28;
);
g_nbx > 1 ? (button(g_px, g_y, 24, 22, "-", 0, 1, 0) ? g_delbox(g_sb););
button(722, g_y, 80, 22, "Solo", g_son && g_soloact == g_sb, g_son, 1) ? ((g_cap & 8) ? (g_solo_m = g_sb;) : (g_solo_l = (g_solo_l == g_sb ? -1 : g_sb);););
// Delta: hear what the EQ takes away (a click latches it, Shift + click and hold only while held)
g_dlt = slider(P_DELTA) >= 0.5;
button(806, g_y, 82, 22, "Delta", g_dlt, 1, 1) ? (
  (g_cap & 8) ? (g_mom_k = g_key(-1, P_DELTA); g_mom_prev = g_dlt;);
  g_kset(g_key(-1, P_DELTA), !g_dlt, 1);
);
g_y += 30;

// ---- the selected band: on, type, channel, dynamic, trigger (and, while a dynamic band uses the sidechain, Sidechain
// view and trim); then frequency, gain and Q (a high or low pass: its slope) on the left, and on a dynamic band its
// threshold, range, attack, release, hold, ratio, knee and detect on the right. The rows are always the same height,
// so nothing below moves when a band becomes dynamic ----
g_son ? (
  g_sty = floor(slider(ep(g_sb, K_TYPE)) + 0.5);
  g_sdy = g_lin == 0 && g_sty <= 2;
  g_sdon = g_sdy && pk_dm(slider(ep(g_sb, K_DYN))) > 0;
  gfx_setfont(2); band_col(g_sb, 1);
  sprintf(#g_bl, "Band %d", g_sb + 1); text(#g_bl, 12, g_y, 60, 20, 4); gfx_a = 1;
  ctog(74, g_y, 40, "On", ep(g_sb, K_ON), 0);
  type_dd(118, g_y, 90, 20, g_sb);
  cdd(212, g_y, 92, 20, g_key(-1, ep(g_sb, K_PLACE)), 440, 5, "Ch:", 1);
  dyn_dd(308, g_y, 140, 20, g_sb, g_sdy);
  g_sdon ? pdd(452, g_y, 136, 20, g_key(-1, ep(g_sb, K_DSRC)), 1, 2, 460, "", 1);
  g_nsc > 0 ? ctog(600, g_y, 112, "Sidechain view", P_SCV, 1);
  g_sdon ? pdd(746, g_y, 142, 20, g_key(-1, ep(g_sb, K_DYN)), 3, 2, 520, "Detect:", 1);
  g_vb = g_sb;
  g_y += 28;
  cctl("Frequency", 12, g_y, ep(g_sb, K_FREQ), 1, 1);
  // the dynamics, in two columns: threshold, ratio, knee | attack, hold, release (range and detect: the row under)
  g_sdon ? (
    cctl("Threshold", 308, g_y, ep(g_sb, K_THR), 0, 1);
    cctl("Attack", 604, g_y, ep(g_sb, K_ATT), 1, 1);
  ) : (
    (g_lin && g_sty <= 2) ? (gfx_setfont(3); c_faint(); text("Dynamic bands are disabled with linear or natural phase.", 308, g_y, 580, 20, 4););
  );
  g_y += 28;
  cctl("Gain", 12, g_y, ep(g_sb, K_GAIN), 0, g_sty <= 2);
  g_sdon ? (
    cctl("Ratio", 308, g_y, V_RAT, 1, 1);
    cctl("Hold", 604, g_y, V_HLD, 0, 1);
  );
  g_y += 28;
  g_sty >= 5 ? (
    label("Slope", 12, g_y - 1, 64);
    slope_dd(78, g_y, 218, 20, g_sb);
  ) : (
    // Q: its dropdown (Q, Light Q, Medium Q, Strong Q: how much the Q follows the gain), the bar, the value
    pdd(12, g_y, 64, 20, g_key(-1, ep(g_sb, K_DSRC)), 2, 4, 530, "", g_sty <= 2);
    cbar(78, g_y, 138, 20, ep(g_sb, K_Q), 1, 1);
    cfmt(#g_cv, ep(g_sb, K_Q), slider(ep(g_sb, K_Q)));
    valbox(220, g_y, 76, 20, g_key(-1, ep(g_sb, K_Q)), log(400) / 138, log(400) / 1380, 5, #g_cv, 1);
  );
  g_sdon ? (
    cctl("Knee", 308, g_y, V_KNE, 0, 1);
    cctl("Release", 604, g_y, ep(g_sb, K_REL), 1, 1);
  );
  g_y += 28 + 2;
);

// ---- the whole EQ: lookahead and phase; the selected dynamic band's range and detector; Set dynamic thresholds
// (against the right edge); then input, dry/wet, auto gain and its mode ----
ctog(12, g_y, 84, "Lookahead", P_LA, 0);
cfmt(#g_cv, P_LAMS, slider(P_LAMS));
valbox(100, g_y, 62, 20, g_key(-1, P_LAMS), 0.1, 0.01, 6, #g_cv, slider(P_LA) >= 0.5 && g_lin == 0);
dropdown(166, g_y, 130, 20, g_key(-1, P_LIN), 490, 8, 1);
// Set dynamic thresholds: listen, then set every dynamic band's threshold so it reaches its full range on the loudest
// moments (Settings: how much of the time). Only while there are dynamic bands.
(g_son && g_sdon) ? cctl("Range", 308, g_y, ep(g_sb, K_RNG), 0, 1);
g_ndyn > 0 ? tg_controls(674, g_y, -1);
g_y += 28;
g_inact = g_drag_k == g_key(-1, P_IN) || hit(12, g_y, 332, 20);
g_inact ? g_fine = (g_cap & 8) != 0;
// Ctrl held on Input: its change moves the output the other way (see @block)
c_iol = g_inact && (g_cap & 4) != 0;
cctlw("Input", 12, g_y, P_IN, 0, 1, 186);
cctlw("Dry/wet", 364, g_y, P_MIX, 0, 1, 142);
mtog(664, g_y, 90, "Auto gain", P_AUTOG, 0);
cdd(758, g_y, 130, 20, g_key(-1, P_AGM), 498, 2, "Mode:", slider(P_AUTOG) >= 0.5);
g_y += 28 + 2;

// ---- output: the built-in Act, laid out like an Act card in the Gain Stage (the drive link where Auto all's tick and name are) ----
g_ch2 = 38 + 26;
c_card(); rect(6, g_y, 888, g_ch2, 1);
setc(0.20, 0.19, 0.18); rect(6, g_y, 888, g_ch2, 0);
drive_label(#g_dlb, -1);
g_dl = slider(si(P_DRIVE)) >= DRIVE_PARAM; g_don = slider(si(P_DRIVEON)) >= 0.5;
checkbox(16, g_y + 10, g_don && g_dl, g_dl) ? g_kset(g_key(-1, P_DRIVEON), !g_don, 1);
button(38, g_y + 6, 280, 22, #g_dlb, g_dl && g_don, MYSLOT >= 0, 1) ? drive_menu(-1, 38, g_y + 28);
// ... | mode | value | channels | Peak/RMS/LUFS | time | Auto
button(324, g_y + 6, 28, 22, "...", 0, 1, 0) ? act_menu(324, g_y + 28);
mode_ctl(356, g_y + 6, 96, -1, 1, 1);
value_ctl(456, g_y + 6, 130, -1, 1);
auto_mode(-1) != 0 ? src_ctl(590, g_y + 6, 76, 22, -1, 0, 1, 1);
dropdown(666, g_y + 6, 80, 22, g_key(-1, P_MEAS), 310, 3, 1);
auto_time_box(750, g_y + 6, 70, 22, -1, 1);
button(826, g_y + 6, 62, 22, auto_label(-1), auto_busy(-1), MYSLOT >= 0, 0) ? auto_click(-1);
// the gain group: meters, readouts, gain
g_tgt = aim_tick(-1);
gfx_setfont(3); c_dim(); text("1-2", 16, g_y + 36, 36, 20, 4);
meter(54, g_y + 36, 410, 9, MYSLOT, 0, g_tgt, g_live_me);
meter(54, g_y + 47, 410, 9, MYSLOT, 1, g_tgt, g_live_me);
readouts(472, g_y + 36, MYSLOT, 0, 2, g_live_me);
gain_ctl(630, g_y + 36, 168, g_key(-1, P_GAIN), 1);
g_y += g_ch2 + 8;
frame_end(g_y);
