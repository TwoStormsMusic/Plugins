c_lmskip > 0 ? (c_lmskip -= samplesblock; c_ei = 0;);
(samplesblock !== c_lbs || srate !== c_lbsr) ? (c_lbs = samplesblock; c_lbsr = srate; c_klm = 1 - exp(-samplesblock / (1.5 * srate)););
