// ---- A/B: the settings that make up a set ----
ABL = alloc(240); ABN = 0;
function ab_add(p) ( ABL[ABN] = p; ABN += 1; );
ab_add(P_ROUTE); ab_add(P_IN); ab_add(P_MIX); ab_add(P_DUCK); ab_add(P_DTHR); ab_add(P_DATT); ab_add(P_DREL); ab_add(P_DSRC); ab_add(P_LCROSS);
a_i = P_RVB; loop(P_HQ - P_RVB + 1, ab_add(a_i); a_i += 1;);
a_i = EB0; loop(NL * EBN, ab_add(a_i); a_i += 1;);
a_i = MB0; loop(NMOD * MN, ab_add(a_i); a_i += 1;);
ABSET = alloc_keep(256);
!ABS_INIT ? (a_i = 0; loop(ABN, ABSET[ABL[a_i]] = slider(ABL[a_i]); a_i += 1;); ABS_INIT = 1;);
LMI = alloc(2); LMO = alloc(2); LMV = alloc(2);
function c_pv(p) ( c_swh ? ABSET[p] : slider(p); );

QT = alloc(8);
QT[0] = 0.5411961; QT[1] = 1.306563; QT[2] = 0.5097956; QT[3] = 0.6013449; QT[4] = 0.8999762; QT[5] = 2.5629154;

// ---- the engine: buffers and state ----
// delay lines (8 s), the pitch / reverse windows (4.5 s), the diffusion all-passes (100 ms) and the reverb: sizes are powers of two
YDLEN = 1; while (YDLEN < 8.1 * srate + 16) ( YDLEN *= 2; ); YDM = YDLEN - 1;
YSLEN = 1; while (YSLEN < 4.5 * srate + 32) ( YSLEN *= 2; ); YSM = YSLEN - 1;
YALEN = 1; while (YALEN < 0.1 * srate + 8) ( YALEN *= 2; ); YAM = YALEN - 1;
YDB = alloc(NL * 2 * YDLEN); memset(YDB, 0, NL * 2 * YDLEN);
YSBF = alloc(NL * 2 * YSLEN); memset(YSBF, 0, NL * 2 * YSLEN);
YABF = alloc(NL * 2 * 4 * YALEN); memset(YABF, 0, NL * 2 * 4 * YALEN);
YCUR = alloc(4); YTGT = alloc(4); YLO = alloc(4); YLP = alloc(4); YDX = alloc(4); YDY = alloc(4);
YMD = alloc(4 * 8); YWR = alloc(4); YFR = alloc(4); YCZ = alloc(4 * 4); YFZ = alloc(4 * 3 * 2); YFC = alloc(2 * 3 * 5); YFEN = alloc(6);
YON = alloc(2); YMODE = alloc(2); YGK = alloc(2); YTM = alloc(2);
YFBc = alloc(2); YFBt = alloc(2); YXc = alloc(2); YXt = alloc(2); YLVc = alloc(2); YLVt = alloc(2); YPNc = alloc(2); YPNt = alloc(2); YWDc = alloc(2); YWDt = alloc(2);
YNT = alloc(2); YTP = alloc(8); YTL = alloc(8);
YCHR = alloc(2); YCA = alloc(2); YNZ = alloc(2); YBQ = alloc(2); YHD = alloc(2); YWA = alloc(2); YFA = alloc(2); YBA = alloc(2);
YSHON = alloc(2); YSHR = alloc(2); YSHW = alloc(2); YSHP = alloc(2); YSHI = alloc(2); YSD1 = alloc(2); YSD2 = alloc(2); YSW1 = alloc(2);
YSHB = alloc(2); YSHBI = alloc(2); YSHE = alloc(2); YSX = alloc(8); YSHOFF = alloc(2);
YDFON = alloc(2); YDFG = alloc(2); YDFD = alloc(16); YDFM = alloc(16); YDFP = alloc(16); YDFI = alloc(16); YDFOFF = alloc(2); YDFY = alloc(16);
YSTc = alloc(2); YDGc = alloc(2); YDGt = alloc(2); YCPc = alloc(2); YCPt = alloc(2); YSBc = alloc(2); YSBt = alloc(2);
YBMC = alloc(10); YBMZ = alloc(8); YBEN = alloc(2); YBCH = alloc(8);   // the tape head bump
YFE = alloc(2); YFG = alloc(2);                                        // the feedback leveler
YOS = alloc(4 * 64); YOSC = alloc(8);                                  // the 2x saturation: rings and half-band coefficients
YRSc = alloc(2); YRSt = alloc(2);
YLCH = alloc(32);                              // what the filters were last built for
// the shared reverb (an 8-line feedback network), its pre-delay, input all-passes and the shimmer shifter
RLEN = 1; while (RLEN < 3779 * 2.1 * srate / 48000 + 96) ( RLEN *= 2; ); RM = RLEN - 1;
RPLEN = 1; while (RPLEN < 0.21 * srate + 8) ( RPLEN *= 2; ); RPM = RPLEN - 1;
RAL = 1; while (RAL < 0.011 * srate + 8) ( RAL *= 2; ); RAM = RAL - 1;
RSL = 1; while (RSL < 0.2 * srate + 16) ( RSL *= 2; ); RSM = RSL - 1;
RVB = alloc(8 * RLEN); memset(RVB, 0, 8 * RLEN);
RPB = alloc(2 * RPLEN); memset(RPB, 0, 2 * RPLEN);
RAP = alloc(6 * RAL); memset(RAP, 0, 6 * RAL);
RSB = alloc(RSL); memset(RSB, 0, RSL);
YRD = alloc(8); YRG = alloc(8); RZ = alloc(8); RVM = alloc(4); RVI = alloc(4); YRAD = alloc(6); RBASE = alloc(8);
RBASE[0] = 1429; RBASE[1] = 1721; RBASE[2] = 2053; RBASE[3] = 2381; RBASE[4] = 2749; RBASE[5] = 3089; RBASE[6] = 3433; RBASE[7] = 3779;
YRSH = 0; YRSE = 0; YRSP = 0; YRSI = 0; YRSR = 2; YRSW = 0; YRPD = 0; YRDA = 0.5; YRIG = 0.3; YROG = 1; YRCH = alloc(4); YRCH[0] = -1;
y_rl = 0; y_rr = 0; y_rvc = 0; y_rvt = 0; y_rvoff = 100000; y_rsl = 0; y_rsr = 0;
EFFP = alloc(256); MV = alloc(NMOD); MPH = alloc(NMOD); MRA = alloc(NMOD); MRB = alloc(NMOD); MEN = alloc(NMOD); MKA = alloc(NMOD); MKR = alloc(NMOD);
MCC = alloc(130); MLS = alloc(NMOD); MSR = alloc(NMOD); MFL = alloc(NMOD);
// analyzer: pre (input), post (output) and sidechain, the last 8192 samples
ANI = alloc(8192); ANO = alloc(8192); ANS = alloc(8192);
a_mem = ceil(a_mem / 8192) * 8192;          // FFT buffers must not cross a 65536-slot boundary
FFA = alloc(8192);
SPI = alloc(2048); SPO = alloc(2048); SPS = alloc(2048);
a_i = 0; loop(2048, SPI[a_i] = -200; SPO[a_i] = -200; SPS[a_i] = -200; a_i += 1;);
c_tr = 1; c_trt = 1; c_hbi = -200; c_mi0 = -200; c_mi1 = -200; c_mo0 = -200; c_uisolo = -1;
y_wp = 0; y_tc = 0; y_snap = 1; y_csr = 0; y_route = 0; y_frc = 0; y_frt = 0; y_dgc = 1; y_dgt = 1; y_mxc = 0; y_mxt = 0; y_dyc = 1; y_dyt = 1;
y_den = 0; y_ingc = 1; y_ingt = 1; y_wetabs = 0; y_lcc = 0; y_lct = 0;
YRSX = 1; y_hq = 1; y_hql = 7; y_bt = 0; y_bps = 0.000005;
YOSC[0] = -0.000539342; YOSC[1] = 0.018795537; YOSC[2] = -0.113860873; YOSC[3] = 0.595604679; YOSC[4] = 0.595604679; YOSC[5] = -0.113860873; YOSC[6] = 0.018795537; YOSC[7] = -0.000539342;

// ---- filter design (the audio thread and the window each have their own copy) ----
// Every filter is a matched biquad: the poles come from the analog prototype (matched z) and the numerator is
// set so the magnitude equals the analog filter's at DC, at the centre frequency and at Nyquist. The top octaves
// of bells, shelves, notches and low passes then stay close to the analog curve instead of cramping.
// A cut is the exact inverse of the boost of the same shape. If a design is not valid, the classic RBJ filter is used.

// the inverse filter: numerator and denominator swap (o = b0 b1 b2 a1 a2, a0 = 1)
function ea_inv(o) local(b0, b1, b2, a1, a2)
(
  b0 = o[0]; b1 = o[1]; b2 = o[2]; a1 = o[3]; a2 = o[4];
  o[0] = 1 / b0; o[1] = a1 / b0; o[2] = a2 / b0; o[3] = b1 / b0; o[4] = b2 / b0;
);

// the matched design for the analog prototypes (s in units of the centre frequency, A >= 1 for the boosts)
//   kind 0: bell (s^2 + s A/Q + 1) / (s^2 + s/(A Q) + 1)      kind 1: low shelf (boost)
//   kind 2: band pass (s/Q) / (s^2 + s/Q + 1)                  kind 3: low pass 1 / (s^2 + s/Q + 1)
// w = centre frequency in rad/sample. Returns 1 and fills o[0..4] when valid, else 0.
function ea_m3(kind, A, Q, w, o) local(rho, z, wp, e, a1, a2, sq, p1, p2, x2, qq, h0, hf, hn, d0, dn, cw, ww, vv, d2f, s1, s0, s2, t2, u, b1, disc, b0, b2, ok)
(
  kind == 0 ? (rho = 1; z = 0.5 / (A * Q);) : (kind == 1 ? (rho = 1 / sqrt(A); z = 0.5 / Q;) : (rho = 1; z = 0.5 / Q;));
  wp = w * rho;
  z < 1 ? (
    e = exp(-z * wp); a1 = -2 * e * cos(wp * sqrt(1 - z * z)); a2 = e * e;
  ) : (
    sq = sqrt(z * z - 1); p1 = exp(-wp * (z - sq)); p2 = exp(-wp * (z + sq));
    a1 = -(p1 + p2); a2 = p1 * p2;
  );
  x2 = $pi / w; x2 *= x2;
  qq = Q * Q;
  kind == 0 ? (
    hn = (sqr(1 - x2) + x2 * A * A / qq) / (sqr(1 - x2) + x2 / (A * A * qq)); h0 = 1; hf = sqr(A * A);
  ) : (kind == 1 ? (
    hn = A * A * (sqr(A - x2) + x2 * A / qq) / (sqr(1 - A * x2) + x2 * A / qq); h0 = sqr(A * A); hf = A * A;
  ) : (kind == 2 ? (
    hn = (x2 / qq) / (sqr(1 - x2) + x2 / qq); h0 = 0; hf = 1;
  ) : (
    hn = 1 / (sqr(1 - x2) + x2 / qq); h0 = 1; hf = qq;
  )));
  d0 = 1 + a1 + a2; dn = 1 - a1 + a2; cw = cos(w);
  ww = sqrt(h0) * d0; vv = sqrt(hn) * dn;
  d2f = 1 + a1 * a1 + a2 * a2 + 2 * (a1 + a1 * a2) * cw + 2 * a2 * cos(2 * w);
  s1 = (1 - cw) * 0.5; s0 = 1 - s1; s2 = 4 * s0 * s1;
  t2 = (hf * d2f - ww * ww * s0 - vv * vv * s1) / s2;
  u = (ww + vv) * 0.5; b1 = (ww - vv) * 0.5; disc = u * u + t2;
  ok = 0;
  disc >= 0 ? (
    b0 = (u + sqrt(disc)) * 0.5; b2 = u - b0;
    (abs(b0) > 0.000000001 && abs(b2 / b0) < 0.9999 && abs(b1 / b0) <= 1 + b2 / b0 + 0.000000001 && a2 < 0.9999 && abs(a1) < 1 + a2 - 0.000001) ? (
      o[0] = b0; o[1] = b1; o[2] = b2; o[3] = a1; o[4] = a2; ok = 1;
    );
  );
  ok;
);

// the classic RBJ bell / shelf / notch / band pass (the fallback), from w and sin/cos
function ea_rbj(type, w, g, q, o) local(cw, sw, al, A, sq, a0)
(
  cw = cos(w); sw = sin(w); al = sw / (2 * q); A = 10 ^ (g / 40);
  type == 0 ? (
    a0 = 1 + al / A;
    o[0] = (1 + al * A) / a0; o[1] = -2 * cw / a0; o[2] = (1 - al * A) / a0; o[3] = o[1]; o[4] = (1 - al / A) / a0;
  );
  type == 1 ? (
    sq = 2 * sqrt(A) * al;
    a0 = (A + 1) + (A - 1) * cw + sq;
    o[0] = A * ((A + 1) - (A - 1) * cw + sq) / a0;
    o[1] = 2 * A * ((A - 1) - (A + 1) * cw) / a0;
    o[2] = A * ((A + 1) - (A - 1) * cw - sq) / a0;
    o[3] = -2 * ((A - 1) + (A + 1) * cw) / a0;
    o[4] = ((A + 1) + (A - 1) * cw - sq) / a0;
  );
  type == 2 ? (
    sq = 2 * sqrt(A) * al;
    a0 = (A + 1) - (A - 1) * cw + sq;
    o[0] = A * ((A + 1) + (A - 1) * cw + sq) / a0;
    o[1] = -2 * A * ((A - 1) + (A + 1) * cw) / a0;
    o[2] = A * ((A + 1) + (A - 1) * cw - sq) / a0;
    o[3] = 2 * ((A - 1) - (A + 1) * cw) / a0;
    o[4] = ((A + 1) - (A - 1) * cw - sq) / a0;
  );
  type == 3 ? (
    a0 = 1 + al;
    o[0] = 1 / a0; o[1] = -2 * cw / a0; o[2] = o[0]; o[3] = o[1]; o[4] = (1 - al) / a0;
  );
  type == 4 ? (
    a0 = 1 + al;
    o[0] = al / a0; o[1] = 0; o[2] = -al / a0; o[3] = -2 * cw / a0; o[4] = (1 - al) / a0;
  );
);

// the gain-dependent Q: the effective Q of a bell or shelf (qm 0 = off, 1 light, 2 medium, 3 strong; shelves follow half as much)
function ea_qe(type, g, q, qm)
(
  (qm > 0 && type <= 2) ? min(100, q * (1 + (qm == 1 ? 0.5 : (qm == 2 ? 1 : 2)) * (type == 0 ? 1 : 0.5) * min(abs(g), 30) / 18)) : q;
);

// section coefficients of a band: up to 4 biquad sections, 5 numbers each (b0 b1 b2 a1 a2, a0 = 1), at o[0..19];
// returns how many sections (0 = the band does nothing)
function ea_coef(type, f, g, q, qm, o) local(w, A, n, sl, ns, qq, i, hp, k, ok, cw, sw, al, a0, e, gn, c1, c2)
(
  w = 2 * $pi * min(f, srate * 0.49) / srate;
  q = max(0.05, q);
  q = ea_qe(type, g, q, qm);
  n = 0;
  (type <= 2 && abs(g) >= 0.001) ? (
    A = 10 ^ (abs(g) / 40);
    ok = ea_m3(type == 0 ? 0 : 1, A, q, w, o);
    ok ? (
      type == 0 ? (g < 0 ? ea_inv(o););
      type == 1 ? (g < 0 ? ea_inv(o););
      type == 2 ? (
        A *= A;
        g >= 0 ? (ea_inv(o); o[0] *= A; o[1] *= A; o[2] *= A;) : (o[0] /= A; o[1] /= A; o[2] /= A;);
      );
    ) : ea_rbj(type, w, g, q, o);
    n = 1;
  );
  type == 3 ? (
    // notch: zeros exactly at the centre; the pole radius is the analog's and the pole angle makes the Nyquist gain the analog's
    cw = cos(w); c1 = $pi / w; c1 *= c1; qq = q * q;
    e = exp(-w / q);
    gn = sqrt(sqr(1 - c1) / (sqr(1 - c1) + c1 / qq));
    c2 = (1 + cw) / (1 - cw);
    o[3] = (gn - c2) * (1 + e) / (c2 + gn); o[4] = e;
    o[0] = (1 + o[3] + o[4]) / (2 - 2 * cw); o[1] = -2 * o[0] * cw; o[2] = o[0];
    (e < 0.9999 && abs(o[3]) < 1 + e - 0.000001 && o[0] > 0.000000001) ? 1 : ea_rbj(3, w, 0, q, o);
    n = 1;
  );
  type == 4 ? (
    ea_m3(2, 1, q, w, o) ? 1 : ea_rbj(4, w, 0, q, o);
    n = 1;
  );
  type >= 5 ? (
    hp = type <= 8; sl = hp ? type - 5 : type - 9;
    sl == 0 ? (
      hp ? (
        k = tan(w * 0.5);
        o[0] = 1 / (1 + k); o[1] = -o[0]; o[2] = 0; o[3] = (k - 1) / (1 + k); o[4] = 0;
      ) : (
        // one pole, DC gain 1, Nyquist gain the analog's
        e = exp(-w); gn = 1 / sqrt(1 + sqr($pi / w));
        o[3] = -e; o[0] = ((1 - e) + gn * (1 + e)) * 0.5; o[1] = ((1 - e) - gn * (1 + e)) * 0.5; o[2] = 0; o[4] = 0;
      );
      n = 1;
    ) : (
      ns = sl == 1 ? 1 : (sl == 2 ? 2 : 4);
      i = 0;
      loop(ns,
        qq = sl == 1 ? q : (sl == 2 ? QT[i] : QT[2 + i]);
        (i == ns - 1 && sl >= 2) ? qq = max(0.1, qq * q / 0.7071068);
        (!hp && ea_m3(3, 1, qq, w, o + i * 5)) ? 1 : (
          cw = cos(w); sw = sin(w); al = sw / (2 * qq); a0 = 1 + al;
          hp ? (o[i * 5] = (1 + cw) * 0.5 / a0; o[i * 5 + 1] = -(1 + cw) / a0;) : (o[i * 5] = (1 - cw) * 0.5 / a0; o[i * 5 + 1] = (1 - cw) / a0;);
          o[i * 5 + 2] = o[i * 5]; o[i * 5 + 3] = -2 * cw / a0; o[i * 5 + 4] = (1 - al) / a0;
        );
        i += 1;
      );
      n = ns;
    );
  );
  n;
);

// power response |H|^2 of n sections at a frequency with cos(w) = cw, cos(2w) = c2
function ea_mag2(o, n, cw, c2) local(p, i, b0, b1, b2, a1, a2, nu, de)
(
  p = 1; i = 0;
  loop(n,
    b0 = o[i]; b1 = o[i + 1]; b2 = o[i + 2]; a1 = o[i + 3]; a2 = o[i + 4];
    nu = b0 * b0 + b1 * b1 + b2 * b2 + 2 * (b0 * b1 + b1 * b2) * cw + 2 * b0 * b2 * c2;
    de = 1 + a1 * a1 + a2 * a2 + 2 * (a1 + a1 * a2) * cw + 2 * a2 * c2;
    p *= nu / max(0.000000000001, de);
    i += 5;
  );
  p;
);

// ---- the static curves (the audio thread and the window each have their own copy) ----
// a fast tanh: slope 1 at 0, exactly +-1 from |x| = 3
function ds_th(x) local(a) ( x > 3 ? 1 : (x < -3 ? -1 : (a = x * x; x * (27 + a) / (27 + 9 * a))); );
// the memoryless part of style st, for an input u already scaled by the drive (about +-1 is "full scale")
function ds_core(st, u) local(y, s, r, p)
(
  y = 0;
  st == 0 ? y = ds_th(u + 0.15) - 0.1489;
  st == 1 ? y = ds_th(u + 0.35) - 0.3364;
  st == 2 ? y = ds_th(u + 0.7) - 0.6044;
  st == 3 ? y = ds_th(2 * u + 0.9) - 0.7163;
  st == 4 ? y = u > 1 ? 0.6667 : (u < -1 ? -0.6667 : u - u * u * u * 0.33333);
  st == 5 ? y = atan(1.2 * u) * 0.82;
  st == 6 ? y = sin(max(-1.5708, min(1.5708, u)));
  st == 7 ? (r = abs(u) / 1.5; p = r * r; p = p * p * r; y = u * exp(-min(p, 30)););
  st == 8 ? y = ds_th(u);                                       // tape head (stateful in the audio thread)
  st == 9 ? y = ds_th(u);
  st == 10 ? y = ds_th(u + 0.1) - 0.0997;
  st == 11 ? y = ds_th(u + 0.2) - 0.1974;
  st == 12 ? y = ds_th(1.4 * (ds_th(u + 0.08) - 0.0798)) / 1.4;
  st == 13 ? (s = ds_th(1.5 * u + 0.2) - 0.1974; s *= 2; r = abs(s); y = s / exp(log(1 + r * r * r) / 3););
  st == 14 ? y = ds_th(ds_th(1.8 * u));
  st == 15 ? (s = u >= 0 ? (1 - exp(-1.6 * u)) / 1.6 : -(1 - exp(1.1 * u)) / 1.1; y = ds_th(3 * s) / 3;);
  st == 16 ? y = ds_th(2.5 * ds_th(2 * (ds_th(2 * u + 0.1) - 0.0997))) / 2.5;
  (st == 17 || st == 18) ? y = ds_th(u);                        // console (stateful in the audio thread)
  st == 19 ? (s = u + 0.25; y = (s + 0.4 * s * abs(s)) / (1 + 0.8 * abs(s)) - 0.22916667; y = 1.2 * ds_th(y / 1.2););
  st == 20 ? (s = max(-0.5, min(0.5, 0.5 * u)); r = min(1, abs(s) * 0.5 + 0.75); y = 4 * (1 - r * abs(s)) * r * s;);
  st == 21 ? y = ds_th(4 * (u + 0.15)) - ds_th(0.6);
  st == 22 ? y = ds_th(u);                                      // smudge (slewed in the audio thread)
  st == 23 ? y = ds_th(u);                                      // breakdown (adds a sub octave)
  st == 24 ? (s = u - 1; s = s - 4 * floor(s / 4); y = abs(s - 2) - 1;);
  st == 25 ? y = sin(u);
  st == 26 ? (r = abs(u); y = 0.6 * ds_th(0.7 * u) + 0.8 * (ds_th(1.3 * r) - 0.35););
  st == 27 ? y = max(-1, min(1, u));                             // destroy (crushed in the audio thread)
  st == 28 ? y = ds_th(u);
  st == 29 ? y = max(-1, min(1, u));
  y;
);


// a biquad (b0 b1 b2 a1 a2, a0 = 1), transposed direct form II; z = two states
function y_bq(x, o, z) local(l_y) ( l_y = o[0] * x + z[0]; z[0] = o[1] * x - o[3] * l_y + z[1]; z[1] = o[2] * x - o[4] * l_y; l_y; );
// a read from a delay buffer: d samples back from the slot about to be written (Catmull-Rom between four neighbours)
function y_rd(l_b, l_m, l_d) local(l_p, l_i, l_f, l_a, l_c, l_e, l_g)
(
  l_p = y_wp - l_d; l_i = floor(l_p); l_f = l_p - l_i;
  l_a = l_b[(l_i - 1) & l_m]; l_g = l_b[l_i & l_m]; l_c = l_b[(l_i + 1) & l_m]; l_e = l_b[(l_i + 2) & l_m];
  l_g + 0.5 * l_f * (l_c - l_a + l_f * (2 * l_a - 5 * l_g + 4 * l_c - l_e + l_f * (3 * (l_g - l_c) + l_e - l_a)));
);
// the same with six neighbours (5th-order Lagrange): flatter at high frequencies, less aliasing when the time moves
function y_rd6(l_b, l_m, l_d) local(l_p, l_i, l_f, l_a, l_c, l_e, l_g, l_h, l_j, l_t, l_u, l_v, l_w, l_x, l_y, l_z)
(
  l_p = y_wp - l_d; l_i = floor(l_p); l_f = l_p - l_i;
  l_a = l_f + 2; l_c = l_f + 1; l_e = l_f - 1; l_g = l_f - 2; l_h = l_f - 3;
  l_t = l_c * l_f; l_u = l_e * l_g; l_v = l_a * l_f; l_w = l_a * l_c;
  l_x = l_t * l_u * l_h * -0.008333333333;                 // node -2:  b c d e g / -120
  l_y = l_v * l_u * l_h * 0.041666666667;                  // node -1:  a c d e g / 24
  l_z = l_w * l_e * l_g * l_h * -0.083333333333;           // node 0:   a b d e g / -12
  l_j = l_w * l_f * l_g * l_h * 0.083333333333;            // node 1:   a b c e g / 12
  l_x = l_x * l_b[(l_i - 2) & l_m] + l_y * l_b[(l_i - 1) & l_m] + l_z * l_b[l_i & l_m] + l_j * l_b[(l_i + 1) & l_m];
  l_x + l_w * l_f * l_e * l_h * -0.041666666667 * l_b[(l_i + 2) & l_m] + l_w * l_f * l_e * l_g * 0.008333333333 * l_b[(l_i + 3) & l_m];
);
function y_rdq(l_b, l_m, l_d) ( y_hq ? y_rd6(l_b, l_m, l_d) : y_rd(l_b, l_m, l_d); );
// a soft ceiling just over full scale, so a feedback over 100% can't run away (the leveler in the loop does the real work)
function y_lim(l_x) local(l_a)
(
  l_a = abs(l_x);
  l_a < 1 ? l_x : (l_x > 0 ? 1 + 0.5 * ds_th((l_a - 1) * 2) : -1 - 0.5 * ds_th((l_a - 1) * 2));
);

// pitch shifting: where to start the tap that is about to fade in so it lines up with the tap that is playing.
// Looks back a few milliseconds for the offset (0 .. ~6 ms further back) where the two sound most alike.
function y_align(l_o, l_dn, l_dr) local(l_i, l_m, l_bi, l_bc, l_c, l_e, l_pa, l_pb, l_a, l_b)
(
  l_pa = floor(y_wp - l_dr);
  l_bi = 0; l_bc = -1000000000; l_i = 0;
  loop(YAL_N,
    l_pb = floor(y_wp - l_dn) - l_i * YAL_ST;
    l_c = 0; l_e = 0.0000001; l_m = 0;
    loop(YAL_M, l_a = l_o[(l_pa - l_m * YAL_ST) & YSM]; l_b = l_o[(l_pb - l_m * YAL_ST) & YSM]; l_c += l_a * l_b; l_e += l_b * l_b; l_m += 1;);
    l_c /= sqrt(l_e);
    l_c > l_bc ? (l_bc = l_c; l_bi = l_i;);
    l_i += 1;
  );
  l_bi * YAL_ST;
);

// what happens to a repeat on its way round: pitch / reverse, diffusion, filters, character, saturation
function y_proc(l_i, l_k, l_x) local(l_o, l_j, l_g, l_v, l_w, l_y, l_z, l_a, l_b, l_e, l_t, l_n, l_pp, l_ii, l_ff)
(
  YSHON[l_k] ? (
    l_o = YSBF + l_i * YSLEN;
    l_o[y_wp & YSM] = l_x;
    YSW1[l_k] >= 1 ? (
      l_x = y_rdq(l_o, YSM, YSD1[l_k] + YSX[l_i * 2]);
    ) : (
      l_x = y_rdq(l_o, YSM, YSD1[l_k] + YSX[l_i * 2]) * YSW1[l_k] + y_rdq(l_o, YSM, YSD2[l_k] + YSX[l_i * 2 + 1]) * (1 - YSW1[l_k]);
    );
  );
  YDFON[l_k] ? (
    l_j = 0; l_g = YDFG[l_k];
    loop(4,
      l_n = l_i * 4 + l_j;
      l_o = YABF + l_n * YALEN;
      YDFM[l_n] > 0 ? (
        // two of the four all-passes move slowly (a hint of chorus that keeps the diffusion from ringing); the all-pass interpolator keeps the level flat
        l_t = YDFP[l_n] + YDFI[l_n]; l_t >= 1 ? l_t -= 1; YDFP[l_n] = l_t;
        l_pp = y_wp - (YDFD[l_n] + YDFM[l_n] * (abs(2 * l_t - 1) * 2 - 1));
        l_ii = floor(l_pp); l_ff = l_pp - l_ii;
        l_a = l_ff / (2 - l_ff);
        l_v = l_a * l_o[(l_ii + 1) & YAM] + l_o[l_ii & YAM] - l_a * YDFY[l_n]; YDFY[l_n] = l_v;
      ) : (l_v = l_o[(y_wp - YDFD[l_n]) & YAM];);
      l_w = l_x + l_g * l_v;
      l_o[y_wp & YAM] = l_w;
      l_x = l_v - l_g * l_w;
      l_j += 1;
    );
  );
  l_j = 0;
  loop(3, YFEN[l_k * 3 + l_j] ? l_x = y_bq(l_x, YFC + (l_k * 3 + l_j) * 5, YFZ + (l_i * 3 + l_j) * 2); l_j += 1;);
  l_j = YCHR[l_k];
  l_j > 0 ? (
    l_z = YCZ + l_i * 4;
    l_x += (rand(2) - 1) * YNZ[l_k];
    l_z[0] += YCA[l_k] * (l_x - l_z[0]); l_x = l_z[0];
    (l_j == 1 || l_j == 2) ? (l_z[1] += YCA[l_k] * (l_x - l_z[1]); l_x = l_z[1];);
    (l_j == 1 && YBEN[l_k]) ? l_x = y_bq(l_x, YBMC + l_k * 5, YBMZ + l_i * 2);
    l_j == 3 ? (
      (l_z[2] -= 1) <= 0 ? (l_z[2] = YHD[l_k]; l_z[3] = floor(l_x * YBQ[l_k] + 0.5) / YBQ[l_k];);
      l_x = l_z[3];
    );
  );
  y_hq ? (
    // saturation at twice the rate (half-band filters, 7 samples of delay that the delay time takes off)
    l_z = YOS + l_i * 64; l_n = y_wp & 15;
    l_z[l_n] = l_x;
    YSBc[l_k] > 0.0005 ? (
      l_z[16 + l_n] = l_x * YDGc[l_k];
      l_e = 0; l_t = 0; loop(8, l_e += YOSC[l_t] * l_z[16 + ((l_n - l_t) & 15)]; l_t += 1;);
      l_z[32 + l_n] = ds_core(YSTc[l_k], l_e);
      l_z[48 + l_n] = ds_core(YSTc[l_k], l_z[16 + ((l_n - 3) & 15)]);
      l_y = 0.5 * l_z[48 + ((l_n - 4) & 15)];
      l_t = 0; loop(8, l_y += 0.5 * YOSC[l_t] * l_z[32 + ((l_n - l_t) & 15)]; l_t += 1;);
      l_y *= YCPc[l_k];
      l_x = l_z[(l_n - 7) & 15];
      l_x += (l_y - l_x) * YSBc[l_k];
    ) : (l_x = l_z[(l_n - 7) & 15];);
  ) : (
    YSBc[l_k] > 0.0005 ? (
      l_y = ds_core(YSTc[l_k], l_x * YDGc[l_k]) * YCPc[l_k];
      l_x += (l_y - l_x) * YSBc[l_k];
    );
  );
  l_y = l_x - YDX[l_i] + DC_R * YDY[l_i]; YDX[l_i] = l_x; YDY[l_i] = l_y;
  l_y = y_lim(l_y);
  abs(l_y) < 0.00000000000000000001 ? 0 : l_y;
);

// the shared reverb: pre-delay, two input all-passes per side, an 8-line feedback network (Hadamard mix, damping, slow modulation), and a shimmer
function y_rv(l_il, l_ir) local(l_p, l_q, l_a, l_b, l_c, l_d, l_f, l_i, l_m, l_o, l_s, l_t, l_x, l_ie, l_io, o0, o1, o2, o3, o4, o5, o6, o7, d0, d1, d2, d3, d4, d5, d6, d7)
(
  l_p = y_wp & RPM;
  RPB[l_p] = l_il; RPB[RPLEN + l_p] = l_ir;
  l_q = (y_wp - YRPD) & RPM;
  l_il = RPB[l_q]; l_ir = RPB[RPLEN + l_q];
  l_i = 0;
  loop(3,
    l_o = RAP + l_i * RAL; l_d = YRAD[l_i];
    l_b = l_o[(y_wp - l_d) & RAM]; l_a = l_il + 0.6 * l_b; l_o[y_wp & RAM] = l_a; l_il = l_b - 0.6 * l_a;
    l_o = RAP + (3 + l_i) * RAL; l_d = YRAD[3 + l_i];
    l_b = l_o[(y_wp - l_d) & RAM]; l_a = l_ir + 0.6 * l_b; l_o[y_wp & RAM] = l_a; l_ir = l_b - 0.6 * l_a;
    l_i += 1;
  );
  l_s = 0;
  YRSH > 0.0003 ? (
    RSB[y_wp & RSM] = (y_rl + y_rr) * 0.5;
    l_t = YRSP + YRSI; l_t >= 1 ? l_t -= 1; YRSP = l_t;
    l_a = l_t + 0.5; l_a >= 1 ? l_a -= 1;
    l_f = l_t < 0.5 ? 2 * l_t : 2 - 2 * l_t; l_f = l_f * l_f * (3 - 2 * l_f);
    l_m = YRSR;
    l_d = 4 + (l_m < 1 ? (1 - l_m) * YRSW * l_t : (l_m - 1) * YRSW * (1 - l_t));
    l_c = 4 + (l_m < 1 ? (1 - l_m) * YRSW * l_a : (l_m - 1) * YRSW * (1 - l_a));
    l_s = y_rd(RSB, RSM, l_d) * l_f + y_rd(RSB, RSM, l_c) * (1 - l_f);
    l_s = y_lim(l_s) * YRSH;
    YRSE += (abs(y_rl) + abs(y_rr) - YRSE) * 0.002;
    YRSE > 0.5 ? l_s *= 0.5 / YRSE;
  );
  l_ie = (l_il + l_s) * YRIG + 0.000000000000000001; l_io = (l_ir + l_s) * YRIG + 0.000000000000000001;
  l_o = RVB + 0 * RLEN;
  l_t = RVM[0] + RVI[0]; l_t >= 1 ? l_t -= 1; RVM[0] = l_t;
  l_q = y_wp - (YRD[0] + YRMD * (abs(2 * l_t - 1) * 2 - 1)); l_i = floor(l_q); l_f = l_q - l_i;
  l_a = l_o[l_i & RM]; o0 = l_a + (l_o[(l_i + 1) & RM] - l_a) * l_f;
  RZ[0] += YRDA * (o0 - RZ[0]); o0 = RZ[0] * YRG[0];
  l_o = RVB + 1 * RLEN;
  o1 = l_o[(y_wp - YRD[1]) & RM];
  RZ[1] += YRDA * (o1 - RZ[1]); o1 = RZ[1] * YRG[1];
  l_o = RVB + 2 * RLEN;
  l_t = RVM[1] + RVI[1]; l_t >= 1 ? l_t -= 1; RVM[1] = l_t;
  l_q = y_wp - (YRD[2] + YRMD * (abs(2 * l_t - 1) * 2 - 1)); l_i = floor(l_q); l_f = l_q - l_i;
  l_a = l_o[l_i & RM]; o2 = l_a + (l_o[(l_i + 1) & RM] - l_a) * l_f;
  RZ[2] += YRDA * (o2 - RZ[2]); o2 = RZ[2] * YRG[2];
  l_o = RVB + 3 * RLEN;
  o3 = l_o[(y_wp - YRD[3]) & RM];
  RZ[3] += YRDA * (o3 - RZ[3]); o3 = RZ[3] * YRG[3];
  l_o = RVB + 4 * RLEN;
  l_t = RVM[2] + RVI[2]; l_t >= 1 ? l_t -= 1; RVM[2] = l_t;
  l_q = y_wp - (YRD[4] + YRMD * (abs(2 * l_t - 1) * 2 - 1)); l_i = floor(l_q); l_f = l_q - l_i;
  l_a = l_o[l_i & RM]; o4 = l_a + (l_o[(l_i + 1) & RM] - l_a) * l_f;
  RZ[4] += YRDA * (o4 - RZ[4]); o4 = RZ[4] * YRG[4];
  l_o = RVB + 5 * RLEN;
  o5 = l_o[(y_wp - YRD[5]) & RM];
  RZ[5] += YRDA * (o5 - RZ[5]); o5 = RZ[5] * YRG[5];
  l_o = RVB + 6 * RLEN;
  l_t = RVM[3] + RVI[3]; l_t >= 1 ? l_t -= 1; RVM[3] = l_t;
  l_q = y_wp - (YRD[6] + YRMD * (abs(2 * l_t - 1) * 2 - 1)); l_i = floor(l_q); l_f = l_q - l_i;
  l_a = l_o[l_i & RM]; o6 = l_a + (l_o[(l_i + 1) & RM] - l_a) * l_f;
  RZ[6] += YRDA * (o6 - RZ[6]); o6 = RZ[6] * YRG[6];
  l_o = RVB + 7 * RLEN;
  o7 = l_o[(y_wp - YRD[7]) & RM];
  RZ[7] += YRDA * (o7 - RZ[7]); o7 = RZ[7] * YRG[7];
  y_rl = (o0 + o3 - o4 - o7) * YROG; y_rr = (o1 + o2 - o5 - o6) * YROG;
  l_a = o0 + o1; l_b = o0 - o1; l_c = o2 + o3; l_d = o2 - o3;
  d0 = o4 + o5; d1 = o4 - o5; d2 = o6 + o7; d3 = o6 - o7;
  d4 = l_a + l_c; d5 = l_b + l_d; d6 = l_a - l_c; d7 = l_b - l_d;          // lines 0..3 after two stages
  l_a = d0 + d2; l_b = d1 + d3; l_c = d0 - d2; l_d = d1 - d3;                // lines 4..7 after two stages
  (RVB + 0 * RLEN)[y_wp & RM] = (d4 + l_a) * 0.35355339 + l_ie;
  (RVB + 1 * RLEN)[y_wp & RM] = (d5 + l_b) * 0.35355339 + l_io;
  (RVB + 2 * RLEN)[y_wp & RM] = (d6 + l_c) * 0.35355339 + l_ie;
  (RVB + 3 * RLEN)[y_wp & RM] = (d7 + l_d) * 0.35355339 + l_io;
  (RVB + 4 * RLEN)[y_wp & RM] = (d4 - l_a) * 0.35355339 + l_ie;
  (RVB + 5 * RLEN)[y_wp & RM] = (d5 - l_b) * 0.35355339 + l_io;
  (RVB + 6 * RLEN)[y_wp & RM] = (d6 - l_c) * 0.35355339 + l_ie;
  (RVB + 7 * RLEN)[y_wp & RM] = (d7 - l_d) * 0.35355339 + l_io;
);

// one sample: the input in, the wet signal out (y_wl, y_wr)
function y_run(l_il, l_ir) local(l_k, l_c, l_i, l_o, l_d, l_n, l_j, l_s, l_v, l_m, l_x, l_a, l_b, l_ph, l_p2, l_f, l_xx, l_pl, l_pr, l_ml, l_mr, l_ol, l_or, l_fo, l_il2, l_ir2, l_sl, l_sr, l_mo, l_ph0, l_w1, l_w2, l_e, l_sp, l_t, l_fe, l_fg, l_pn, l_lv)
(
  y_frc += (y_frt - y_frc) * YKF;
  l_k = 0;
  loop(NL,
    YON[l_k] ? (
      YSHON[l_k] ? (
        l_j = YSHR[l_k];
        YSHB[l_k] ? (
          // reverse in chunks that start on the beat: the last chunk, backwards, with a short crossfade at the seams
          l_ph = y_bt * YSHBI[l_k]; l_ph -= floor(l_ph);
          l_e = YSHE[l_k]; l_sp = 1 + abs(l_j);
          YSD1[l_k] = 4 + l_sp * YSHW[l_k] * l_ph;
          YSD2[l_k] = 4 + l_sp * YSHW[l_k] * (l_ph + 1);
          l_ph < l_e ? (l_t = l_ph / l_e; YSW1[l_k] = l_t * l_t * (3 - 2 * l_t);) : (YSW1[l_k] = 1;);
        ) : (
          l_ph0 = YSHP[l_k]; l_ph = l_ph0 + YSHI[l_k]; l_w1 = l_ph >= 1; l_w1 ? l_ph -= 1; YSHP[l_k] = l_ph;
          l_w2 = l_ph0 < 0.5 && l_ph >= 0.5;
          l_p2 = l_ph + 0.5; l_p2 >= 1 ? l_p2 -= 1;
          l_a = l_ph < 0.5 ? 2 * l_ph : 2 - 2 * l_ph; YSW1[l_k] = l_a * l_a * (3 - 2 * l_a);
          YSD1[l_k] = 4 + (l_j < 1 ? (1 - l_j) * YSHW[l_k] * l_ph : (l_j - 1) * YSHW[l_k] * (1 - l_ph));
          YSD2[l_k] = 4 + (l_j < 1 ? (1 - l_j) * YSHW[l_k] * l_p2 : (l_j - 1) * YSHW[l_k] * (1 - l_p2));
          (y_hq && l_j > 0 && (l_w1 || l_w2)) ? (
            l_c = 0;
            loop(2,
              l_i = l_k * 2 + l_c; l_o = YSBF + l_i * YSLEN;
              l_w1 ? YSX[l_i * 2] = y_align(l_o, YSD1[l_k], YSD2[l_k] + YSX[l_i * 2 + 1]);
              l_w2 ? YSX[l_i * 2 + 1] = y_align(l_o, YSD2[l_k], YSD1[l_k] + YSX[l_i * 2]);
              l_c += 1;
            );
          );
        );
      );
      YFBc[l_k] += (YFBt[l_k] - YFBc[l_k]) * YKS; YXc[l_k] += (YXt[l_k] - YXc[l_k]) * YKS;
      YLVc[l_k] += (YLVt[l_k] - YLVc[l_k]) * YKS; YPNc[l_k] += (YPNt[l_k] - YPNc[l_k]) * YKS; YWDc[l_k] += (YWDt[l_k] - YWDc[l_k]) * YKS;
      YDGc[l_k] += (YDGt[l_k] - YDGc[l_k]) * YKS; YCPc[l_k] += (YCPt[l_k] - YCPc[l_k]) * YKS; YSBc[l_k] += (YSBt[l_k] - YSBc[l_k]) * YKS;
      YRSc[l_k] += (YRSt[l_k] - YRSc[l_k]) * YKS;
      l_n = YNT[l_k];
      l_c = 0;
      loop(2,
        l_i = l_k * 2 + l_c;
        l_o = YDB + l_i * YDLEN;
        YCUR[l_i] += (YTGT[l_i] - YCUR[l_i]) * YGK[l_k];
        l_d = YCUR[l_i];
        l_m = YMD + l_i * 8;
        YWA[l_k] > 0 ? (
          l_m[0] += YWR[l_i]; l_m[0] >= 1 ? (l_m[0] -= 1; l_m[1] = l_m[2]; l_m[2] = rand(2) - 1;);
          l_t = l_m[0]; l_d += YWA[l_k] * (l_m[1] + (l_m[2] - l_m[1]) * (l_t * l_t * (3 - 2 * l_t)));
        );
        YFA[l_k] > 0 ? (
          l_m[3] += YFR[l_i]; l_m[3] >= 1 ? (l_m[3] -= 1; l_m[4] = l_m[5]; l_m[5] = rand(2) - 1;);
          l_t = l_m[3]; l_d += YFA[l_k] * (l_m[4] + (l_m[5] - l_m[4]) * (l_t * l_t * (3 - 2 * l_t)));
        );
        YBA[l_k] > 0 ? (
          l_m[6] += YBR; l_m[6] >= 1 ? l_m[6] -= 1;
          l_t = l_m[6] < 0.5 ? l_m[6] : l_m[6] - 1; l_t = 4 * l_t * (1 - 2 * abs(l_t));      // a sine, near enough
          l_d += YBA[l_k] * l_t;
        );
        l_d = max(4, min(YDLEN - 8, l_d));
        l_v = 0; l_j = 0;
        loop(l_n - 1, l_v += y_rdq(l_o, YDM, max(4, l_d * YTP[l_k * 4 + l_j] - y_hql)) * YTL[l_k * 4 + l_j]; l_j += 1;);
        l_s = y_rdq(l_o, YDM, max(4, l_d - y_hql));
        YLO[l_i] = l_v + l_s;
        YLP[l_i] = l_s;
        l_c += 1;
      );
    ) : (YLO[l_k * 2] = 0; YLO[l_k * 2 + 1] = 0; YLP[l_k * 2] = 0; YLP[l_k * 2 + 1] = 0;);
    l_k += 1;
  );
  // what goes into the lines, and round again
  l_k = 0;
  loop(NL,
    l_o = YDB + (l_k * 2) * YDLEN; l_d = YDB + (l_k * 2 + 1) * YDLEN;
    YON[l_k] ? (
      l_il2 = l_il; l_ir2 = l_ir;
      (y_route == 1 && l_k == 1 && YON[0]) ? (l_il2 = YLO[0]; l_ir2 = YLO[1];);
      (y_route == 2 && l_k == 0 && YON[1]) ? (l_il2 = YLO[2]; l_ir2 = YLO[3];);
      l_j = YMODE[l_k];
      l_j == 0 ? (l_sl = l_il2; l_sr = l_ir2;) : (l_m = (l_il2 + l_ir2) * 0.5; l_sl = l_j == 1 ? l_m : 0; l_sr = l_j == 1 ? 0 : l_m;);
      l_sl *= 1 - y_frc; l_sr *= 1 - y_frc;
      l_f = YFBc[l_k] + (1 - YFBc[l_k]) * y_frc;
      l_xx = YXc[l_k];
      l_pl = YLP[l_k * 2]; l_pr = YLP[l_k * 2 + 1];
      l_ml = l_pl * (1 - l_xx) + l_pr * l_xx; l_mr = l_pr * (1 - l_xx) + l_pl * l_xx;
      // the leveler: when the feedback itself gets near full scale it is turned down, smoothly, rather than clipped
      l_fe = max(abs(l_ml), abs(l_mr)) * l_f;
      YFE[l_k] += (l_fe > YFE[l_k] ? YKA : YKR) * (l_fe - YFE[l_k]);
      l_fg = YFE[l_k] > 0.9 ? 0.9 / YFE[l_k] : 1; YFG[l_k] = l_fg;
      l_f *= l_fg;
      l_fo = 1 - l_k;
      (y_route == 3 && YON[l_fo] && y_lcc > 0) ? (
        l_a = (YFBc[l_fo] + (1 - YFBc[l_fo]) * y_frc) * YFG[l_fo]; l_xx = YXc[l_fo];
        l_pl = YLP[l_fo * 2]; l_pr = YLP[l_fo * 2 + 1];
        l_ol = l_pl * (1 - l_xx) + l_pr * l_xx; l_or = l_pr * (1 - l_xx) + l_pl * l_xx;
        l_sl += (1 - y_lcc) * l_f * l_ml + y_lcc * l_a * l_ol;
        l_sr += (1 - y_lcc) * l_f * l_mr + y_lcc * l_a * l_or;
      ) : (l_sl += l_f * l_ml; l_sr += l_f * l_mr;);
      // everything on the way in (input and repeats alike): pitch, diffusion, filters, character, saturation
      l_x = y_proc(l_k * 2, l_k, l_sl); l_sl = l_x + (l_sl - l_x) * y_frc;
      l_x = y_proc(l_k * 2 + 1, l_k, l_sr); l_sr = l_x + (l_sr - l_x) * y_frc;
      l_o[y_wp & YDM] = y_lim(l_sl); l_d[y_wp & YDM] = y_lim(l_sr);
    ) : (l_o[y_wp & YDM] = 0; l_d[y_wp & YDM] = 0;);
    l_k += 1;
  );
  // the wet signal: each line with its width, pan and level (and what it sends to the reverb)
  y_wl = 0; y_wr = 0; y_rsl = 0; y_rsr = 0;
  l_k = 0;
  loop(NL,
    YON[l_k] ? (
      l_m = (YLO[l_k * 2] + YLO[l_k * 2 + 1]) * 0.5; l_s = (YLO[l_k * 2] - YLO[l_k * 2 + 1]) * 0.5 * YWDc[l_k];
      l_a = YPNc[l_k]; l_lv = YLVc[l_k];
      l_pl = (l_m + l_s) * l_lv * (l_a > 0 ? 1 - l_a : 1);
      l_pr = (l_m - l_s) * l_lv * (l_a < 0 ? 1 + l_a : 1);
      y_wl += l_pl; y_wr += l_pr;
      y_rsl += l_pl * YRSc[l_k]; y_rsr += l_pr * YRSc[l_k];
    );
    l_k += 1;
  );
  // the shared reverb
  y_rvc += (y_rvt - y_rvc) * YKS;
  (y_rvc > 0.0003 || y_rvt > 0.0003) ? (
    y_rv(y_rsl, y_rsr);
    y_wl += y_rl * y_rvc; y_wr += y_rr * y_rvc;
  );
  y_wetabs = max(abs(y_wl), abs(y_wr));
  y_bt += y_bps;
  y_wp = (y_wp + 1) & 1073741823;
);

// ---- modulation (the saturator's sources, aimed at the delay) ----
MTP = alloc(12); MTP[0] = K_TL; MTP[1] = K_FB; MTP[2] = K_LEVEL; MTP[3] = K_PAN; MTP[4] = K_CROSS; MTP[5] = K_HP;
MTP[6] = K_LP; MTP[7] = K_DRIVE; MTP[8] = K_SEMI; MTP[9] = K_DIFF; MTP[10] = K_WIDTH; MTP[11] = K_BG;
MTS = alloc(12); MTS[0] = 1; MTS[1] = 100; MTS[2] = 24; MTS[3] = 100; MTS[4] = 100; MTS[5] = 5; MTS[6] = 5; MTS[7] = 100; MTS[8] = 12; MTS[9] = 100; MTS[10] = 100; MTS[11] = 12;
function d_clamp(v, lo, hi) ( v < lo ? lo : (v > hi ? hi : v); );
// slot s's value for this tick: -1..1 (LFO) or 0..1 (follower, MIDI)
function d_mval(s) local(ty, ph, o, v, cyc, sh, t, rt)
(
  ty = floor(c_pv(mp(s, M_TYPE)) + 0.5);
  v = 0;
  ty == 1 ? (
    sh = floor(c_pv(mp(s, M_OPT)) + 0.5) % 6;
    o = floor(c_pv(mp(s, M_SYNC)) + 0.5);
    o > 0 ? (
      cyc = SYNB[o];
      ph = d_beat / cyc; ph -= floor(ph);
    ) : (
      MPH[s] += c_pv(mp(s, M_RATE)) * 16 / srate; MPH[s] -= floor(MPH[s]); ph = MPH[s];
    );
    sh == 0 ? v = sin(2 * $pi * ph);
    sh == 1 ? v = ph < 0.25 ? 4 * ph : (ph < 0.75 ? 2 - 4 * ph : 4 * ph - 4);
    sh == 2 ? v = 2 * ph - 1;
    sh == 3 ? v = 1 - 2 * ph;
    sh == 4 ? (MLS[s] += ((ph < 0.5 ? 1 : -1) - MLS[s]) * 0.5; v = MLS[s];);
    sh == 5 ? (
      ph < MRB[s] ? (MRA[s] = MEN[s]; MEN[s] = rand(2) - 1;);
      MRB[s] = ph;
      t = 0.5 - 0.5 * cos($pi * ph); v = MRA[s] + (MEN[s] - MRA[s]) * t;
    );
  );
  ty == 2 ? (
    o = floor(c_pv(mp(s, M_OPT)) + 0.5); rt = 24 * (1 + floor(o / 4) % 3);
    v = d_clamp((20 * log10(MEN[s] + 0.000001) + rt) / rt, 0, 1);
  );
  ty == 3 ? (
    o = floor(c_pv(mp(s, M_OPT)) + 0.5);
    v = o < 128 ? MCC[o] : (o == 128 ? d_nvel : (d_pb + 1) * 0.5);
  );
  v;
);
// every slot, on top of the settings in EFFP
function d_modeval() local(s, ty, tb, tp, amt, v, p, b, b0, b1)
(
  s = 0; d_nf = 0;
  loop(NMOD,
    ty = floor(c_pv(mp(s, M_TYPE)) + 0.5);
    ty > 0 ? (
      ty == 2 ? (
        MKA[s] = 1 - exp(-1 / (max(0.05, c_pv(mp(s, M_RATE))) * 0.001 * srate));
        MKR[s] = 1 - exp(-1 / (max(0.5, c_pv(mp(s, M_RATE2))) * 0.001 * srate));
        MSR[s] = min(2, floor(c_pv(mp(s, M_OPT)) + 0.5) % 4);
        MFL[d_nf] = s; d_nf += 1;
      );
      v = d_mval(s); MV[s] = v;
      tb = floor(c_pv(mp(s, M_TLINE)) + 0.5); tp = floor(c_pv(mp(s, M_TPAR)) + 0.5);
      amt = c_pv(mp(s, M_AMT)) * 0.01 * v;
      tb == 0 ? (
        tp = min(tp, 4);
        tp == 0 ? EFFP[P_MIX] = d_clamp(EFFP[P_MIX] + amt * 100, 0, 100);
        tp == 1 ? EFFP[P_IN] = d_clamp(EFFP[P_IN] + amt * 12, -24, 24);
        tp == 2 ? EFFP[P_DUCK] = d_clamp(EFFP[P_DUCK] + amt * 100, 0, 100);
        tp == 3 ? (amt >= 0.5 ? EFFP[P_FREEZE] = 1;);
        tp == 4 ? EFFP[P_RVB] = d_clamp(EFFP[P_RVB] + amt * 100, 0, 100);
      ) : (
        b0 = tb == 3 ? 0 : tb - 1; b1 = tb == 3 ? 1 : tb - 1;
        b = b0;
        loop(b1 - b0 + 1,
          p = ep(b, MTP[tp]);
          tp == 0 ? YTM[b] *= 2 ^ amt : (
            (tp == 5 || tp == 6) ? EFFP[p] = d_clamp(EFFP[p] * 2 ^ (amt * 5), PLO[p], PHI[p]) :
                                   EFFP[p] = d_clamp(EFFP[p] + amt * MTS[tp], PLO[p], PHI[p]);
          );
          b += 1;
        );
      );
    ) : (MV[s] = 0;);
    s += 1;
  );
);

function d_cmp(st, d) local(i, f, o)
(
  i = min(19, floor(d / 5)); f = d / 5 - i; o = CMPT + st * 21 + i;
  o[0] + (o[1] - o[0]) * f;
);
// ---- one line's settings -> what the engine uses (every 16 samples) ----
function y_lprep(l_k) local(l_o, l_c, l_u, l_s, l_ms, l_ch, l_n, l_e, l_j, l_pw, l_st, l_dv, l_f, l_g, l_q, l_ty, l_w, l_ag, l_sz, l_r, l_m, l_x, l_tl, l_sy, l_cb, l_cs, l_on)
(
  l_o = EB0 + l_k * EBN;
  YON[l_k] = EFFP[l_o + K_ON] >= 0.5;
  YMODE[l_k] = floor(EFFP[l_o + K_MODE] + 0.5);
  // times: free in ms, or a note value at the host tempo
  l_c = 0;
  loop(2,
    l_u = (l_c == 1 && EFFP[l_o + K_LINK] >= 0.5) ? 0 : l_c;
    l_s = floor(EFFP[l_o + (l_u ? K_SR : K_SL)] + 0.5);
    l_ms = l_s > 0 ? YBEATS[l_s] * 60000 / y_tempo : EFFP[l_o + (l_u ? K_TR : K_TL)];
    l_ms = d_clamp(l_ms * YTM[l_k], 1, 8000);
    YTGT[l_k * 2 + l_c] = l_ms * 0.001 * srate;
    l_c += 1;
  );
  YGK[l_k] = 1 - exp(-1 / (max(1, EFFP[l_o + K_GLIDE]) * 0.001 * srate));
  // feedback, cross, level, pan, width
  l_ch = YMODE[l_k] > 0;
  YFBt[l_k] = d_clamp(EFFP[l_o + K_FB], 0, 120) * 0.01;
  YXt[l_k] = l_ch ? 1 : d_clamp(EFFP[l_o + K_CROSS], 0, 100) * 0.01;
  l_x = EFFP[l_o + K_LEVEL]; YLVt[l_k] = l_x <= -59.9 ? 0 : 10 ^ (l_x / 20);
  YPNt[l_k] = d_clamp(EFFP[l_o + K_PAN], -100, 100) * 0.01;
  YWDt[l_k] = d_clamp(EFFP[l_o + K_WIDTH], 0, 200) * 0.01;
  // taps: where they sit between 0 and the delay, and how loud
  l_n = 1 + d_clamp(floor(EFFP[l_o + K_TAPS] + 0.5), 0, 3);
  YNT[l_k] = l_n;
  l_e = floor(EFFP[l_o + K_TPAT] + 0.5); l_e = l_e == 0 ? 1 : (l_e == 1 ? 2 : (l_e == 2 ? 0.5 : 0.6));
  l_tl = d_clamp(EFFP[l_o + K_TLVL], 0, 100) * 0.01;
  l_j = 0;
  loop(4, YTP[l_k * 4 + l_j] = ((l_j + 1) / l_n) ^ l_e; YTL[l_k * 4 + l_j] = l_tl ^ (l_n - 1 - l_j); l_j += 1;);
  // character and age
  l_ty = floor(EFFP[l_o + K_CHAR] + 0.5); YCHR[l_k] = l_ty;
  l_ag = d_clamp(EFFP[l_o + K_AGE], 0, 100) * 0.01;
  l_f = l_ty == 1 ? 15000 * 0.22 ^ l_ag : (l_ty == 2 ? 9000 * 0.3 ^ l_ag : 16000 * 0.4 ^ l_ag);
  YCA[l_k] = 1 - exp(-2 * $pi * min(l_f, srate * 0.45) / srate);
  YNZ[l_k] = l_ty == 1 ? l_ag * l_ag * 0.0012 : (l_ty == 2 ? l_ag * l_ag * 0.004 : (l_ty == 3 ? l_ag * l_ag * 0.003 : 0));
  YBQ[l_k] = 2 ^ (15 - 10 * l_ag); YHD[l_k] = 1 + floor(l_ag * 5);
  YWA[l_k] = d_clamp(EFFP[l_o + K_WOW], 0, 100) * 0.01 * 0.003 * srate;
  YFA[l_k] = d_clamp(EFFP[l_o + K_FLUT], 0, 100) * 0.01 * 0.00012 * srate;
  YBA[l_k] = l_ty == 2 ? 0.00035 * l_ag * srate : 0;
  // the tape's head bump: a low bell that grows with age
  YBEN[l_k] = l_ty == 1;
  (l_ty == 1 && (l_ag !== YBCH[l_k * 2] || y_snap)) ? (YBCH[l_k * 2] = l_ag; ea_coef(0, 70, 1.2 + 2.3 * l_ag, 0.8, 0, YBMC + l_k * 5););
  YRSt[l_k] = d_clamp(EFFP[l_o + K_RSND], 0, 100) * 0.01;
  // saturation
  l_dv = d_clamp(EFFP[l_o + K_DRIVE], 0, 100);
  l_st = YSATI[d_clamp(floor(EFFP[l_o + K_SAT] + 0.5), 0, 23)];
  YSTc[l_k] = l_st;
  YDGt[l_k] = 10 ^ ((-6 + 0.5 * l_dv + YSATG[l_st]) / 20);
  YCPt[l_k] = 10 ^ (d_cmp(l_st, l_dv) / 20);
  YSBt[l_k] = min(1, l_dv / 5);
  // diffusion
  l_x = d_clamp(EFFP[l_o + K_DIFF], 0, 100);
  l_on = l_x >= 0.5;
  l_on ? (
    YDFOFF[l_k] > 300 ? memset(YABF + (l_k * 2 * 4) * YALEN, 0, 8 * YALEN);
    YDFOFF[l_k] = 0;
  ) : (YDFOFF[l_k] = min(100000, YDFOFF[l_k] + 1););
  YDFON[l_k] = l_on;
  YDFG[l_k] = 0.65 * l_x * 0.01;
  l_sz = d_clamp(EFFP[l_o + K_DSZ], 5, 80) * 0.001 * srate;
  l_c = 0;
  loop(2,
    l_j = 0;
    loop(4,
      l_m = (l_k * 2 + l_c) * 4 + l_j;
      YDFD[l_m] = max(8, floor(l_sz * (l_j == 0 ? 0.29 : (l_j == 1 ? 0.43 : (l_j == 2 ? 0.71 : 1))) * (1 + 0.073 * l_c) + 0.5));
      YDFM[l_m] = (l_j & 1) ? min(0.025 * YDFD[l_m], 0.0004 * srate) : 0;
      l_j += 1;
    );
    l_c += 1;
  );
  // pitch and reverse
  l_ty = floor(EFFP[l_o + K_SH] + 0.5);
  l_r = (l_ty & 1) ? 2 ^ (EFFP[l_o + K_SEMI] / 12) : 1;
  (l_ty & 2) ? l_r = -l_r;
  l_w = d_clamp(EFFP[l_o + K_SHSZ], 20, 300) * 0.001 * srate;
  l_on = l_ty > 0 && l_r != 1;
  l_on ? (
    YSHOFF[l_k] > 300 ? (memset(YSBF + (l_k * 2) * YSLEN, 0, 2 * YSLEN); l_j = 0; loop(4, YSX[l_k * 4 + l_j] = 0; l_j += 1;););
    YSHOFF[l_k] = 0;
  ) : (YSHOFF[l_k] = min(100000, YSHOFF[l_k] + 1););
  YSHON[l_k] = l_on;
  YSHR[l_k] = l_r; YSHI[l_k] = 1 / l_w;
  // reverse in chunks that follow the beat (a note value for the window), else free windows
  l_sy = floor(EFFP[l_o + K_SHSY] + 0.5);
  YSHB[l_k] = (l_ty & 2) && l_sy > 0;
  YSHB[l_k] ? (
    l_cb = YBEATS[l_sy];
    l_cs = min(l_cb * 60 / y_tempo * srate, (YSLEN - 600) / ((1 + abs(l_r)) * 1.05));
    YSHW[l_k] = l_cs; YSHBI[l_k] = 1 / (l_cs * y_tempo / (60 * srate));
    YSHE[l_k] = min(0.45, 0.012 * srate / l_cs);
  ) : (YSHW[l_k] = l_w;);
  (!y_hq || l_r < 0 || YSHB[l_k]) ? (l_j = 0; loop(4, YSX[l_k * 4 + l_j] = 0; l_j += 1;););
  // the three filters in the loop: low cut, high cut, bell (rebuilt only when they change)
  l_m = YLCH + l_k * 12;
  l_f = EFFP[l_o + K_HP];
  YFEN[l_k * 3] = l_f > 20.5;
  (YFEN[l_k * 3] && (l_f !== l_m[0] || y_snap)) ? (l_m[0] = l_f; ea_coef(6, l_f, 0, 0.7071, 0, YFC + (l_k * 3) * 5););
  l_f = EFFP[l_o + K_LP];
  YFEN[l_k * 3 + 1] = l_f < 19500;
  (YFEN[l_k * 3 + 1] && (l_f !== l_m[1] || y_snap)) ? (l_m[1] = l_f; ea_coef(10, l_f, 0, 0.7071, 0, YFC + (l_k * 3 + 1) * 5););
  l_f = EFFP[l_o + K_BF]; l_g = EFFP[l_o + K_BG]; l_q = EFFP[l_o + K_BQ];
  YFEN[l_k * 3 + 2] = abs(l_g) >= 0.05;
  (YFEN[l_k * 3 + 2] && (l_f !== l_m[2] || l_g !== l_m[3] || l_q !== l_m[4] || y_snap)) ? (l_m[2] = l_f; l_m[3] = l_g; l_m[4] = l_q; ea_coef(0, l_f, l_g, l_q, 0, YFC + (l_k * 3 + 2) * 5););
);
// everything that changes slowly, every 16 samples
function y_tick() local(l_i, l_k, l_x, l_e, l_t)
(
  l_i = 0; loop(EB0 + NL * EBN, EFFP[l_i] = c_pv(l_i); l_i += 1;);
  l_i = MB0; loop(NMOD * MN, EFFP[l_i] = c_pv(l_i); l_i += 1;);
  YTM[0] = 1; YTM[1] = 1;
  d_beat += 16 * y_tempo / (60 * srate);
  d_modeval();
  y_route = d_clamp(floor(EFFP[P_ROUTE] + 0.5), 0, 3);
  y_lct = d_clamp(EFFP[P_LCROSS], 0, 100) * 0.01; y_lcc += (y_lct - y_lcc) * 0.3;
  y_frt = EFFP[P_FREEZE] >= 0.5;
  y_hq = EFFP[P_HQ] >= 0.5; y_hql = y_hq ? 7 : 0;
  // the shared reverb
  y_rvt = d_clamp(EFFP[P_RVB], 0, 100) * 0.01;
  l_x = d_clamp(EFFP[P_RDEC], 0.2, 10); l_t = d_clamp(EFFP[P_RSIZ], 50, 200);
  (l_x !== YRCH[0] || l_t !== YRCH[1] || y_snap) ? (
    YRCH[0] = l_x; YRCH[1] = l_t;
    l_i = 0;
    loop(8,
      YRD[l_i] = max(16, floor(RBASE[l_i] * l_t * 0.01 * srate / 48000 + 0.5));
      YRG[l_i] = 10 ^ (-3 * YRD[l_i] / (srate * l_x * 1.13));
      l_i += 1;
    );
    YROG = 1.65 / sqrt(l_x);
  );
  YRDA = 1 - exp(-2 * $pi * min(d_clamp(EFFP[P_RDMP], 1000, 20000), srate * 0.45) / srate);
  YRPD = floor(d_clamp(EFFP[P_RPRE], 0, 200) * 0.001 * srate);
  l_e = floor(EFFP[P_RSHP] + 0.5);
  YRSR = l_e == 0 ? 2 : (l_e == 1 ? 1.498307 : (l_e == 2 ? 2.996614 : 0.5));
  // 100% stays under the point where the loop would start to grow (it gets lower with longer decay and smaller size)
  YRSH = d_clamp(EFFP[P_RSHM], 0, 100) * 0.01 * min(1, 0.35 * l_x ^ -0.42 * l_t * 0.01) * (l_e == 3 ? 0.8 : 1);
  YRSW = 0.06 * srate; YRSI = 1 / YRSW;
  (y_rvt > 0.0003 || y_rvc > 0.0003) ? (
    y_rvoff > 600 ? (
      memset(RVB, 0, 8 * RLEN); memset(RPB, 0, 2 * RPLEN); memset(RAP, 0, 6 * RAL); memset(RSB, 0, RSL);
      l_i = 0; loop(8, RZ[l_i] = 0; l_i += 1;); y_rl = 0; y_rr = 0;
    );
    y_rvoff = 0;
  ) : (y_rvoff = min(1000000, y_rvoff + 1););
  l_k = 0; loop(NL, y_lprep(l_k); l_k += 1;);
  // input and dry/wet (equal power)
  y_ingt = 10 ^ (d_clamp(EFFP[P_IN], -24, 24) / 20);
  l_x = d_clamp(EFFP[P_MIX], 0, 100) * 0.01;
  y_mxt = sin(l_x * $pi * 0.5); y_dyt = cos(l_x * $pi * 0.5);
  // the first time (or a new sample rate): start at the targets
  y_snap ? (
    l_i = 0; loop(4, YCUR[l_i] = YTGT[l_i]; l_i += 1;);
    l_k = 0;
    loop(NL,
      YFBc[l_k] = YFBt[l_k]; YXc[l_k] = YXt[l_k]; YLVc[l_k] = YLVt[l_k]; YPNc[l_k] = YPNt[l_k]; YWDc[l_k] = YWDt[l_k];
      YDGc[l_k] = YDGt[l_k]; YCPc[l_k] = YCPt[l_k]; YSBc[l_k] = YSBt[l_k]; YSHP[l_k] = 0; YRSc[l_k] = YRSt[l_k];
      l_k += 1;
    );
    y_rvc = y_rvt; y_ingc = y_ingt; y_mxc = y_mxt; y_dyc = y_dyt; y_frc = y_frt; y_lcc = y_lct;
  );
  y_snap = 0;
);

function fmt_hz(dst, v) ( v >= 10000 ? sprintf(dst, "%.1fk", v / 1000) : (v >= 1000 ? sprintf(dst, "%.2fk", v / 1000) : sprintf(dst, "%.0f Hz", v)); );
function fmt_ms(dst, v) ( v >= 1000 ? sprintf(dst, "%.2f s", v / 1000) : (v >= 100 ? sprintf(dst, "%.0f ms", v) : sprintf(dst, "%.1f ms", v)); );
// a value for a delay control, as the box shows it
function cfmt(dst, p, v) local(k, m)
(
  k = (p >= EB0 && p < EB0 + NL * EBN) ? (p - EB0) % EBN : -1;
  m = (p >= MB0 && p < MB0 + NMOD * MN) ? (p - MB0) % MN : -1;
  (p == P_IN || p == P_DTHR || k == K_LEVEL || k == K_BG) ? sprintf(dst, "%+.1f dB", v) : (
  (k == K_PAN || m == M_AMT) ? sprintf(dst, "%+.0f%%", v) : (
  (p == P_MIX || p == P_DUCK || p == P_RVB || p == P_RSIZ || p == P_RSHM || k == K_RSND || p == P_LCROSS || k == K_FB || k == K_CROSS || k == K_WIDTH || k == K_AGE || k == K_WOW || k == K_FLUT || k == K_DRIVE || k == K_DIFF || k == K_TLVL) ? sprintf(dst, "%.0f%%", v) : (
  (k == K_HP || k == K_LP || k == K_BF || p == P_RDMP) ? fmt_hz(dst, v) : (
  p == P_RDEC ? sprintf(dst, "%.2f s", v) : (
  (k == K_TL || k == K_TR || k == K_GLIDE || k == K_DSZ || k == K_SHSZ || p == P_DATT || p == P_DREL || p == P_RPRE) ? fmt_ms(dst, v) : (
  k == K_SEMI ? sprintf(dst, "%+.2f st", v) : (
  m == M_RATE ? sprintf(dst, v < 10 ? "%.2f" : "%.1f", v) : (
  m == M_RATE2 ? sprintf(dst, v < 1000 ? "%.0f ms" : "%.2f s", v < 1000 ? v : v / 1000) : (
  sprintf(dst, "%.2f", v)
  )))))))));
);
// a bar for parameter p: filled from the left, on a log scale if lg
function cbar(x, y, w, h, p, lg, enabled) local(v, f, k)
(
  k = g_key(-1, p); v = slider(p);
  f = lg ? log(max(PLO[p], v) / PLO[p]) / log(PHI[p] / PLO[p]) : (v - PLO[p]) / (PHI[p] - PLO[p]);
  f = max(0, min(1, f));
  c_well(); rect(x, y, w, h, 1);
  enabled ? setc(0.92, 0.49, 0.07) : setc(0.20, 0.19, 0.18);
  rect(x, y + 3, max(1 / g_sc, w * f), h - 6, 1);
  enabled ? setc(1.0, 0.95, 0.88) : c_faint();
  rect(x + w * f - 1.5, y + 1, 3, h - 2, 1);
  c_border(); rect(x, y, w, h, 0);
  g_bm = lg ? 3 : 2; g_bw = w; g_blo = PLO[p]; g_bhi = PHI[p];
  enabled ? ctl_input(k, x, y, w, h, lg ? log(PHI[p] / PLO[p]) / w : (PHI[p] - PLO[p]) / w,
                      lg ? log(PHI[p] / PLO[p]) / w / 10 : (PHI[p] - PLO[p]) / w / 10, lg ? 5 : 6);
  g_bm = 0;
);

// label, bar and value box for parameter p (286 wide)
function cctl(lbl, x, y, p, lg, enabled)
(
  label(lbl, x, y - 1, 64);
  cbar(x + 66, y, 138, 20, p, lg, enabled);
  cfmt(#g_cv, p, slider(p));
  valbox(x + 208, y, 76, 20, g_key(-1, p), lg ? log(PHI[p] / PLO[p]) / 138 : (PHI[p] - PLO[p]) / 138,
         lg ? log(PHI[p] / PLO[p]) / 1380 : (PHI[p] - PLO[p]) / 1380, lg ? 5 : 6, #g_cv, enabled);
);

// an on/off button for parameter p
function ctog(x, y, w, lbl, p, style) local(on)
(
  on = slider(p) >= 0.5;
  button(x, y, w, 20, lbl, on, 1, style) ? g_kset(g_key(-1, p), !on, 1);
);

// like ctog, but Shift + click and hold only flips it for as long as the mouse is held
function mtog(x, y, w, lbl, p, style) local(on, k)
(
  on = slider(p) >= 0.5; k = g_key(-1, p);
  button(x, y, w, 20, lbl, on, 1, style) ? (
    (g_cap & 8) ? (g_mom_k = k; g_mom_prev = on;);
    g_kset(k, !on, 1);
  );
);

// a vertical meter: level db, filled from the bottom (the Act's meter range and colors)
function vmeter(x, y, w, h, db, active) local(f, fz1, fz2)
(
  setc(0.09, 0.10, 0.11); rect(x, y, w, h, 1);
  active ? (
    f = mfrac(db); fz1 = mfrac(-12); fz2 = mfrac(-3);
    setc(0.18, 0.62, 0.33); rect(x + 1, y + h * (1 - min(f, fz1)), w - 2, h * min(f, fz1), 1);
    f > fz1 ? (setc(0.80, 0.66, 0.18); rect(x + 1, y + h * (1 - min(f, fz2)), w - 2, h * (min(f, fz2) - fz1), 1););
    f > fz2 ? (setc(0.86, 0.25, 0.22); rect(x + 1, y + h * (1 - f), w - 2, h * (f - fz2), 1););
  );
  setc(0.30, 0.33, 0.38); rect(x, y, w, h, 0);
);

// A/B: swap the sliders with the stored set; copy this set into the other one

// the analyzer: the newest n samples of src, windowed, into dB per bin in dst (falling slowly)
function an_fft(src, dst, n) local(i, p0, m, db, k)
(
  p0 = (c_ap - n) & 8191;
  i = 0;
  loop(n, FFA[i] = src[(p0 + i) & 8191] * (0.5 - 0.5 * cos(2 * $pi * i / n)); i += 1;);
  fft_real(FFA, n); fft_permute(FFA, n / 2);
  k = min(1, g_dt * 5);
  i = 1;
  loop(n / 2 - 1,
    m = sqr(FFA[2 * i]) + sqr(FFA[2 * i + 1]);
    db = m > 0 ? 10 * log10(m) - g_annorm : -200;
    dst[i] = db > dst[i] ? db : dst[i] + (db - dst[i]) * k;
    i += 1;
  );
);
// frequency <-> x in the analyzer (20 Hz .. 20 kHz on a log scale)
function an_x(f) ( g_ax + g_aw * log(max(20, f) / 20) / log(1000); );
function an_f(x) ( 20 * 1000 ^ ((x - g_ax) / g_aw); );
// dB -> y in the analyzer, with a 4.5 dB/octave tilt around 1 kHz (so music looks flat)
function an_y(db, f) ( g_ay + g_ah * min(1, max(0, -(db + 4.5 * log(f / 1000) / log(2)) / 90)); );
// draw one spectrum: filled (input) or as a line (output)
function an_draw(spec, n, fill) local(px, px1, f0, f1, bl, bh, b, mx, y, ly, lx)
(
  px = floor(X(g_ax)); px1 = floor(X(g_ax + g_aw)); ly = -1;
  while (px < px1) (
    f0 = an_f((px - g_ox) / g_sc); f1 = an_f((px + 1 - g_ox) / g_sc);
    bl = max(1, floor(f0 * n / srate)); bh = max(bl, min(n / 2 - 1, floor(f1 * n / srate)));
    mx = -200; b = bl; loop(bh - bl + 1, spec[b] > mx ? mx = spec[b]; b += 1;);
    y = Y(an_y(mx, (f0 + f1) * 0.5));
    fill ? gfx_rect(px, y, 1, Y(g_ay + g_ah) - y, 1) : (ly >= 0 ? gfx_line(lx, ly, px, y, 1););
    lx = px; ly = y;
    px += 1;
  );
);
// ---- filter design (the audio thread and the window each have their own copy) ----
// Every filter is a matched biquad: the poles come from the analog prototype (matched z) and the numerator is
// set so the magnitude equals the analog filter's at DC, at the centre frequency and at Nyquist. The top octaves
// of bells, shelves, notches and low passes then stay close to the analog curve instead of cramping.
// A cut is the exact inverse of the boost of the same shape. If a design is not valid, the classic RBJ filter is used.

// the inverse filter: numerator and denominator swap (o = b0 b1 b2 a1 a2, a0 = 1)
function eg_inv(o) local(b0, b1, b2, a1, a2)
(
  b0 = o[0]; b1 = o[1]; b2 = o[2]; a1 = o[3]; a2 = o[4];
  o[0] = 1 / b0; o[1] = a1 / b0; o[2] = a2 / b0; o[3] = b1 / b0; o[4] = b2 / b0;
);

// the matched design for the analog prototypes (s in units of the centre frequency, A >= 1 for the boosts)
//   kind 0: bell (s^2 + s A/Q + 1) / (s^2 + s/(A Q) + 1)      kind 1: low shelf (boost)
//   kind 2: band pass (s/Q) / (s^2 + s/Q + 1)                  kind 3: low pass 1 / (s^2 + s/Q + 1)
// w = centre frequency in rad/sample. Returns 1 and fills o[0..4] when valid, else 0.
function eg_m3(kind, A, Q, w, o) local(rho, z, wp, e, a1, a2, sq, p1, p2, x2, qq, h0, hf, hn, d0, dn, cw, ww, vv, d2f, s1, s0, s2, t2, u, b1, disc, b0, b2, ok)
(
  kind == 0 ? (rho = 1; z = 0.5 / (A * Q);) : (kind == 1 ? (rho = 1 / sqrt(A); z = 0.5 / Q;) : (rho = 1; z = 0.5 / Q;));
  wp = w * rho;
  z < 1 ? (
    e = exp(-z * wp); a1 = -2 * e * cos(wp * sqrt(1 - z * z)); a2 = e * e;
  ) : (
    sq = sqrt(z * z - 1); p1 = exp(-wp * (z - sq)); p2 = exp(-wp * (z + sq));
    a1 = -(p1 + p2); a2 = p1 * p2;
  );
  x2 = $pi / w; x2 *= x2;
  qq = Q * Q;
  kind == 0 ? (
    hn = (sqr(1 - x2) + x2 * A * A / qq) / (sqr(1 - x2) + x2 / (A * A * qq)); h0 = 1; hf = sqr(A * A);
  ) : (kind == 1 ? (
    hn = A * A * (sqr(A - x2) + x2 * A / qq) / (sqr(1 - A * x2) + x2 * A / qq); h0 = sqr(A * A); hf = A * A;
  ) : (kind == 2 ? (
    hn = (x2 / qq) / (sqr(1 - x2) + x2 / qq); h0 = 0; hf = 1;
  ) : (
    hn = 1 / (sqr(1 - x2) + x2 / qq); h0 = 1; hf = qq;
  )));
  d0 = 1 + a1 + a2; dn = 1 - a1 + a2; cw = cos(w);
  ww = sqrt(h0) * d0; vv = sqrt(hn) * dn;
  d2f = 1 + a1 * a1 + a2 * a2 + 2 * (a1 + a1 * a2) * cw + 2 * a2 * cos(2 * w);
  s1 = (1 - cw) * 0.5; s0 = 1 - s1; s2 = 4 * s0 * s1;
  t2 = (hf * d2f - ww * ww * s0 - vv * vv * s1) / s2;
  u = (ww + vv) * 0.5; b1 = (ww - vv) * 0.5; disc = u * u + t2;
  ok = 0;
  disc >= 0 ? (
    b0 = (u + sqrt(disc)) * 0.5; b2 = u - b0;
    (abs(b0) > 0.000000001 && abs(b2 / b0) < 0.9999 && abs(b1 / b0) <= 1 + b2 / b0 + 0.000000001 && a2 < 0.9999 && abs(a1) < 1 + a2 - 0.000001) ? (
      o[0] = b0; o[1] = b1; o[2] = b2; o[3] = a1; o[4] = a2; ok = 1;
    );
  );
  ok;
);

// the classic RBJ bell / shelf / notch / band pass (the fallback), from w and sin/cos
function eg_rbj(type, w, g, q, o) local(cw, sw, al, A, sq, a0)
(
  cw = cos(w); sw = sin(w); al = sw / (2 * q); A = 10 ^ (g / 40);
  type == 0 ? (
    a0 = 1 + al / A;
    o[0] = (1 + al * A) / a0; o[1] = -2 * cw / a0; o[2] = (1 - al * A) / a0; o[3] = o[1]; o[4] = (1 - al / A) / a0;
  );
  type == 1 ? (
    sq = 2 * sqrt(A) * al;
    a0 = (A + 1) + (A - 1) * cw + sq;
    o[0] = A * ((A + 1) - (A - 1) * cw + sq) / a0;
    o[1] = 2 * A * ((A - 1) - (A + 1) * cw) / a0;
    o[2] = A * ((A + 1) - (A - 1) * cw - sq) / a0;
    o[3] = -2 * ((A - 1) + (A + 1) * cw) / a0;
    o[4] = ((A + 1) + (A - 1) * cw - sq) / a0;
  );
  type == 2 ? (
    sq = 2 * sqrt(A) * al;
    a0 = (A + 1) - (A - 1) * cw + sq;
    o[0] = A * ((A + 1) + (A - 1) * cw + sq) / a0;
    o[1] = -2 * A * ((A - 1) + (A + 1) * cw) / a0;
    o[2] = A * ((A + 1) + (A - 1) * cw - sq) / a0;
    o[3] = 2 * ((A - 1) - (A + 1) * cw) / a0;
    o[4] = ((A + 1) - (A - 1) * cw - sq) / a0;
  );
  type == 3 ? (
    a0 = 1 + al;
    o[0] = 1 / a0; o[1] = -2 * cw / a0; o[2] = o[0]; o[3] = o[1]; o[4] = (1 - al) / a0;
  );
  type == 4 ? (
    a0 = 1 + al;
    o[0] = al / a0; o[1] = 0; o[2] = -al / a0; o[3] = -2 * cw / a0; o[4] = (1 - al) / a0;
  );
);

// the gain-dependent Q: the effective Q of a bell or shelf (qm 0 = off, 1 light, 2 medium, 3 strong; shelves follow half as much)
function eg_qe(type, g, q, qm)
(
  (qm > 0 && type <= 2) ? min(100, q * (1 + (qm == 1 ? 0.5 : (qm == 2 ? 1 : 2)) * (type == 0 ? 1 : 0.5) * min(abs(g), 30) / 18)) : q;
);

// section coefficients of a band: up to 4 biquad sections, 5 numbers each (b0 b1 b2 a1 a2, a0 = 1), at o[0..19];
// returns how many sections (0 = the band does nothing)
function eg_coef(type, f, g, q, qm, o) local(w, A, n, sl, ns, qq, i, hp, k, ok, cw, sw, al, a0, e, gn, c1, c2)
(
  w = 2 * $pi * min(f, srate * 0.49) / srate;
  q = max(0.05, q);
  q = eg_qe(type, g, q, qm);
  n = 0;
  (type <= 2 && abs(g) >= 0.001) ? (
    A = 10 ^ (abs(g) / 40);
    ok = eg_m3(type == 0 ? 0 : 1, A, q, w, o);
    ok ? (
      type == 0 ? (g < 0 ? eg_inv(o););
      type == 1 ? (g < 0 ? eg_inv(o););
      type == 2 ? (
        A *= A;
        g >= 0 ? (eg_inv(o); o[0] *= A; o[1] *= A; o[2] *= A;) : (o[0] /= A; o[1] /= A; o[2] /= A;);
      );
    ) : eg_rbj(type, w, g, q, o);
    n = 1;
  );
  type == 3 ? (
    // notch: zeros exactly at the centre; the pole radius is the analog's and the pole angle makes the Nyquist gain the analog's
    cw = cos(w); c1 = $pi / w; c1 *= c1; qq = q * q;
    e = exp(-w / q);
    gn = sqrt(sqr(1 - c1) / (sqr(1 - c1) + c1 / qq));
    c2 = (1 + cw) / (1 - cw);
    o[3] = (gn - c2) * (1 + e) / (c2 + gn); o[4] = e;
    o[0] = (1 + o[3] + o[4]) / (2 - 2 * cw); o[1] = -2 * o[0] * cw; o[2] = o[0];
    (e < 0.9999 && abs(o[3]) < 1 + e - 0.000001 && o[0] > 0.000000001) ? 1 : eg_rbj(3, w, 0, q, o);
    n = 1;
  );
  type == 4 ? (
    eg_m3(2, 1, q, w, o) ? 1 : eg_rbj(4, w, 0, q, o);
    n = 1;
  );
  type >= 5 ? (
    hp = type <= 8; sl = hp ? type - 5 : type - 9;
    sl == 0 ? (
      hp ? (
        k = tan(w * 0.5);
        o[0] = 1 / (1 + k); o[1] = -o[0]; o[2] = 0; o[3] = (k - 1) / (1 + k); o[4] = 0;
      ) : (
        // one pole, DC gain 1, Nyquist gain the analog's
        e = exp(-w); gn = 1 / sqrt(1 + sqr($pi / w));
        o[3] = -e; o[0] = ((1 - e) + gn * (1 + e)) * 0.5; o[1] = ((1 - e) - gn * (1 + e)) * 0.5; o[2] = 0; o[4] = 0;
      );
      n = 1;
    ) : (
      ns = sl == 1 ? 1 : (sl == 2 ? 2 : 4);
      i = 0;
      loop(ns,
        qq = sl == 1 ? q : (sl == 2 ? QT[i] : QT[2 + i]);
        (i == ns - 1 && sl >= 2) ? qq = max(0.1, qq * q / 0.7071068);
        (!hp && eg_m3(3, 1, qq, w, o + i * 5)) ? 1 : (
          cw = cos(w); sw = sin(w); al = sw / (2 * qq); a0 = 1 + al;
          hp ? (o[i * 5] = (1 + cw) * 0.5 / a0; o[i * 5 + 1] = -(1 + cw) / a0;) : (o[i * 5] = (1 - cw) * 0.5 / a0; o[i * 5 + 1] = (1 - cw) / a0;);
          o[i * 5 + 2] = o[i * 5]; o[i * 5 + 3] = -2 * cw / a0; o[i * 5 + 4] = (1 - al) / a0;
        );
        i += 1;
      );
      n = ns;
    );
  );
  n;
);

// power response |H|^2 of n sections at a frequency with cos(w) = cw, cos(2w) = c2
function eg_mag2(o, n, cw, c2) local(p, i, b0, b1, b2, a1, a2, nu, de)
(
  p = 1; i = 0;
  loop(n,
    b0 = o[i]; b1 = o[i + 1]; b2 = o[i + 2]; a1 = o[i + 3]; a2 = o[i + 4];
    nu = b0 * b0 + b1 * b1 + b2 * b2 + 2 * (b0 * b1 + b1 * b2) * cw + 2 * b0 * b2 * c2;
    de = 1 + a1 * a1 + a2 * a2 + 2 * (a1 + a1 * a2) * cw + 2 * a2 * c2;
    p *= nu / max(0.000000000001, de);
    i += 5;
  );
  p;
);


// ---------- TwoStorms Delay window: helpers ----------
GCO = alloc(60); GNS = alloc(3); EVT = alloc(300); EVC = alloc(300); EVA = alloc(300); QT_ = alloc(900); SDT = alloc(300); SDC = alloc(300); SDA = alloc(300);
g_fdrag = -1; g_edrag = -1; g_sel = 0; g_nev = 0;

// a line's colour (alpha a)
function band_col(b, a) ( b == 0 ? setc(0.93, 0.50, 0.07) : setc(0.66, 0.50, 1.0); gfx_a = a; );
function g_selband(b) ( slider(P_SEL) = b; );

// a line's time for channel c in ms (a note value at the host tempo, or the free time)
function g_tms(k, c) local(l_o, l_u, l_s)
(
  l_o = EB0 + k * EBN;
  l_u = (c == 1 && slider(l_o + K_LINK) >= 0.5) ? 0 : c;
  l_s = floor(slider(l_o + (l_u ? K_SR : K_SL)) + 0.5);
  max(1, min(4000, l_s > 0 ? YBEATS[l_s] * 60000 / y_tempo : slider(l_o + (l_u ? K_TR : K_TL))));
);

// the repeats of line k as the display shows them, from the seeds in SDT / SDC / SDA (g_nsd of them):
// EVT = when (ms), EVC = which side, EVA = how loud
function g_sim(k, span) local(l_o, l_n, l_e, l_tl, l_fb, l_x, l_lv, l_qi, l_qn, l_t, l_c, l_a, l_tt, l_j, l_p, l_ml)
(
  l_o = EB0 + k * EBN;
  l_n = 1 + max(0, min(3, floor(slider(l_o + K_TAPS) + 0.5)));
  l_e = floor(slider(l_o + K_TPAT) + 0.5); l_e = l_e == 0 ? 1 : (l_e == 1 ? 2 : (l_e == 2 ? 0.5 : 0.6));
  l_tl = slider(l_o + K_TLVL) * 0.01;
  l_fb = slider(l_o + K_FB) * 0.01;
  l_x = floor(slider(l_o + K_MODE) + 0.5) > 0 ? 1 : slider(l_o + K_CROSS) * 0.01;
  l_lv = slider(l_o + K_LEVEL) <= -59.9 ? 0 : 10 ^ (slider(l_o + K_LEVEL) / 20);
  l_qi = 0; l_qn = 0;
  while (l_qi < g_nsd) ( QT_[l_qn * 3] = SDT[l_qi]; QT_[l_qn * 3 + 1] = SDC[l_qi]; QT_[l_qn * 3 + 2] = SDA[l_qi]; l_qn += 1; l_qi += 1; );
  l_qi = 0; g_nev = 0;
  while (l_qi < l_qn && g_nev < 240) (
    l_t = QT_[l_qi * 3]; l_c = QT_[l_qi * 3 + 1]; l_a = QT_[l_qi * 3 + 2]; l_qi += 1;
    l_tt = g_tms(k, l_c);
    l_j = 0;
    loop(l_n,
      l_p = l_j == l_n - 1 ? 1 : ((l_j + 1) / l_n) ^ l_e;
      (l_t + l_tt * l_p <= span * 1.01 && g_nev < 290) ? (
        EVT[g_nev] = l_t + l_tt * l_p; EVC[g_nev] = l_c; EVA[g_nev] = l_a * l_lv * (l_tl ^ (l_n - 1 - l_j)); g_nev += 1;
      );
      l_j += 1;
    );
    (l_t + l_tt <= span * 1.01 && l_qn < 280) ? (
      l_ml = l_a * l_fb * (1 - l_x);
      l_ml > 0.02 ? (QT_[l_qn * 3] = l_t + l_tt; QT_[l_qn * 3 + 1] = l_c; QT_[l_qn * 3 + 2] = l_ml; l_qn += 1;);
      l_ml = l_a * l_fb * l_x;
      l_ml > 0.02 ? (QT_[l_qn * 3] = l_t + l_tt; QT_[l_qn * 3 + 1] = 1 - l_c; QT_[l_qn * 3 + 2] = l_ml; l_qn += 1;);
    );
  );
);
// seeds: what comes in at time 0 (stereo: both sides; ping-pong: the first side)
function g_seed_input(k) local(l_m)
(
  l_m = floor(slider(EB0 + k * EBN + K_MODE) + 0.5);
  g_nsd = 0;
  (l_m == 0 || l_m == 1) ? (SDT[g_nsd] = 0; SDC[g_nsd] = 0; SDA[g_nsd] = 1; g_nsd += 1;);
  (l_m == 0 || l_m == 2) ? (SDT[g_nsd] = 0; SDC[g_nsd] = 1; SDA[g_nsd] = 1; g_nsd += 1;);
);
// the repeats of the line just simulated become the seeds of the line after it (series routing)
function g_seed_from_events(k) local(l_i, l_m)
(
  l_m = floor(slider(EB0 + k * EBN + K_MODE) + 0.5);
  g_nsd = 0; l_i = 0;
  loop(g_nev,
    g_nsd < 280 ? (
      SDT[g_nsd] = EVT[l_i]; SDA[g_nsd] = EVA[l_i] * (l_m == 0 ? 1 : 0.5);
      SDC[g_nsd] = l_m == 0 ? EVC[l_i] : (l_m == 1 ? 0 : 1);
      g_nsd += 1;
    );
    l_i += 1;
  );
);
// draw the repeats in EVT / EVC / EVA: one side up from the middle line, the other down
function g_draw_events(k, cy, hh, x0, w, span, a) local(l_i, l_x, l_h, l_c)
(
  l_i = 0;
  loop(g_nev,
    l_x = x0 + EVT[l_i] / span * w; l_h = max(2, min(hh, EVA[l_i] * hh));
    band_col(k, a);
    EVC[l_i] < 0.5 ? rect(l_x - 1, cy - l_h, 3, l_h, 1) : rect(l_x - 1, cy, 3, l_h, 1);
    l_i += 1;
  );
  gfx_a = 1;
);

// a time control: label, the note value (or Free) and the time itself (286 wide)
function timectl(lbl, x, y, pT, pS, enabled) local(l_s, l_ms)
(
  label(lbl, x, y - 1, 64);
  dropdown(x + 66, y, 78, 20, g_key(-1, pS), 560, 17, enabled);
  l_s = floor(slider(pS) + 0.5);
  l_ms = l_s > 0 ? YBEATS[l_s] * 60000 / y_tempo : slider(pT);
  fmt_ms(#g_cv, l_ms);
  valbox(x + 150, y, 134, 20, g_key(-1, pT), log(PHI[pT] / PLO[pT]) / 138, log(PHI[pT] / PLO[pT]) / 1380, 5, #g_cv, enabled && l_s == 0);
);

// a dropdown for one field of a packed parameter (as in the EQ)
function pdd(x, y, w, h, k, dv, md, first, pre, enabled) local(v, cv, r)
(
  v = floor(g_kget(k) + 0.5);
  cv = floor(v / dv) % md;
  strlen(pre) ? sprintf(#g_dd, "%s %s  v", pre, first + cv) : sprintf(#g_dd, "%s  v", first + cv);
  button(x, y, w, h, #g_dd, 0, enabled, 0) ? (
    enum_menu(#g_menu, first, md, cv);
    gfx_x = X(x); gfx_y = Y(y + h);
    r = gfx_showmenu(#g_menu);
    r > 0 ? g_kset(k, v + (r - 1 - cv) * dv, 1);
  );
);

// a line chip: click to select it; the colour bar says whether it is on
function lchip(x, y, w, h, k) local(on, sel, hv, clk)
(
  on = slider(ep(k, K_ON)) >= 0.5; sel = floor(slider(P_SEL) + 0.5) == k;
  hv = hit(x, y, w, h);
  hv ? setc(0.21, 0.20, 0.19) : setc(0.15, 0.145, 0.14);
  rect(x, y, w, h, 1);
  on ? (band_col(k, 1); rect(x, y + h - 3, w, 3, 1););
  sel ? setc(1.0, 0.95, 0.88) : c_border();
  rect(x, y, w, h, 0);
  gfx_setfont(1); on ? c_text() : c_faint();
  text(k == 0 ? "Line A" : "Line B", x, y - 1, w, h - 2, 5);
  clk = hv && g_lclick && !g_used;
  clk ? (g_used = 1; g_selband(k););
);

// a control with a marker where the modulation has it right now
function mctl(lbl, x, y, p, lg, enabled) local(f, e)
(
  cctl(lbl, x, y, p, lg, enabled);
  (g_live_me && g_ma && abs(EFFP[p] - slider(p)) > 0.0002 * (PHI[p] - PLO[p])) ? (
    e = EFFP[p];
    f = lg ? log(max(PLO[p], e) / PLO[p]) / log(PHI[p] / PLO[p]) : (e - PLO[p]) / (PHI[p] - PLO[p]);
    f = max(0, min(1, f));
    c_purple(); rect(x + 66 + 138 * f - 1, y - 1, 3, 22, 1);
  );
);

// keep a slot's option in the range its type uses
function g_modfix(s, ty) local(o, n)
(
  o = floor(slider(mp(s, M_OPT)) + 0.5);
  ty == 1 ? (n = o % 6;) : (ty == 2 ? (n = min(2, o % 4) + 4 * (floor(o / 4) % 3);) : (n = min(129, o);));
  n !== o ? g_kset(g_key(-1, mp(s, M_OPT)), n, 0);
);

// one modulation slot (a row, 876 wide)
function g_modrow(x, y, s) local(ty, tb, tp, o, v, r)
(
  ty = floor(slider(mp(s, M_TYPE)) + 0.5);
  gfx_setfont(2); ty > 0 ? c_purple() : c_faint();
  sprintf(#g_cvs, "%d", s + 1); text(#g_cvs, x, y, 16, 20, 5);
  dropdown(x + 20, y, 90, 20, g_key(-1, mp(s, M_TYPE)), 420, 4, 1);
  ty > 0 ? (
    g_modfix(s, ty);
    tb = floor(slider(mp(s, M_TLINE)) + 0.5); tp = floor(slider(mp(s, M_TPAR)) + 0.5);
    (tb == 0 && tp > 4) ? (g_kset(g_key(-1, mp(s, M_TPAR)), 4, 0); tp = 4;);
    dropdown(x + 114, y, 84, 20, g_key(-1, mp(s, M_TLINE)), 510, 4, 1);
    tb == 0 ? dropdown(x + 202, y, 112, 20, g_key(-1, mp(s, M_TPAR)), 520, 5, 1)
            : dropdown(x + 202, y, 112, 20, g_key(-1, mp(s, M_TPAR)), 495, 12, 1);
    cbar(x + 318, y, 70, 20, mp(s, M_AMT), 0, 1);
    cfmt(#g_cv, mp(s, M_AMT), slider(mp(s, M_AMT)));
    valbox(x + 392, y, 54, 20, g_key(-1, mp(s, M_AMT)), 2.9, 0.29, 6, #g_cv, 1);
    o = floor(slider(mp(s, M_OPT)) + 0.5);
    ty == 1 ? (
      dropdown(x + 454, y, 80, 20, g_key(-1, mp(s, M_OPT)), 430, 6, 1);
      dropdown(x + 538, y, 66, 20, g_key(-1, mp(s, M_SYNC)), 450, 13, 1);
      sprintf(#g_cv, "%.2f Hz", slider(mp(s, M_RATE)));
      valbox(x + 608, y, 76, 20, g_key(-1, mp(s, M_RATE)), log(PHI[mp(s, M_RATE)] / PLO[mp(s, M_RATE)]) / 138, log(PHI[mp(s, M_RATE)] / PLO[mp(s, M_RATE)]) / 1380, 5, #g_cv, slider(mp(s, M_SYNC)) < 0.5);
    );
    ty == 2 ? (
      pdd(x + 454, y, 76, 20, g_key(-1, mp(s, M_OPT)), 1, 3, 440, "", 1);
      pdd(x + 534, y, 56, 20, g_key(-1, mp(s, M_OPT)), 4, 3, 525, "", 1);
      sprintf(#g_cv, "A %.1f ms", slider(mp(s, M_RATE)));
      valbox(x + 594, y, 76, 20, g_key(-1, mp(s, M_RATE)), log(PHI[mp(s, M_RATE)] / PLO[mp(s, M_RATE)]) / 138, log(PHI[mp(s, M_RATE)] / PLO[mp(s, M_RATE)]) / 1380, 5, #g_cv, 1);
      sprintf(#g_cv, "R %.0f ms", slider(mp(s, M_RATE2)));
      valbox(x + 674, y, 76, 20, g_key(-1, mp(s, M_RATE2)), log(PHI[mp(s, M_RATE2)] / PLO[mp(s, M_RATE2)]) / 138, log(PHI[mp(s, M_RATE2)] / PLO[mp(s, M_RATE2)]) / 1380, 5, #g_cv, 1);
    );
    ty == 3 ? (
      sprintf(#g_dd, "%s  v", 528 + (o < 128 ? 0 : o - 127));
      button(x + 454, y, 100, 20, #g_dd, 0, 1, 0) ? (
        enum_menu(#g_menu, 528, 3, o < 128 ? 0 : o - 127);
        gfx_x = X(x + 454); gfx_y = Y(y + 20);
        r = gfx_showmenu(#g_menu);
        r > 0 ? g_kset(g_key(-1, mp(s, M_OPT)), r == 1 ? (o < 128 ? o : 1) : 127 + r - 1, 1);
      );
      sprintf(#g_cv, "CC %d", o);
      valbox(x + 558, y, 70, 20, g_key(-1, mp(s, M_OPT)), 0.3, 0.05, 6, #g_cv, o < 128);
    );
    c_well(); rect(x + 788, y + 6, 88, 8, 1);
    v = MV[s];
    g_live_me ? (
      c_purple();
      ty == 1 ? (v >= 0 ? rect(x + 832, y + 7, 44 * v, 6, 1) : rect(x + 832 + 44 * v, y + 7, -44 * v, 6, 1);) : rect(x + 788, y + 7, 88 * max(0, min(1, v)), 6, 1);
    );
    c_border(); rect(x + 788, y + 6, 88, 8, 0);
  ) : (
    gfx_setfont(3); c_faint(); text("off", x + 118, y, 60, 20, 4);
  );
);

// dB -> y on the filter display (+-18 dB)
function ey(db) ( g_ay + g_ah * 0.5 - db / 18 * g_ah * 0.5; );

// nothing to add to a user preset besides the settings
function pr_xsave(b) ( 0; );
function pr_xload(b) ( 0; );
// ---------- shared by every TwoStorms plug-in: A/B sets, presets and the top bar ----------
// the other A/B set: swap it with the playing one, or copy the playing one into it
function ab_swap() local(i, p, t)
(
  i = 0;
  loop(ABN, p = ABL[i]; t = slider(p); g_setsl(p, ABSET[p]); ABSET[p] = t; i += 1;);
  g_setsl(P_AB, slider(P_AB) < 0.5);
  c_uiabn += 1;
  sliderchange(-1);
);
function ab_copy() local(i, p)
(
  i = 0; loop(ABN, p = ABL[i]; ABSET[p] = slider(p); i += 1;);
  g_setsl(P_CUIST, slider(P_CUIST) + 1);
  sliderchange(-1);
);

// ---- presets ----
// Factory presets come with the plug-in: pr_factory(n) sets the n-th, #pr_fmenu is its menu (PR_NF items). A preset
// starts from every setting's default (PRH: the defaults in the plug-in's header), so it always sounds the same.
// User presets are saved by the helper script (version 6 and newer) in REAPER's Data/TwoStorms/Presets folder (one file
// per plug-in) and published in the shared memory, so every window lists them without reading files: at
// UPK = UP + 10000 + SUBKIND * 60000 the count, each name from +100 (64 apart: its length, then its characters) and each
// preset from +3000 (1400 apart: how many settings, the setting and value pairs, then anything the plug-in adds, such as
// the IR Loader's file paths). Saving and deleting go through a mailbox at UP + 10: request number, the asker's ID, the
// operation (1 save, 2 delete), the plug-in's kind, which preset (delete); the helper answers with the request number it
// finished (UP + 15), the result (UP + 16: 1 done, 0 cancelled, -1 failed) and the asker's ID (UP + 17). What to save
// goes at UP + 100: how many settings, then the pairs, then the plug-in's extras.
UP = 4800000; UP_MAGIC = 7532; UP_MAX = 40; UP_NM = 64; UP_PSZ = 1400;
UPK = UP + 10000 + SUBKIND * 60000;
PRA = alloc(256); PRB = alloc(256); PRH = alloc(256); PRIN = alloc(256);
PRH[43] = 0; PRH[44] = 0; PRH[45] = 0; PRH[46] = 0; PRH[47] = 30; PRH[48] = 0; PRH[49] = 0; PRH[50] = 0;
PRH[51] = -30; PRH[52] = 10; PRH[53] = 300; PRH[54] = 0; PRH[55] = 0; PRH[56] = 0; PRH[57] = 0; PRH[58] = 50;
PRH[59] = 3; PRH[60] = 0; PRH[61] = 2; PRH[62] = 100; PRH[63] = 8000; PRH[64] = 0; PRH[65] = 0; PRH[66] = 15;
PRH[67] = 1; PRH[70] = 1; PRH[71] = 375; PRH[72] = 7; PRH[73] = 375; PRH[74] = 7; PRH[75] = 1; PRH[76] = 40;
PRH[77] = 0; PRH[78] = 0; PRH[79] = 0; PRH[80] = 0; PRH[81] = 100; PRH[82] = 0; PRH[83] = 30; PRH[84] = 0;
PRH[85] = 0; PRH[86] = 150; PRH[87] = 0; PRH[88] = 1; PRH[89] = 20; PRH[90] = 20000; PRH[91] = 1000; PRH[92] = 0;
PRH[93] = 1; PRH[94] = 0; PRH[95] = 30; PRH[96] = 0; PRH[97] = 0; PRH[98] = 80; PRH[99] = 0; PRH[100] = 0;
PRH[101] = 60; PRH[102] = 0; PRH[103] = 100; PRH[110] = 0; PRH[111] = 375; PRH[112] = 10; PRH[113] = 375; PRH[114] = 10;
PRH[115] = 1; PRH[116] = 40; PRH[117] = 0; PRH[118] = 0; PRH[119] = -6; PRH[120] = 0; PRH[121] = 100; PRH[122] = 0;
PRH[123] = 30; PRH[124] = 0; PRH[125] = 0; PRH[126] = 150; PRH[127] = 0; PRH[128] = 1; PRH[129] = 20; PRH[130] = 20000;
PRH[131] = 1000; PRH[132] = 0; PRH[133] = 1; PRH[134] = 0; PRH[135] = 30; PRH[136] = 0; PRH[137] = 0; PRH[138] = 80;
PRH[139] = 0; PRH[140] = 0; PRH[141] = 60; PRH[142] = 0; PRH[143] = 100; PRH[170] = 0; PRH[171] = 1; PRH[172] = 0;
PRH[173] = 50; PRH[174] = 1; PRH[175] = 200; PRH[176] = 0; PRH[177] = 0; PRH[178] = 0; PRH[179] = 1; PRH[180] = 0;
PRH[181] = 50; PRH[182] = 1; PRH[183] = 200; PRH[184] = 0; PRH[185] = 0; PRH[186] = 0; PRH[187] = 1; PRH[188] = 0;
PRH[189] = 50; PRH[190] = 1; PRH[191] = 200; PRH[192] = 0; PRH[193] = 0; PRH[194] = 0; PRH[195] = 1; PRH[196] = 0;
PRH[197] = 50; PRH[198] = 1; PRH[199] = 200; PRH[200] = 0; PRH[201] = 0; PRH[202] = 0; PRH[203] = 1; PRH[204] = 0;
PRH[205] = 50; PRH[206] = 1; PRH[207] = 200; PRH[208] = 0; PRH[209] = 0; PRH[210] = 0; PRH[211] = 1; PRH[212] = 0;
PRH[213] = 50; PRH[214] = 1; PRH[215] = 200; PRH[216] = 0; PRH[217] = 0; PRH[218] = 0; PRH[219] = 1; PRH[220] = 0;
PRH[221] = 50; PRH[222] = 1; PRH[223] = 200; PRH[224] = 0; PRH[225] = 0; PRH[226] = 0; PRH[227] = 1; PRH[228] = 0;
PRH[229] = 50; PRH[230] = 1; PRH[231] = 200; PRH[232] = 0; PRH[233] = 0;
PRL = ABL; PRLN = ABN;            // the settings a preset holds: the A/B set

a_i = 0; loop(PRLN, PRIN[PRL[a_i]] = 1; a_i += 1;);
pr_req = 0; pr_msgt = -100;

// every preset setting back to its default
function pr_reset() local(i, p) ( i = 0; loop(PRLN, p = PRL[i]; g_setsl(p, PRH[p]); i += 1;); );
// "p=v p=v ...": set those settings (a factory preset's own values)
function pr_isnum(ch) ( ch == 45 || ch == 46 || (ch >= 48 && ch <= 57); );
function pr_rd(s, n) local(ch, v, sg, dv, dot)
(
  v = 0; sg = 1; dv = 1; dot = 0;
  while (pr_i < n && !pr_isnum(str_getchar(s, pr_i))) (pr_i += 1;);
  (pr_i < n && str_getchar(s, pr_i) == 45) ? (sg = -1; pr_i += 1;);
  while (pr_i < n && pr_isnum(ch = str_getchar(s, pr_i)) && ch != 45) (
    ch == 46 ? dot = 1 : (dot ? (dv *= 10; v += (ch - 48) / dv;) : v = v * 10 + ch - 48;);
    pr_i += 1;
  );
  sg * v;
);
function pr_str(s) local(n, p, v)
(
  n = strlen(s); pr_i = 0;
  while (pr_i < n) (
    p = pr_rd(s, n); v = pr_rd(s, n);
    (p >= 1 && p < 256 && PRIN[p]) ? g_setsl(p, v);
  );
);

// the user presets the helper script published for this plug-in
function pr_nuser() ( gmem[UP] == UP_MAGIC ? max(0, min(UP_MAX, floor(gmem[UPK]))) : 0; );
function pr_uname(dst, i) local(b, n, k)
(
  b = UPK + 100 + i * UP_NM; n = max(0, min(UP_NM - 1, floor(gmem[b]))); strcpy(dst, ""); k = 0;
  loop(n, sprintf(#pr_c1, "%c", max(32, min(255, gmem[b + 1 + k]))); strcat(dst, #pr_c1); k += 1;);
);
function pr_uapply(i) local(b, n, k, p)
(
  b = UPK + 3000 + i * UP_PSZ; n = max(0, min(600, floor(gmem[b])));
  pr_reset();
  k = 0;
  loop(n, p = floor(gmem[b + 1 + 2 * k] + 0.5); (p >= 1 && p < 256 && PRIN[p]) ? g_setsl(p, gmem[b + 2 + 2 * k]); k += 1;);
  pr_xload(b + 1 + 2 * n);
  sliderchange(-1);
);
// ask the helper script to save (op 1) or delete (op 2) a user preset
function pr_send(op, i) local(k, p)
(
  gmem[UP + 11] = MYID; gmem[UP + 12] = op; gmem[UP + 13] = SUBKIND; gmem[UP + 14] = i;
  op == 1 ? (
    gmem[UP + 100] = PRLN;
    k = 0; loop(PRLN, p = PRL[k]; gmem[UP + 101 + 2 * k] = p; gmem[UP + 102 + 2 * k] = slider(p); k += 1;);
    pr_xsave(UP + 101 + 2 * PRLN);
  );
  gmem[UP + 10] += 1; pr_req = gmem[UP + 10]; pr_reqop = op; pr_reqt = g_now;
);
// the helper's answer: a short note next to the Presets button
function pr_poll()
(
  (pr_req > 0 && gmem[UP + 15] >= pr_req && gmem[UP + 17] === MYID) ? (
    gmem[UP + 16] > 0 ? strcpy(#pr_msg, pr_reqop == 1 ? "preset saved" : "preset deleted") :
      (gmem[UP + 16] < 0 ? strcpy(#pr_msg, "the preset could not be saved") : strcpy(#pr_msg, ""));
    pr_msgt = g_now; pr_req = 0;
  );
  (pr_req > 0 && g_now - pr_reqt > 120) ? pr_req = 0;
);

// ---- factory presets (the shared Presets menu): built from the preset table (presets.py) ----
PR_NF = 21;
strcpy(#pr_fmenu, ">Live rig|Clean bass: dotted eighth, clean lows|Dist bass: slapback|Slap bass: short room echo|Singing vocal: quarter tape|<Talking vocal: slap|>Bass ");
strcat(#pr_fmenu, "by genre|Punk rock|Pop punk|Metal|Rock|Jazz|<Pop|>Classic|Slapback|Dotted eighth|Ping-pong eighths|Tape echo|Analog (BBD)|<Dub|>Space|Ambient wash|Shi");
strcat(#pr_fmenu, "mmer swell|Reverse echoes|<Octave-up repeats");
function pr_factory(n)
(
  n == 0 ? pr_str("45=0 47=15 50=40 60=0 61=2 64=0 72=8 76=25 89=250 90=6000");     // Live rig: Clean bass: dotted eighth, clean lows
  n == 1 ? pr_str("45=0 47=15 50=0 60=0 61=2 64=0 71=120 72=0 76=10 82=1 89=300 90=4000");     // Live rig: Dist bass: slapback
  n == 2 ? pr_str("45=0 47=10 50=0 60=0 61=2 64=0 71=80 72=0 76=5 89=300 90=5000");     // Live rig: Slap bass: short room echo
  n == 3 ? pr_str("45=0 47=18 50=50 60=15 61=2 64=0 72=10 76=30 82=1 83=25 89=250 90=6000");     // Live rig: Singing vocal: quarter tape
  n == 4 ? pr_str("45=0 47=10 50=0 60=0 61=2 64=0 71=90 72=0 76=5 89=300 90=7000");     // Live rig: Talking vocal: slap
  n == 5 ? pr_str("45=0 47=20 50=0 60=0 61=2 64=0 71=110 72=0 76=15 82=1 89=250 90=5000");     // Bass by genre: Punk rock
  n == 6 ? pr_str("45=0 47=20 50=50 60=0 61=2 64=0 72=7 76=30 78=1 89=250 90=7000");     // Bass by genre: Pop punk
  n == 7 ? pr_str("45=0 47=20 50=60 60=0 61=2 64=0 72=11 76=35 89=300 90=4000");     // Bass by genre: Metal
  n == 8 ? pr_str("45=0 47=25 50=0 60=0 61=2 64=0 72=8 76=35 82=1 89=200 90=5500");     // Bass by genre: Rock
  n == 9 ? pr_str("45=0 47=15 50=0 60=0 61=2 64=0 72=10 76=20 82=2 89=200 90=3500");     // Bass by genre: Jazz
  n == 10 ? pr_str("45=0 47=22 50=40 60=20 61=2 64=0 72=10 76=25 89=250 90=8000 110=1 112=8 114=8 116=25 119=-6 120=50 129=300 130=8000");     // Bass by genre: Pop
  n == 11 ? pr_str("45=0 47=25 50=0 60=0 61=2 64=0 71=110 72=0 76=10 82=1 89=150 90=6000");     // Classic: Slapback
  n == 12 ? pr_str("45=0 47=30 50=30 60=0 61=2 64=0 72=8 76=40 89=200 90=7000");     // Classic: Dotted eighth
  n == 13 ? pr_str("45=0 47=30 50=0 60=0 61=2 64=0 72=7 76=45 78=1 89=200 90=8000");     // Classic: Ping-pong eighths
  n == 14 ? pr_str("45=0 47=30 50=0 60=0 61=2 64=0 72=10 76=45 82=1 83=40 84=20 85=15 87=20");     // Classic: Tape echo
  n == 15 ? pr_str("45=0 47=30 50=0 60=0 61=2 64=0 72=10 76=45 82=2 83=50");     // Classic: Analog (BBD)
  n == 16 ? pr_str("45=0 47=35 50=0 60=0 61=2 64=0 72=11 76=80 82=2 87=30 89=300 90=2000");     // Classic: Dub
  n == 17 ? pr_str("45=0 47=40 50=0 60=40 61=4 64=0 72=10 76=50 89=200 90=6000 94=60");     // Space: Ambient wash
  n == 18 ? pr_str("45=0 47=40 50=0 60=50 61=6 64=40 72=10 76=40 89=300 94=40");     // Space: Shimmer swell
  n == 19 ? pr_str("45=0 47=35 50=0 60=0 61=2 64=0 72=10 76=35 96=2");     // Space: Reverse echoes
  n == 20 ? pr_str("45=0 47=30 50=0 60=0 61=2 64=0 72=8 76=40 89=300 96=1 97=12");     // Space: Octave-up repeats
);

function pr_menu(x, y) local(nu, n, r, i, ok)
(
  nu = pr_nuser(); n = 0;
  strcpy(#pr_menu, "");
  PR_NF > 0 ? (
    strcat(#pr_menu, #pr_fmenu); i = 0; loop(PR_NF, n += 1; PRA[n] = 1; PRB[n] = i; i += 1;);
    strcat(#pr_menu, "||");
  );
  nu > 0 ? (
    strcat(#pr_menu, ">User presets");
    i = 0; loop(nu, strcat(#pr_menu, i == nu - 1 ? "|<" : "|"); pr_uname(#pr_nm, i); strcat(#pr_menu, #pr_nm); n += 1; PRA[n] = 2; PRB[n] = i; i += 1;);
    strcat(#pr_menu, "|");
  ) : (
    strcat(#pr_menu, "#User presets: none saved yet|"); n += 1; PRA[n] = 0;
  );
  ok = MYSLOT >= 0 && g_script_ok && gmem[GM_SCRIPTVER] >= 6 && gmem[UP] == UP_MAGIC;
  strcat(#pr_menu, ok ? "Save these settings as a user preset..." : "#Save as a user preset (needs the helper script, version 6)");
  n += 1; PRA[n] = ok ? 3 : 0;
  (ok && nu > 0) ? (
    strcat(#pr_menu, "|>Delete a user preset");
    i = 0; loop(nu, strcat(#pr_menu, i == nu - 1 ? "|<" : "|"); pr_uname(#pr_nm, i); strcat(#pr_menu, #pr_nm); n += 1; PRA[n] = 4; PRB[n] = i; i += 1;);
  );
  strcat(#pr_menu, "||Reset to defaults"); n += 1; PRA[n] = 5;
  gfx_x = X(x); gfx_y = Y(y);
  r = gfx_showmenu(#pr_menu);
  (r >= 1 && r <= n) ? (
    PRA[r] == 1 ? (pr_reset(); pr_factory(PRB[r]); sliderchange(-1););
    PRA[r] == 2 ? pr_uapply(PRB[r]);
    PRA[r] == 3 ? pr_send(1, 0);
    PRA[r] == 4 ? pr_send(2, PRB[r]);
    PRA[r] == 5 ? (pr_reset(); sliderchange(-1););
  );
);

// ---- the top bar every TwoStorms plug-in shares: title, finale, Presets, A / B / Copy, Swap and Bypass, Settings ----
// ab: the plug-in has A/B sets (and so Swap). Swap = the other set at this one's loudness; Bypass = the input at the same
// loudness. A click latches it, Shift + click and hold only while the mouse is held.
function top_bar(title, ab)
(
  gfx_setfont(4); c_orange();
  text(title, 12, 8, 236, 24, 4);
  g_fin ? badge("finale", 250, 11, 2);
  pr_poll();
  button(304, 8, 84, 24, "Presets  v", 0, 1, 0) ? pr_menu(304, 32);
  ab ? (
    g_ab = slider(P_AB) >= 0.5;
    button(396, 8, 28, 24, "A", !g_ab, 1, 0) ? (g_ab ? (ab_swap(); (g_cap & 8) ? (g_abm = 1;);););
    button(426, 8, 28, 24, "B", g_ab, 1, 0) ? (!g_ab ? (ab_swap(); (g_cap & 8) ? (g_abm = 1;);););
    (g_abm && !(g_cap & 1)) ? (ab_swap(); g_abm = 0;);
    button(458, 8, 76, 24, g_ab ? "Copy B>A" : "Copy A>B", 0, 1, 0) ? ab_copy();
    button(542, 8, 120, 24, "Swap (Lvl Match)", g_holdid == 2, 1, 1) ? ((g_cap & 8) ? (g_holdm = 2;) : (g_hl = (g_hl == 2 ? 0 : 2);););
  );
  button(666, 8, 126, 24, "Bypass (Lvl Match)", g_holdid == 1, 1, 1) ? ((g_cap & 8) ? (g_holdm = 1;) : (g_hl = (g_hl == 1 ? 0 : 1);););
  !(g_cap & 1) ? g_holdm = 0;
  g_holdid = g_holdm ? g_holdm : g_hl;
  c_uihold = g_holdid; c_uibeat = g_now;
  button(798, 8, 90, 24, "Settings", g_cset, 1, 0) ? g_cset = !g_cset;
  // a note from the presets (saved, deleted) for a few seconds, at the right of the line below
  g_now - pr_msgt < 4 ? (gfx_setfont(3); c_orange(); text(#pr_msg, 588, 34, 300, 16, 6););
);

@serialize
z_ver = 1;
file_var(0, z_ver);
file_mem(0, ABSET, 256);

@slider
// a host change (automation, ReaLearn, a preset) to one side of a linked pair moves the other side too
s_k = 0;
loop(4,
  s_a = s_k * 2; s_b = s_a + 1;
  (slider(si(P_LINK + s_k)) >= 0.5 && s_b < 2 + 2 * max(0, min(3, floor(slider(si(P_NCH)) + 0.5))) &&
   slider(si(P_USED + s_a)) >= 0.5 && slider(si(P_USED + s_b)) >= 0.5) ? (
    s_ga = slider(si(P_GAIN + s_a)); s_gb = slider(si(P_GAIN + s_b));
    s_ga !== s_gb ? (
      s_ga !== LASTG[s_a] ? (
        slider(si(P_GAIN + s_b)) = s_ga; sliderchange(slider(si(P_GAIN + s_b)));
      ) : (
        slider(si(P_GAIN + s_a)) = s_gb; sliderchange(slider(si(P_GAIN + s_a)));
      );
    );
  );
  s_k += 1;
);
s_c = 0; loop(8, LASTG[s_c] = slider(si(P_GAIN + s_c)); s_c += 1;);
@block
// ---------- Delay: once per block ----------
c_uiok = a_now - c_uibeat < 0.5;
c_bph = c_uiok && c_uihold == 1;
c_swh = c_uiok && c_uihold == 2;
c_lat = slider(P_AB) >= 0.5;          // the latched set: 0 = A, 1 = B
c_side = c_swh ? !c_lat : c_lat;      // the set playing now
(srate !== y_csr) ? (
  y_csr = srate; y_snap = 1;
  DC_R = 1 - 2 * $pi * 8 / srate;
  YKS = 1 - exp(-1 / (0.01 * srate)); YKF = 1 - exp(-1 / (0.03 * srate)); YBR = 0.8 / srate;
  a_i = 0; loop(4, YWR[a_i] = (0.45 + 0.17 * (a_i & 1) + 0.05 * (a_i >> 1)) / srate; YFR[a_i] = (7 + 1.3 * (a_i & 1) + 0.4 * (a_i >> 1)) / srate; a_i += 1;);
  D_KAE = 1 - exp(-1 / (0.003 * srate));
  YKA = 1 - exp(-1 / (0.001 * srate)); YKR = 1 - exp(-1 / (0.12 * srate));
  YAL_ST = 2 * ceil(srate / 48000); YAL_N = floor(0.006 * srate / YAL_ST); YAL_M = floor(0.003 * srate / YAL_ST);
  a_i = 0; loop(16, YDFP[a_i] = (a_i * 0.137) % 1; YDFI[a_i] = (0.29 + 0.083 * a_i) / srate; a_i += 1;);
  RVI[0] = 0.31 / srate; RVI[1] = 0.43 / srate; RVI[2] = 0.57 / srate; RVI[3] = 0.71 / srate; YRMD = 0.0005 * srate;
  a_i = 0; loop(3, YRAD[a_i] = floor((a_i == 0 ? 142 : (a_i == 1 ? 107 : 379)) * srate / 48000 + 0.5); YRAD[a_i + 3] = floor((a_i == 0 ? 152 : (a_i == 1 ? 113 : 401)) * srate / 48000 + 0.5); a_i += 1;);
  y_cur_init = 0;
);
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;
c_latms = 0;
y_tempo = tempo > 0 ? tempo : 120;
y_bps = y_tempo / (60 * srate);
(play_state & 1) ? y_bt = beat_position;
(play_state & 1) ? (abs(beat_position - d_beat) > 0.25 ? d_beat = beat_position : d_beat += (beat_position - d_beat) * 0.1;);
// MIDI: control changes and notes for the MIDI sources; everything is passed on
while (midirecv(d_mo, d_m1, d_m2, d_m3)) (
  d_st = d_m1 & 240;
  d_st == 176 ? MCC[d_m2 & 127] = (d_m3 & 127) / 127;
  (d_st == 144 && (d_m3 & 127) > 0) ? (d_nvel = (d_m3 & 127) / 127; d_nheld += 1;);
  (d_st == 128 || (d_st == 144 && (d_m3 & 127) == 0)) ? (d_nheld = max(0, d_nheld - 1); d_nheld == 0 ? d_nvel = 0;);
  d_st == 224 ? d_pb = ((d_m2 & 127) + (d_m3 & 127) * 128 - 8192) / 8192;
  midisend(d_mo, d_m1, d_m2, d_m3);
);
// ducking: how fast, and from where
y_dka = 1 - exp(-1 / (max(0.5, c_pv(P_DATT)) * 0.001 * srate)); y_dkr = 1 - exp(-1 / (max(5, c_pv(P_DREL)) * 0.001 * srate));
y_dsrc = c_pv(P_DSRC) >= 0.5; y_dthr = c_pv(P_DTHR); y_dam = c_pv(P_DUCK) * 0.01;
// flush the tiny leftovers (denormals)
a_i = 0; loop(4 * 3 * 2, abs(YFZ[a_i]) < 0.000000000000000000001 ? YFZ[a_i] = 0; a_i += 1;);
a_i = 0; loop(4 * 4, abs(YCZ[a_i]) < 0.000000000000000000001 ? YCZ[a_i] = 0; a_i += 1;);
a_i = 0; loop(NMOD, MEN[a_i] < 0.000000000000000000001 ? MEN[a_i] = 0; a_i += 1;);
y_den < 0.000000000000000000001 ? y_den = 0;

// the window is open (meters, level matching, analyzer only run then)
c_uion = a_now - g_last < 0.5;
c_anw = c_uion && slider(P_AN) >= 0.5;

// level matching (about 1.5 s), per set: how much louder the plug-in makes things, input to output
// (not for 0.3 s after the playing set changes: the filters are still settling)
c_side !== c_lside ? (c_lside = c_side; c_lmskip = 0.3 * srate;);
c_lmskip > 0 ? (c_lmskip -= samplesblock; c_ei = 0;);
(samplesblock !== c_lbs || srate !== c_lbsr) ? (c_lbs = samplesblock; c_lbsr = srate; c_klm = 1 - exp(-samplesblock / (1.5 * srate)););
c_ei > 0.0000001 * samplesblock ? (
  LMI[c_side] += c_klm * (c_ei / samplesblock - LMI[c_side]);
  LMO[c_side] += c_klm * (c_eo / samplesblock - LMO[c_side]);
  LMV[c_side] = 1;
);
c_ei = 0; c_eo = 0;
// held Bypass: the raw input at the playing set's loudness; held Swap: the other set at this one's
c_bpg = (LMV[c_side] && LMI[c_side] > 0) ? sqrt(LMO[c_side] / LMI[c_side]) : 1;
c_trt = (c_swh && LMV[0] && LMV[1] && LMI[0] > 0 && LMI[1] > 0 && LMO[0] > 0 && LMO[1] > 0) ?
  sqrt((LMO[c_lat] / LMI[c_lat]) / (LMO[!c_lat] / LMI[!c_lat])) : 1;
c_bps = 1 / (0.01 * srate); c_trk = 1 - exp(-1 / (0.01 * srate));

// input/output link: the input gain moved (by hand or automation), so the output moves the other way
// (an A/B switch doesn't count: the window bumps c_uiabn)
c_inv = slider(P_IN);
c_uiabn !== c_abseen ? (c_abseen = c_uiabn; c_inlast = c_inv;);
(slider(P_IOL) >= 0.5 && c_inlast > -100 && c_inv !== c_inlast && slider(si(P_GAIN)) > GFLOOR) ?
  a_apply(P_GAIN, max(-99.9, min(60, slider(si(P_GAIN)) - (c_inv - c_inlast))));
c_inlast = c_inv;

// meters for the window: input peak (after Input), loudest output
a_dur = samplesblock / srate;
c_mi0 = max(c_ip0 > 0.0000000001 ? 20 * log10(c_ip0) : -200, c_mi0 - 20 * a_dur);
c_mi1 = max(c_ip1 > 0.0000000001 ? 20 * log10(c_ip1) : -200, c_mi1 - 20 * a_dur);
a_b = SLOTBASE + MYSLOT * SLOTSZ;
c_mo0 = MYSLOT >= 0 ? max(gmem[a_b + O_BPK], gmem[a_b + O_BPK + 1]) : 0;
c_mo0 = c_mo0 > 0.0000000001 ? 20 * log10(c_mo0) : -200;
c_ip0 = 0; c_ip1 = 0;

// fold the fast path's meter accumulators (see @sample) into the per-channel ones
BPK[0] = max(BPK[0], a_fp0); BPK[1] = max(BPK[1], a_fp1); BEN[0] += a_fe0; BEN[1] += a_fe1;
a_fp0 = 0; a_fp1 = 0; a_fe0 = 0; a_fe1 = 0;
a_now = time_precise();
a_claim();
MYSLOT >= 0 ? a_dupcheck();
a_pos = 0; a_pf = 0;
a_trk = get_host_placement(a_pos, a_pf);
MYSLOT >= 0 ? (
  a_nmb = NAMEBASE + MYSLOT * NAMESZ;
  // chain order: from the helper script when it has seen this instance, else REAPER's FX position
  a_order = gmem[a_nmb + N_ID] === MYID ? gmem[a_nmb + N_ORDER] : ((a_pf & 2) ? -100000 : 0) + a_pos;
  a_ring();
  a_aim_check();
  a_drive_follow();
);
a_gains();
a_nchs = a_nch(-1);
a_auto_block();
a_kout_was = a_kout;
MYSLOT >= 0 ? (
  a_meters();
  // the next point is matching loudness against this one: K-weight the output too
  a_kout = a_now - gmem[SLOTBASE + MYSLOT * SLOTSZ + O_KREQ] < 0.5;
  (a_kout && !a_kout_was) ? memset(KOUT, 0, 32);
  a_publish();
) : (
  a_kout = 0;
  a_c = 0; loop(8, BPK[a_c] = 0; BEN[a_c] = 0; BKE[a_c] = 0; a_c += 1;);
);
// the audio key (a gate later on this track may be listening to this plug-in)
a_aud_block();
a_inm = AST >= AS_WAIT;
a_binon = AST == AS_MEAS && AMODE == 0;
a_kin = a_inm && AU_KIN;
a_prevblk = samplesblock;
a_fast = a_nchs == 2 && USEDA[0] && USEDA[1] && !RAMP[0] && !RAMP[1] && !a_inm && !a_kout;
a_g0 = GLIN[0]; a_g1 = GLIN[1];

@sample
// ---------- Delay: per sample ----------
c_r0 = spl0; c_r1 = spl1;
y_ingc += (y_ingt - y_ingc) * 0.002;
c_x0 = c_r0 * y_ingc; c_x1 = c_r1 * y_ingc;
// the modulation followers (the wet signal for source "Wet")
d_nf > 0 ? (
  d_i = 0;
  loop(d_nf,
    d_s = MFL[d_i];
    d_v = MSR[d_s] == 0 ? max(abs(c_x0), abs(c_x1)) : (MSR[d_s] == 1 ? y_wetabs : max(abs(spl2), abs(spl3)));
    MEN[d_s] += (d_v > MEN[d_s] ? MKA[d_s] : MKR[d_s]) * (d_v - MEN[d_s]);
    d_i += 1;
  );
);
(y_tc += 1) >= 16 ? (y_tc = 0; y_tick(););
y_run(c_x0, c_x1);
// ducking: the louder the source, the quieter the repeats
d_v = y_dsrc ? max(abs(spl2), abs(spl3)) : max(abs(c_x0), abs(c_x1));
y_den += (d_v > y_den ? y_dka : y_dkr) * (d_v - y_den);
y_dgt = 10 ^ (-(y_dam * 40 * d_clamp((20 * log10(y_den + 0.000000001) - y_dthr) / 10, 0, 1)) / 20);
y_dgc += (y_dgt - y_dgc) * 0.002;
y_mxc += (y_mxt - y_mxc) * 0.002; y_dyc += (y_dyt - y_dyc) * 0.002;
c_q0 = c_r0; c_q1 = c_r1;
spl0 = c_x0 * y_dyc + y_wl * y_dgc * y_mxc;
spl1 = c_x1 * y_dyc + y_wr * y_dgc * y_mxc;
a_fast ? (
  // the usual case (one stereo pair, steady gain, nothing measuring): straight-line code
  a_y0 = spl0 * a_g0; a_y1 = spl1 * a_g1;
  spl0 = a_y0; spl1 = a_y1;
  a_ay = abs(a_y0); a_ay > a_fp0 ? a_fp0 = a_ay;
  a_ay = abs(a_y1); a_ay > a_fp1 ? a_fp1 = a_ay;
  a_fe0 += a_y0 * a_y0; a_fe1 += a_y1 * a_y1;
) : (
a_c = 0;
loop(a_nchs,
  USEDA[a_c] ? (
    a_x = spl(a_c);
    a_inm ? (
      // auto stage / match: the input, before the gain
      a_ax = abs(a_x);
      a_ax > IBP[a_c] ? IBP[a_c] = a_ax;
      a_e = a_kin ? sqr(a_kw(a_x, KIN + a_c * 4)) : a_x * a_x;
      IBE[a_c] += a_e;
      a_binon ? (MBACC[a_c] += a_e; a_ax > MPK[a_c] ? MPK[a_c] = a_ax;);
    );
    RAMP[a_c] ? (
      CUR[a_c] += STEP[a_c];
      ((STEP[a_c] > 0 && CUR[a_c] >= RTGT[a_c]) || (STEP[a_c] < 0 && CUR[a_c] <= RTGT[a_c]) || STEP[a_c] === 0) ? (
        CUR[a_c] = RTGT[a_c]; RAMP[a_c] = 0;
      );
      GLIN[a_c] = CUR[a_c] <= GFLOOR ? 0 : 10 ^ (CUR[a_c] / 20);
    );
    a_y = a_x * GLIN[a_c];
    spl(a_c) = a_y;
    a_ay = abs(a_y); a_ay > BPK[a_c] ? BPK[a_c] = a_ay;
    BEN[a_c] += a_y * a_y;
    a_kout ? BKE[a_c] += sqr(a_kw(a_y, KOUT + a_c * 4));
  );
  a_c += 1;
);
a_binon ? (
  AU_NS += 1; AU_BPOS += 1;
  AU_BPOS >= a_lbinlen ? (
    AU_NB < MAXB ? (
      a_c = 0; loop(8, MB[a_c * MAXB + AU_NB] = MBACC[a_c] / AU_BPOS; MBACC[a_c] = 0; a_c += 1;);
      AU_NB += 1;
    );
    AU_BPOS = 0;
  );
);
);
// ---------- Saturator: after the built-in Act ----------
// meters and level matching are only for the window (and its hold buttons)
c_uion ? (
  c_ei += c_r0 * c_r0 + c_r1 * c_r1; c_eo += spl0 * spl0 + spl1 * spl1;
  a_t = abs(c_x0); a_t > c_ip0 ? c_ip0 = a_t; a_t = abs(c_x1); a_t > c_ip1 ? c_ip1 = a_t;
);
// held Bypass (crossfaded) and held Swap (its level-matching trim, glided)
(c_bpv > 0 || c_bph || c_tr != 1 || c_trt != 1) ? (
  c_bpv = max(0, min(1, c_bpv + (c_bph ? c_bps : -c_bps)));
  c_tr += (c_trt - c_tr) * c_trk; abs(c_tr - c_trt) < 0.00001 ? c_tr = c_trt;
  spl0 = spl0 * c_tr * (1 - c_bpv) + c_q0 * c_bpg * c_bpv;
  spl1 = spl1 * c_tr * (1 - c_bpv) + c_q1 * c_bpg * c_bpv;
);
c_anw ? (ANI[c_ap] = (c_r0 + c_r1) * 0.5; ANO[c_ap] = (spl0 + spl1) * 0.5; ANS[c_ap] = (spl2 + spl3) * 0.5; c_ap = (c_ap + 1) & 8191;);
// audio key: hand this plug-in's output samples to a later plug-in that asked for them (the very last thing)
a_wr ? (gmem[a_wr0 + a_wp] = spl0; gmem[a_wr0 + AUD_R + a_wp] = spl1; a_wp = (a_wp + 1) & AUD_MASK;);

@gfx 1040 780
frame_begin(900);
fin_compute();
g_fin = MYSLOT >= 0 ? FIN[MYSLOT] : 0;
g_live_me = MYSLOT >= 0 && g_live(MYSLOT, g_now);
g_sel = max(0, min(1, floor(slider(P_SEL) + 0.5)));
g_ma = 0; g_i = 0; loop(NMOD, slider(mp(g_i, M_TYPE)) >= 0.5 ? g_ma = 1; g_i += 1;);
g_route = floor(slider(P_ROUTE) + 0.5);

// ---- top bar (shared): title, finale, Presets, A/B, Swap, Bypass, Settings ----
top_bar("TWOSTORMS DELAY", 1);
MYSLOT >= 0 ? track_name(#g_tn, MYSLOT) : strcpy(#g_tn, "");
strcpy(#g_lt, "no latency");
sprintf(#g_sub, "%s    %s    playing: %s", #g_tn, #g_lt, c_side ? "B" : "A");
!g_script_ok ? strcat(#g_sub, "    (helper script not running)");
g_script_old ? strcat(#g_sub, "    (old helper script running: replace it)");
gfx_setfont(3); c_dim(); text(#g_sub, 12, 34, 876, 16, 4);
g_y = 56;

// ---- settings: meters, zoom, finale ----
g_cset ? (
  c_panel(); rect(6, g_y - 4, 888, 76, 1);
  label("Peak hold", 12, g_y, 64);
  dropdown(78, g_y, 86, 22, g_key(-1, P_HOLD), 320, 6, 1);
  label("Meter range", 178, g_y, 80);
  dropdown(260, g_y, 80, 22, g_key(-1, P_RANGE), 330, 6, 1);
  label("Zoom", 356, g_y, 40);
  dropdown(398, g_y, 80, 22, g_key(-1, P_ZOOM), 360, 6, 1);
  label("Finale", 494, g_y, 44);
  dropdown(540, g_y, 86, 22, g_key(-1, P_FINAL), 370, 3, 1);
  g_fm = floor(slider(si(P_FINAL)) + 0.5);
  g_fc = MYSLOT >= 0 ? fin_of_chain(MYSLOT) : -1;
  g_warn = 0;
  g_fm == FIN_NEVER ? strcpy(#g_fs, "Never on the Finales tab.") : (
    g_fin ? (
      fin_tail(MYSLOT) ? (strcpy(#g_fs, "Finale, but plug-ins after it change the output."); g_warn = 1;)
                       : strcpy(#g_fs, g_fin == 2 ? "Always on the Finales tab." : "The finale: the last Act in its chain.");
    ) : (
      g_fc >= 0 ? (point_title(#g_ft, g_fc); sprintf(#g_fs, "Not the finale: %s is.", #g_ft);) : strcpy(#g_fs, "Not the finale.");
    );
  );
  gfx_setfont(3); g_warn ? c_red() : (g_fin ? c_orange() : c_dim());
  text(#g_fs, 634, g_y, 254, 22, 4);
  c_faint();
  text("Bypass (Lvl Match) plays the input at the same loudness; Swap (Lvl Match) plays the other A/B set at this one's loudness.", 12, g_y + 28, 876, 16, 4);
  text("Click to latch these and A/B; Shift + click and hold to use them only while the mouse is held.", 12, g_y + 44, 876, 16, 4);
  sprintf(#g_idt, "Plugin ID %d", MYID); text(#g_idt, 12, g_y + 44, 876, 16, 6);
  g_y += 80;
);


// ---- the echo map: each line's repeats in time, left side above the middle, right side below ----
g_ax = 12; g_ay = g_y; g_aw = 796; g_ah = 170;
g_dpy = g_ay;
c_well(); rect(g_ax, g_ay, g_aw, g_ah, 1);
gfx_setfont(3);
// how much time to show: about six of the longest delay, in a round number
g_tmx = 100;
g_k = 0; loop(2, slider(ep(g_k, K_ON)) >= 0.5 ? g_tmx = max(g_tmx, max(g_tms(g_k, 0), g_tms(g_k, 1))); g_k += 1;);
g_tmx *= 6;
g_span = g_tmx <= 500 ? 500 : (g_tmx <= 1000 ? 1000 : (g_tmx <= 1500 ? 1500 : (g_tmx <= 2000 ? 2000 : (g_tmx <= 3000 ? 3000 : (g_tmx <= 4000 ? 4000 : (g_tmx <= 6000 ? 6000 : 8000))))));
g_edrag >= 0 ? g_span = g_dspan : g_dspan = g_span;
g_stp = g_span <= 500 ? 50 : (g_span <= 1000 ? 100 : (g_span <= 2000 ? 250 : (g_span <= 4000 ? 500 : 1000)));
g_t = 0;
while (g_t <= g_span) (
  g_px = g_ax + g_t / g_span * g_aw;
  setc(0.15, 0.15, 0.17); rect(g_px, g_ay, 1 / g_sc, g_ah, 1);
  (g_t > 0 && g_px < g_ax + g_aw - 36) ? (
    g_t >= 1000 ? sprintf(#g_fl, g_t % 1000 == 0 ? "%d s" : "%.1f s", g_t / 1000) : sprintf(#g_fl, "%d ms", g_t);
    c_faint(); text(#g_fl, g_px + 2, g_ay + g_ah - 13, 50, 12, 4);
  );
  g_t += g_stp;
);
g_cy = g_ay + g_ah * 0.5; g_hh = g_ah * 0.5 - 14;
setc(0.30, 0.30, 0.34); rect(g_ax, g_cy, g_aw, 1 / g_sc, 1);
c_faint(); text("L", g_ax + 4, g_ay + 3, 12, 12, 4); text("R", g_ax + 4, g_ay + g_ah - 15, 12, 12, 4);
setc(1.0, 0.95, 0.88); rect(g_ax, g_ay + 14, 2, g_ah - 28, 1);
// the repeats (series: the first line's repeats feed the second; B to A: the other way round)
g_o1 = g_route == 2 ? 1 : 0; g_o2 = 1 - g_o1;
g_k = g_o1;
slider(ep(g_k, K_ON)) >= 0.5 ? (
  g_seed_input(g_k); g_sim(g_k, g_span); g_draw_events(g_k, g_cy, g_hh, g_ax, g_aw, g_span, g_k == g_sel ? 1 : 0.55);
  g_seed_from_events(g_o2);
) : g_seed_input(g_o2);
g_k = g_o2;
slider(ep(g_k, K_ON)) >= 0.5 ? (
  g_sim(g_k, g_span); g_draw_events(g_k, g_cy, g_hh, g_ax, g_aw, g_span, g_k == g_sel ? 1 : 0.55);
);
c_border(); rect(g_ax, g_ay, g_aw, g_ah, 0);
// the first repeat of the selected line can be grabbed: sideways changes its time
g_mxd = (g_mx - g_ox) / g_sc; g_myd = (g_my - g_oy) / g_sc;
g_ind = g_mxd >= g_ax && g_mxd < g_ax + g_aw && g_myd >= g_ay && g_myd < g_ay + g_ah;
g_gh = -1;
slider(ep(g_sel, K_ON)) >= 0.5 ? (
  g_gx0 = g_ax + g_tms(g_sel, 0) / g_span * g_aw; g_gx1 = g_ax + g_tms(g_sel, 1) / g_span * g_aw;
  (g_ind && g_myd < g_cy && abs(g_mxd - g_gx0) < 7) ? g_gh = 0;
  (g_ind && g_myd >= g_cy && abs(g_mxd - g_gx1) < 7) ? g_gh = 1;
  g_edrag >= 0 ? g_gh = g_edrag;
  g_gh >= 0 ? (
    band_col(g_sel, 1); gfx_circle(X(g_gh == 0 ? g_gx0 : g_gx1), Y(g_gh == 0 ? g_cy - 6 : g_cy + 6), 5 * g_sc, 1, 1); gfx_a = 1;
  );
);
(g_ind && g_lclick && !g_used && g_gh >= 0) ? (g_used = 1; g_edrag = g_gh;);
(g_edrag >= 0 && (g_cap & 1)) ? (
  g_nt = max(1, min(8000, (g_mxd - g_ax) / g_aw * g_span));
  g_c = (g_edrag == 1 && slider(ep(g_sel, K_LINK)) < 0.5) ? 1 : 0;
  g_ps = ep(g_sel, g_c ? K_SR : K_SL); g_pt = ep(g_sel, g_c ? K_TR : K_TL);
  floor(slider(g_ps) + 0.5) == 0 ? (
    g_kset(g_key(-1, g_pt), g_nt, 0);
  ) : (
    g_bj = 1; g_bd = 1000000; g_j = 1;
    loop(16, g_d1 = abs(log(YBEATS[g_j] * 60000 / y_tempo / g_nt)); g_d1 < g_bd ? (g_bd = g_d1; g_bj = g_j;); g_j += 1;);
    g_kset(g_key(-1, g_ps), g_bj, 0);
  );
);
(g_edrag >= 0 && !(g_cap & 1)) ? (
  g_c = (g_edrag == 1 && slider(ep(g_sel, K_LINK)) < 0.5) ? 1 : 0;
  g_kset(g_key(-1, ep(g_sel, g_c ? K_SR : K_SL)), slider(ep(g_sel, g_c ? K_SR : K_SL)), 1);
  g_kset(g_key(-1, ep(g_sel, g_c ? K_TR : K_TL)), slider(ep(g_sel, g_c ? K_TR : K_TL)), 1);
  g_edrag = -1;
);
// the meters, input and output
gfx_setfont(3); c_dim();
text("IN", 816, g_ay, 24, 12, 5); text("OUT", 862, g_ay, 28, 12, 5);
vmeter(816, g_ay + 14, 10, g_ah - 18, c_mi0, g_live_me);
vmeter(828, g_ay + 14, 10, g_ah - 18, c_mi1, g_live_me);
g_b = SLOTBASE + MYSLOT * SLOTSZ;
vmeter(866, g_ay + 14, 10, g_ah - 18, MYSLOT >= 0 ? gmem[g_b + O_PKD] : -200, g_live_me);
vmeter(878, g_ay + 14, 10, g_ah - 18, MYSLOT >= 0 ? gmem[g_b + O_PKD + 1] : -200, g_live_me);
c_dim();
g_gh >= 0 ? (
  fmt_ms(#g_fl, g_tms(g_sel, g_gh));
  sprintf(#g_hint, "Line %s, %s side: %s    drag sideways to change the time", g_sel == 0 ? "A" : "B", g_gh == 0 ? "left" : "right", #g_fl);
) : strcpy(#g_hint, "The repeats of both lines over time, left above the line and right below. Drag the first repeat of the selected line sideways to set its time.");
text(#g_hint, g_ax + 2, g_ay + g_ah + 3, 796, 14, 4);
g_y = g_dpy + g_ah + 22;

// ---- the lines: a chip each, and the routing between them ----
label("Lines", 12, g_y - 1, 48);
lchip(60, g_y, 70, 22, 0); lchip(134, g_y, 70, 22, 1);
cdd(214, g_y, 170, 22, g_key(-1, P_ROUTE), 480, 4, "Routing:", 1);
g_route == 3 ? cctl("Link", 394, g_y + 1, P_LCROSS, 0, 1);
mtog(700, g_y + 1, 90, "Freeze", P_FREEZE, 1);
g_y += 30;

// ---- the filters of the selected line: the loop's low cut, high cut and bell over the spectrum ----
g_ax = 12; g_ay = g_y; g_aw = 876; g_ah = 140;
c_well(); rect(g_ax, g_ay, g_aw, g_ah, 1);
gfx_setfont(3);
g_i = 0;
loop(8,
  g_f = g_i == 0 ? 50 : (g_i == 1 ? 100 : (g_i == 2 ? 200 : (g_i == 3 ? 500 : (g_i == 4 ? 1000 : (g_i == 5 ? 2000 : (g_i == 6 ? 5000 : 10000))))));
  setc(0.15, 0.15, 0.17); rect(an_x(g_f), g_ay, 1 / g_sc, g_ah, 1);
  g_f >= 1000 ? sprintf(#g_fl, "%dk", g_f / 1000) : sprintf(#g_fl, "%d", g_f);
  c_faint(); text(#g_fl, an_x(g_f) + 2, g_ay + g_ah - 13, 30, 12, 4);
  g_i += 1;
);
g_d = -12;
loop(5,
  g_d == 0 ? setc(0.30, 0.30, 0.34) : setc(0.15, 0.15, 0.17);
  rect(g_ax, ey(g_d), g_aw, 1 / g_sc, 1);
  c_faint(); g_d > 0 ? sprintf(#g_fl, "+%d", g_d) : sprintf(#g_fl, "%d", g_d);
  text(#g_fl, g_ax + 3, ey(g_d) - 13, 30, 12, 4);
  g_d += 6;
);
g_an = floor(slider(P_AN) + 0.5);
(g_live_me && g_an > 0) ? (
  g_annorm = 20 * log10(4096 / 4);
  (g_an == 1 || g_an == 3) ? (an_fft(ANI, SPI, 4096); setc(0.21, 0.21, 0.25); an_draw(SPI, 4096, 1););
  (g_an == 2 || g_an == 3) ? (
    an_fft(ANO, SPO, 4096);
    g_an == 2 ? (setc(0.25, 0.15, 0.05); an_draw(SPO, 4096, 1););
    c_orange(); gfx_a = 0.75; an_draw(SPO, 4096, 0); gfx_a = 1;
  );
);
// the three filters as the loop has them
g_fo = EB0 + g_sel * EBN;
g_hpf = slider(g_fo + K_HP); g_lpf = slider(g_fo + K_LP); g_bf = slider(g_fo + K_BF); g_bg = slider(g_fo + K_BG); g_bq = slider(g_fo + K_BQ);
GNS[0] = g_hpf > 20.5 ? eg_coef(6, g_hpf, 0, 0.7071, 0, GCO) : 0;
GNS[1] = g_lpf < 19500 ? eg_coef(10, g_lpf, 0, 0.7071, 0, GCO + 20) : 0;
GNS[2] = abs(g_bg) >= 0.05 ? eg_coef(0, g_bf, g_bg, g_bq, 0, GCO + 40) : 0;
g_cn = floor(g_aw / 2);
g_i = 0; g_lx = -1;
loop(g_cn + 1,
  g_px = g_ax + g_i * g_aw / g_cn;
  g_f = an_f(g_px); g_w = 2 * $pi * g_f / srate; g_cw = cos(g_w); g_c2 = cos(2 * g_w);
  g_tot = 0; g_j = 0;
  loop(3, GNS[g_j] > 0 ? g_tot += 10 * log10(max(0.000000000001, eg_mag2(GCO + g_j * 20, GNS[g_j], g_cw, g_c2))); g_j += 1;);
  g_py = ey(max(-18, min(18, g_tot)));
  band_col(g_sel, 1);
  g_lx >= 0 ? (gfx_line(g_lx, g_ly, X(g_px), Y(g_py), 1); gfx_line(g_lx, g_ly + 1, X(g_px), Y(g_py) + 1, 1););
  gfx_a = 1;
  g_lx = X(g_px); g_ly = Y(g_py);
  g_i += 1;
);
// nodes: low cut and high cut slide sideways along 0 dB, the bell moves both ways (wheel = Q)
g_nxh = an_x(g_hpf); g_nyh = ey(0); g_nxl = an_x(g_lpf); g_nyl = ey(0); g_nxb = an_x(g_bf); g_nyb = ey(g_bg);
g_mxd = (g_mx - g_ox) / g_sc; g_myd = (g_my - g_oy) / g_sc;
g_ind = g_mxd >= g_ax && g_mxd < g_ax + g_aw && g_myd >= g_ay && g_myd < g_ay + g_ah;
g_nh = -1;
g_ind ? (
  g_best = 1000000;
  g_dd2 = sqrt(sqr(g_mxd - g_nxh) + sqr(g_myd - g_nyh)); (g_dd2 < 10 && g_dd2 < g_best) ? (g_best = g_dd2; g_nh = 0;);
  g_dd2 = sqrt(sqr(g_mxd - g_nxl) + sqr(g_myd - g_nyl)); (g_dd2 < 10 && g_dd2 < g_best) ? (g_best = g_dd2; g_nh = 1;);
  g_dd2 = sqrt(sqr(g_mxd - g_nxb) + sqr(g_myd - g_nyb)); (g_dd2 < 10 && g_dd2 <= g_best) ? (g_best = g_dd2; g_nh = 2;);
);
g_fdrag >= 0 ? g_nh = g_fdrag;
g_i = 0;
loop(3,
  g_nx = g_i == 0 ? g_nxh : (g_i == 1 ? g_nxl : g_nxb); g_ny = g_i == 0 ? g_nyh : (g_i == 1 ? g_nyl : g_nyb);
  band_col(g_sel, 1);
  gfx_circle(X(g_nx), Y(g_ny), (g_i == g_nh ? 8 : 6.5) * g_sc, 1, 1);
  gfx_setfont(3); setc(0.05, 0.04, 0.03);
  text(g_i == 0 ? "H" : (g_i == 1 ? "L" : "B"), g_nx - 8, g_ny - 7, 16, 14, 5);
  g_i += 1;
);
c_border(); rect(g_ax, g_ay, g_aw, g_ah, 0);
gfx_setfont(3); c_dim();
g_nh == 0 ? (fmt_hz(#g_fl, g_hpf); sprintf(#g_hint, "Low cut: %s", #g_fl);) : (
  g_nh == 1 ? (fmt_hz(#g_fl, g_lpf); sprintf(#g_hint, "High cut: %s", #g_fl);) : (
    g_nh == 2 ? (fmt_hz(#g_fl, g_bf); sprintf(#g_hint, "Bell: %s   %+.1f dB   Q %.2f    wheel = Q", #g_fl, g_bg, g_bq);) :
    strcpy(#g_hint, "The filters in the loop, so every repeat passes them: H = low cut, L = high cut, B = bell. Drag the nodes; right-click one to reset it.")));
text(#g_hint, g_ax + 36, g_ay + 4, 830, 14, 4);
(g_ind && g_lclick && !g_used && g_nh >= 0) ? (g_used = 1; g_fdrag = g_nh;);
(g_ind && g_rclick && !g_used && g_nh >= 0) ? (
  g_used = 1;
  gfx_x = g_mx; gfx_y = g_my;
  gfx_showmenu("Reset this filter") == 1 ? (
    g_nh == 0 ? g_kset(g_key(-1, g_fo + K_HP), PDEF[g_fo + K_HP], 1);
    g_nh == 1 ? g_kset(g_key(-1, g_fo + K_LP), PDEF[g_fo + K_LP], 1);
    g_nh == 2 ? g_kset(g_key(-1, g_fo + K_BG), 0, 1);
  );
);
(g_ind && g_wheel != 0 && !g_used && !(g_cap & 8) && g_nh == 2) ? (
  g_used = 1;
  g_kset(g_key(-1, g_fo + K_BQ), max(0.2, min(8, g_bq * exp((g_wheel > 0 ? 1 : -1) * 0.12))), 1);
);
(g_fdrag >= 0 && (g_cap & 1)) ? (
  g_fv = max(20, min(20000, an_f(g_mxd)));
  g_fdrag == 0 ? g_kset(g_key(-1, g_fo + K_HP), max(20, min(2000, g_fv)), 0);
  g_fdrag == 1 ? g_kset(g_key(-1, g_fo + K_LP), max(200, min(20000, g_fv)), 0);
  g_fdrag == 2 ? (
    g_kset(g_key(-1, g_fo + K_BF), g_fv, 0);
    g_kset(g_key(-1, g_fo + K_BG), floor(max(-18, min(18, (g_ay + g_ah * 0.5 - g_myd) / (g_ah * 0.5) * 18)) * 10 + 0.5) / 10, 0);
  );
);
(g_fdrag >= 0 && !(g_cap & 1)) ? (
  g_fdrag == 0 ? g_kset(g_key(-1, g_fo + K_HP), slider(g_fo + K_HP), 1);
  g_fdrag == 1 ? g_kset(g_key(-1, g_fo + K_LP), slider(g_fo + K_LP), 1);
  g_fdrag == 2 ? (g_kset(g_key(-1, g_fo + K_BF), slider(g_fo + K_BF), 1); g_kset(g_key(-1, g_fo + K_BG), slider(g_fo + K_BG), 1););
  g_fdrag = -1;
);
g_y = g_ay + g_ah + 8;

// ---- the selected line ----
g_sb = g_sel;
g_son = slider(ep(g_sb, K_ON)) >= 0.5;
g_mode = floor(slider(ep(g_sb, K_MODE)) + 0.5); g_chr = floor(slider(ep(g_sb, K_CHAR)) + 0.5); g_shm = floor(slider(ep(g_sb, K_SH)) + 0.5);
gfx_setfont(2); band_col(g_sb, 1);
text(g_sb == 0 ? "Line A" : "Line B", 12, g_y, 60, 20, 4); gfx_a = 1;
ctog(74, g_y, 40, "On", ep(g_sb, K_ON), 0);
cdd(118, g_y, 160, 20, g_key(-1, ep(g_sb, K_MODE)), 490, 3, "Mode:", 1);
cdd(282, g_y, 130, 20, g_key(-1, ep(g_sb, K_CHAR)), 540, 4, "Char:", 1);
ctog(416, g_y, 64, "R = L", ep(g_sb, K_LINK), 0);
cdd(484, g_y, 204, 20, g_key(-1, ep(g_sb, K_SAT)), 610, 24, "Saturation:", 1);
cdd(692, g_y, 196, 20, g_key(-1, ep(g_sb, K_SH)), 545, 4, "Shift:", 1);
g_y += 26;
cdd(12, g_y, 110, 20, g_key(-1, ep(g_sb, K_TAPS)), 555, 4, "", 1);
slider(ep(g_sb, K_TAPS)) >= 0.5 ? cdd(126, g_y, 190, 20, g_key(-1, ep(g_sb, K_TPAT)), 550, 4, "Tap pattern:", 1);
gfx_setfont(3); c_faint();
text(g_mode > 0 ? "Ping-pong: the input goes into one side, the repeats cross over to the other." : "Stereo: each side repeats on its own, and Cross feeds some of it to the other side.", 326, g_y, 560, 20, 4);
g_y += 28;
timectl("Time L", 12, g_y, ep(g_sb, K_TL), ep(g_sb, K_SL), g_son);
mctl("Drive", 308, g_y, ep(g_sb, K_DRIVE), 0, g_son);
g_chr > 0 ? mctl("Age", 604, g_y, ep(g_sb, K_AGE), 0, g_son);
g_y += 28;
slider(ep(g_sb, K_LINK)) < 0.5 ? timectl("Time R", 12, g_y, ep(g_sb, K_TR), ep(g_sb, K_SR), g_son);
mctl("Low cut", 308, g_y, ep(g_sb, K_HP), 1, g_son);
mctl("Wow", 604, g_y, ep(g_sb, K_WOW), 0, g_son);
g_y += 28;
mctl("Feedback", 12, g_y, ep(g_sb, K_FB), 0, g_son);
mctl("High cut", 308, g_y, ep(g_sb, K_LP), 1, g_son);
mctl("Flutter", 604, g_y, ep(g_sb, K_FLUT), 0, g_son);
g_y += 28;
g_mode == 0 ? mctl("Cross", 12, g_y, ep(g_sb, K_CROSS), 0, g_son);
cctl("Bell freq", 308, g_y, ep(g_sb, K_BF), 1, g_son);
(g_shm & 1) ? mctl("Pitch", 604, g_y, ep(g_sb, K_SEMI), 0, g_son);
g_y += 28;
mctl("Level", 12, g_y, ep(g_sb, K_LEVEL), 0, g_son);
mctl("Bell gain", 308, g_y, ep(g_sb, K_BG), 0, g_son);
(g_shm > 0 && !((g_shm & 2) && slider(ep(g_sb, K_SHSY)) > 0.5)) ? cctl("Window", 604, g_y, ep(g_sb, K_SHSZ), 0, g_son);
g_y += 28;
mctl("Pan", 12, g_y, ep(g_sb, K_PAN), 0, g_son);
cctl("Bell Q", 308, g_y, ep(g_sb, K_BQ), 1, g_son);
slider(ep(g_sb, K_TAPS)) >= 0.5 ? cctl("Tap level", 604, g_y, ep(g_sb, K_TLVL), 0, g_son);
g_y += 28;
mctl("Width", 12, g_y, ep(g_sb, K_WIDTH), 0, g_son);
mctl("Diffusion", 308, g_y, ep(g_sb, K_DIFF), 0, g_son);
cctl("Glide", 604, g_y, ep(g_sb, K_GLIDE), 1, g_son);
g_y += 28;
cctl("Diff size", 308, g_y, ep(g_sb, K_DSZ), 0, g_son);
mctl("Rev send", 12, g_y, ep(g_sb, K_RSND), 0, g_son);
(g_shm & 2) ? cdd(604, g_y, 284, 20, g_key(-1, ep(g_sb, K_SHSY)), 560, 17, "Reverse on the beat:", g_son);
g_y += 36;

// ---- the whole delay: input, dry/wet, ducking ----
g_inact = g_drag_k == g_key(-1, P_IN) || hit(12, g_y, 284, 20);
g_inact ? g_fine = (g_cap & 8) != 0;
g_iolw = g_inact && (g_cap & 4) != 0;
(slider(P_IOL) >= 0.5) != g_iolw ? g_kset(g_key(-1, P_IOL), g_iolw, 1);
mctl("Input", 12, g_y, P_IN, 0, 1);
mctl("Dry/wet", 308, g_y, P_MIX, 0, 1);
ctog(604, g_y, 150, "Modulation", P_MODOPEN, 1);
g_y += 28;
mctl("Ducking", 12, g_y, P_DUCK, 0, 1);
slider(P_DUCK) >= 0.5 ? cctl("Threshold", 308, g_y, P_DTHR, 0, 1);
slider(P_DUCK) >= 0.5 ? cdd(604, g_y, 150, 20, g_key(-1, P_DSRC), 485, 2, "From:", 1);
g_y += 28;
slider(P_DUCK) >= 0.5 ? cctl("Attack", 12, g_y, P_DATT, 1, 1);
slider(P_DUCK) >= 0.5 ? cctl("Release", 308, g_y, P_DREL, 1, 1);
gfx_setfont(3); c_dim();
text("Ducking lowers the repeats while the source is loud.", 604, g_y, 280, 20, 4);
g_y += 32;

// ---- the shared reverb (after both lines) and the quality mode ----
g_ron = slider(P_RVB) >= 0.5;
mctl("Reverb", 12, g_y, P_RVB, 0, 1);
g_ron ? cctl("Decay", 308, g_y, P_RDEC, 1, 1);
g_ron ? cctl("Size", 604, g_y, P_RSIZ, 0, 1);
g_y += 28;
g_ron ? cctl("Damping", 12, g_y, P_RDMP, 1, 1);
g_ron ? cctl("Pre-delay", 308, g_y, P_RPRE, 0, 1);
g_ron ? cctl("Shimmer", 604, g_y, P_RSHM, 0, 1);
g_y += 28;
(g_ron && slider(P_RSHM) >= 0.5) ? cdd(12, g_y, 284, 20, g_key(-1, P_RSHP), 700, 4, "Shimmer:", 1);
cdd(308, g_y, 284, 20, g_key(-1, P_HQ), 710, 2, "Quality:", 1);
gfx_setfont(3); c_faint();
text("Both lines share this reverb.", 604, g_y, 284, 20, 4);
g_y += 32;

// ---- modulation ----
slider(P_MODOPEN) >= 0.5 ? (
  c_panel(); rect(6, g_y - 4, 888, 8 * 26 + 24, 1);
  gfx_setfont(3); c_faint();
  text("Type", 32, g_y, 80, 14, 4); text("Target", 126, g_y, 80, 14, 4); text("Setting", 214, g_y, 80, 14, 4); text("Amount", 330, g_y, 80, 14, 4);
  text("Shape / source / CC", 466, g_y, 200, 14, 4); text("Now", 800, g_y, 80, 14, 4);
  g_y += 16;
  g_i = 0;
  loop(NMOD, g_modrow(12, g_y, g_i); g_y += 26; g_i += 1;);
  g_y += 14;
);

// ---- output: the built-in Act, laid out like an Act card in the Gain Stage (the drive link where Auto all's tick and name are) ----
g_ch2 = 38 + 26;
c_card(); rect(6, g_y, 888, g_ch2, 1);
setc(0.20, 0.19, 0.18); rect(6, g_y, 888, g_ch2, 0);
drive_label(#g_dlb, -1);
g_dl = slider(si(P_DRIVE)) >= DRIVE_PARAM; g_don = slider(si(P_DRIVEON)) >= 0.5;
checkbox(16, g_y + 10, g_don && g_dl, g_dl) ? g_kset(g_key(-1, P_DRIVEON), !g_don, 1);
button(38, g_y + 6, 280, 22, #g_dlb, g_dl && g_don, MYSLOT >= 0, 1) ? drive_menu(-1, 38, g_y + 28);
// ... | mode | value | channels | Peak/RMS/LUFS | time | Auto
button(324, g_y + 6, 28, 22, "...", 0, 1, 0) ? act_menu(324, g_y + 28);
mode_ctl(356, g_y + 6, 96, -1, 1, 1);
value_ctl(456, g_y + 6, 130, -1, 1);
auto_mode(-1) != 0 ? src_ctl(590, g_y + 6, 76, 22, -1, 0, 1, 1);
dropdown(666, g_y + 6, 80, 22, g_key(-1, P_MEAS), 310, 3, 1);
auto_time_box(750, g_y + 6, 70, 22, -1, 1);
button(826, g_y + 6, 62, 22, auto_label(-1), auto_busy(-1), MYSLOT >= 0, 0) ? auto_click(-1);
// the gain group: meters, readouts, gain
g_tgt = aim_tick(-1);
gfx_setfont(3); c_dim(); text("1-2", 16, g_y + 36, 36, 20, 4);
meter(54, g_y + 36, 410, 9, MYSLOT, 0, g_tgt, g_live_me);
meter(54, g_y + 47, 410, 9, MYSLOT, 1, g_tgt, g_live_me);
readouts(472, g_y + 36, MYSLOT, 0, 2, g_live_me);
gain_ctl(630, g_y + 36, 168, g_key(-1, P_GAIN), 1);
g_y += g_ch2 + 8;
frame_end(g_y);
