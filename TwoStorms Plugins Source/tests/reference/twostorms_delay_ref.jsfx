sprintf(700, "Octave up"); sprintf(701, "Fifth up"); sprintf(702, "Octave + fifth"); sprintf(703, "Octave down"); sprintf(710, "Standard"); sprintf(711, "High");
sprintf(550, "Even"); sprintf(551, "Accelerating"); sprintf(552, "Decelerating"); sprintf(553, "Gallop");
sprintf(560, "Free"); sprintf(561, "1/32T"); sprintf(562, "1/32"); sprintf(563, "1/16T"); sprintf(564, "1/16"); sprintf(565, "1/16."); sprintf(566, "1/8T"); sprintf(567, "1/8"); sprintf(568, "1/8."); sprintf(569, "1/4T"); sprintf(570, "1/4"); sprintf(571, "1/4."); sprintf(572, "1/2T"); sprintf(573, "1/2"); sprintf(574, "1/2."); sprintf(575, "1 bar"); sprintf(576, "2 bars"); 
// the saturation styles (the saturator's, the ones that work without memory)
sprintf(610, "Clean Tube"); sprintf(611, "Warm Tube"); sprintf(612, "Hot Tube"); sprintf(613, "Broken Tube"); sprintf(614, "Clean Tape"); sprintf(615, "Warm Tape"); sprintf(616, "Hot Tape"); sprintf(617, "Extreme Tape"); sprintf(618, "Subtle Transformer"); sprintf(619, "Warm Transformer"); sprintf(620, "Lush Transformer"); sprintf(621, "American Amp"); sprintf(622, "British Amp"); sprintf(623, "Smooth Amp"); sprintf(624, "Crunch Amp"); sprintf(625, "Scream Amp"); sprintf(626, "Even Harmonics"); sprintf(627, "Inflator"); sprintf(628, "Fuzz"); sprintf(629, "Foldback"); sprintf(630, "Sine Fold"); sprintf(631, "Rectify"); sprintf(632, "Soft Clip"); sprintf(633, "Hard Clip"); 
YSATI = alloc(24); YSATG = alloc(30);
YSATI[0] = 0; YSATI[1] = 1; YSATI[2] = 2; YSATI[3] = 3; YSATI[4] = 4; YSATI[5] = 5; YSATI[6] = 6; YSATI[7] = 7; YSATI[8] = 9; YSATI[9] = 10; YSATI[10] = 11; YSATI[11] = 12; YSATI[12] = 13; YSATI[13] = 14; YSATI[14] = 15; YSATI[15] = 16; YSATI[16] = 19; YSATI[17] = 20; YSATI[18] = 21; YSATI[19] = 24; YSATI[20] = 25; YSATI[21] = 26; YSATI[22] = 28; YSATI[23] = 29; YSATG[0] = 0; YSATG[1] = 0; YSATG[2] = 2; YSATG[3] = 3; YSATG[4] = 0; YSATG[5] = 0; YSATG[6] = 0; YSATG[7] = 0; YSATG[8] = 0; YSATG[9] = 0; YSATG[10] = 0; YSATG[11] = 0; YSATG[12] = 0; YSATG[13] = 3; YSATG[14] = 2; YSATG[15] = 3; YSATG[16] = 6; YSATG[17] = 0; YSATG[18] = 0; YSATG[19] = 0; YSATG[20] = 0; YSATG[21] = 4; YSATG[22] = 0; YSATG[23] = 0; YSATG[24] = 0; YSATG[25] = 0; YSATG[26] = 0; YSATG[27] = 0; YSATG[28] = 0; YSATG[29] = 0; 
// the style cores' pre-gain (dB) and the loudness compensation measured for the saturator (dB, drive 0..100% in steps of 5)
CMPT = alloc(30 * 21);
a_k = CMPT + 0; a_k[0] = 7.858; a_k[1] = 5.369; a_k[2] = 2.885; a_k[3] = 0.411; a_k[4] = -2.048; a_k[5] = -4.482; a_k[6] = -6.874; a_k[7] = -9.201; a_k[8] = -11.429; a_k[9] = -13.513; a_k[10] = -15.406; a_k[11] = -17.064; a_k[12] = -18.456; a_k[13] = -19.578; a_k[14] = -20.446; a_k[15] = -21.094; a_k[16] = -21.565; a_k[17] = -21.898; a_k[18] = -22.130; a_k[19] = -22.290; a_k[20] = -22.400;
a_k = CMPT + 21; a_k[0] = 8.446; a_k[1] = 5.961; a_k[2] = 3.483; a_k[3] = 1.014; a_k[4] = -1.440; a_k[5] = -3.872; a_k[6] = -6.270; a_k[7] = -8.615; a_k[8] = -10.881; a_k[9] = -13.030; a_k[10] = -15.010; a_k[11] = -16.766; a_k[12] = -18.252; a_k[13] = -19.447; a_k[14] = -20.363; a_k[15] = -21.037; a_k[16] = -21.516; a_k[17] = -21.850; a_k[18] = -22.079; a_k[19] = -22.235; a_k[20] = -22.341;
