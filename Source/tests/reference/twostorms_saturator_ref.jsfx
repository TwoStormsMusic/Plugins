  d_nb > 5 ? (
    ty = cx4a0_0 * bl0 + zal04_0_1; zal04_0_1 = cx4a0_1 * bl0 - cx4a0_3 * ty + zal04_0_2; zal04_0_2 = cx4a0_2 * bl0 - cx4a0_4 * ty; bl0 = ty;
    d_slope == 2 ? (ty = cx4a1_0 * bl0 + zal04_1_1; zal04_1_1 = cx4a1_1 * bl0 - cx4a1_3 * ty + zal04_1_2; zal04_1_2 = cx4a1_2 * bl0 - cx4a1_4 * ty; bl0 = ty;
);
    ty = cx4a0_0 * bl1 + zal14_0_1; zal14_0_1 = cx4a0_1 * bl1 - cx4a0_3 * ty + zal14_0_2; zal14_0_2 = cx4a0_2 * bl1 - cx4a0_4 * ty; bl1 = ty;
    d_slope == 2 ? (ty = cx4a1_0 * bl1 + zal14_1_1; zal14_1_1 = cx4a1_1 * bl1 - cx4a1_3 * ty + zal14_1_2; zal14_1_2 = cx4a1_2 * bl1 - cx4a1_4 * ty; bl1 = ty;
);
    ty = cx4a0_0 * bl2 + zal24_0_1; zal24_0_1 = cx4a0_1 * bl2 - cx4a0_3 * ty + zal24_0_2; zal24_0_2 = cx4a0_2 * bl2 - cx4a0_4 * ty; bl2 = ty;
    d_slope == 2 ? (ty = cx4a1_0 * bl2 + zal24_1_1; zal24_1_1 = cx4a1_1 * bl2 - cx4a1_3 * ty + zal24_1_2; zal24_1_2 = cx4a1_2 * bl2 - cx4a1_4 * ty; bl2 = ty;
);
    ty = cx4a0_0 * bl3 + zal34_0_1; zal34_0_1 = cx4a0_1 * bl3 - cx4a0_3 * ty + zal34_0_2; zal34_0_2 = cx4a0_2 * bl3 - cx4a0_4 * ty; bl3 = ty;
    d_slope == 2 ? (ty = cx4a1_0 * bl3 + zal34_1_1; zal34_1_1 = cx4a1_1 * bl3 - cx4a1_3 * ty + zal34_1_2; zal34_1_2 = cx4a1_2 * bl3 - cx4a1_4 * ty; bl3 = ty;
);
    ty = cx4a0_0 * br0 + zar04_0_1; zar04_0_1 = cx4a0_1 * br0 - cx4a0_3 * ty + zar04_0_2; zar04_0_2 = cx4a0_2 * br0 - cx4a0_4 * ty; br0 = ty;
    d_slope == 2 ? (ty = cx4a1_0 * br0 + zar04_1_1; zar04_1_1 = cx4a1_1 * br0 - cx4a1_3 * ty + zar04_1_2; zar04_1_2 = cx4a1_2 * br0 - cx4a1_4 * ty; br0 = ty;
);
    ty = cx4a0_0 * br1 + zar14_0_1; zar14_0_1 = cx4a0_1 * br1 - cx4a0_3 * ty + zar14_0_2; zar14_0_2 = cx4a0_2 * br1 - cx4a0_4 * ty; br1 = ty;
    d_slope == 2 ? (ty = cx4a1_0 * br1 + zar14_1_1; zar14_1_1 = cx4a1_1 * br1 - cx4a1_3 * ty + zar14_1_2; zar14_1_2 = cx4a1_2 * br1 - cx4a1_4 * ty; br1 = ty;
);
    ty = cx4a0_0 * br2 + zar24_0_1; zar24_0_1 = cx4a0_1 * br2 - cx4a0_3 * ty + zar24_0_2; zar24_0_2 = cx4a0_2 * br2 - cx4a0_4 * ty; br2 = ty;
    d_slope == 2 ? (ty = cx4a1_0 * br2 + zar24_1_1; zar24_1_1 = cx4a1_1 * br2 - cx4a1_3 * ty + zar24_1_2; zar24_1_2 = cx4a1_2 * br2 - cx4a1_4 * ty; br2 = ty;
);
    ty = cx4a0_0 * br3 + zar34_0_1; zar34_0_1 = cx4a0_1 * br3 - cx4a0_3 * ty + zar34_0_2; zar34_0_2 = cx4a0_2 * br3 - cx4a0_4 * ty; br3 = ty;
    d_slope == 2 ? (ty = cx4a1_0 * br3 + zar34_1_1; zar34_1_1 = cx4a1_1 * br3 - cx4a1_3 * ty + zar34_1_2; zar34_1_2 = cx4a1_2 * br3 - cx4a1_4 * ty; br3 = ty;
);
  );
  BSG[0] = bl0;
  BSG[1] = bl1;
  BSG[2] = bl2;
  BSG[3] = bl3;
  BSG[4] = bl4;
  BSG[5] = bl5;
  BSG[8] = br0;
  BSG[9] = br1;
  BSG[10] = br2;
  BSG[11] = br3;
  BSG[12] = br4;
  BSG[13] = br5;
);


// ---- the crossovers: Linkwitz-Riley 12 / 24 / 48 dB per octave, each with its all-pass for the bands below ----
QX = alloc(4); QX[0] = 0.5411961; QX[1] = 1.306563; QX[2] = 0.5411961; QX[3] = 1.306563;
// crossover j at f: LP sections at XC + j * 40, HP at + 20, the all-pass at XA + j * 10
function d_xdes(j, f, slope) local(w, t, a1, i, n, q, cw, al, a0, lp, hp, ap)
(
  w = 2 * $pi * min(f, srate * 0.45) / srate;
  lp = XC + j * 40; hp = lp + 20; ap = XA + j * 10;
  slope == 0 ? (
    t = tan(w * 0.5); a1 = (t - 1) / (t + 1);
    i = 0;
    loop(2,
      lp[i * 5] = t / (1 + t); lp[i * 5 + 1] = lp[i * 5]; lp[i * 5 + 2] = 0; lp[i * 5 + 3] = a1; lp[i * 5 + 4] = 0;
      hp[i * 5] = 1 / (1 + t); hp[i * 5 + 1] = -hp[i * 5]; hp[i * 5 + 2] = 0; hp[i * 5 + 3] = a1; hp[i * 5 + 4] = 0;
      i += 1;
    );
    ap[0] = a1; ap[1] = 1; ap[2] = 0; ap[3] = a1; ap[4] = 0;
  ) : (
    n = slope == 1 ? 2 : 4;
    cw = cos(w); i = 0;
    loop(n,
      q = slope == 1 ? 0.7071068 : QX[i];
      al = sin(w) / (2 * q); a0 = 1 + al;
      lp[i * 5] = (1 - cw) * 0.5 / a0; lp[i * 5 + 1] = (1 - cw) / a0; lp[i * 5 + 2] = lp[i * 5]; lp[i * 5 + 3] = -2 * cw / a0; lp[i * 5 + 4] = (1 - al) / a0;
      hp[i * 5] = (1 + cw) * 0.5 / a0; hp[i * 5 + 1] = -(1 + cw) / a0; hp[i * 5 + 2] = hp[i * 5]; hp[i * 5 + 3] = lp[i * 5 + 3]; hp[i * 5 + 4] = lp[i * 5 + 4];
      i += 1;
    );
    n = slope == 1 ? 1 : 2; i = 0;
    loop(n,
      q = slope == 1 ? 0.7071068 : QX[i];
      al = sin(w) / (2 * q); a0 = 1 + al;
      ap[i * 5] = (1 - al) / a0; ap[i * 5 + 1] = -2 * cw / a0; ap[i * 5 + 2] = 1; ap[i * 5 + 3] = ap[i * 5 + 1]; ap[i * 5 + 4] = ap[i * 5];
      i += 1;
    );
  );
  d_xpub(j);
);
// ---- stateful styles: rate-dependent constants (the shaper runs at srate * oversampling) ----
CCH = alloc(16); CBS = alloc(16);
function d_k(f, r) ( 1 - exp(-2 * $pi * f / r); );
function d_kf(c, osf) ( 1 - exp(log(1 - c) / osf); );
function d_rates() local(r)
(
  r = srate * d_osf;
  CCH[0] = d_k(120, r); CCH[1] = d_k(r, r); CCH[2] = d_k(5, r); CCH[3] = d_k(80, r); CCH[4] = d_kf(0.512, d_osf); CCH[5] = d_k(320, r); CCH[6] = d_k(20000, r);
  CBS[0] = d_k(220, r); CBS[1] = d_k(r, r); CBS[2] = d_k(5, r); CBS[3] = d_k(100, r); CBS[4] = d_kf(0.513, d_osf); CBS[5] = d_k(320, r); CBS[6] = d_k(20000, r); CBS[7] = d_k(8, r);
  TH_K2 = 2 * sin(3680 * $pi / r); TH_K3 = -1.4 * TH_K2; TH_K1 = 5 / 7;
  TH_G3 = -10 ^ ((r < 88200 ? 1.4 : 2.0) * 3 / 20) * TH_K1;
  SM_L = 0.16 / d_osf; BD_K = 0.002 / d_osf;
);
function d_ss(x) ( x < -1 ? -1 : (x > 1 ? 1 : x * 1.5 - x * x * x * 0.5); );

// one sample of style st at the shaper's rate; sz = this band and channel's shaper state (16 numbers)
function d_shape(st, u, sz) local(y, c, x1, x2, x3, x4, x5, x6, lo3, hi3, x7, x8, pos, hold, q)
(
  st == 8 ? (
    x1 = max(-1, min(1, u));
    sz[0] += sz[1] * TH_K2;
    sz[2] = sz[0] * TH_K1 + sz[1] - x1;
    sz[1] += sz[2] * TH_K3;
    y = max(-1, min(1, (max(-1, min(1, sz[2])) * TH_G3 + d_ss(sz[0] * 1.516) + d_ss(sz[1] * 1.516)) * 0.4956));
  ) : (st == 17 ? (
    // console channel (JClones SatChannel): feedback network around a rational saturator
    x1 = 2.6 * ds_th(u / 2.6) * 0.3981;
    x2 = (sz[0] += (x1 * 0.4 - sz[0]) * CCH[0]) + 1.4142135622 - (sz[1] += (0.0002135622 - sz[1]) * CCH[1]);
    x3 = x2 * x2 * 0.5 - 1;
    x4 = (0.735 * x3 - sz[0]) * 5.8 + x1;
    lo3 = (sz[2] += ((sz[8] - sz[9]) - sz[2]) * CCH[2]); hi3 = (sz[8] - sz[9]) - lo3;
    x5 = x4 - 0.01 - hi3 * 0.15 - lo3 * 0.410706;
    x6 = x5 - sz[7] * 0.4 - sz[9] * 0.6 + 1.3 * (sz[3] += (hi3 - sz[3]) * CCH[3]);
    sz[8] = x6;
    sz[9] = (sz[4] += ((hi3 * 0.09 + ds_th(x6) + 0.008) - sz[4]) * CCH[4]);
    sz[5] += (sz[9] - sz[5]) * CCH[5];
    sz[7] = (sz[6] += ((sz[9] - sz[5]) - sz[6]) * CCH[6]);
    y = (0.34 * sz[7] + sz[9]) * 1.9;
  ) : (st == 18 ? (
    // console buss (JClones SatBuss, no crosstalk): even harmonics from a squarer, a filtered feedback network
    x3 = 2.6 * ds_th(u / 2.6) * 0.3981;
    x4 = (sz[0] += (x3 * 0.45 - sz[0]) * CBS[0]) + 1.4142135622 - (sz[1] += (0.0002135622 - sz[1]) * CBS[1]);
    x5 = x4 * x4 * 0.5 - 1;
    x6 = (0.74 * x5 - sz[0]) * 5.8 + x3;
    hi3 = (sz[8] - sz[9]) - (sz[2] += ((sz[8] - sz[9]) - sz[2]) * CBS[2]);
    x7 = x6 - 0.01 - 0.2 * hi3 - 0.411795 * sz[2] - 0.4 * sz[10] - 0.6 * sz[9] + 0.26 * (sz[3] += (hi3 - sz[3]) * CBS[3]);
    sz[8] = x7;
    sz[4] += ((0.18 * hi3 + ds_th(x7) + 0.008) - sz[4]) * CBS[4];
    sz[5] += (sz[4] - sz[5]) * CBS[5];
    sz[9] = sz[4];
    sz[10] = (sz[6] += ((sz[4] - sz[5]) - sz[6]) * CBS[6]);
    x8 = (0.34 * sz[10] + sz[9]) * 3.9;
    sz[7] += (x8 - sz[7]) * CBS[7];
    y = (x8 - sz[7]) * 0.5;
  ) : (st == 22 ? (
    // smudge: the shaped signal can only move so fast, then is smoothed again
    c = ds_th(u);
    sz[0] += max(-SM_L, min(SM_L, c - sz[0]));
    sz[1] += (sz[0] - sz[1]) * 0.6;
    y = sz[1];
  ) : (st == 23 ? (
    // breakdown: the distorted signal plus a square sub octave that follows its level
    c = ds_th(u);
    pos = u > 0.02 ? 1 : (u < -0.02 ? 0 : sz[1]);
    (pos && !sz[1]) ? sz[0] = -sz[0];
    sz[1] = pos;
    sz[2] += (abs(c) - sz[2]) * BD_K * 10;
    y = 0.55 * c + 0.65 * sz[0] * sz[2];
  ) : (st == 27 ? (
    // destroy: fewer bits and a lower sample rate as the drive goes up
    sz[0] -= 1;
    sz[0] <= 0 ? (
      hold = 1 + floor(d_cdp / 12.5);
      q = 2 ^ (13 - 0.1 * d_cdp);
      sz[0] = hold;
      sz[1] = floor(max(-1, min(1, u)) * q + 0.5) / q;
    );
    y = sz[1];
  ) : (
    y = ds_core(st, u);
  ))))));
  y;
);

// a band's style filters and tone: rebuild what changed
function d_filt(b) local(st, o, p, n, i, t, f, g, q, k, tn, ch)
(
  st = BST[b]; o = STYT + st * 24; p = PCO + b * 60;
  // style pre (filters 1, 2) and post (3, 4)
  n = 0; i = 0;
  loop(2, t = o[1 + i * 4]; t >= 0 ? n += ea_coef(t, o[2 + i * 4], o[3 + i * 4], o[4 + i * 4], 0, p + n * 5); i += 1;);
  PNS[b] = n;
  n = 0; i = 2;
  loop(2, t = o[1 + i * 4]; t >= 0 ? n += ea_coef(t, o[2 + i * 4], o[3 + i * 4], o[4 + i * 4], 0, p + 20 + n * 5); i += 1;);
  QNS[b] = n;
  // tone: bass, mid, treble, presence (a slot with no gain does nothing)
  k = 0;
  loop(4,
    g = EFFP[ep(b, K_BASS + k)];
    tn = k == 0 ? ea_coef(1, 150, g, 0.7, 0, p + 40) : (k == 1 ? ea_coef(0, 900, g, 0.7, 0, p + 45) : (k == 2 ? ea_coef(2, 4000, g, 0.7, 0, p + 50) : ea_coef(0, 9000, g, 0.8, 0, p + 55)));
    TON[b * 4 + k] = tn > 0;
    k += 1;
  );
);


// ---- one band, one channel: pre filters, drive (with feedback), the shaper at the oversampled rate, DC, feedback tap, post filters, tone, level ----
function d_chan(b, c, x) local(z, u, y, st, os, fb, n, k, p, sz, v1, v2, v3, a0, a1, r0, r1, y0, y1)
(
  z = BSZ + (b * 2 + c) * BSTR; p = PCO + b * 60;
  n = PNS[b]; n > 0 ? x = d_chain(x, p, n, z + ZPRE);
  u = x * DGc[b * 2 + c] * GDc[b];
  fb = FBc[b]; fb > 0 ? u += fb * z[ZFB + 2];
  st = BST[b]; os = BOS[b]; sz = z + ZSH; d_cdp = DRVP[b * 2 + c];
  os == 1 ? (
    y = d_shape(st, u, sz);
  ) : (os == 2 ? (
    d_ups3(u, z + ZUA, OSA, UPO);
    y0 = d_shape(st, UPO[0], sz); y1 = d_shape(st, UPO[1], sz);
    y = d_dns3(y0, y1, z + ZDA, OSA);
  ) : (
    d_ups3(u, z + ZUA, OSA, UPO); a0 = UPO[0]; a1 = UPO[1];
    d_ups2(a0, z + ZUB, OSB, UPO);
    y0 = d_shape(st, UPO[0], sz); y1 = d_shape(st, UPO[1], sz); r0 = d_dns2(y0, y1, z + ZDB, OSB);
    d_ups2(a1, z + ZUB, OSB, UPO);
    y0 = d_shape(st, UPO[0], sz); y1 = d_shape(st, UPO[1], sz); r1 = d_dns2(y0, y1, z + ZDB, OSB);
    y = d_dns3(r0, r1, z + ZDA, OSA);
  ));
  // DC
  v1 = y; y = y - z[ZDC] + DC_R * z[ZDC + 1]; z[ZDC] = v1; z[ZDC + 1] = y;
  // the feedback tap: a band pass at the feedback frequency (always running, so it is warm when the feedback comes in)
  FBON[b] ? (
    k = b * 4;
    v3 = y - z[ZFB + 1]; v1 = FBK[k] * z[ZFB] + FBK[k + 1] * v3; v2 = z[ZFB + 1] + FBK[k + 1] * z[ZFB] + FBK[k + 2] * v3;
    z[ZFB] = 2 * v1 - z[ZFB]; z[ZFB + 1] = 2 * v2 - z[ZFB + 1]; z[ZFB + 2] = v1 * FBK[k + 3];
  );
  n = QNS[b]; n > 0 ? y = d_chain(y, p + 20, n, z + ZPOST);
  k = b * 4;
  TON[k] ? y = d_bq(y, p + 40, z + ZTONE);
  TON[k + 1] ? y = d_bq(y, p + 45, z + ZTONE + 2);
  TON[k + 2] ? y = d_bq(y, p + 50, z + ZTONE + 4);
  TON[k + 3] ? y = d_bq(y, p + 55, z + ZTONE + 6);
  y * PGc[b * 2 + c];
);

// one band: the dry (late by the oversampling delay), the wet, their mix; added to d_o0 / d_o1
function d_band(b) local(l, r, x1a, x1b, wa, wb, wl, wr, dl, dr, e, og, di, fr, p, q, k)
(
  l = BSG[b]; r = BSG[8 + b];
  k = b * 2;
  DGc[k] += DGi[k]; DGc[k + 1] += DGi[k + 1]; PGc[k] += PGi[k]; PGc[k + 1] += PGi[k + 1];
  MXc[b] += MXi[b]; GDc[b] += GDi[b]; FBc[b] += FBi[b];
  OGc[b] += (OGt[b] - OGc[b]) * 0.004;
  e = max(abs(l), abs(r)); EF[b] += (e > EF[b] ? D_KAE : D_KRE) * (e - EF[b]);
  og = OGc[b];
  (og > 0.0001 || OGt[b] > 0) ? (
    // the dry, late by d_dd
    di = floor(d_dd); fr = d_dd - di;
    p = DDL + k * 16; q = p + 16;
    p[d_dp & 15] = l; q[d_dp & 15] = r;
    fr == 0 ? (dl = p[(d_dp - di) & 15]; dr = q[(d_dp - di) & 15];) : (
      dl = p[(d_dp - di) & 15] * (1 - fr) + p[(d_dp - di - 1) & 15] * fr;
      dr = q[(d_dp - di) & 15] * (1 - fr) + q[(d_dp - di - 1) & 15] * fr;
    );
    BON[b] ? (
      BMS[b] ? (x1a = (l + r) * 0.5; x1b = (l - r) * 0.5;) : (x1a = l; x1b = r;);
      wa = d_chan(b, 0, x1a); wb = d_chan(b, 1, x1b);
      BMS[b] ? (wl = wa + wb; wr = wa - wb;) : (wl = wa; wr = wb;);
      l = dl + MXc[b] * (wl - dl); r = dr + MXc[b] * (wr - dr);
    ) : (l = dl; r = dr;);
    l *= og; r *= og;
    c_uion ? (e = max(abs(l), abs(r)); EO[b] += (e > EO[b] ? D_KAE : D_KRE) * (e - EO[b]););
    (d_slope == 0 && (b & 1)) ? (d_o0 -= l; d_o1 -= r;) : (d_o0 += l; d_o1 += r;);
  ) : (EO[b] = 0;);
);

// ---- modulation ----
SYNB = alloc(16); SYNB[1] = 0.125; SYNB[2] = 0.25; SYNB[3] = 0.5; SYNB[4] = 1; SYNB[5] = 2; SYNB[6] = 4; SYNB[7] = 8; SYNB[8] = 16;
SYNB[9] = 1 / 6; SYNB[10] = 1 / 3; SYNB[11] = 2 / 3; SYNB[12] = 0.75;
MTP = alloc(12); MTP[0] = K_DRIVE; MTP[1] = K_MIX; MTP[2] = K_LEVEL; MTP[3] = K_DYN; MTP[4] = K_FB; MTP[5] = K_FBF;
MTP[6] = K_BASS; MTP[7] = K_MID; MTP[8] = K_TRE; MTP[9] = K_PRES; MTP[10] = K_DPAN; MTP[11] = K_LPAN;
MTS = alloc(12); MTS[0] = 100; MTS[1] = 100; MTS[2] = 24; MTS[3] = 100; MTS[4] = 100; MTS[5] = 5; MTS[6] = 12; MTS[7] = 12; MTS[8] = 12; MTS[9] = 12; MTS[10] = 100; MTS[11] = 100;
function d_clamp(v, lo, hi) ( v < lo ? lo : (v > hi ? hi : v); );
// slot s's value for this tick: -1..1 (LFO) or 0..1 (follower, MIDI)
function d_mval(s) local(ty, ph, o, v, cyc, sh, ph2, t, r, rt)
(
  ty = floor(c_pv(mp(s, M_TYPE)) + 0.5);
  v = 0;
  ty == 1 ? (
    sh = floor(c_pv(mp(s, M_OPT)) + 0.5) % 6;
    o = floor(c_pv(mp(s, M_SYNC)) + 0.5);
    o > 0 ? (
      cyc = SYNB[o];
      ph = d_beat / cyc; ph -= floor(ph);
    ) : (
      MPH[s] += c_pv(mp(s, M_RATE)) * 16 / srate; MPH[s] -= floor(MPH[s]); ph = MPH[s];
    );
    sh == 0 ? v = sin(2 * $pi * ph);
    sh == 1 ? v = ph < 0.25 ? 4 * ph : (ph < 0.75 ? 2 - 4 * ph : 4 * ph - 4);
    sh == 2 ? v = 2 * ph - 1;
    sh == 3 ? v = 1 - 2 * ph;
    sh == 4 ? (MLS[s] += ((ph < 0.5 ? 1 : -1) - MLS[s]) * 0.5; v = MLS[s];);
    sh == 5 ? (
      ph < MRB[s] ? (MRA[s] = MEN[s]; MEN[s] = rand(2) - 1;);
      MRB[s] = ph;
      t = 0.5 - 0.5 * cos($pi * ph); v = MRA[s] + (MEN[s] - MRA[s]) * t;
    );
  );
  ty == 2 ? (
    o = floor(c_pv(mp(s, M_OPT)) + 0.5); rt = 24 * (1 + floor(o / 4) % 3);
    v = d_clamp((20 * log10(MEN[s] + 0.000001) + rt) / rt, 0, 1);
  );
  ty == 3 ? (
    o = floor(c_pv(mp(s, M_OPT)) + 0.5);
    v = o < 128 ? MCC[o] : (o == 128 ? d_nvel : (d_pb + 1) * 0.5);
  );
  v;
);
function d_modeval() local(s, ty, tb, tp, amt, v, p, b, b0, b1, sp)
(
  s = 0; d_nf = 0;
  loop(NMOD,
    ty = floor(c_pv(mp(s, M_TYPE)) + 0.5);
    ty > 0 ? (
      ty == 2 ? (
        MKA[s] = 1 - exp(-1 / (max(0.05, c_pv(mp(s, M_RATE))) * 0.001 * srate));
        MKR[s] = 1 - exp(-1 / (max(0.5, c_pv(mp(s, M_RATE2))) * 0.001 * srate));
        MSR[s] = floor(c_pv(mp(s, M_OPT)) + 0.5) % 4;
        MSB[s] = max(0, min(NB - 1, (c_pv(mp(s, M_TBAND)) >= 1 && c_pv(mp(s, M_TBAND)) <= 6) ? floor(c_pv(mp(s, M_TBAND)) + 0.5) - 1 : 0));
        MFL[d_nf] = s; d_nf += 1;
      );
      v = d_mval(s); MV[s] = v;
      tb = floor(c_pv(mp(s, M_TBAND)) + 0.5); tp = floor(c_pv(mp(s, M_TPAR)) + 0.5);
      amt = c_pv(mp(s, M_AMT)) * 0.01 * v;
      tb == 0 ? (
        tp = min(tp, 3);
        p = tp == 0 ? P_GDRV : (tp == 1 ? P_MIX : (tp == 2 ? P_IN : P_GDYN));
        sp = tp == 2 ? 12 : 100;
        EFFP[p] = d_clamp(EFFP[p] + amt * sp, PLO[p], PHI[p]);
      ) : (
        b0 = tb == 7 ? 0 : tb - 1; b1 = tb == 7 ? d_nb - 1 : tb - 1;
        b = b0;
        loop(b1 - b0 + 1,
          p = ep(b, MTP[tp]);
          tp == 5 ? EFFP[p] = d_clamp(EFFP[p] * 2 ^ (amt * 5), PLO[p], PHI[p]) :
                    EFFP[p] = d_clamp(EFFP[p] + amt * MTS[tp], PLO[p], PHI[p]);
          b += 1;
        );
      );
    ) : (MV[s] = 0;);
    s += 1;
  );
);

// ---- everything that changes slowly, every 16 samples: settings -> gains, filters, crossovers ----
function d_cmp(st, d) local(i, f, o)
(
  i = min(19, floor(d / 5)); f = d / 5 - i; o = CMPT + st * 21 + i;
  o[0] + (o[1] - o[0]) * f;
);
function d_bprep(b) local(on, mute, st, d, dl, dr, mix, lv, lvdb, dpan, lpan, gdr, gdl, c, k, tg, chg, f, g, gate, dy, dv, lvs, lvf, gdd, fb, a1, a2, a3, kk, ge)
(
  k = b * EBN + EB0;
  on = EFFP[k + K_ON] >= 0.5; mute = EFFP[k + K_MUTE] >= 0.5;
  st = d_clamp(floor(EFFP[k + K_STYLE] + 0.5), 0, NSTY - 1);
  // a new style: clear this band's states, rebuild its filters
  (st !== BST[b] || d_snap) ? (
    BST[b] = st; memset(BSZ + b * 2 * BSTR, 0, 2 * BSTR);
    BSZ[b * 2 * BSTR + ZSH] = 1; BSZ[b * 2 * BSTR + BSTR + ZSH] = 1;
    BOS[b] = STYF[st] ? 1 : d_osf;
    TCH[b * 8 + 7] = 1;
  );
  c = 0;
  loop(4, EFFP[k + K_BASS + c] !== TCH[b * 8 + c] ? (TCH[b * 8 + c] = EFFP[k + K_BASS + c]; TCH[b * 8 + 7] = 1;); c += 1;);
  TCH[b * 8 + 7] ? (d_filt(b); TCH[b * 8 + 7] = 0;);
  BON[b] = on; BMS[b] = EFFP[k + K_CH] >= 0.5;
  OGt[b] = (mute || (c_uisolo >= 0 && c_uiok && c_uisolo !== b)) ? 0 : 1;
  d = d_clamp(EFFP[k + K_DRIVE] + EFFP[P_GDRV], 0, 100);
  mix = d_clamp(EFFP[k + K_MIX], 0, 100) * 0.0001 * d_clamp(EFFP[P_MIX], 0, 100);
  lvdb = EFFP[k + K_LEVEL]; lv = lvdb <= -59.9 ? 0 : 10 ^ (lvdb / 20);
  dpan = EFFP[k + K_DPAN] * 0.01; lpan = EFFP[k + K_LPAN] * 0.01;
  c = 0;
  loop(2,
    dv = d * (c == 0 ? 1 - max(0, dpan) : 1 - max(0, -dpan));
    DRVP[b * 2 + c] = dv;
    tg = 10 ^ ((-6 + 0.5 * dv + STYT[st * 24]) / 20);
    DGi[b * 2 + c] = (tg - DGc[b * 2 + c]) / 16;
    tg = (s_nocomp ? 1 : 10 ^ (d_cmp(st, dv) / 20)) * lv * (c == 0 ? 1 - max(0, lpan) : 1 - max(0, -lpan));
    PGi[b * 2 + c] = (tg - PGc[b * 2 + c]) / 16;
    c += 1;
  );
  MXi[b] = (mix - MXc[b]) / 16;
  // the band's level (fast, and a slow average of it) -> dynamics
  lvf = EF[b]; ES[b] += (lvf - ES[b]) * D_KS;
  lvs = 20 * log10(ES[b] + 0.000000001);
  dy = d_clamp(EFFP[k + K_DYN] + EFFP[P_GDYN], -100, 100) * 0.01;
  gdd = 0;
  (dy != 0 && lvs > -70) ? (
    dv = d_clamp(20 * log10(lvf + 0.000000001) - lvs, -24, 24);
    dy > 0 ? (gdd = d_clamp(-dy * 0.8 * dv, -18, 9);) : (gdd = d_clamp(dv < 0 ? -dy * 1.6 * dv : -dy * 0.3 * dv, -40, 6););
  );
  GDB[b] = gdd;
  GDi[b] = (10 ^ (gdd / 20) - GDc[b]) / 16;
  // feedback: how much (only while there is signal), and the band pass's frequency
  fb = d_clamp(EFFP[k + K_FB], 0, 100) * 0.011;
  gate = min(1, lvf * 3000);
  FBi[b] = (fb * gate - FBc[b]) / 16;
  // the band pass runs while there is feedback; when it stops, its state is cleared for the next time
  FBON[b] = fb > 0 || FBc[b] > 0.0000001;
  !FBON[b] ? (a1 = BSZ + b * 2 * BSTR; a1[ZFB] = 0; a1[ZFB + 1] = 0; a1[ZFB + 2] = 0; a1 += BSTR; a1[ZFB] = 0; a1[ZFB + 1] = 0; a1[ZFB + 2] = 0;);
  f = EFFP[k + K_FBF];
  (f !== TCH[b * 8 + 4] || d_snap) ? (
    TCH[b * 8 + 4] = f;
    g = tan($pi * min(f, srate * 0.45) / srate); kk = 1 / 3;
    a1 = 1 / (1 + g * (g + kk)); a2 = g * a1; a3 = g * a2;
    FBK[b * 4] = a1; FBK[b * 4 + 1] = a2; FBK[b * 4 + 2] = a3; FBK[b * 4 + 3] = kk;
  );
  // the first time (or after a restart): start at the targets
  d_snap ? (
    c = 0;
    loop(2, DGc[b * 2 + c] += DGi[b * 2 + c] * 16; DGi[b * 2 + c] = 0; PGc[b * 2 + c] += PGi[b * 2 + c] * 16; PGi[b * 2 + c] = 0; c += 1;);
    MXc[b] += MXi[b] * 16; MXi[b] = 0; GDc[b] += GDi[b] * 16; GDi[b] = 0; FBc[b] += FBi[b] * 16; FBi[b] = 0; OGc[b] = OGt[b];
  );
);
function d_tick() local(i, b, f, pf, ch)
(
  // the settings (this set, or the other while Swap is held), then the modulation on top
  i = 0; loop(EB0 + NB * EBN, EFFP[i] = c_pv(i); i += 1;);
  i = MB0; loop(NMOD * MN, EFFP[i] = c_pv(i); i += 1;);
  d_beat += 16 * d_tempo / (60 * srate);
  d_modeval();
  // crossovers: sorted, at least a quarter octave apart, gliding
  pf = 20; i = 0;
  loop(d_nb - 1,
    f = d_clamp(EFFP[P_XF + i], 20, min(20000, srate * 0.45));
    f = max(f, pf * 1.19); pf = f;
    XFt[i] = f;
    (d_snap || XFc[i] <= 0) ? XFc[i] = f : XFc[i] += (f - XFc[i]) * 0.35;
    (d_snap || abs(XFc[i] - XFd[i]) > 0.0004 * XFc[i]) ? (d_xdes(i, XFc[i], d_slope); XFd[i] = XFc[i];);
    i += 1;
  );
  b = 0; loop(d_nb, d_bprep(b); b += 1;);
  d_snap = 0;
);

function fmt_hz(dst, v) ( v >= 10000 ? sprintf(dst, "%.1fk", v / 1000) : (v >= 1000 ? sprintf(dst, "%.2fk", v / 1000) : sprintf(dst, "%.0f Hz", v)); );
// a value for a saturator control, as the box shows it
function cfmt(dst, p, v) local(k, m)
(
  k = (p >= EB0 && p < EB0 + NB * EBN) ? (p - EB0) % EBN : -1;
  m = (p >= MB0 && p < MB0 + NMOD * MN) ? (p - MB0) % MN : -1;
  (p == P_IN || k == K_BASS || k == K_MID || k == K_TRE || k == K_PRES) ? sprintf(dst, "%+.1f dB", v) : (
  (p == P_GDRV || p == P_GDYN || k == K_DPAN || k == K_LPAN || m == M_AMT) ? sprintf(dst, "%+.0f%%", v) : (
  (p == P_MIX || k == K_DRIVE || k == K_MIX || k == K_FB) ? sprintf(dst, "%.0f%%", v) : (
  k == K_DYN ? (abs(v) < 0.5 ? sprintf(dst, "off") : sprintf(dst, v > 0 ? "comp %.0f%%" : "gate %.0f%%", abs(v))) : (
  k == K_LEVEL ? (v <= -59.9 ? sprintf(dst, "-inf dB") : sprintf(dst, "%+.1f dB", v)) : (
  (k == K_FBF || (p >= P_XF && p < P_XF + 5)) ? fmt_hz(dst, v) : (
  m == M_RATE ? sprintf(dst, v < 10 ? "%.2f" : "%.1f", v) : (
  m == M_RATE2 ? sprintf(dst, v < 1000 ? "%.0f ms" : "%.2f s", v < 1000 ? v : v / 1000) : (
  sprintf(dst, "%.2f", v)
  ))))))));
);
// a bar for parameter p: filled from the left, on a log scale if lg
function cbar(x, y, w, h, p, lg, enabled) local(v, f, k)
(
  k = g_key(-1, p); v = slider(p);
  f = lg ? log(max(PLO[p], v) / PLO[p]) / log(PHI[p] / PLO[p]) : (v - PLO[p]) / (PHI[p] - PLO[p]);
  f = max(0, min(1, f));
  c_well(); rect(x, y, w, h, 1);
  enabled ? setc(0.92, 0.49, 0.07) : setc(0.20, 0.19, 0.18);
  rect(x, y + 3, max(1 / g_sc, w * f), h - 6, 1);
  enabled ? setc(1.0, 0.95, 0.88) : c_faint();
  rect(x + w * f - 1.5, y + 1, 3, h - 2, 1);
  c_border(); rect(x, y, w, h, 0);
  g_bm = lg ? 3 : 2; g_bw = w; g_blo = PLO[p]; g_bhi = PHI[p];
  enabled ? ctl_input(k, x, y, w, h, lg ? log(PHI[p] / PLO[p]) / w : (PHI[p] - PLO[p]) / w,
                      lg ? log(PHI[p] / PLO[p]) / w / 10 : (PHI[p] - PLO[p]) / w / 10, lg ? 5 : 6);
  g_bm = 0;
);

// label, bar and value box for parameter p (286 wide)
function cctl(lbl, x, y, p, lg, enabled)
(
  label(lbl, x, y - 1, 64);
  cbar(x + 66, y, 138, 20, p, lg, enabled);
  cfmt(#g_cv, p, slider(p));
  valbox(x + 208, y, 76, 20, g_key(-1, p), lg ? log(PHI[p] / PLO[p]) / 138 : (PHI[p] - PLO[p]) / 138,
         lg ? log(PHI[p] / PLO[p]) / 1380 : (PHI[p] - PLO[p]) / 1380, lg ? 5 : 6, #g_cv, enabled);
);

// an on/off button for parameter p
function ctog(x, y, w, lbl, p, style) local(on)
(
  on = slider(p) >= 0.5;
  button(x, y, w, 20, lbl, on, 1, style) ? g_kset(g_key(-1, p), !on, 1);
);

// like ctog, but Shift + click and hold only flips it for as long as the mouse is held
function mtog(x, y, w, lbl, p, style) local(on, k)
(
  on = slider(p) >= 0.5; k = g_key(-1, p);
  button(x, y, w, 20, lbl, on, 1, style) ? (
    (g_cap & 8) ? (g_mom_k = k; g_mom_prev = on;);
    g_kset(k, !on, 1);
  );
);

// a vertical meter: level db, filled from the bottom (the Act's meter range and colors)
function vmeter(x, y, w, h, db, active) local(f, fz1, fz2)
(
  setc(0.09, 0.10, 0.11); rect(x, y, w, h, 1);
  active ? (
    f = mfrac(db); fz1 = mfrac(-12); fz2 = mfrac(-3);
    setc(0.18, 0.62, 0.33); rect(x + 1, y + h * (1 - min(f, fz1)), w - 2, h * min(f, fz1), 1);
    f > fz1 ? (setc(0.80, 0.66, 0.18); rect(x + 1, y + h * (1 - min(f, fz2)), w - 2, h * (min(f, fz2) - fz1), 1););
    f > fz2 ? (setc(0.86, 0.25, 0.22); rect(x + 1, y + h * (1 - f), w - 2, h * (f - fz2), 1););
  );
  setc(0.30, 0.33, 0.38); rect(x, y, w, h, 0);
);

// A/B: swap the sliders with the stored set; copy this set into the other one

// the analyzer: the newest n samples of src, windowed, into dB per bin in dst (falling slowly)
function an_fft(src, dst, n) local(i, p0, m, db, k)
(
  p0 = (c_ap - n) & 8191;
  i = 0;
  loop(n, FFA[i] = src[(p0 + i) & 8191] * (0.5 - 0.5 * cos(2 * $pi * i / n)); i += 1;);
  fft_real(FFA, n); fft_permute(FFA, n / 2);
  k = min(1, g_dt * 5);
  i = 1;
  loop(n / 2 - 1,
    m = sqr(FFA[2 * i]) + sqr(FFA[2 * i + 1]);
    db = m > 0 ? 10 * log10(m) - g_annorm : -200;
    dst[i] = db > dst[i] ? db : dst[i] + (db - dst[i]) * k;
    i += 1;
  );
);
// frequency <-> x in the analyzer (20 Hz .. 20 kHz on a log scale)
function an_x(f) ( g_ax + g_aw * log(max(20, f) / 20) / log(1000); );
function an_f(x) ( 20 * 1000 ^ ((x - g_ax) / g_aw); );
// dB -> y in the analyzer, with a 4.5 dB/octave tilt around 1 kHz (so music looks flat)
function an_y(db, f) ( g_ay + g_ah * min(1, max(0, -(db + 4.5 * log(f / 1000) / log(2)) / 90)); );
// draw one spectrum: filled (input) or as a line (output)
function an_draw(spec, n, fill) local(px, px1, f0, f1, bl, bh, b, mx, y, ly, lx)
(
  px = floor(X(g_ax)); px1 = floor(X(g_ax + g_aw)); ly = -1;
  while (px < px1) (
    f0 = an_f((px - g_ox) / g_sc); f1 = an_f((px + 1 - g_ox) / g_sc);
    bl = max(1, floor(f0 * n / srate)); bh = max(bl, min(n / 2 - 1, floor(f1 * n / srate)));
    mx = -200; b = bl; loop(bh - bl + 1, spec[b] > mx ? mx = spec[b]; b += 1;);
    y = Y(an_y(mx, (f0 + f1) * 0.5));
    fill ? gfx_rect(px, y, 1, Y(g_ay + g_ah) - y, 1) : (ly >= 0 ? gfx_line(lx, ly, px, y, 1););
    lx = px; ly = y;
    px += 1;
  );
);
// ---- the static curves (the audio thread and the window each have their own copy) ----
// a fast tanh: slope 1 at 0, exactly +-1 from |x| = 3
function gs_th(x) local(a) ( x > 3 ? 1 : (x < -3 ? -1 : (a = x * x; x * (27 + a) / (27 + 9 * a))); );
// the memoryless part of style st, for an input u already scaled by the drive (about +-1 is "full scale")
function gs_core(st, u) local(y, s, r, p)
(
  y = 0;
  // the style, found in five steps (a binary tree) rather than thirty comparisons
  (st < 15 ? (st < 7 ? (st < 3 ? (st < 1 ? (y = gs_th(u + 0.15) - 0.1489;) : (st < 2 ? (y = gs_th(u + 0.35) - 0.3364;) : (y = gs_th(u + 0.7) - 0.6044;))) : (st < 5 ? (st < 4 ? (y = gs_th(2 * u + 0.9) - 0.7163;) : (y = u > 1 ? 0.6667 : (u < -1 ? -0.6667 : u - u * u * u * 0.33333);)) : (st < 6 ? (y = atan(1.2 * u) * 0.82;) : (y = sin(max(-1.5708, min(1.5708, u)));)))) : (st < 11 ? (st < 9 ? (st < 8 ? ((r = abs(u) / 1.5; p = r * r; p = p * p * r; y = u * exp(-min(p, 30)););) : (y = gs_th(u);)) : (st < 10 ? (y = gs_th(u);) : (y = gs_th(u + 0.1) - 0.0997;))) : (st < 13 ? (st < 12 ? (y = gs_th(u + 0.2) - 0.1974;) : (y = gs_th(1.4 * (gs_th(u + 0.08) - 0.0798)) / 1.4;)) : (st < 14 ? ((s = gs_th(1.5 * u + 0.2) - 0.1974; s *= 2; r = abs(s); y = s / exp(log(1 + r * r * r) / 3););) : (y = gs_th(gs_th(1.8 * u));))))) : (st < 22 ? (st < 18 ? (st < 16 ? ((s = u >= 0 ? (1 - exp(-1.6 * u)) / 1.6 : -(1 - exp(1.1 * u)) / 1.1; y = gs_th(3 * s) / 3;);) : (st < 17 ? (y = gs_th(2.5 * gs_th(2 * (gs_th(2 * u + 0.1) - 0.0997))) / 2.5;) : (y = gs_th(u);))) : (st < 20 ? (st < 19 ? (y = gs_th(u);) : ((s = u + 0.25; y = (s + 0.4 * s * abs(s)) / (1 + 0.8 * abs(s)) - 0.22916667; y = 1.2 * gs_th(y / 1.2););)) : (st < 21 ? ((s = max(-0.5, min(0.5, 0.5 * u)); r = min(1, abs(s) * 0.5 + 0.75); y = 4 * (1 - r * abs(s)) * r * s;);) : (y = gs_th(4 * (u + 0.15)) - gs_th(0.6);)))) : (st < 26 ? (st < 24 ? (st < 23 ? (y = gs_th(u);) : (y = gs_th(u);)) : (st < 25 ? ((s = u - 1; s = s - 4 * floor(s / 4); y = abs(s - 2) - 1;);) : (y = sin(u);))) : (st < 28 ? (st < 27 ? ((r = abs(u); y = 0.6 * gs_th(0.7 * u) + 0.8 * (gs_th(1.3 * r) - 0.35););) : (y = max(-1, min(1, u));)) : (st < 29 ? (y = gs_th(u);) : (y = max(-1, min(1, u));))))));
  y;
);


// ---------- TwoStorms Saturator window: helpers ----------
GXF = alloc(8); GXX = alloc(8); GRX0 = alloc(NB); GRX1 = alloc(NB); GHX = alloc(NB); GHY = alloc(NB);
g_solo_l = -1; g_solo_m = -1; g_xdrag = -1; g_hdrag = -1; c_uisolo = -1; g_nb = 3;

// a band's colour (alpha a)
function band_col(b, a) local(h)
(
  h = b % 8;
  h == 0 ? setc(0.93, 0.50, 0.07) : (h == 1 ? setc(0.66, 0.50, 1.0) : (h == 2 ? setc(0.25, 0.78, 0.78) : (h == 3 ? setc(0.40, 0.82, 0.40) :
  (h == 4 ? setc(0.40, 0.60, 1.0) : (h == 5 ? setc(0.95, 0.45, 0.65) : (h == 6 ? setc(0.92, 0.80, 0.30) : setc(0.85, 0.40, 0.35)))))));
  gfx_a = a;
);

// the window's view of the bands: how many, and where the crossovers are (kept apart as the audio does)
function g_prep() local(i, pf, f)
(
  g_nb = max(1, min(NB, floor(slider(P_NB) + 0.5)));
  pf = 20; i = 0;
  loop(g_nb - 1, f = max(slider(P_XF + i), pf * 1.19); GXF[i] = min(f, 20000); pf = f; i += 1;);
);
function g_selband(b) ( slider(P_SEL) = b; );
function g_lo(b) ( b <= 0 ? 20 : GXF[b - 1]; );
function g_hi(b) ( b >= g_nb - 1 ? 20000 : GXF[b]; );
function g_bandat(f) local(b)
(
  b = 0; loop(g_nb - 1, f >= GXF[b] ? b += 1;);
  b;
);
function g_bcopy(s, d) local(k)
(
  k = 0; loop(EBN, g_kset(g_key(-1, ep(d, k)), slider(ep(s, k)), 0); k += 1;);
);
function g_breset(b) local(k)
(
  k = 0; loop(EBN, g_kset(g_key(-1, ep(b, k)), PDEF[ep(b, k)], 0); k += 1;);
);
// split band j at f: a new band above, a copy of j
function g_split(j, f) local(n, i)
(
  n = g_nb;
  (n < NB && f > g_lo(j) * 1.2 && f < g_hi(j) / 1.2) ? (
    i = n - 1; loop(n - 1 - j, g_bcopy(i, i + 1); i -= 1;);
    g_bcopy(j, j + 1);
    i = n - 2; loop(n - 1 - j, g_kset(g_key(-1, P_XF + i + 1), slider(P_XF + i), 0); i -= 1;);
    g_kset(g_key(-1, P_XF + j), f, 0);
    g_kset(g_key(-1, P_NB), n + 1, 1);
    g_selband(j);
  );
);
// take crossover c out: bands c and c+1 become one (keepup: with the upper one's settings)
function g_merge(c, keepup) local(n, i)
(
  n = g_nb;
  n > 1 ? (
    g_solo_l = -1; g_solo_m = -1;
    keepup ? g_bcopy(c + 1, c);
    i = c + 2; loop(n - c - 2, g_bcopy(i, i - 1); i += 1;);
    g_breset(n - 1);
    i = c + 1; loop(n - 2 - c, g_kset(g_key(-1, P_XF + i - 1), slider(P_XF + i), 0); i += 1;);
    g_kset(g_key(-1, P_XF + n - 2), PDEF[P_XF + n - 2], 0);
    g_kset(g_key(-1, P_NB), n - 1, 1);
    g_selband(min(c, n - 2));
  );
);
function g_delband(b) ( b == 0 ? g_merge(0, 1) : g_merge(b - 1, 0); );
// split the widest band in its middle
function g_autosplit() local(b, j, r, br)
(
  j = 0; r = 0; b = 0;
  loop(g_nb, br = g_hi(b) / g_lo(b); br > r ? (r = br; j = b;); b += 1;);
  g_split(j, sqrt(g_lo(j) * g_hi(j)));
);

// the style menu: the 30 styles in their groups
function g_stylestr(cur) local(i)
(
  strcpy(#g_menu, "");
  i = 0;
  loop(NSTY,
    i == 0 ? strcat(#g_menu, ">Tube|");
    i == 4 ? strcat(#g_menu, ">Tape|");
    i == 9 ? strcat(#g_menu, ">Transformer|");
    i == 12 ? strcat(#g_menu, ">Amp|");
    i == 17 ? strcat(#g_menu, ">Console|");
    i == 19 ? strcat(#g_menu, ">Harmonics|");
    i == 21 ? strcat(#g_menu, ">Wild|");
    i == 27 ? strcat(#g_menu, ">Digital|");
    (i == 3 || i == 8 || i == 11 || i == 16 || i == 18 || i == 20 || i == 26 || i == 29) ? strcat(#g_menu, "<");
    i == cur ? strcat(#g_menu, "!");
    strcat(#g_menu, 540 + i);
    i < NSTY - 1 ? strcat(#g_menu, "|");
    i += 1;
  );
);
function style_dd(x, y, w, h, b) local(st, r)
(
  st = max(0, min(NSTY - 1, floor(slider(ep(b, K_STYLE)) + 0.5)));
  sprintf(#g_dd, "%s  v", 540 + st);
  button(x, y, w, h, #g_dd, 0, 1, 0) ? (
    g_stylestr(st);
    gfx_x = X(x); gfx_y = Y(y + h);
    r = gfx_showmenu(#g_menu);
    r > 0 ? g_kset(g_key(-1, ep(b, K_STYLE)), r - 1, 1);
  );
);

// a dropdown for one field of a packed parameter (as in the EQ)
function pdd(x, y, w, h, k, dv, md, first, pre, enabled) local(v, cv, r)
(
  v = floor(g_kget(k) + 0.5);
  cv = floor(v / dv) % md;
  strlen(pre) ? sprintf(#g_dd, "%s %s  v", pre, first + cv) : sprintf(#g_dd, "%s  v", first + cv);
  button(x, y, w, h, #g_dd, 0, enabled, 0) ? (
    enum_menu(#g_menu, first, md, cv);
    gfx_x = X(x); gfx_y = Y(y + h);
    r = gfx_showmenu(#g_menu);
    r > 0 ? g_kset(k, v + (r - 1 - cv) * dv, 1);
  );
);

// a numbered chip: click to select a band (an unused one adds a band by splitting the widest)
function chip(x, y, w, h, b) local(on, sel, hv, clk, live)
(
  live = b < g_nb;
  on = live && slider(ep(b, K_ON)) >= 0.5 && slider(ep(b, K_MUTE)) < 0.5; sel = live && floor(slider(P_SEL) + 0.5) == b;
  hv = hit(x, y, w, h);
  hv ? setc(0.21, 0.20, 0.19) : setc(0.15, 0.145, 0.14);
  rect(x, y, w, h, 1);
  on ? (band_col(b, 1); rect(x, y + h - 3, w, 3, 1););
  sel ? setc(1.0, 0.95, 0.88) : c_border();
  rect(x, y, w, h, 0);
  gfx_setfont(1); live ? c_text() : c_faint();
  sprintf(#g_cvs, live ? "%d" : "+", b + 1);
  text(#g_cvs, x, y - 1, w, h - 2, 5);
  clk = hv && g_lclick && !g_used;
  clk ? (
    g_used = 1;
    live ? g_selband(b) : g_autosplit();
  );
);

// the transfer curve of band b's style at its drive (the memoryless part)
function g_curve(x, y, w, h, b) local(st, d, gn, i, u, v, px, py, lx, ly, cx, cy, hw, hh, ef)
(
  st = max(0, min(NSTY - 1, floor(slider(ep(b, K_STYLE)) + 0.5)));
  d = max(0, min(100, slider(ep(b, K_DRIVE) + 0) + slider(P_GDRV)));
  gn = 10 ^ ((-6 + 0.5 * d + STYT[st * 24]) / 20);
  c_well(); rect(x, y, w, h, 1);
  cx = x + w * 0.5; cy = y + h * 0.5 + 6; hw = w * 0.5 - 8; hh = h * 0.5 - 16;
  setc(0.15, 0.15, 0.17); rect(x + 4, cy, w - 8, 1 / g_sc, 1); rect(cx, y + 14, 1 / g_sc, h - 18, 1);
  setc(0.24, 0.24, 0.27); gfx_line(X(cx - hw), Y(cy + hh), X(cx + hw), Y(cy - hh), 1);
  (g_live_me && EF[b] > 0.0001) ? (
    ef = min(1, EF[b]);
    band_col(b, 0.30); rect(cx + ef * hw - 1, y + 14, 2, h - 18, 1); rect(cx - ef * hw - 1, y + 14, 2, h - 18, 1); gfx_a = 1;
  );
  band_col(b, 1);
  i = 0; lx = 0; ly = 0;
  loop(65,
    u = -1 + i / 32;
    v = max(-1.25, min(1.25, gs_core(st, u * gn)));
    px = cx + u * hw; py = cy - v / 1.25 * hh;
    i > 0 ? (gfx_line(X(lx), Y(ly), X(px), Y(py), 1); gfx_line(X(lx), Y(ly) + 1, X(px), Y(py) + 1, 1););
    lx = px; ly = py; i += 1;
  );
  c_border(); rect(x, y, w, h, 0);
  gfx_setfont(3); c_dim();
  sprintf(#g_cvs, "%s   in %+.1f dB", 540 + st, -6 + 0.5 * d + STYT[st * 24]);
  text(#g_cvs, x + 6, y + 2, w - 12, 12, 4);
);

// a control with a marker where the modulation has it right now
function mctl(lbl, x, y, p, lg, enabled) local(f, e)
(
  cctl(lbl, x, y, p, lg, enabled);
  (g_live_me && g_ma && abs(EFFP[p] - slider(p)) > 0.0002 * (PHI[p] - PLO[p])) ? (
    e = EFFP[p];
    f = lg ? log(max(PLO[p], e) / PLO[p]) / log(PHI[p] / PLO[p]) : (e - PLO[p]) / (PHI[p] - PLO[p]);
    f = max(0, min(1, f));
    c_purple(); rect(x + 66 + 138 * f - 1, y - 1, 3, 22, 1);
  );
);

// keep a slot's option in the range its type uses
function g_modfix(s, ty) local(o, n)
(
  o = floor(slider(mp(s, M_OPT)) + 0.5);
  ty == 1 ? (n = o % 6;) : (ty == 2 ? (n = min(2, o % 4) + 4 * (floor(o / 4) % 3);) : (n = min(129, o);));
  n !== o ? g_kset(g_key(-1, mp(s, M_OPT)), n, 0);
);

// one modulation slot (a row, 876 wide)
function g_modrow(x, y, s) local(ty, tb, tp, o, v, sy, k, r)
(
  ty = floor(slider(mp(s, M_TYPE)) + 0.5);
  gfx_setfont(2); ty > 0 ? c_purple() : c_faint();
  sprintf(#g_cvs, "%d", s + 1); text(#g_cvs, x, y, 16, 20, 5);
  dropdown(x + 20, y, 90, 20, g_key(-1, mp(s, M_TYPE)), 420, 4, 1);
  ty > 0 ? (
    g_modfix(s, ty);
    tb = floor(slider(mp(s, M_TBAND)) + 0.5); tp = floor(slider(mp(s, M_TPAR)) + 0.5);
    (tb == 0 && tp > 3) ? (g_kset(g_key(-1, mp(s, M_TPAR)), 3, 0); tp = 3;);
    dropdown(x + 114, y, 84, 20, g_key(-1, mp(s, M_TBAND)), 510, 8, 1);
    tb == 0 ? dropdown(x + 202, y, 112, 20, g_key(-1, mp(s, M_TPAR)), 520, 4, 1)
            : dropdown(x + 202, y, 112, 20, g_key(-1, mp(s, M_TPAR)), 495, 12, 1);
    cbar(x + 318, y, 70, 20, mp(s, M_AMT), 0, 1);
    cfmt(#g_cv, mp(s, M_AMT), slider(mp(s, M_AMT)));
    valbox(x + 392, y, 54, 20, g_key(-1, mp(s, M_AMT)), 2.9, 0.29, 6, #g_cv, 1);
    o = floor(slider(mp(s, M_OPT)) + 0.5);
    ty == 1 ? (
      dropdown(x + 454, y, 80, 20, g_key(-1, mp(s, M_OPT)), 430, 6, 1);
      dropdown(x + 538, y, 66, 20, g_key(-1, mp(s, M_SYNC)), 450, 13, 1);
      v = slider(mp(s, M_RATE));
      sprintf(#g_cv, "%.2f Hz", v);
      valbox(x + 608, y, 76, 20, g_key(-1, mp(s, M_RATE)), log(PHI[mp(s, M_RATE)] / PLO[mp(s, M_RATE)]) / 138, log(PHI[mp(s, M_RATE)] / PLO[mp(s, M_RATE)]) / 1380, 5, #g_cv, slider(mp(s, M_SYNC)) < 0.5);
    );
    ty == 2 ? (
      pdd(x + 454, y, 76, 20, g_key(-1, mp(s, M_OPT)), 1, 3, 440, "", 1);
      pdd(x + 534, y, 56, 20, g_key(-1, mp(s, M_OPT)), 4, 3, 525, "", 1);
      sprintf(#g_cv, "A %.1f ms", slider(mp(s, M_RATE)));
      valbox(x + 594, y, 76, 20, g_key(-1, mp(s, M_RATE)), log(PHI[mp(s, M_RATE)] / PLO[mp(s, M_RATE)]) / 138, log(PHI[mp(s, M_RATE)] / PLO[mp(s, M_RATE)]) / 1380, 5, #g_cv, 1);
      sprintf(#g_cv, "R %.0f ms", slider(mp(s, M_RATE2)));
      valbox(x + 674, y, 76, 20, g_key(-1, mp(s, M_RATE2)), log(PHI[mp(s, M_RATE2)] / PLO[mp(s, M_RATE2)]) / 138, log(PHI[mp(s, M_RATE2)] / PLO[mp(s, M_RATE2)]) / 1380, 5, #g_cv, 1);
    );
    ty == 3 ? (
      sprintf(#g_dd, "%s  v", 528 + (o < 128 ? 0 : o - 127));
      button(x + 454, y, 100, 20, #g_dd, 0, 1, 0) ? (
        enum_menu(#g_menu, 528, 3, o < 128 ? 0 : o - 127);
        gfx_x = X(x + 454); gfx_y = Y(y + 20);
        r = gfx_showmenu(#g_menu);
        r > 0 ? g_kset(g_key(-1, mp(s, M_OPT)), r == 1 ? (o < 128 ? o : 1) : 127 + r - 1, 1);
      );
      sprintf(#g_cv, "CC %d", o);
      valbox(x + 558, y, 70, 20, g_key(-1, mp(s, M_OPT)), 0.3, 0.05, 6, #g_cv, o < 128);
    );
    // where the modulator is now
    c_well(); rect(x + 788, y + 6, 88, 8, 1);
    v = MV[s];
    g_live_me ? (
      c_purple();
      ty == 1 ? (v >= 0 ? rect(x + 832, y + 7, 44 * v, 6, 1) : rect(x + 832 + 44 * v, y + 7, -44 * v, 6, 1);) : rect(x + 788, y + 7, 88 * max(0, min(1, v)), 6, 1);
    );
    c_border(); rect(x + 788, y + 6, 88, 8, 0);
  ) : (
    gfx_setfont(3); c_faint(); text("off", x + 118, y, 60, 20, 4);
  );
);

// nothing to add to a user preset besides the settings
function pr_xsave(b) ( 0; );
function pr_xload(b) ( 0; );
// ---------- shared by every TwoStorms plug-in: A/B sets, presets and the top bar ----------
// the other A/B set: swap it with the playing one, or copy the playing one into it
function ab_swap() local(i, p, t)
(
  i = 0;
  loop(ABN, p = ABL[i]; t = slider(p); g_setsl(p, ABSET[p]); ABSET[p] = t; i += 1;);
  g_setsl(P_AB, slider(P_AB) < 0.5);
  c_uiabn += 1;
  sliderchange(-1);
);
function ab_copy() local(i, p)
(
  i = 0; loop(ABN, p = ABL[i]; ABSET[p] = slider(p); i += 1;);
  g_setsl(P_CUIST, slider(P_CUIST) + 1);
  sliderchange(-1);
);

// ---- presets ----
// Factory presets come with the plug-in: pr_factory(n) sets the n-th, #pr_fmenu is its menu (PR_NF items). A preset
// starts from every setting's default (PRH: the defaults in the plug-in's header), so it always sounds the same.
// User presets are saved by the helper script (version 6 and newer) in REAPER's Data/TwoStorms/Presets folder (one file
// per plug-in) and published in the shared memory, so every window lists them without reading files: at
// UPK = UP + 10000 + SUBKIND * 60000 the count, each name from +100 (64 apart: its length, then its characters) and each
// preset from +3000 (1400 apart: how many settings, the setting and value pairs, then anything the plug-in adds, such as
// the IR Loader's file paths). Saving and deleting go through a mailbox at UP + 10: request number, the asker's ID, the
// operation (1 save, 2 delete), the plug-in's kind, which preset (delete); the helper answers with the request number it
// finished (UP + 15), the result (UP + 16: 1 done, 0 cancelled, -1 failed) and the asker's ID (UP + 17). What to save
// goes at UP + 100: how many settings, then the pairs, then the plug-in's extras.
UP = 4800000; UP_MAGIC = 7532; UP_MAX = 40; UP_NM = 64; UP_PSZ = 1400;
UPK = UP + 10000 + SUBKIND * 60000;
PRA = alloc(256); PRB = alloc(256); PRH = alloc(256); PRIN = alloc(256);
PRH[43] = 0; PRH[44] = 0; PRH[45] = 3; PRH[46] = 1; PRH[47] = 1; PRH[48] = 0; PRH[49] = 0; PRH[50] = 0;
PRH[51] = 100; PRH[52] = 0; PRH[53] = 3; PRH[54] = 0; PRH[55] = 0; PRH[56] = 0; PRH[57] = 0; PRH[60] = 150;
PRH[61] = 3000; PRH[62] = 6000; PRH[63] = 9000; PRH[64] = 13000; PRH[70] = 1; PRH[71] = 0; PRH[72] = 1; PRH[73] = 25;
PRH[74] = 100; PRH[75] = 0; PRH[76] = 0; PRH[77] = 0; PRH[78] = 1000; PRH[79] = 0; PRH[80] = 0; PRH[81] = 0;
PRH[82] = 0; PRH[83] = 0; PRH[84] = 0; PRH[85] = 0; PRH[86] = 1; PRH[87] = 0; PRH[88] = 1; PRH[89] = 25;
PRH[90] = 100; PRH[91] = 0; PRH[92] = 0; PRH[93] = 0; PRH[94] = 1000; PRH[95] = 0; PRH[96] = 0; PRH[97] = 0;
PRH[98] = 0; PRH[99] = 0; PRH[100] = 0; PRH[101] = 0; PRH[102] = 1; PRH[103] = 0; PRH[104] = 1; PRH[105] = 25;
PRH[106] = 100; PRH[107] = 0; PRH[108] = 0; PRH[109] = 0; PRH[110] = 1000; PRH[111] = 0; PRH[112] = 0; PRH[113] = 0;
PRH[114] = 0; PRH[115] = 0; PRH[116] = 0; PRH[117] = 0; PRH[118] = 1; PRH[119] = 0; PRH[120] = 1; PRH[121] = 25;
PRH[122] = 100; PRH[123] = 0; PRH[124] = 0; PRH[125] = 0; PRH[126] = 1000; PRH[127] = 0; PRH[128] = 0; PRH[129] = 0;
PRH[130] = 0; PRH[131] = 0; PRH[132] = 0; PRH[133] = 0; PRH[134] = 1; PRH[135] = 0; PRH[136] = 1; PRH[137] = 25;
PRH[138] = 100; PRH[139] = 0; PRH[140] = 0; PRH[141] = 0; PRH[142] = 1000; PRH[143] = 0; PRH[144] = 0; PRH[145] = 0;
PRH[146] = 0; PRH[147] = 0; PRH[148] = 0; PRH[149] = 0; PRH[150] = 1; PRH[151] = 0; PRH[152] = 1; PRH[153] = 25;
PRH[154] = 100; PRH[155] = 0; PRH[156] = 0; PRH[157] = 0; PRH[158] = 1000; PRH[159] = 0; PRH[160] = 0; PRH[161] = 0;
PRH[162] = 0; PRH[163] = 0; PRH[164] = 0; PRH[165] = 0; PRH[170] = 0; PRH[171] = 1; PRH[172] = 0; PRH[173] = 50;
PRH[174] = 1; PRH[175] = 200; PRH[176] = 0; PRH[177] = 0; PRH[178] = 0; PRH[179] = 1; PRH[180] = 0; PRH[181] = 50;
PRH[182] = 1; PRH[183] = 200; PRH[184] = 0; PRH[185] = 0; PRH[186] = 0; PRH[187] = 1; PRH[188] = 0; PRH[189] = 50;
PRH[190] = 1; PRH[191] = 200; PRH[192] = 0; PRH[193] = 0; PRH[194] = 0; PRH[195] = 1; PRH[196] = 0; PRH[197] = 50;
PRH[198] = 1; PRH[199] = 200; PRH[200] = 0; PRH[201] = 0; PRH[202] = 0; PRH[203] = 1; PRH[204] = 0; PRH[205] = 50;
PRH[206] = 1; PRH[207] = 200; PRH[208] = 0; PRH[209] = 0; PRH[210] = 0; PRH[211] = 1; PRH[212] = 0; PRH[213] = 50;
PRH[214] = 1; PRH[215] = 200; PRH[216] = 0; PRH[217] = 0; PRH[218] = 0; PRH[219] = 1; PRH[220] = 0; PRH[221] = 50;
PRH[222] = 1; PRH[223] = 200; PRH[224] = 0; PRH[225] = 0; PRH[226] = 0; PRH[227] = 1; PRH[228] = 0; PRH[229] = 50;
PRH[230] = 1; PRH[231] = 200; PRH[232] = 0; PRH[233] = 0;
// the settings a preset holds: the A/B set, and the oversampling (live presets use none: no latency)
PRL = alloc(256); a_i = 0; loop(ABN, PRL[a_i] = ABL[a_i]; a_i += 1;); PRLN = ABN;
PRL[PRLN] = 47; PRLN += 1; 

a_i = 0; loop(PRLN, PRIN[PRL[a_i]] = 1; a_i += 1;);
pr_req = 0; pr_msgt = -100;

// every preset setting back to its default
function pr_reset() local(i, p) ( i = 0; loop(PRLN, p = PRL[i]; g_setsl(p, PRH[p]); i += 1;); );
// "p=v p=v ...": set those settings (a factory preset's own values)
function pr_isnum(ch) ( ch == 45 || ch == 46 || (ch >= 48 && ch <= 57); );
function pr_rd(s, n) local(ch, v, sg, dv, dot)
(
  v = 0; sg = 1; dv = 1; dot = 0;
  while (pr_i < n && !pr_isnum(str_getchar(s, pr_i))) (pr_i += 1;);
  (pr_i < n && str_getchar(s, pr_i) == 45) ? (sg = -1; pr_i += 1;);
  while (pr_i < n && pr_isnum(ch = str_getchar(s, pr_i)) && ch != 45) (
    ch == 46 ? dot = 1 : (dot ? (dv *= 10; v += (ch - 48) / dv;) : v = v * 10 + ch - 48;);
    pr_i += 1;
  );
  sg * v;
);
function pr_str(s) local(n, p, v)
(
  n = strlen(s); pr_i = 0;
  while (pr_i < n) (
    p = pr_rd(s, n); v = pr_rd(s, n);
    (p >= 1 && p < 256 && PRIN[p]) ? g_setsl(p, v);
  );
);

// the user presets the helper script published for this plug-in
function pr_nuser() ( gmem[UP] == UP_MAGIC ? max(0, min(UP_MAX, floor(gmem[UPK]))) : 0; );
function pr_uname(dst, i) local(b, n, k)
(
  b = UPK + 100 + i * UP_NM; n = max(0, min(UP_NM - 1, floor(gmem[b]))); strcpy(dst, ""); k = 0;
  loop(n, sprintf(#pr_c1, "%c", max(32, min(255, gmem[b + 1 + k]))); strcat(dst, #pr_c1); k += 1;);
);
function pr_uapply(i) local(b, n, k, p)
(
  b = UPK + 3000 + i * UP_PSZ; n = max(0, min(600, floor(gmem[b])));
  pr_reset();
  k = 0;
  loop(n, p = floor(gmem[b + 1 + 2 * k] + 0.5); (p >= 1 && p < 256 && PRIN[p]) ? g_setsl(p, gmem[b + 2 + 2 * k]); k += 1;);
  pr_xload(b + 1 + 2 * n);
  sliderchange(-1);
);
// ask the helper script to save (op 1) or delete (op 2) a user preset
function pr_send(op, i) local(k, p)
(
  gmem[UP + 11] = MYID; gmem[UP + 12] = op; gmem[UP + 13] = SUBKIND; gmem[UP + 14] = i;
  op == 1 ? (
    gmem[UP + 100] = PRLN;
    k = 0; loop(PRLN, p = PRL[k]; gmem[UP + 101 + 2 * k] = p; gmem[UP + 102 + 2 * k] = slider(p); k += 1;);
    pr_xsave(UP + 101 + 2 * PRLN);
  );
  gmem[UP + 10] += 1; pr_req = gmem[UP + 10]; pr_reqop = op; pr_reqt = g_now;
);
// the helper's answer: a short note next to the Presets button
function pr_poll()
(
  (pr_req > 0 && gmem[UP + 15] >= pr_req && gmem[UP + 17] === MYID) ? (
    gmem[UP + 16] > 0 ? strcpy(#pr_msg, pr_reqop == 1 ? "preset saved" : "preset deleted") :
      (gmem[UP + 16] < 0 ? strcpy(#pr_msg, "the preset could not be saved") : strcpy(#pr_msg, ""));
    pr_msgt = g_now; pr_req = 0;
  );
  (pr_req > 0 && g_now - pr_reqt > 120) ? pr_req = 0;
);

// ---- factory presets (the shared Presets menu): built from the preset table (presets.py) ----
PR_NF = 16;
strcpy(#pr_fmenu, ">Live rig|Clean bass: warm glow|Dist bass: clean lows, driven mids|Slap bass: tape snap|Singing vocal: transformer warmth|<Talking vocal: console|>Bas");
strcat(#pr_fmenu, "s by genre|Punk rock|Pop punk|Metal|Rock|Jazz|<Pop|>Mixing|Drum bus tape|Mix bus console|Vocal air (highs only)|Inflate|<Lo-fi destroy");
function pr_factory(n)
(
  n == 0 ? pr_str("45=1 47=0 51=100 70=1 72=1 73=20 74=100 75=0 76=0 79=0 80=0 81=0 82=0");     // Live rig: Clean bass: warm glow
  n == 1 ? pr_str("45=3 47=0 51=100 60=150 61=2500 70=1 72=0 73=10 74=100 75=0 76=0 79=0 80=0 81=0 82=0 86=1 88=13 89=60 90=100 91=0 92=0 95=0 96=0 97=0 98=0 102=1 104=21 105=30 106=100 107=-6 108=0 111=0 112=0 113=-3 114=0");     // Live rig: Dist bass: clean lows, driven mids
  n == 2 ? pr_str("45=1 47=0 51=100 70=1 72=5 73=25 74=100 75=0 76=0 79=0 80=0 81=0 82=2");     // Live rig: Slap bass: tape snap
  n == 3 ? pr_str("45=1 47=0 51=100 70=1 72=10 73=15 74=100 75=0 76=0 79=0 80=0 81=0 82=0");     // Live rig: Singing vocal: transformer warmth
  n == 4 ? pr_str("45=1 47=0 51=100 70=1 72=17 73=10 74=100 75=0 76=0 79=0 80=0 81=0 82=0");     // Live rig: Talking vocal: console
  n == 5 ? pr_str("45=3 47=0 51=100 60=150 61=2500 70=1 72=0 73=12 74=100 75=0 76=0 79=0 80=0 81=0 82=0 86=1 88=15 89=65 90=100 91=0 92=0 95=0 96=0 97=0 98=0 102=1 104=21 105=35 106=100 107=-6 108=0 111=0 112=0 113=0 114=0");     // Bass by genre: Punk rock
  n == 6 ? pr_str("45=3 47=0 51=100 60=150 61=2500 70=1 72=0 73=10 74=100 75=0 76=0 79=0 80=0 81=0 82=0 86=1 88=13 89=45 90=100 91=0 92=0 95=0 96=0 97=0 98=0 102=1 104=28 105=20 106=100 107=-4 108=0 111=0 112=0 113=0 114=0");     // Bass by genre: Pop punk
  n == 7 ? pr_str("45=3 47=0 51=100 60=120 61=3000 70=1 72=0 73=15 74=100 75=0 76=0 79=0 80=0 81=0 82=0 86=1 88=16 89=75 90=100 91=0 92=0 95=0 96=2 97=0 98=0 102=1 104=29 105=40 106=100 107=-8 108=0 111=0 112=0 113=-4 114=0");     // Bass by genre: Metal
  n == 8 ? pr_str("45=3 47=0 51=100 60=150 61=3000 70=1 72=1 73=15 74=100 75=0 76=0 79=0 80=0 81=0 82=0 86=1 88=12 89=45 90=100 91=0 92=0 95=0 96=0 97=0 98=0 102=1 104=1 105=20 106=100 107=-4 108=0 111=0 112=0 113=0 114=0");     // Bass by genre: Rock
  n == 9 ? pr_str("45=1 47=0 51=100 70=1 72=1 73=15 74=60 75=0 76=0 79=0 80=0 81=0 82=0");     // Bass by genre: Jazz
  n == 10 ? pr_str("45=2 47=0 51=100 60=120 70=1 72=0 73=10 74=100 75=0 76=0 79=0 80=0 81=0 82=0 86=1 88=19 89=30 90=70 91=0 92=0 95=0 96=0 97=0 98=0");     // Bass by genre: Pop
  n == 11 ? pr_str("45=1 47=1 51=100 70=1 72=5 73=30 74=100 75=0 76=0 79=0 80=0 81=0 82=0");     // Mixing: Drum bus tape
  n == 12 ? pr_str("45=1 47=1 51=100 70=1 72=18 73=20 74=100 75=0 76=0 79=0 80=0 81=0 82=0");     // Mixing: Mix bus console
  n == 13 ? pr_str("45=2 47=1 51=100 60=5000 70=1 72=0 73=0 74=0 75=0 76=0 79=0 80=0 81=0 82=0 86=1 88=19 89=35 90=60 91=0 92=0 95=0 96=0 97=0 98=0");     // Mixing: Vocal air (highs only)
  n == 14 ? pr_str("45=1 47=1 51=100 70=1 72=20 73=40 74=100 75=0 76=0 79=0 80=0 81=0 82=0");     // Mixing: Inflate
  n == 15 ? pr_str("45=1 47=0 51=100 70=1 72=27 73=50 74=60 75=0 76=0 79=0 80=0 81=0 82=0");     // Mixing: Lo-fi destroy
);

function pr_menu(x, y) local(nu, n, r, i, ok)
(
  nu = pr_nuser(); n = 0;
  strcpy(#pr_menu, "");
  PR_NF > 0 ? (
    strcat(#pr_menu, #pr_fmenu); i = 0; loop(PR_NF, n += 1; PRA[n] = 1; PRB[n] = i; i += 1;);
    strcat(#pr_menu, "||");
  );
  nu > 0 ? (
    strcat(#pr_menu, ">User presets");
    i = 0; loop(nu, strcat(#pr_menu, i == nu - 1 ? "|<" : "|"); pr_uname(#pr_nm, i); strcat(#pr_menu, #pr_nm); n += 1; PRA[n] = 2; PRB[n] = i; i += 1;);
    strcat(#pr_menu, "|");
  ) : (
    strcat(#pr_menu, "#User presets: none saved yet|"); n += 1; PRA[n] = 0;
  );
  ok = MYSLOT >= 0 && g_script_ok && gmem[GM_SCRIPTVER] >= 6 && gmem[UP] == UP_MAGIC;
  strcat(#pr_menu, ok ? "Save these settings as a user preset..." : "#Save as a user preset (needs the helper script, version 6)");
  n += 1; PRA[n] = ok ? 3 : 0;
  (ok && nu > 0) ? (
    strcat(#pr_menu, "|>Delete a user preset");
    i = 0; loop(nu, strcat(#pr_menu, i == nu - 1 ? "|<" : "|"); pr_uname(#pr_nm, i); strcat(#pr_menu, #pr_nm); n += 1; PRA[n] = 4; PRB[n] = i; i += 1;);
  );
  strcat(#pr_menu, "||Reset to defaults"); n += 1; PRA[n] = 5;
  gfx_x = X(x); gfx_y = Y(y);
  r = gfx_showmenu(#pr_menu);
  (r >= 1 && r <= n) ? (
    PRA[r] == 1 ? (pr_reset(); pr_factory(PRB[r]); sliderchange(-1););
    PRA[r] == 2 ? pr_uapply(PRB[r]);
    PRA[r] == 3 ? pr_send(1, 0);
    PRA[r] == 4 ? pr_send(2, PRB[r]);
    PRA[r] == 5 ? (pr_reset(); sliderchange(-1););
  );
);

// ---- the top bar every TwoStorms plug-in shares: title, finale, Presets, A / B / Copy, Swap and Bypass, Settings ----
// ab: the plug-in has A/B sets (and so Swap). Swap = the other set at this one's loudness; Bypass = the input at the same
// loudness. A click latches it, Shift + click and hold only while the mouse is held.
function top_bar(title, ab)
(
  gfx_setfont(4); c_orange();
  text(title, 12, 8, 236, 24, 4);
  g_fin ? badge("finale", 250, 11, 2);
  pr_poll();
  button(304, 8, 84, 24, "Presets  v", 0, 1, 0) ? pr_menu(304, 32);
  ab ? (
    g_ab = slider(P_AB) >= 0.5;
    button(396, 8, 28, 24, "A", !g_ab, 1, 0) ? (g_ab ? (ab_swap(); (g_cap & 8) ? (g_abm = 1;);););
    button(426, 8, 28, 24, "B", g_ab, 1, 0) ? (!g_ab ? (ab_swap(); (g_cap & 8) ? (g_abm = 1;);););
    (g_abm && !(g_cap & 1)) ? (ab_swap(); g_abm = 0;);
    button(458, 8, 76, 24, g_ab ? "Copy B>A" : "Copy A>B", 0, 1, 0) ? ab_copy();
    button(542, 8, 120, 24, "Swap (Lvl Match)", g_holdid == 2, 1, 1) ? ((g_cap & 8) ? (g_holdm = 2;) : (g_hl = (g_hl == 2 ? 0 : 2);););
  );
  button(666, 8, 126, 24, "Bypass (Lvl Match)", g_holdid == 1, 1, 1) ? ((g_cap & 8) ? (g_holdm = 1;) : (g_hl = (g_hl == 1 ? 0 : 1);););
  !(g_cap & 1) ? g_holdm = 0;
  g_holdid = g_holdm ? g_holdm : g_hl;
  c_uihold = g_holdid; c_uibeat = g_now;
  button(798, 8, 90, 24, "Settings", g_cset, 1, 0) ? g_cset = !g_cset;
  // a note from the presets (saved, deleted) for a few seconds, at the right of the line below
  g_now - pr_msgt < 4 ? (gfx_setfont(3); c_orange(); text(#pr_msg, 588, 34, 300, 16, 6););
);

@serialize
z_ver = 1;
file_var(0, z_ver);
file_mem(0, ABSET, 256);

@slider
// a host change (automation, ReaLearn, a preset) to one side of a linked pair moves the other side too
s_k = 0;
loop(4,
  s_a = s_k * 2; s_b = s_a + 1;
  (slider(si(P_LINK + s_k)) >= 0.5 && s_b < 2 + 2 * max(0, min(3, floor(slider(si(P_NCH)) + 0.5))) &&
   slider(si(P_USED + s_a)) >= 0.5 && slider(si(P_USED + s_b)) >= 0.5) ? (
    s_ga = slider(si(P_GAIN + s_a)); s_gb = slider(si(P_GAIN + s_b));
    s_ga !== s_gb ? (
      s_ga !== LASTG[s_a] ? (
        slider(si(P_GAIN + s_b)) = s_ga; sliderchange(slider(si(P_GAIN + s_b)));
      ) : (
        slider(si(P_GAIN + s_a)) = s_gb; sliderchange(slider(si(P_GAIN + s_a)));
      );
    );
  );
  s_k += 1;
);
s_c = 0; loop(8, LASTG[s_c] = slider(si(P_GAIN + s_c)); s_c += 1;);
@block
// ---------- Saturator: once per block ----------
// the window's hold buttons (1 = Bypass, 2 = Swap) and its solo, while its heartbeat is fresh
c_uiok = a_now - c_uibeat < 0.5;
c_bph = c_uiok && c_uihold == 1;
c_swh = c_uiok && c_uihold == 2;
c_lat = slider(P_AB) >= 0.5;          // the latched set: 0 = A, 1 = B
c_side = c_swh ? !c_lat : c_lat;      // the set playing now
(srate !== d_csr) ? (
  d_csr = srate; d_snap = 1; d_os = -1;
  DC_R = 1 - 2 * $pi * 8 / srate;
  D_KAE = 1 - exp(-1 / (0.003 * srate)); D_KRE = 1 - exp(-1 / (0.06 * srate)); D_KS = 1 - exp(-16 / (1.5 * srate));
);
d_ingt = 10 ^ (c_pv(P_IN) / 20); d_snap ? d_ingc = d_ingt;
d_del = slider(P_DELTA) >= 0.5;
// oversampling (the latched set's: a held Swap never changes the latency)
d_osn = max(0, min(2, floor(slider(P_OS) + 0.5)));
d_osn !== d_os ? (
  d_os = d_osn; d_osf = d_os == 0 ? 1 : (d_os == 1 ? 2 : 4);
  d_rates();
  d_dd = d_os == 0 ? 0 : (d_os == 1 ? 3.2115 : 4.5117);
  d_dint = floor(d_dd + 0.5);
  memset(BSZ, 0, NB * 2 * BSTR);
  a_i = 0; loop(NB, a_k = BSZ + a_i * 2 * BSTR; a_k[ZSH] = 1; a_k[BSTR + ZSH] = 1; a_i += 1;);
  d_snap = 1;
);
pdc_delay = d_dint; pdc_bot_ch = 0; pdc_top_ch = 2;
c_latms = d_dint / srate * 1000;
d_nbn = max(1, min(NB, floor(c_pv(P_NB) + 0.5))); d_sln = max(0, min(2, floor(c_pv(P_SLOPE) + 0.5)));
(d_nbn !== d_nb || d_sln !== d_slope) ? (
  d_nb = d_nbn; d_slope = d_sln;
  d_xzero();
  d_snap = 1;
);
// tempo for the synced LFOs
d_tempo = tempo > 0 ? tempo : 120;
(play_state & 1) ? (abs(beat_position - d_beat) > 0.25 ? d_beat = beat_position : d_beat += (beat_position - d_beat) * 0.1;);
// MIDI: control changes and notes for the MIDI sources; everything is passed on
while (midirecv(d_mo, d_m1, d_m2, d_m3)) (
  d_st = d_m1 & 240;
  d_st == 176 ? MCC[d_m2 & 127] = (d_m3 & 127) / 127;
  (d_st == 144 && (d_m3 & 127) > 0) ? (d_nvel = (d_m3 & 127) / 127; d_nheld += 1;);
  (d_st == 128 || (d_st == 144 && (d_m3 & 127) == 0)) ? (d_nheld = max(0, d_nheld - 1); d_nheld == 0 ? d_nvel = 0;);
  d_st == 224 ? d_pb = ((d_m2 & 127) + (d_m3 & 127) * 128 - 8192) / 8192;
  midisend(d_mo, d_m1, d_m2, d_m3);
);
// flush the filters' tiny leftovers (denormals)
a_i = 0; loop(NB * 2 * BSTR, abs(BSZ[a_i]) < 0.000000000000000000001 ? BSZ[a_i] = 0; a_i += 1;);
d_xflush();
a_i = 0; loop(NB, EF[a_i] < 0.000000000000000000001 ? EF[a_i] = 0; ES[a_i] < 0.000000000000000000001 ? ES[a_i] = 0; EO[a_i] < 0.000000000000000000001 ? EO[a_i] = 0; a_i += 1;);
a_i = 0; loop(NMOD, MEN[a_i] < 0.000000000000000000001 ? MEN[a_i] = 0; a_i += 1;);


// the window is open (meters, level matching, analyzer only run then)
c_uion = a_now - g_last < 0.5;
c_anw = c_uion && slider(P_AN) >= 0.5;

// level matching (about 1.5 s), per set: how much louder the plug-in makes things, input to output
// (not for 0.3 s after the playing set changes: the filters are still settling)
c_side !== c_lside ? (c_lside = c_side; c_lmskip = 0.3 * srate;);
c_lmskip > 0 ? (c_lmskip -= samplesblock; c_ei = 0;);
(samplesblock !== c_lbs || srate !== c_lbsr) ? (c_lbs = samplesblock; c_lbsr = srate; c_klm = 1 - exp(-samplesblock / (1.5 * srate)););
c_ei > 0.0000001 * samplesblock ? (
  LMI[c_side] += c_klm * (c_ei / samplesblock - LMI[c_side]);
  LMO[c_side] += c_klm * (c_eo / samplesblock - LMO[c_side]);
  LMV[c_side] = 1;
);
c_ei = 0; c_eo = 0;
// held Bypass: the raw input at the playing set's loudness; held Swap: the other set at this one's
c_bpg = (LMV[c_side] && LMI[c_side] > 0) ? sqrt(LMO[c_side] / LMI[c_side]) : 1;
c_trt = (c_swh && LMV[0] && LMV[1] && LMI[0] > 0 && LMI[1] > 0 && LMO[0] > 0 && LMO[1] > 0) ?
  sqrt((LMO[c_lat] / LMI[c_lat]) / (LMO[!c_lat] / LMI[!c_lat])) : 1;
c_bps = 1 / (0.01 * srate); c_trk = 1 - exp(-1 / (0.01 * srate));

// input/output link: the input gain moved (by hand or automation), so the output moves the other way
// (an A/B switch doesn't count: the window bumps c_uiabn)
c_inv = slider(P_IN);
c_uiabn !== c_abseen ? (c_abseen = c_uiabn; c_inlast = c_inv;);
(slider(P_IOL) >= 0.5 && c_inlast > -100 && c_inv !== c_inlast && slider(si(P_GAIN)) > GFLOOR) ?
  a_apply(P_GAIN, max(-99.9, min(60, slider(si(P_GAIN)) - (c_inv - c_inlast))));
c_inlast = c_inv;

// meters for the window: input peak (after Input), loudest output
a_dur = samplesblock / srate;
c_mi0 = max(c_ip0 > 0.0000000001 ? 20 * log10(c_ip0) : -200, c_mi0 - 20 * a_dur);
c_mi1 = max(c_ip1 > 0.0000000001 ? 20 * log10(c_ip1) : -200, c_mi1 - 20 * a_dur);
a_b = SLOTBASE + MYSLOT * SLOTSZ;
c_mo0 = MYSLOT >= 0 ? max(gmem[a_b + O_BPK], gmem[a_b + O_BPK + 1]) : 0;
c_mo0 = c_mo0 > 0.0000000001 ? 20 * log10(c_mo0) : -200;
c_ip0 = 0; c_ip1 = 0;

// fold the fast path's meter accumulators (see @sample) into the per-channel ones
BPK[0] = max(BPK[0], a_fp0); BPK[1] = max(BPK[1], a_fp1); BEN[0] += a_fe0; BEN[1] += a_fe1;
a_fp0 = 0; a_fp1 = 0; a_fe0 = 0; a_fe1 = 0;
a_now = time_precise();
a_claim();
MYSLOT >= 0 ? a_dupcheck();
a_pos = 0; a_pf = 0;
a_trk = get_host_placement(a_pos, a_pf);
MYSLOT >= 0 ? (
  a_nmb = NAMEBASE + MYSLOT * NAMESZ;
  // chain order: from the helper script when it has seen this instance, else REAPER's FX position
  a_order = gmem[a_nmb + N_ID] === MYID ? gmem[a_nmb + N_ORDER] : ((a_pf & 2) ? -100000 : 0) + a_pos;
  a_ring();
  a_aim_check();
  a_drive_follow();
);
a_gains();
a_nchs = a_nch(-1);
a_auto_block();
a_kout_was = a_kout;
MYSLOT >= 0 ? (
  a_meters();
  // the next point is matching loudness against this one: K-weight the output too
  a_kout = a_now - gmem[SLOTBASE + MYSLOT * SLOTSZ + O_KREQ] < 0.5;
  (a_kout && !a_kout_was) ? memset(KOUT, 0, 32);
  a_publish();
) : (
  a_kout = 0;
  a_c = 0; loop(8, BPK[a_c] = 0; BEN[a_c] = 0; BKE[a_c] = 0; a_c += 1;);
);
// the audio key (a gate later on this track may be listening to this plug-in)
a_aud_block();
a_inm = AST >= AS_WAIT;
a_binon = AST == AS_MEAS && AMODE == 0;
a_kin = a_inm && AU_KIN;
a_prevblk = samplesblock;
a_fast = a_nchs == 2 && USEDA[0] && USEDA[1] && !RAMP[0] && !RAMP[1] && !a_inm && !a_kout;
a_g0 = GLIN[0]; a_g1 = GLIN[1];

@sample
// ---------- Saturator: per sample ----------
c_r0 = spl0; c_r1 = spl1;
d_ingc += (d_ingt - d_ingc) * 0.002;
c_x0 = c_r0 * d_ingc; c_x1 = c_r1 * d_ingc;
// the modulation followers
d_nf > 0 ? (
  d_i = 0;
  loop(d_nf,
    d_s = MFL[d_i];
    d_v = MSR[d_s] == 0 ? max(abs(c_x0), abs(c_x1)) : (MSR[d_s] == 1 ? EF[MSB[d_s]] : max(abs(spl2), abs(spl3)));
    MEN[d_s] += (d_v > MEN[d_s] ? MKA[d_s] : MKR[d_s]) * (d_v - MEN[d_s]);
    d_i += 1;
  );
);
(d_tc += 1) >= 16 ? (d_tc = 0; d_tick(););
// the raw input, as late as the oversampled bands (whole samples for Bypass, interpolated for Delta)
DRW[d_rp & 63] = c_r0; DRW[64 + (d_rp & 63)] = c_r1; DRW[128 + (d_rp & 63)] = c_x0; DRW[192 + (d_rp & 63)] = c_x1;
c_q0 = DRW[(d_rp - d_dint) & 63]; c_q1 = DRW[64 + ((d_rp - d_dint) & 63)];
d_del ? (
  d_di = floor(d_dd); d_fr = d_dd - d_di;
  d_d0 = DRW[128 + ((d_rp - d_di) & 63)] * (1 - d_fr) + DRW[128 + ((d_rp - d_di - 1) & 63)] * d_fr;
  d_d1 = DRW[192 + ((d_rp - d_di) & 63)] * (1 - d_fr) + DRW[192 + ((d_rp - d_di - 1) & 63)] * d_fr;
);
d_rp += 1;
d_split2(c_x0, c_x1);
d_o0 = 0; d_o1 = 0; d_b = 0;
loop(d_nb, d_band(d_b); d_b += 1;);
d_dp += 1;
d_del ? (spl0 = d_o0 - d_d0; spl1 = d_o1 - d_d1;) : (spl0 = d_o0; spl1 = d_o1;);
a_fast ? (
  // the usual case (one stereo pair, steady gain, nothing measuring): straight-line code
  a_y0 = spl0 * a_g0; a_y1 = spl1 * a_g1;
  spl0 = a_y0; spl1 = a_y1;
  a_ay = abs(a_y0); a_ay > a_fp0 ? a_fp0 = a_ay;
  a_ay = abs(a_y1); a_ay > a_fp1 ? a_fp1 = a_ay;
  a_fe0 += a_y0 * a_y0; a_fe1 += a_y1 * a_y1;
) : (
a_c = 0;
loop(a_nchs,
  USEDA[a_c] ? (
    a_x = spl(a_c);
    a_inm ? (
      // auto stage / match: the input, before the gain
      a_ax = abs(a_x);
      a_ax > IBP[a_c] ? IBP[a_c] = a_ax;
      a_e = a_kin ? sqr(a_kw(a_x, KIN + a_c * 4)) : a_x * a_x;
      IBE[a_c] += a_e;
      a_binon ? (MBACC[a_c] += a_e; a_ax > MPK[a_c] ? MPK[a_c] = a_ax;);
    );
    RAMP[a_c] ? (
      CUR[a_c] += STEP[a_c];
      ((STEP[a_c] > 0 && CUR[a_c] >= RTGT[a_c]) || (STEP[a_c] < 0 && CUR[a_c] <= RTGT[a_c]) || STEP[a_c] === 0) ? (
        CUR[a_c] = RTGT[a_c]; RAMP[a_c] = 0;
      );
      GLIN[a_c] = CUR[a_c] <= GFLOOR ? 0 : 10 ^ (CUR[a_c] / 20);
    );
    a_y = a_x * GLIN[a_c];
    spl(a_c) = a_y;
    a_ay = abs(a_y); a_ay > BPK[a_c] ? BPK[a_c] = a_ay;
    BEN[a_c] += a_y * a_y;
    a_kout ? BKE[a_c] += sqr(a_kw(a_y, KOUT + a_c * 4));
  );
  a_c += 1;
);
a_binon ? (
  AU_NS += 1; AU_BPOS += 1;
  AU_BPOS >= a_lbinlen ? (
    AU_NB < MAXB ? (
      a_c = 0; loop(8, MB[a_c * MAXB + AU_NB] = MBACC[a_c] / AU_BPOS; MBACC[a_c] = 0; a_c += 1;);
      AU_NB += 1;
    );
    AU_BPOS = 0;
  );
);
);
// ---------- Saturator: after the built-in Act ----------
// meters and level matching are only for the window (and its hold buttons)
c_uion ? (
  c_ei += c_r0 * c_r0 + c_r1 * c_r1; c_eo += spl0 * spl0 + spl1 * spl1;
  a_t = abs(c_x0); a_t > c_ip0 ? c_ip0 = a_t; a_t = abs(c_x1); a_t > c_ip1 ? c_ip1 = a_t;
);
// held Bypass (crossfaded) and held Swap (its level-matching trim, glided)
(c_bpv > 0 || c_bph || c_tr != 1 || c_trt != 1) ? (
  c_bpv = max(0, min(1, c_bpv + (c_bph ? c_bps : -c_bps)));
  c_tr += (c_trt - c_tr) * c_trk; abs(c_tr - c_trt) < 0.00001 ? c_tr = c_trt;
  spl0 = spl0 * c_tr * (1 - c_bpv) + c_q0 * c_bpg * c_bpv;
  spl1 = spl1 * c_tr * (1 - c_bpv) + c_q1 * c_bpg * c_bpv;
);
c_anw ? (ANI[c_ap] = (c_r0 + c_r1) * 0.5; ANO[c_ap] = (spl0 + spl1) * 0.5; ANS[c_ap] = (spl2 + spl3) * 0.5; c_ap = (c_ap + 1) & 8191;);
// audio key: hand this plug-in's output samples to a later plug-in that asked for them (the very last thing)
a_wr ? (gmem[a_wr0 + a_wp] = spl0; gmem[a_wr0 + AUD_R + a_wp] = spl1; a_wp = (a_wp + 1) & AUD_MASK;);

@gfx 1040 780
frame_begin(900);
fin_compute();
g_fin = MYSLOT >= 0 ? FIN[MYSLOT] : 0;
g_live_me = MYSLOT >= 0 && g_live(MYSLOT, g_now);
g_prep();
g_sel = max(0, min(g_nb - 1, floor(slider(P_SEL) + 0.5)));
g_sel != slider(P_SEL) ? g_selband(g_sel);
g_ma = 0; g_i = 0; loop(NMOD, slider(mp(g_i, M_TYPE)) >= 0.5 ? g_ma = 1; g_i += 1;);

// ---- top bar (shared): title, finale, Presets, A/B, Swap, Bypass, Settings ----
top_bar("TWOSTORMS SATURATOR", 1);
MYSLOT >= 0 ? track_name(#g_tn, MYSLOT) : strcpy(#g_tn, "");
d_dint > 0 ? sprintf(#g_lt, "latency %.1f ms (oversampling)", c_latms) : strcpy(#g_lt, "no latency");
sprintf(#g_sub, "%s    %s    playing: %s", #g_tn, #g_lt, c_side ? "B" : "A");
!g_script_ok ? strcat(#g_sub, "    (helper script not running)");
g_script_old ? strcat(#g_sub, "    (old helper script running: replace it)");
gfx_setfont(3); c_dim(); text(#g_sub, 12, 34, 876, 16, 4);
g_y = 56;

// ---- settings: meters, zoom, finale ----
g_cset ? (
  c_panel(); rect(6, g_y - 4, 888, 76, 1);
  label("Peak hold", 12, g_y, 64);
  dropdown(78, g_y, 86, 22, g_key(-1, P_HOLD), 320, 6, 1);
  label("Meter range", 178, g_y, 80);
  dropdown(260, g_y, 80, 22, g_key(-1, P_RANGE), 330, 6, 1);
  label("Zoom", 356, g_y, 40);
  dropdown(398, g_y, 80, 22, g_key(-1, P_ZOOM), 360, 6, 1);
  label("Finale", 494, g_y, 44);
  dropdown(540, g_y, 86, 22, g_key(-1, P_FINAL), 370, 3, 1);
  g_fm = floor(slider(si(P_FINAL)) + 0.5);
  g_fc = MYSLOT >= 0 ? fin_of_chain(MYSLOT) : -1;
  g_warn = 0;
  g_fm == FIN_NEVER ? strcpy(#g_fs, "Never on the Finales tab.") : (
    g_fin ? (
      fin_tail(MYSLOT) ? (strcpy(#g_fs, "Finale, but plug-ins after it change the output."); g_warn = 1;)
                       : strcpy(#g_fs, g_fin == 2 ? "Always on the Finales tab." : "The finale: the last Act in its chain.");
    ) : (
      g_fc >= 0 ? (point_title(#g_ft, g_fc); sprintf(#g_fs, "Not the finale: %s is.", #g_ft);) : strcpy(#g_fs, "Not the finale.");
    );
  );
  gfx_setfont(3); g_warn ? c_red() : (g_fin ? c_orange() : c_dim());
  text(#g_fs, 634, g_y, 254, 22, 4);
  c_faint();
  text("Bypass (Lvl Match) plays the input at the same loudness; Swap (Lvl Match) plays the other A/B set at this one's loudness.", 12, g_y + 28, 876, 16, 4);
  text("Click to latch these, A/B and Delta; Shift + click and hold to use them only while the mouse is held.", 12, g_y + 44, 876, 16, 4);
  sprintf(#g_idt, "Plugin ID %d", MYID); text(#g_idt, 12, g_y + 44, 876, 16, 6);
  g_y += 80;
);

// ---- the display: spectrum behind, one region per band (its top edge = its drive), the crossovers between ----
g_ax = 12; g_ay = g_y; g_aw = 796; g_ah = 300;
g_dpy = g_ay;
c_well(); rect(g_ax, g_ay, g_aw, g_ah, 1);
gfx_setfont(3);
g_i = 0;
loop(8,
  g_f = g_i == 0 ? 50 : (g_i == 1 ? 100 : (g_i == 2 ? 200 : (g_i == 3 ? 500 : (g_i == 4 ? 1000 : (g_i == 5 ? 2000 : (g_i == 6 ? 5000 : 10000))))));
  setc(0.15, 0.15, 0.17); rect(an_x(g_f), g_ay, 1 / g_sc, g_ah, 1);
  g_f >= 1000 ? sprintf(#g_fl, "%dk", g_f / 1000) : sprintf(#g_fl, "%d", g_f);
  c_faint(); text(#g_fl, an_x(g_f) + 2, g_ay + g_ah - 13, 30, 12, 4);
  g_i += 1;
);
g_i = 1;
loop(3, setc(0.12, 0.12, 0.14); rect(g_ax, g_ay + g_ah * g_i / 4, g_aw, 1 / g_sc, 1); c_faint(); sprintf(#g_fl, "%d%%", 100 - 25 * g_i); text(#g_fl, g_ax + g_aw - 40, g_ay + g_ah * g_i / 4 - 12, 36, 12, 6); g_i += 1;);
// the analyzer: pre = grey fill, post = orange line
g_an = floor(slider(P_AN) + 0.5);
(g_live_me && g_an > 0) ? (
  g_annorm = 20 * log10(4096 / 4);
  (g_an == 1 || g_an == 3) ? (an_fft(ANI, SPI, 4096); setc(0.21, 0.21, 0.25); an_draw(SPI, 4096, 1););
  (g_an == 2 || g_an == 3) ? (
    an_fft(ANO, SPO, 4096);
    g_an == 2 ? (setc(0.25, 0.15, 0.05); an_draw(SPO, 4096, 1););
    c_orange(); gfx_a = 0.75; an_draw(SPO, 4096, 0); gfx_a = 1;
  );
);
// where everything is
g_mxd = (g_mx - g_ox) / g_sc; g_myd = (g_my - g_oy) / g_sc;
g_ind = g_mxd >= g_ax && g_mxd < g_ax + g_aw && g_myd >= g_ay && g_myd < g_ay + g_ah;
g_b = 0;
loop(g_nb,
  GRX0[g_b] = g_b == 0 ? g_ax : an_x(GXF[g_b - 1]);
  GRX1[g_b] = g_b == g_nb - 1 ? g_ax + g_aw : an_x(GXF[g_b]);
  GHX[g_b] = (GRX0[g_b] + GRX1[g_b]) * 0.5;
  GHY[g_b] = g_ay + g_ah * (1 - max(0, min(100, slider(ep(g_b, K_DRIVE)))) / 100);
  g_b += 1;
);
g_i = 0; loop(g_nb - 1, GXX[g_i] = an_x(GXF[g_i]); g_i += 1;);
// what is under the mouse: a solo / mute icon, a drive handle, a crossover, or a band's region
g_ih = -1; g_hh = -1; g_xh = -1; g_rg = -1; g_best = 1000000;
g_ind ? (
  g_b = 0;
  loop(g_nb,
    (GRX1[g_b] - GRX0[g_b] >= 22) ? (
      (g_mxd >= GRX0[g_b] + 3 && g_mxd < GRX0[g_b] + 15) ? (
        (g_myd >= g_ay + 16 && g_myd < g_ay + 28) ? g_ih = g_b * 2;
        (g_myd >= g_ay + 30 && g_myd < g_ay + 42) ? g_ih = g_b * 2 + 1;
      );
    );
    g_dd2 = sqrt(sqr(g_mxd - GHX[g_b]) + sqr(g_myd - GHY[g_b]));
    (g_dd2 < 10 && g_dd2 < g_best) ? (g_best = g_dd2; g_hh = g_b;);
    g_b += 1;
  );
  g_i = 0; loop(g_nb - 1, abs(g_mxd - GXX[g_i]) < 5 ? g_xh = g_i; g_i += 1;);
  g_rg = g_bandat(an_f(g_mxd));
  g_ih >= 0 ? (g_hh = -1; g_xh = -1;);
  g_hh >= 0 ? g_xh = -1;
);
g_xdrag >= 0 ? (g_xh = g_xdrag; g_hh = -1; g_ih = -1;);
g_hdrag >= 0 ? (g_hh = g_hdrag; g_xh = -1; g_ih = -1;);
g_soloact = g_solo_m >= 0 ? g_solo_m : g_solo_l;
// the regions
g_b = 0;
loop(g_nb,
  g_x0 = GRX0[g_b]; g_x1 = GRX1[g_b];
  g_bon = slider(ep(g_b, K_ON)) >= 0.5 && slider(ep(g_b, K_MUTE)) < 0.5;
  g_b == g_sel ? (band_col(g_b, 0.09); rect(g_x0, g_ay, g_x1 - g_x0, g_ah, 1););
  g_bon ? band_col(g_b, 0.24) : setc(0.35, 0.34, 0.33);
  g_bon ? 0 : (gfx_a = 0.10);
  rect(g_x0, GHY[g_b], g_x1 - g_x0, g_ay + g_ah - GHY[g_b], 1);
  g_bon ? band_col(g_b, 0.95) : (setc(0.40, 0.38, 0.36));
  rect(g_x0, GHY[g_b] - 1, g_x1 - g_x0, 2, 1);
  // the band's level in and out
  (g_live_me && g_x1 - g_x0 > 30) ? (
    setc(0.40, 0.40, 0.45);
    g_mh = g_ah * max(0, min(1, (g_lin2db(EF[g_b]) + 60) / 60)); rect(g_x1 - 9, g_ay + g_ah - g_mh, 3, g_mh, 1);
    band_col(g_b, 1);
    g_mh = g_ah * max(0, min(1, (g_lin2db(EO[g_b]) + 60) / 60)); rect(g_x1 - 5, g_ay + g_ah - g_mh, 3, g_mh, 1);
  );
  // number, solo, mute
  (g_x1 - g_x0 >= 22) ? (
    gfx_setfont(3); band_col(g_b, 1);
    sprintf(#g_cvs, "%d", g_b + 1); text(#g_cvs, g_x0 + 3, g_ay + 2, 12, 12, 5);
    g_soloact == g_b ? band_col(g_b, 1) : (g_ih == g_b * 2 ? setc(0.30, 0.29, 0.28) : setc(0.16, 0.155, 0.15));
    rect(g_x0 + 3, g_ay + 16, 12, 12, 1);
    g_soloact == g_b ? setc(0.05, 0.04, 0.03) : c_border(); rect(g_x0 + 3, g_ay + 16, 12, 12, 0);
    g_soloact == g_b ? setc(0.05, 0.04, 0.03) : c_dim(); text("S", g_x0 + 3, g_ay + 15, 12, 12, 5);
    slider(ep(g_b, K_MUTE)) >= 0.5 ? setc(0.95, 0.33, 0.28) : (g_ih == g_b * 2 + 1 ? setc(0.30, 0.29, 0.28) : setc(0.16, 0.155, 0.15));
    rect(g_x0 + 3, g_ay + 30, 12, 12, 1);
    slider(ep(g_b, K_MUTE)) >= 0.5 ? setc(0.05, 0.04, 0.03) : c_border(); rect(g_x0 + 3, g_ay + 30, 12, 12, 0);
    slider(ep(g_b, K_MUTE)) >= 0.5 ? setc(0.05, 0.04, 0.03) : c_dim(); text("M", g_x0 + 3, g_ay + 29, 12, 12, 5);
    g_st = max(0, min(NSTY - 1, floor(slider(ep(g_b, K_STYLE)) + 0.5)));
    c_dim(); text(540 + g_st, g_x0 + 20, g_ay + 2, g_x1 - g_x0 - 24, 12, 4);
  );
  g_b += 1;
);
// the crossovers
g_i = 0;
loop(g_nb - 1,
  g_hv = g_xh == g_i;
  g_hv ? setc(1.0, 0.95, 0.88) : setc(0.50, 0.48, 0.46);
  rect(GXX[g_i] - (g_hv ? 1 : 0), g_ay, g_hv ? 2 : 1, g_ah, 1);
  g_hv ? setc(1.0, 0.95, 0.88) : setc(0.30, 0.29, 0.28);
  rect(GXX[g_i] - 3, g_ay + g_ah * 0.5 - 12, 6, 24, 1);
  c_border(); rect(GXX[g_i] - 3, g_ay + g_ah * 0.5 - 12, 6, 24, 0);
  g_hv ? (
    fmt_hz(#g_fl, GXF[g_i]); gfx_setfont(2); c_text();
    text(#g_fl, GXX[g_i] - 36, g_ay + g_ah * 0.5 - 30, 72, 14, 5);
  );
  g_i += 1;
);
// the drive handles
g_b = 0;
loop(g_nb,
  g_hy = max(g_ay + 8, min(g_ay + g_ah - 8, GHY[g_b]));
  band_col(g_b, 1);
  gfx_circle(X(GHX[g_b]), Y(g_hy), (g_b == g_sel || g_b == g_hh ? 8 : 6.5) * g_sc, 1, 1);
  g_b == g_sel ? (setc(1, 1, 1); gfx_circle(X(GHX[g_b]), Y(g_hy), 8.5 * g_sc, 0, 1););
  gfx_setfont(3); setc(0.05, 0.04, 0.03);
  sprintf(#g_cvs, "%d", g_b + 1);
  text(#g_cvs, GHX[g_b] - 8, g_hy - 7, 16, 14, 5);
  g_b += 1;
);
c_border(); rect(g_ax, g_ay, g_aw, g_ah, 0);
// the line of help (or what is under the mouse)
gfx_setfont(3); c_dim();
g_hh >= 0 ? (
  sprintf(#g_hint, "Band %d: %s    drive %.1f%%    drag up or down", g_hh + 1, 540 + max(0, min(NSTY - 1, floor(slider(ep(g_hh, K_STYLE)) + 0.5))), slider(ep(g_hh, K_DRIVE)));
) : (g_xh >= 0 ? (
  fmt_hz(#g_fl, GXF[g_xh]); sprintf(#g_hint, "Crossover %d: %s    drag sideways; right-click to remove", g_xh + 1, #g_fl);
) : strcpy(#g_hint, "Drag a handle up or down for the band's drive, a crossover sideways. Double-click a band to split it; right-click for more. Shift + click and hold S to solo while held."););
text(#g_hint, g_ax + 2, g_ay + g_ah + 3, 796, 14, 4);
// the meters, input and output
gfx_setfont(3); c_dim();
text("IN", 816, g_ay, 24, 12, 5); text("OUT", 862, g_ay, 28, 12, 5);
vmeter(816, g_ay + 14, 10, g_ah - 30, c_mi0, g_live_me);
vmeter(828, g_ay + 14, 10, g_ah - 30, c_mi1, g_live_me);
g_b = SLOTBASE + MYSLOT * SLOTSZ;
vmeter(866, g_ay + 14, 10, g_ah - 30, MYSLOT >= 0 ? gmem[g_b + O_PKD] : -200, g_live_me);
vmeter(878, g_ay + 14, 10, g_ah - 30, MYSLOT >= 0 ? gmem[g_b + O_PKD + 1] : -200, g_live_me);

// mouse on the display
(g_ind && g_lclick && !g_used) ? (
  g_used = 1;
  g_ih >= 0 ? (
    g_ib = floor(g_ih / 2); g_selband(g_ib);
    (g_ih % 2) == 0 ? (
      (g_cap & 8) ? (g_solo_m = g_ib;) : (g_solo_l = (g_solo_l == g_ib ? -1 : g_ib););
    ) : g_kset(g_key(-1, ep(g_ib, K_MUTE)), slider(ep(g_ib, K_MUTE)) < 0.5, 1);
  ) : (g_hh >= 0 ? (
    g_selband(g_hh);
    (g_now - g_hclk_t < 0.35 && g_hclk_b == g_hh) ? (
      g_kset(g_key(-1, ep(g_hh, K_DRIVE)), PDEF[ep(g_hh, K_DRIVE)], 1); g_hclk_t = 0;
    ) : (
      g_hdrag = g_hh; g_hdy = g_myd - GHY[g_hh]; g_hclk_t = g_now; g_hclk_b = g_hh;
    );
  ) : (g_xh >= 0 ? (
    g_xdrag = g_xh; g_xdx = g_mxd - GXX[g_xh];
  ) : (g_rg >= 0 ? (
    g_selband(g_rg);
    (g_now - g_dclk_t < 0.35) ? (g_split(g_rg, an_f(g_mxd)); g_dclk_t = 0;) : (g_dclk_t = g_now;);
  ))));
);
(g_ind && g_rclick && !g_used) ? (
  g_used = 1;
  gfx_x = g_mx; gfx_y = g_my;
  g_xh >= 0 ? (
    gfx_showmenu("Remove this crossover (merge the bands)") == 1 ? g_merge(g_xh, 0);
  ) : (g_rg >= 0 ? (
    g_selband(g_rg);
    g_r = gfx_showmenu("Solo this band|Mute this band|Split here|Delete band");
    g_r == 1 ? g_solo_l = (g_solo_l == g_rg ? -1 : g_rg);
    g_r == 2 ? g_kset(g_key(-1, ep(g_rg, K_MUTE)), slider(ep(g_rg, K_MUTE)) < 0.5, 1);
    g_r == 3 ? g_split(g_rg, an_f(g_mxd));
    g_r == 4 ? g_delband(g_rg);
  ););
);
(g_ind && g_wheel != 0 && !g_used && !(g_cap & 8) && g_rg >= 0) ? (
  g_used = 1;
  g_selband(g_rg);
  g_kset(g_key(-1, ep(g_rg, K_DRIVE)), max(0, min(100, slider(ep(g_rg, K_DRIVE)) + (g_wheel > 0 ? 1 : -1) * (g_fine ? 0.5 : 2))), 1);
);
(g_xdrag >= 0 && (g_cap & 1)) ? (
  g_i = g_xdrag;
  g_flo = g_i == 0 ? 24 : GXF[g_i - 1] * 1.2;
  g_fhi = g_i == g_nb - 2 ? 20000 : GXF[g_i + 1] / 1.2;
  g_kset(g_key(-1, P_XF + g_i), max(g_flo, min(g_fhi, an_f(g_mxd - g_xdx))), 0);
);
(g_xdrag >= 0 && !(g_cap & 1)) ? (g_kset(g_key(-1, P_XF + g_xdrag), slider(P_XF + g_xdrag), 1); g_xdrag = -1;);
(g_hdrag >= 0 && (g_cap & 1)) ? (
  g_kset(g_key(-1, ep(g_hdrag, K_DRIVE)), floor(max(0, min(100, (g_ay + g_ah - (g_myd - g_hdy)) / g_ah * 100)) * 10 + 0.5) / 10, 0);
);
(g_hdrag >= 0 && !(g_cap & 1)) ? (g_kset(g_key(-1, ep(g_hdrag, K_DRIVE)), slider(ep(g_hdrag, K_DRIVE)), 1); g_hdrag = -1;);
!(g_cap & 1) ? g_solo_m = -1;
c_uisolo = g_solo_m >= 0 ? g_solo_m : g_solo_l;
g_y = g_dpy + 300 + 24;

// ---- the bands: a numbered chip each, then slope, oversampling, analyzer, delta ----
label("Bands", 12, g_y - 1, 48);
g_b = 0;
loop(NB, chip(60 + g_b * 34, g_y, 30, 22, g_b); g_b += 1;);
cdd(272, g_y, 150, 22, g_key(-1, P_SLOPE), 480, 3, "Slope:", 1);
cdd(426, g_y, 150, 22, g_key(-1, P_OS), 485, 3, "Oversampling:", 1);
cdd(580, g_y, 134, 22, g_key(-1, P_AN), 470, 4, "Analyzer:", 1);
mtog(720, g_y + 1, 64, "Delta", P_DELTA, 1);
g_y += 30;

// ---- the selected band ----
g_sb = g_sel;
g_son = slider(ep(g_sb, K_ON)) >= 0.5;
gfx_setfont(2); band_col(g_sb, 1);
sprintf(#g_bl, "Band %d", g_sb + 1); text(#g_bl, 12, g_y, 60, 20, 4); gfx_a = 1;
ctog(74, g_y, 40, "On", ep(g_sb, K_ON), 0);
ctog(118, g_y, 50, "Mute", ep(g_sb, K_MUTE), 0);
button(172, g_y, 46, 20, "Solo", g_soloact == g_sb, 1, 1) ? ((g_cap & 8) ? (g_solo_m = g_sb;) : (g_solo_l = (g_solo_l == g_sb ? -1 : g_sb);););
style_dd(222, g_y, 158, 20, g_sb);
cdd(384, g_y, 128, 20, g_key(-1, ep(g_sb, K_CH)), 490, 2, "Mode:", 1);
gfx_setfont(3); c_dim(); text("Range", 520, g_y, 40, 20, 4);
g_sb > 0 ? (
  fmt_hz(#g_cv, GXF[g_sb - 1]);
  valbox(558, g_y, 66, 20, g_key(-1, P_XF + g_sb - 1), log(PHI[P_XF] / PLO[P_XF]) / 138, log(PHI[P_XF] / PLO[P_XF]) / 1380, 5, #g_cv, 1);
) : (valbox(558, g_y, 66, 20, -5, 1, 1, 5, "20 Hz", 0););
gfx_setfont(3); c_dim(); text("to", 626, g_y, 14, 20, 5);
g_sb < g_nb - 1 ? (
  fmt_hz(#g_cv, GXF[g_sb]);
  valbox(642, g_y, 66, 20, g_key(-1, P_XF + g_sb), log(PHI[P_XF] / PLO[P_XF]) / 138, log(PHI[P_XF] / PLO[P_XF]) / 1380, 5, #g_cv, 1);
) : (valbox(642, g_y, 66, 20, -5, 1, 1, 5, "20 kHz", 0););
button(782, g_y, 106, 20, "Delete band", 0, g_nb > 1, 0) ? g_delband(g_sb);
g_y += 28;
mctl("Drive", 12, g_y, ep(g_sb, K_DRIVE), 0, g_son);
mctl("Mix", 12, g_y + 28, ep(g_sb, K_MIX), 0, g_son);
mctl("Level", 12, g_y + 56, ep(g_sb, K_LEVEL), 0, g_son);
mctl("Dynamics", 12, g_y + 84, ep(g_sb, K_DYN), 0, g_son);
mctl("Feedback", 12, g_y + 112, ep(g_sb, K_FB), 0, g_son);
mctl("FB freq", 12, g_y + 140, ep(g_sb, K_FBF), 1, g_son);
mctl("Bass", 308, g_y, ep(g_sb, K_BASS), 0, g_son);
mctl("Mid", 308, g_y + 28, ep(g_sb, K_MID), 0, g_son);
mctl("Treble", 308, g_y + 56, ep(g_sb, K_TRE), 0, g_son);
mctl("Presence", 308, g_y + 84, ep(g_sb, K_PRES), 0, g_son);
mctl(slider(ep(g_sb, K_CH)) >= 0.5 ? "Drive M/S" : "Drive L/R", 308, g_y + 112, ep(g_sb, K_DPAN), 0, g_son);
mctl(slider(ep(g_sb, K_CH)) >= 0.5 ? "Level M/S" : "Level L/R", 308, g_y + 140, ep(g_sb, K_LPAN), 0, g_son);
g_curve(604, g_y, 284, 166, g_sb);
gfx_setfont(3); c_faint();
text("Dynamics: + levels the band before it saturates, - gates it.  Feedback: output fed back through a band pass at FB freq.  Bass..Presence: tone.", 12, g_y + 170, 876, 16, 4);
g_y += 190;

// ---- the whole plug-in: input, drive and dynamics for every band, dry/wet ----
g_inact = g_drag_k == g_key(-1, P_IN) || hit(12, g_y, 284, 20);
g_inact ? g_fine = (g_cap & 8) != 0;
g_iolw = g_inact && (g_cap & 4) != 0;
(slider(P_IOL) >= 0.5) != g_iolw ? g_kset(g_key(-1, P_IOL), g_iolw, 1);
mctl("Input", 12, g_y, P_IN, 0, 1);
mctl("All drive", 308, g_y, P_GDRV, 0, 1);
mctl("All dyn.", 604, g_y, P_GDYN, 0, 1);
g_y += 28;
mctl("Dry/wet", 12, g_y, P_MIX, 0, 1);
ctog(308, g_y, 150, "Modulation", P_MODOPEN, 1);
gfx_setfont(3); c_dim();
text("8 slots: LFO, follower or MIDI moving any setting.", 466, g_y, 420, 20, 4);
g_y += 30;

// ---- modulation ----
slider(P_MODOPEN) >= 0.5 ? (
  c_panel(); rect(6, g_y - 4, 888, 8 * 26 + 24, 1);
  gfx_setfont(3); c_faint();
  text("Type", 32, g_y, 80, 14, 4); text("Target", 126, g_y, 80, 14, 4); text("Setting", 214, g_y, 80, 14, 4); text("Amount", 330, g_y, 80, 14, 4);
  text("Shape / source / CC", 466, g_y, 200, 14, 4); text("Now", 800, g_y, 80, 14, 4);
  g_y += 16;
  g_i = 0;
  loop(NMOD, g_modrow(12, g_y, g_i); g_y += 26; g_i += 1;);
  g_y += 14;
);

// ---- output: the built-in Act, laid out like an Act card in the Gain Stage (the drive link where Auto all's tick and name are) ----
g_ch2 = 38 + 26;
c_card(); rect(6, g_y, 888, g_ch2, 1);
setc(0.20, 0.19, 0.18); rect(6, g_y, 888, g_ch2, 0);
drive_label(#g_dlb, -1);
g_dl = slider(si(P_DRIVE)) >= DRIVE_PARAM; g_don = slider(si(P_DRIVEON)) >= 0.5;
checkbox(16, g_y + 10, g_don && g_dl, g_dl) ? g_kset(g_key(-1, P_DRIVEON), !g_don, 1);
button(38, g_y + 6, 280, 22, #g_dlb, g_dl && g_don, MYSLOT >= 0, 1) ? drive_menu(-1, 38, g_y + 28);
// ... | mode | value | channels | Peak/RMS/LUFS | time | Auto
button(324, g_y + 6, 28, 22, "...", 0, 1, 0) ? act_menu(324, g_y + 28);
mode_ctl(356, g_y + 6, 96, -1, 1, 1);
value_ctl(456, g_y + 6, 130, -1, 1);
auto_mode(-1) != 0 ? src_ctl(590, g_y + 6, 76, 22, -1, 0, 1, 1);
dropdown(666, g_y + 6, 80, 22, g_key(-1, P_MEAS), 310, 3, 1);
auto_time_box(750, g_y + 6, 70, 22, -1, 1);
button(826, g_y + 6, 62, 22, auto_label(-1), auto_busy(-1), MYSLOT >= 0, 0) ? auto_click(-1);
// the gain group: meters, readouts, gain
g_tgt = aim_tick(-1);
gfx_setfont(3); c_dim(); text("1-2", 16, g_y + 36, 36, 20, 4);
meter(54, g_y + 36, 410, 9, MYSLOT, 0, g_tgt, g_live_me);
meter(54, g_y + 47, 410, 9, MYSLOT, 1, g_tgt, g_live_me);
readouts(472, g_y + 36, MYSLOT, 0, 2, g_live_me);
gain_ctl(630, g_y + 36, 168, g_key(-1, P_GAIN), 1);
g_y += g_ch2 + 8;
frame_end(g_y);
