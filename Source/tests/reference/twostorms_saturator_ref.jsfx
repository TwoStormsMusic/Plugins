// ---- A/B: the settings that make up a set (not the output gain, which the Gain Stage stages) ----
ABL = alloc(240); ABN = 0;
function ab_add(p) ( ABL[ABN] = p; ABN += 1; );
ab_add(P_NB); ab_add(P_SLOPE); ab_add(P_IN); ab_add(P_GDRV); ab_add(P_GDYN); ab_add(P_MIX);
a_i = P_XF; loop(5, ab_add(a_i); a_i += 1;);
a_i = EB0; loop(NB * EBN, ab_add(a_i); a_i += 1;);
a_i = MB0; loop(NMOD * MN, ab_add(a_i); a_i += 1;);
ABSET = alloc_keep(256);
!ABS_INIT ? (a_i = 0; loop(ABN, ABSET[ABL[a_i]] = slider(ABL[a_i]); a_i += 1;); ABS_INIT = 1;);
LMI = alloc(2); LMO = alloc(2); LMV = alloc(2);
function c_pv(p) ( c_swh ? ABSET[p] : slider(p); );

QT = alloc(8);
QT[0] = 0.5411961; QT[1] = 1.306563; QT[2] = 0.5097956; QT[3] = 0.6013449; QT[4] = 0.8999762; QT[5] = 2.5629154;


// ---- the engine: buffers and state ----
BSTR = 96;                                  // per band and channel: states
ZPRE = 0; ZPOST = 8; ZTONE = 16; ZDC = 24; ZFB = 26; ZSH = 32; ZUA = 48; ZUB = 54; ZDA = 58; ZDB = 65;
BSZ = alloc(NB * 2 * BSTR);
PCO = alloc(NB * 60);                       // per band: pre (4 sections), style post (4), tone (4 slots), 5 numbers each
PNS = alloc(NB); QNS = alloc(NB); TON = alloc(NB * 4); BSTc = alloc(NB); TCH = alloc(NB * 8);
BON = alloc(NB); BMU = alloc(NB); BST = alloc(NB); BMS = alloc(NB); BOS = alloc(NB); BSOL = alloc(NB);
DGc = alloc(NB * 2); DGi = alloc(NB * 2); PGc = alloc(NB * 2); PGi = alloc(NB * 2); DRVP = alloc(NB * 2);
MXc = alloc(NB); MXi = alloc(NB); GDc = alloc(NB); GDi = alloc(NB); FBc = alloc(NB); FBi = alloc(NB); OGc = alloc(NB); OGt = alloc(NB);
EF = alloc(NB); ES = alloc(NB); FBK = alloc(NB * 4); GDB = alloc(NB); FBON = alloc(NB);
DDL = alloc(NB * 2 * 16); BSG = alloc(16); ETM = alloc(24); UPO = alloc(8);
XC = alloc(5 * 40); XA = alloc(5 * 10); XZ = alloc(5 * 2 * 16); AZ = alloc(6 * 5 * 2 * 4); XFc = alloc(5); XFt = alloc(5); XFd = alloc(5);
EFFP = alloc(256); MV = alloc(NMOD); MPH = alloc(NMOD); MRA = alloc(NMOD); MRB = alloc(NMOD); MEN = alloc(NMOD); MKA = alloc(NMOD); MKR = alloc(NMOD);
MCC = alloc(130); MLS = alloc(NMOD); MSR = alloc(NMOD); MSB = alloc(NMOD); MFL = alloc(NMOD); EO = alloc(NB);
DRW = alloc(256);                           // the raw input, delayed by the oversampling latency: 4 x 64
a_i = 0; loop(NB, a_k = BSZ + a_i * 2 * BSTR; a_k[ZSH] = 1; a_k[BSTR + ZSH] = 1; a_i += 1;);   // breakdown's flip-flop starts at +1
// analyzer: pre (input), post (output) and sidechain, the last 8192 samples
ANI = alloc(8192); ANO = alloc(8192); ANS = alloc(8192);
a_mem = ceil(a_mem / 8192) * 8192;          // FFT buffers must not cross a 65536-slot boundary
FFA = alloc(8192);
SPI = alloc(2048); SPO = alloc(2048); SPS = alloc(2048);
a_i = 0; loop(2048, SPI[a_i] = -200; SPO[a_i] = -200; SPS[a_i] = -200; a_i += 1;);
BNV = alloc(NB * 2); BNO = alloc(NB * 2);   // per band: level in and out (dB), for the window
c_tr = 1; c_trt = 1; c_hbi = -200; c_mi0 = -200; c_mi1 = -200; c_mo0 = -200; c_uisolo = -1;
d_nb = 3; d_slope = 1; d_os = 0; d_osf = 1; d_tc = 0; d_dp = 0; d_snap = 1; d_csr = 0; d_cdp = 0;
MKB = alloc(8);

// the oversampling halfband filters: polyphase all-pass pairs (3 + 3 for 1 -> 2, 2 + 2 for 2 -> 4)
OSA = alloc(6); OSA[0] = 0.042739; OSA[1] = 0.324518; OSA[2] = 0.698222; OSA[3] = 0.159812; OSA[4] = 0.509278; OSA[5] = 0.893506;
OSB = alloc(4); OSB[0] = 0.048108; OSB[1] = 0.436836; OSB[2] = 0.193414; OSB[3] = 0.778879;
// the delay of an oversampled band in input samples (and so how late the dry has to be): 2x 3.21, 4x 4.51
function d_ups(x, z, c, n, o) local(k, y, a, w)
(
  y = x; k = 0;
  loop(n, a = c[k]; w = y - a * z[k]; y = a * w + z[k]; z[k] = w; k += 1;);
  o[0] = y;
  y = x; k = 0;
  loop(n, a = c[n + k]; w = y - a * z[n + k]; y = a * w + z[n + k]; z[n + k] = w; k += 1;);
  o[1] = y;
);
function d_dns(x0, x1, z, c, n) local(k, y, y0, a, w)
(
  y = x0; k = 0;
  loop(n, a = c[k]; w = y - a * z[k]; y = a * w + z[k]; z[k] = w; k += 1;);
  y0 = y;
  y = z[2 * n]; k = 0;
  loop(n, a = c[n + k]; w = y - a * z[n + k]; y = a * w + z[n + k]; z[n + k] = w; k += 1;);
  z[2 * n] = x1;
  0.5 * (y0 + y);
);
// the same, unrolled for the two half-band stages (3 and 2 allpasses per path)
function d_ups3(x, z, c, o) local(y, w)
(
  y = x; w = y - c[0] * z[0]; y = c[0] * w + z[0]; z[0] = w; w = y - c[1] * z[1]; y = c[1] * w + z[1]; z[1] = w; w = y - c[2] * z[2]; y = c[2] * w + z[2]; z[2] = w; o[0] = y;
  y = x; w = y - c[3] * z[3]; y = c[3] * w + z[3]; z[3] = w; w = y - c[4] * z[4]; y = c[4] * w + z[4]; z[4] = w; w = y - c[5] * z[5]; y = c[5] * w + z[5]; z[5] = w; o[1] = y;
);
function d_dns3(x0, x1, z, c) local(y, y0, w)
(
  y = x0; w = y - c[0] * z[0]; y = c[0] * w + z[0]; z[0] = w; w = y - c[1] * z[1]; y = c[1] * w + z[1]; z[1] = w; w = y - c[2] * z[2]; y = c[2] * w + z[2]; z[2] = w; y0 = y;
  y = z[6]; w = y - c[3] * z[3]; y = c[3] * w + z[3]; z[3] = w; w = y - c[4] * z[4]; y = c[4] * w + z[4]; z[4] = w; w = y - c[5] * z[5]; y = c[5] * w + z[5]; z[5] = w; z[6] = x1;
  0.5 * (y0 + y);
);
function d_ups2(x, z, c, o) local(y, w)
(
  y = x; w = y - c[0] * z[0]; y = c[0] * w + z[0]; z[0] = w; w = y - c[1] * z[1]; y = c[1] * w + z[1]; z[1] = w; o[0] = y;
  y = x; w = y - c[2] * z[2]; y = c[2] * w + z[2]; z[2] = w; w = y - c[3] * z[3]; y = c[3] * w + z[3]; z[3] = w; o[1] = y;
);
function d_dns2(x0, x1, z, c) local(y, y0, w)
(
  y = x0; w = y - c[0] * z[0]; y = c[0] * w + z[0]; z[0] = w; w = y - c[1] * z[1]; y = c[1] * w + z[1]; z[1] = w; y0 = y;
  y = z[4]; w = y - c[2] * z[2]; y = c[2] * w + z[2]; z[2] = w; w = y - c[3] * z[3]; y = c[3] * w + z[3]; z[3] = w; z[4] = x1;
  0.5 * (y0 + y);
);


// a biquad (b0 b1 b2 a1 a2, a0 = 1), transposed direct form II; z = two states
function d_bq(x, o, z) local(y) ( y = o[0] * x + z[0]; z[0] = o[1] * x - o[3] * y + z[1]; z[1] = o[2] * x - o[4] * y; y; );
function d_chain(x, o, n, z) local(k) ( k = 0; loop(n, x = d_bq(x, o + k * 5, z + k * 2); k += 1;); x; );

// ---- filter design (the audio thread and the window each have their own copy) ----
// Every filter is a matched biquad: the poles come from the analog prototype (matched z) and the numerator is
// set so the magnitude equals the analog filter's at DC, at the centre frequency and at Nyquist. The top octaves
// of bells, shelves, notches and low passes then stay close to the analog curve instead of cramping.
// A cut is the exact inverse of the boost of the same shape. If a design is not valid, the classic RBJ filter is used.

// the inverse filter: numerator and denominator swap (o = b0 b1 b2 a1 a2, a0 = 1)
function ea_inv(o) local(b0, b1, b2, a1, a2)
(
  b0 = o[0]; b1 = o[1]; b2 = o[2]; a1 = o[3]; a2 = o[4];
  o[0] = 1 / b0; o[1] = a1 / b0; o[2] = a2 / b0; o[3] = b1 / b0; o[4] = b2 / b0;
);

// the matched design for the analog prototypes (s in units of the centre frequency, A >= 1 for the boosts)
//   kind 0: bell (s^2 + s A/Q + 1) / (s^2 + s/(A Q) + 1)      kind 1: low shelf (boost)
//   kind 2: band pass (s/Q) / (s^2 + s/Q + 1)                  kind 3: low pass 1 / (s^2 + s/Q + 1)
// w = centre frequency in rad/sample. Returns 1 and fills o[0..4] when valid, else 0.
function ea_m3(kind, A, Q, w, o) local(rho, z, wp, e, a1, a2, sq, p1, p2, x2, qq, h0, hf, hn, d0, dn, cw, ww, vv, d2f, s1, s0, s2, t2, u, b1, disc, b0, b2, ok)
(
  kind == 0 ? (rho = 1; z = 0.5 / (A * Q);) : (kind == 1 ? (rho = 1 / sqrt(A); z = 0.5 / Q;) : (rho = 1; z = 0.5 / Q;));
  wp = w * rho;
  z < 1 ? (
    e = exp(-z * wp); a1 = -2 * e * cos(wp * sqrt(1 - z * z)); a2 = e * e;
  ) : (
    sq = sqrt(z * z - 1); p1 = exp(-wp * (z - sq)); p2 = exp(-wp * (z + sq));
    a1 = -(p1 + p2); a2 = p1 * p2;
  );
  x2 = $pi / w; x2 *= x2;
  qq = Q * Q;
  kind == 0 ? (
    hn = (sqr(1 - x2) + x2 * A * A / qq) / (sqr(1 - x2) + x2 / (A * A * qq)); h0 = 1; hf = sqr(A * A);
  ) : (kind == 1 ? (
    hn = A * A * (sqr(A - x2) + x2 * A / qq) / (sqr(1 - A * x2) + x2 * A / qq); h0 = sqr(A * A); hf = A * A;
  ) : (kind == 2 ? (
    hn = (x2 / qq) / (sqr(1 - x2) + x2 / qq); h0 = 0; hf = 1;
  ) : (
    hn = 1 / (sqr(1 - x2) + x2 / qq); h0 = 1; hf = qq;
  )));
  d0 = 1 + a1 + a2; dn = 1 - a1 + a2; cw = cos(w);
  ww = sqrt(h0) * d0; vv = sqrt(hn) * dn;
  d2f = 1 + a1 * a1 + a2 * a2 + 2 * (a1 + a1 * a2) * cw + 2 * a2 * cos(2 * w);
  s1 = (1 - cw) * 0.5; s0 = 1 - s1; s2 = 4 * s0 * s1;
  t2 = (hf * d2f - ww * ww * s0 - vv * vv * s1) / s2;
  u = (ww + vv) * 0.5; b1 = (ww - vv) * 0.5; disc = u * u + t2;
  ok = 0;
  disc >= 0 ? (
    b0 = (u + sqrt(disc)) * 0.5; b2 = u - b0;
    (abs(b0) > 0.000000001 && abs(b2 / b0) < 0.9999 && abs(b1 / b0) <= 1 + b2 / b0 + 0.000000001 && a2 < 0.9999 && abs(a1) < 1 + a2 - 0.000001) ? (
      o[0] = b0; o[1] = b1; o[2] = b2; o[3] = a1; o[4] = a2; ok = 1;
    );
  );
  ok;
);

// the classic RBJ bell / shelf / notch / band pass (the fallback), from w and sin/cos
function ea_rbj(type, w, g, q, o) local(cw, sw, al, A, sq, a0)
(
  cw = cos(w); sw = sin(w); al = sw / (2 * q); A = 10 ^ (g / 40);
  type == 0 ? (
    a0 = 1 + al / A;
    o[0] = (1 + al * A) / a0; o[1] = -2 * cw / a0; o[2] = (1 - al * A) / a0; o[3] = o[1]; o[4] = (1 - al / A) / a0;
  );
  type == 1 ? (
    sq = 2 * sqrt(A) * al;
    a0 = (A + 1) + (A - 1) * cw + sq;
    o[0] = A * ((A + 1) - (A - 1) * cw + sq) / a0;
    o[1] = 2 * A * ((A - 1) - (A + 1) * cw) / a0;
    o[2] = A * ((A + 1) - (A - 1) * cw - sq) / a0;
    o[3] = -2 * ((A - 1) + (A + 1) * cw) / a0;
    o[4] = ((A + 1) + (A - 1) * cw - sq) / a0;
  );
  type == 2 ? (
    sq = 2 * sqrt(A) * al;
    a0 = (A + 1) - (A - 1) * cw + sq;
    o[0] = A * ((A + 1) + (A - 1) * cw + sq) / a0;
    o[1] = -2 * A * ((A - 1) + (A + 1) * cw) / a0;
    o[2] = A * ((A + 1) + (A - 1) * cw - sq) / a0;
    o[3] = 2 * ((A - 1) - (A + 1) * cw) / a0;
    o[4] = ((A + 1) - (A - 1) * cw - sq) / a0;
  );
  type == 3 ? (
    a0 = 1 + al;
    o[0] = 1 / a0; o[1] = -2 * cw / a0; o[2] = o[0]; o[3] = o[1]; o[4] = (1 - al) / a0;
  );
  type == 4 ? (
    a0 = 1 + al;
    o[0] = al / a0; o[1] = 0; o[2] = -al / a0; o[3] = -2 * cw / a0; o[4] = (1 - al) / a0;
  );
);

// the gain-dependent Q: the effective Q of a bell or shelf (qm 0 = off, 1 light, 2 medium, 3 strong; shelves follow half as much)
function ea_qe(type, g, q, qm)
(
  (qm > 0 && type <= 2) ? min(100, q * (1 + (qm == 1 ? 0.5 : (qm == 2 ? 1 : 2)) * (type == 0 ? 1 : 0.5) * min(abs(g), 30) / 18)) : q;
);

// section coefficients of a band: up to 4 biquad sections, 5 numbers each (b0 b1 b2 a1 a2, a0 = 1), at o[0..19];
// returns how many sections (0 = the band does nothing)
function ea_coef(type, f, g, q, qm, o) local(w, A, n, sl, ns, qq, i, hp, k, ok, cw, sw, al, a0, e, gn, c1, c2)
(
  w = 2 * $pi * min(f, srate * 0.49) / srate;
  q = max(0.05, q);
  q = ea_qe(type, g, q, qm);
  n = 0;
  (type <= 2 && abs(g) >= 0.001) ? (
    A = 10 ^ (abs(g) / 40);
    ok = ea_m3(type == 0 ? 0 : 1, A, q, w, o);
    ok ? (
      type == 0 ? (g < 0 ? ea_inv(o););
      type == 1 ? (g < 0 ? ea_inv(o););
      type == 2 ? (
        A *= A;
        g >= 0 ? (ea_inv(o); o[0] *= A; o[1] *= A; o[2] *= A;) : (o[0] /= A; o[1] /= A; o[2] /= A;);
      );
    ) : ea_rbj(type, w, g, q, o);
    n = 1;
  );
  type == 3 ? (
    // notch: zeros exactly at the centre; the pole radius is the analog's and the pole angle makes the Nyquist gain the analog's
    cw = cos(w); c1 = $pi / w; c1 *= c1; qq = q * q;
    e = exp(-w / q);
    gn = sqrt(sqr(1 - c1) / (sqr(1 - c1) + c1 / qq));
    c2 = (1 + cw) / (1 - cw);
    o[3] = (gn - c2) * (1 + e) / (c2 + gn); o[4] = e;
    o[0] = (1 + o[3] + o[4]) / (2 - 2 * cw); o[1] = -2 * o[0] * cw; o[2] = o[0];
    (e < 0.9999 && abs(o[3]) < 1 + e - 0.000001 && o[0] > 0.000000001) ? 1 : ea_rbj(3, w, 0, q, o);
    n = 1;
  );
  type == 4 ? (
    ea_m3(2, 1, q, w, o) ? 1 : ea_rbj(4, w, 0, q, o);
    n = 1;
  );
  type >= 5 ? (
    hp = type <= 8; sl = hp ? type - 5 : type - 9;
    sl == 0 ? (
      hp ? (
        k = tan(w * 0.5);
        o[0] = 1 / (1 + k); o[1] = -o[0]; o[2] = 0; o[3] = (k - 1) / (1 + k); o[4] = 0;
      ) : (
        // one pole, DC gain 1, Nyquist gain the analog's
        e = exp(-w); gn = 1 / sqrt(1 + sqr($pi / w));
        o[3] = -e; o[0] = ((1 - e) + gn * (1 + e)) * 0.5; o[1] = ((1 - e) - gn * (1 + e)) * 0.5; o[2] = 0; o[4] = 0;
      );
      n = 1;
    ) : (
      ns = sl == 1 ? 1 : (sl == 2 ? 2 : 4);
      i = 0;
      loop(ns,
        qq = sl == 1 ? q : (sl == 2 ? QT[i] : QT[2 + i]);
        (i == ns - 1 && sl >= 2) ? qq = max(0.1, qq * q / 0.7071068);
        (!hp && ea_m3(3, 1, qq, w, o + i * 5)) ? 1 : (
          cw = cos(w); sw = sin(w); al = sw / (2 * qq); a0 = 1 + al;
          hp ? (o[i * 5] = (1 + cw) * 0.5 / a0; o[i * 5 + 1] = -(1 + cw) / a0;) : (o[i * 5] = (1 - cw) * 0.5 / a0; o[i * 5 + 1] = (1 - cw) / a0;);
          o[i * 5 + 2] = o[i * 5]; o[i * 5 + 3] = -2 * cw / a0; o[i * 5 + 4] = (1 - al) / a0;
        );
        i += 1;
      );
      n = ns;
    );
  );
  n;
);

// power response |H|^2 of n sections at a frequency with cos(w) = cw, cos(2w) = c2
function ea_mag2(o, n, cw, c2) local(p, i, b0, b1, b2, a1, a2, nu, de)
(
  p = 1; i = 0;
  loop(n,
    b0 = o[i]; b1 = o[i + 1]; b2 = o[i + 2]; a1 = o[i + 3]; a2 = o[i + 4];
    nu = b0 * b0 + b1 * b1 + b2 * b2 + 2 * (b0 * b1 + b1 * b2) * cw + 2 * b0 * b2 * c2;
    de = 1 + a1 * a1 + a2 * a2 + 2 * (a1 + a1 * a2) * cw + 2 * a2 * c2;
    p *= nu / max(0.000000000001, de);
    i += 5;
  );
  p;
);

// ---- the static curves (the audio thread and the window each have their own copy) ----
// a fast tanh: slope 1 at 0, exactly +-1 from |x| = 3
function ds_th(x) local(a) ( x > 3 ? 1 : (x < -3 ? -1 : (a = x * x; x * (27 + a) / (27 + 9 * a))); );
// the memoryless part of style st, for an input u already scaled by the drive (about +-1 is "full scale")
function ds_core(st, u) local(y, s, r, p)
(
  y = 0;
  // the style, found in five steps (a binary tree) rather than thirty comparisons
  (st < 15 ? (st < 7 ? (st < 3 ? (st < 1 ? (y = ds_th(u + 0.15) - 0.1489;) : (st < 2 ? (y = ds_th(u + 0.35) - 0.3364;) : (y = ds_th(u + 0.7) - 0.6044;))) : (st < 5 ? (st < 4 ? (y = ds_th(2 * u + 0.9) - 0.7163;) : (y = u > 1 ? 0.6667 : (u < -1 ? -0.6667 : u - u * u * u * 0.33333);)) : (st < 6 ? (y = atan(1.2 * u) * 0.82;) : (y = sin(max(-1.5708, min(1.5708, u)));)))) : (st < 11 ? (st < 9 ? (st < 8 ? ((r = abs(u) / 1.5; p = r * r; p = p * p * r; y = u * exp(-min(p, 30)););) : (y = ds_th(u);)) : (st < 10 ? (y = ds_th(u);) : (y = ds_th(u + 0.1) - 0.0997;))) : (st < 13 ? (st < 12 ? (y = ds_th(u + 0.2) - 0.1974;) : (y = ds_th(1.4 * (ds_th(u + 0.08) - 0.0798)) / 1.4;)) : (st < 14 ? ((s = ds_th(1.5 * u + 0.2) - 0.1974; s *= 2; r = abs(s); y = s / exp(log(1 + r * r * r) / 3););) : (y = ds_th(ds_th(1.8 * u));))))) : (st < 22 ? (st < 18 ? (st < 16 ? ((s = u >= 0 ? (1 - exp(-1.6 * u)) / 1.6 : -(1 - exp(1.1 * u)) / 1.1; y = ds_th(3 * s) / 3;);) : (st < 17 ? (y = ds_th(2.5 * ds_th(2 * (ds_th(2 * u + 0.1) - 0.0997))) / 2.5;) : (y = ds_th(u);))) : (st < 20 ? (st < 19 ? (y = ds_th(u);) : ((s = u + 0.25; y = (s + 0.4 * s * abs(s)) / (1 + 0.8 * abs(s)) - 0.22916667; y = 1.2 * ds_th(y / 1.2););)) : (st < 21 ? ((s = max(-0.5, min(0.5, 0.5 * u)); r = min(1, abs(s) * 0.5 + 0.75); y = 4 * (1 - r * abs(s)) * r * s;);) : (y = ds_th(4 * (u + 0.15)) - ds_th(0.6);)))) : (st < 26 ? (st < 24 ? (st < 23 ? (y = ds_th(u);) : (y = ds_th(u);)) : (st < 25 ? ((s = u - 1; s = s - 4 * floor(s / 4); y = abs(s - 2) - 1;);) : (y = sin(u);))) : (st < 28 ? (st < 27 ? ((r = abs(u); y = 0.6 * ds_th(0.7 * u) + 0.8 * (ds_th(1.3 * r) - 0.35););) : (y = max(-1, min(1, u));)) : (st < 29 ? (y = ds_th(u);) : (y = max(-1, min(1, u));))))));
  y;
);


// the crossovers as straight-line code: coefficients and states are plain variables
function d_xpub(j) local(o)
(
  j == 0 ? (
    o = XC + 0;
    cx0l0_0 = o[0];    cx0l0_1 = o[1];    cx0l0_2 = o[2];    cx0l0_3 = o[3];    cx0l0_4 = o[4];
