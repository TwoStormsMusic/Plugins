    c_s1 += c_u; c_q1 += c_u * c_u; c_u = abs(c_u); c_u > c_v1 ? c_v1 = c_u;
    );
  );
) : (c_v0 = abs(c_d0); c_v1 = abs(c_d1); c_s0 = c_d0; c_s1 = c_d1;);
(c_nr > 0 && e_rcb) ? (c_v0 = sqrt(c_q0); c_v1 = sqrt(c_q1););
e_one ? (
  // one gain for both channels (see @block): the louder level, or the power average, then one gain computer
  e_c0.ch_lin(c_d0, c_v0); e_c1.ch_lin(c_d1, c_v1);
  a_m = max(e_c0.lin, e_c1.lin);
  a_a0 = (e_pwr ? log(0.5 * (e_c0.lin * e_c0.lin + e_c1.lin * e_c1.lin)) * 4.342944819032518 : log(a_m) * 8.685889638065035) + e_fbk * e_c0.y;
  c_vneed ? (a_m > c_vdot ? c_vdot = a_m;);
  c_tgs == 2 ? (e_l0 = log(a_m) * 8.685889638065035; e_l1 = e_l0;);
  e_c0.ch_gain(a_a0);
  e_c1.y = e_c0.y; e_c1.yf = e_c0.yf; e_c1.ys = e_c0.ys; e_c1.sa = e_c0.sa; e_c1.hold = e_c0.hold; e_c1.k = e_c0.k;
) : (
// detector levels (dB), then feedback and the stereo link (in dB; Mono is a power average of the two sides)
e_c0.ch_det(c_d0, c_v0); e_c1.ch_det(c_d1, c_v1);
e_l0 = e_c0.lv; e_l1 = e_c1.lv;
a_a0 = e_l0 + e_fbk * e_c0.y; a_a1 = e_l1 + e_fbk * e_c1.y;
e_mono ? (
  a_a0 = log(0.5 * (exp(a_a0 * 0.2302585092994046) + exp(a_a1 * 0.2302585092994046))) * 4.342944819032518; a_a1 = a_a0;
) : (
  a_ref = e_lkl ? log(0.5 * (exp(a_a0 * 0.2302585092994046) + exp(a_a1 * 0.2302585092994046))) * 4.342944819032518 : max(a_a0, a_a1);
  a_a0 += e_lk * (a_ref - a_a0); a_a1 += e_lk * (a_ref - a_a1);
);
c_vneed ? (a_t = exp(max(e_l0, e_l1) * 0.11512925464970229); a_t > c_vdot ? c_vdot = a_t;);
// gain computer, lookahead and ballistics
e_c0.ch_gain(a_a0);
e_mono ? (e_c1.y = e_c0.y; e_c1.k = e_c0.k;) : e_c1.ch_gain(a_a1);
);
c_y0 = e_c0.y; c_y1 = e_c1.y; c_k0 = e_c0.k; c_k1 = e_c1.k;
// "Set threshold" is listening: the loudest detector level of each millisecond
c_tgs == 2 ? (
  a_t = max(e_l0, e_l1); a_t > c_tm ? c_tm = a_t;
  (c_tc += 1) >= c_tms ? (
    c_tgn < 60000 ? (TGB[c_tgn] = c_tm; c_tgn += 1;);
    c_tm = -200; c_tc = 0;
  );
);
// lookahead: the audio waits, the detector doesn't (a change of the time crosses over, see @block)
(e_ldA == 0 && c_xf >= 1) ? (c_qa0 = c_r0; c_qa1 = c_r1;) : (a_t = (c_lp - e_ldA) & 8191; c_qa0 = LAB0[a_t]; c_qa1 = LAB1[a_t];);
c_xf < 1 ? (
  a_t = (c_lp - e_ldB) & 8191;
  c_xf += e_xfk; c_xf > 1 ? c_xf = 1;
  c_q0 = LAB0[a_t] + c_xf * (c_qa0 - LAB0[a_t]); c_q1 = LAB1[a_t] + c_xf * (c_qa1 - LAB1[a_t]);
) : (c_q0 = c_qa0; c_q1 = c_qa1;);
c_lp = (c_lp + 1) & 8191;
c_dx0 = c_q0 * c_ings; c_dx1 = c_q1 * c_ings;
// the wet signal: the gain on the original left and right (Mono shares one gain, it does not sum the channels)
c_mode == 2 ? (
  a_m = (c_dx0 + c_dx1) * 0.5 * c_k0; a_s = (c_dx0 - c_dx1) * 0.5 * c_k1; c_w0 = a_m + a_s; c_w1 = a_m - a_s;
) : (
  c_w0 = c_dx0 * c_k0; c_w1 = c_dx1 * (c_mode == 0 ? c_k0 : c_k1);
);
e_sat > 0.001 ? (c_w0 = e_s0.sat_run(c_w0); c_w1 = e_s1.sat_run(c_w1););
// out = dry * (1 - mix) + compressed * makeup * mix. Delta = the input minus the compressed signal (before makeup and mix)
c_lis ? (
  c_mode == 0 ? (spl0 = (c_s0 + c_s1) * 0.5; spl1 = spl0;) : (spl0 = c_s0; spl1 = c_s1;);
) : (
  c_del ? (spl0 = c_dx0 - c_w0; spl1 = c_dx1 - c_w1;) : (
    spl0 = c_dx0 * c_dms + c_w0 * c_wms; spl1 = c_dx1 * c_dms + c_w1 * c_wms;
  );
);
a_fast ? (
  // the usual case (one stereo pair, steady gain, nothing measuring): straight-line code
  a_y0 = spl0 * a_g0; a_y1 = spl1 * a_g1;
  spl0 = a_y0; spl1 = a_y1;
  a_ay = abs(a_y0); a_ay > a_fp0 ? a_fp0 = a_ay;
  a_ay = abs(a_y1); a_ay > a_fp1 ? a_fp1 = a_ay;
  a_fe0 += a_y0 * a_y0; a_fe1 += a_y1 * a_y1;
) : (
a_c = 0;
loop(a_nchs,
  USEDA[a_c] ? (
    a_x = spl(a_c);
    a_inm ? (
      // auto stage / match: the input, before the gain
      a_ax = abs(a_x);
      a_ax > IBP[a_c] ? IBP[a_c] = a_ax;
      a_e = a_kin ? sqr(a_kw(a_x, KIN + a_c * 4)) : a_x * a_x;
      IBE[a_c] += a_e;
      a_binon ? (MBACC[a_c] += a_e; a_ax > MPK[a_c] ? MPK[a_c] = a_ax;);
    );
    RAMP[a_c] ? (
      CUR[a_c] += STEP[a_c];
      ((STEP[a_c] > 0 && CUR[a_c] >= RTGT[a_c]) || (STEP[a_c] < 0 && CUR[a_c] <= RTGT[a_c]) || STEP[a_c] === 0) ? (
        CUR[a_c] = RTGT[a_c]; RAMP[a_c] = 0;
      );
      GLIN[a_c] = CUR[a_c] <= GFLOOR ? 0 : 10 ^ (CUR[a_c] / 20);
    );
    a_y = a_x * GLIN[a_c];
    spl(a_c) = a_y;
    a_ay = abs(a_y); a_ay > BPK[a_c] ? BPK[a_c] = a_ay;
    BEN[a_c] += a_y * a_y;
    a_kout ? BKE[a_c] += sqr(a_kw(a_y, KOUT + a_c * 4));
  );
  a_c += 1;
);
a_binon ? (
  AU_NS += 1; AU_BPOS += 1;
  AU_BPOS >= a_lbinlen ? (
    AU_NB < MAXB ? (
      a_c = 0; loop(8, MB[a_c * MAXB + AU_NB] = MBACC[a_c] / AU_BPOS; MBACC[a_c] = 0; a_c += 1;);
      AU_NB += 1;
    );
    AU_BPOS = 0;
  );
);
);
// ---------- compressor: after the built-in Act ----------
// meters and level matching are only for the window (and its hold buttons)
c_uion ? (
  c_ei += c_r0 * c_r0 + c_r1 * c_r1; c_eo += spl0 * spl0 + spl1 * spl1;
  a_t = abs(c_x0); a_t > c_ip0 ? c_ip0 = a_t; a_t = abs(c_x1); a_t > c_ip1 ? c_ip1 = a_t;
);
// held Bypass (crossfaded) and held Swap (its level-matching trim, glided)
(c_bpv > 0 || c_bph || c_tr != 1 || c_trt != 1) ? (
  c_bpv = max(0, min(1, c_bpv + (c_bph ? c_bps : -c_bps)));
  c_tr += (c_trt - c_tr) * c_trk; abs(c_tr - c_trt) < 0.00001 ? c_tr = c_trt;
  spl0 = spl0 * c_tr * (1 - c_bpv) + c_q0 * c_bpg * c_bpv;
  spl1 = spl1 * c_tr * (1 - c_bpv) + c_q1 * c_bpg * c_bpv;
);
c_anw ? (ANI[c_ap] = (c_x0 + c_x1) * 0.5; ANO[c_ap] = (spl0 + spl1) * 0.5; c_ap = (c_ap + 1) & 8191;);
// audio key: hand this plug-in's output samples to a later plug-in that asked for them (the very last thing)
a_wr ? (gmem[a_wr0 + a_wp] = spl0; gmem[a_wr0 + AUD_R + a_wp] = spl1; a_wp = (a_wp + 1) & AUD_MASK;);

@gfx 1040 800
frame_begin(900);
fin_compute();
g_fin = MYSLOT >= 0 ? FIN[MYSLOT] : 0;
g_live_me = MYSLOT >= 0 && g_live(MYSLOT, g_now);
g_ckn = max(0.0001, slider(P_KNEE)); g_csl = slider(P_RAT) >= 99.5 ? -1 : 1 / max(1, slider(P_RAT)) - 1;
g_cnrg = slider(P_RNG) >= 59.95 ? -200 : -slider(P_RNG);
g_chr = floor(slider(P_CHAR) + 0.5);
g_cvt = g_chr == 0 ? floor(slider(P_CURVE) + 0.5) : (g_chr == 2 ? 2 : (g_chr == 4 ? 1 : 0));

// ---- top bar (shared): title, finale, Presets, A/B, Swap, Bypass, Settings ----
top_bar("TWOSTORMS COMPRESSOR", 1);
MYSLOT >= 0 ? track_name(#g_tn, MYSLOT) : strcpy(#g_tn, "");
c_ld > 0 ? sprintf(#g_lt, "latency %.1f ms (lookahead)", c_latms) : strcpy(#g_lt, "no latency");
sprintf(#g_sub, "%s    %s    playing: %s", #g_tn, #g_lt, c_side ? "B" : "A");
!g_script_ok ? strcat(#g_sub, "    (helper script not running)");
g_script_old ? strcat(#g_sub, "    (old helper script running: replace it)");
gfx_setfont(3); c_dim(); text(#g_sub, 12, 34, 876, 16, 4);
g_y = 56;

// ---- settings: meters, zoom, finale, link law / ranges / makeup, and the collapsible sidechain options ----
g_cset ? (
  g_sph = 80 + (g_scopen ? 26 : 0);     // where the two help lines start
  c_panel(); rect(6, g_y - 4, 888, g_sph + 48, 1);
  label("Peak hold", 12, g_y, 64);
  dropdown(78, g_y, 86, 22, g_key(-1, P_HOLD), 320, 6, 1);
  label("Meter range", 178, g_y, 80);
  dropdown(260, g_y, 80, 22, g_key(-1, P_RANGE), 330, 6, 1);
  label("Zoom", 356, g_y, 40);
  dropdown(398, g_y, 80, 22, g_key(-1, P_ZOOM), 360, 6, 1);
  label("Finale", 494, g_y, 44);
  dropdown(540, g_y, 86, 22, g_key(-1, P_FINAL), 370, 3, 1);
  g_fm = floor(slider(si(P_FINAL)) + 0.5);
  g_fc = MYSLOT >= 0 ? fin_of_chain(MYSLOT) : -1;
  g_warn = 0;
  g_fm == FIN_NEVER ? strcpy(#g_fs, "Never on the Finales tab.") : (
    g_fin ? (
      fin_tail(MYSLOT) ? (strcpy(#g_fs, "Finale, but plug-ins after it change the output."); g_warn = 1;)
                       : strcpy(#g_fs, g_fin == 2 ? "Always on the Finales tab." : "The finale: the last Act in its chain.");
    ) : (
      g_fc >= 0 ? (point_title(#g_ft, g_fc); sprintf(#g_fs, "Not the finale: %s is.", #g_ft);) : strcpy(#g_fs, "Not the finale.");
    );
  );
  gfx_setfont(3); g_warn ? c_red() : (g_fin ? c_orange() : c_dim());
  text(#g_fs, 634, g_y, 254, 22, 4);
  // how the detector hears the signal and what the output does
  cdd(12, g_y + 28, 150, 20, g_key(-1, P_LKL), 444, 2, "Link law:", slider(P_CMODE) >= 0.5);
  cdd(168, g_y + 28, 150, 20, g_key(-1, P_RCMB), 448, 2, "Ranges:", 1);
  cdd(324, g_y + 28, 168, 20, g_key(-1, P_AMKM), 458, 2, "Makeup:", 1);
  slider(P_DET) >= 1.5 ? (
    label("RMS share", 498, g_y + 27, 64);
    cfmt(#g_cv, P_BLEND, slider(P_BLEND));
    valbox(564, g_y + 28, 64, 20, g_key(-1, P_BLEND), 1, 0.1, 6, #g_cv, 1);
  );
  // sidechain options: a header that opens and closes the group
  sprintf(#g_dd, g_scopen ? "Sidechain options  v" : "Sidechain options  >");
  button(12, g_y + 54, 160, 22, #g_dd, g_scopen, 1, 0) ? g_scopen = !g_scopen;
  !g_scopen ? (
    cfmt(#g_cv, P_SCHP, slider(P_SCHP)); sprintf(#g_scs, "HPF %s", #g_cv);
    cfmt(#g_cv, P_SCTL, slider(P_SCTL)); strcat(#g_scs, "    Tilt "); strcat(#g_scs, #g_cv);
    gfx_setfont(3); c_dim(); text(#g_scs, 180, g_y + 54, 700, 22, 4);
  ) : (
    g_y += 80;
