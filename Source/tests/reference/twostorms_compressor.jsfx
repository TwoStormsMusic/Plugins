    dropdown(112, g_y, 88, 20, g_key(-1, P_SCHS), 452, 3, slider(P_SCHP) > 20.5);
    label("Tilt", 210, g_y - 1, 26);
    cfmt(#g_cv, P_SCTL, slider(P_SCTL));
    valbox(238, g_y, 66, 20, g_key(-1, P_SCTL), 0.2, 0.02, 6, #g_cv, 1);
    label("Trim", 314, g_y - 1, 32);
    cfmt(#g_cv, P_SCT, slider(P_SCT));
    valbox(348, g_y, 66, 20, g_key(-1, P_SCT), 0.2, 0.02, 6, #g_cv, slider(P_SC) >= 0.5);
    g_y -= 80;
  );
  c_faint();
  text("Bypass (Lvl Match) plays the input at the same loudness; Swap (Lvl Match) plays the other A/B set at this one's loudness.", 12, g_y + g_sph, 876, 16, 4);
  text("Click to latch these, A/B, Delta, Listen and Auto makeup; Shift + click and hold to use them only while the mouse is held.", 12, g_y + g_sph + 16, 876, 16, 4);
  sprintf(#g_idt, "Plugin ID %d", MYID); text(#g_idt, 12, g_y + g_sph + 16, 876, 16, 6);
  g_y += g_sph + 52;
);

// ---- the curve: input level across, output level up; drag across it to move the threshold ----
g_cx = 12; g_cy = g_y; g_cs = 216;
c_well(); rect(g_cx, g_cy, g_cs, g_cs, 1);
g_d = -48;
loop(4,
  setc(0.15, 0.15, 0.17);
  rect(g_cx + (g_d + 60) / 60 * g_cs, g_cy, 1 / g_sc, g_cs, 1);
  rect(g_cx, g_cy + g_cs - (g_d + 60) / 60 * g_cs, g_cs, 1 / g_sc, 1);
  g_d += 12;
);
setc(0.26, 0.26, 0.29); gfx_line(X(g_cx), Y(g_cy + g_cs), X(g_cx + g_cs), Y(g_cy), 1);
c_purple(); rect(g_cx + (slider(P_THR) + 60) / 60 * g_cs, g_cy, 1 / g_sc, g_cs, 1);
c_orange(); g_i = 0; g_lx = -1;
loop(g_cs / 2 + 1,
  g_in = -60 + g_i * 120 / g_cs; g_out = g_in + g_cgr(g_in);
  g_px = X(g_cx + g_i * 2); g_py = Y(g_cy + g_cs - (max(-60, g_out) + 60) / 60 * g_cs);
  g_lx >= 0 ? (gfx_line(g_lx, g_ly, g_px, g_py, 1); gfx_line(g_lx, g_ly + 1, g_px, g_py + 1, 1););
  g_lx = g_px; g_ly = g_py; g_i += 1;
);
(c_dlv > -60 && g_live_me) ? (
  g_out = min(0, c_dlv) + c_ugr;
  setc(1, 1, 1);
  rect(g_cx + (min(0, c_dlv) + 60) / 60 * g_cs - 3, g_cy + g_cs - (max(-60, min(0, g_out)) + 60) / 60 * g_cs - 3, 6, 6, 1);
);
c_border(); rect(g_cx, g_cy, g_cs, g_cs, 0);
gfx_setfont(3); c_faint(); text("drag across: threshold", g_cx + 4, g_cy + g_cs - 16, 150, 14, 4);
ctl_input(g_key(-1, P_THR), g_cx, g_cy, g_cs, g_cs, 60 / g_cs, 6 / g_cs, 6);

// ---- history: input (grey), output (orange) and gain reduction (red, from the top), 10 ms per step ----
g_hx = 236; g_hw = 572; g_hh = 216;
c_well(); rect(g_hx, g_cy, g_hw, g_hh, 1);
g_d = -12;
loop(4, setc(0.15, 0.15, 0.17); rect(g_hx, g_cy + g_hh * (-g_d / 60), g_hw, 1 / g_sc, 1); g_d -= 12;);
g_i = 0;
loop(g_hw,
  g_e = (c_hp - g_hw + g_i) & 1023; g_v = HIN[g_e];
  g_v > -60 ? (setc(0.24, 0.24, 0.27); rect(g_hx + g_i, g_cy + g_hh * min(1, -g_v / 60), 1, g_hh * max(0, 1 + g_v / 60), 1););
  g_i += 1;
);
c_orange(); g_i = 0; g_lx = -1;
loop(g_hw,
  g_e = (c_hp - g_hw + g_i) & 1023;
  g_px = X(g_hx + g_i); g_py = Y(g_cy + g_hh * min(1, -max(-60, HOUT[g_e]) / 60));
  g_lx >= 0 ? gfx_line(g_lx, g_ly, g_px, g_py, 1);
  g_lx = g_px; g_ly = g_py; g_i += 1;
);
c_red(); g_i = 0; g_lx = -1;
loop(g_hw,
  g_e = (c_hp - g_hw + g_i) & 1023;
  g_px = X(g_hx + g_i); g_py = Y(g_cy + g_hh * min(1, -HGR[g_e] / 24));
  g_lx >= 0 ? (gfx_line(g_lx, g_ly, g_px, g_py, 1); gfx_line(g_lx, g_ly + 1, g_px, g_py + 1, 1););
  g_lx = g_px; g_ly = g_py; g_i += 1;
);
c_border(); rect(g_hx, g_cy, g_hw, g_hh, 0);
gfx_setfont(3);
setc(0.55, 0.55, 0.58); text("input", g_hx + 6, g_cy + 4, 40, 14, 4);
c_orange(); text("output", g_hx + 40, g_cy + 4, 44, 14, 4);
c_red(); text("gain reduction (0 to 24 dB, from the top)", g_hx + 84, g_cy + 4, 260, 14, 4);

// ---- meters: input, gain reduction, output ----
gfx_setfont(3); c_dim();
text("IN", 816, g_cy, 24, 12, 5); text("GR", 842, g_cy, 20, 12, 5); text("OUT", 862, g_cy, 28, 12, 5);
vmeter(816, g_cy + 14, 10, g_hh - 30, c_mi0, g_live_me);
vmeter(828, g_cy + 14, 10, g_hh - 30, c_mi1, g_live_me);
grmeter(845, g_cy + 14, 12, g_hh - 30, g_live_me ? c_ugr : 0);
g_b = SLOTBASE + MYSLOT * SLOTSZ;
vmeter(866, g_cy + 14, 10, g_hh - 30, MYSLOT >= 0 ? gmem[g_b + O_PKD] : -200, g_live_me);
vmeter(878, g_cy + 14, 10, g_hh - 30, MYSLOT >= 0 ? gmem[g_b + O_PKD + 1] : -200, g_live_me);
sprintf(#g_grt, "%.1f", g_live_me ? -c_ugr : 0); c_red(); text(#g_grt, 836, g_cy + g_hh - 14, 30, 14, 5);

// ---- analyzer, with the trigger ranges ----
g_ax = 12; g_ay = g_cy + g_cs + 8; g_aw = 876; g_ah = 120;
c_well(); rect(g_ax, g_ay, g_aw, g_ah, 1);
gfx_setfont(3);
g_i = 0;
loop(8,
  g_f = g_i == 0 ? 50 : (g_i == 1 ? 100 : (g_i == 2 ? 200 : (g_i == 3 ? 500 : (g_i == 4 ? 1000 : (g_i == 5 ? 2000 : (g_i == 6 ? 5000 : 10000))))));
  setc(0.15, 0.15, 0.17); rect(an_x(g_f), g_ay, 1 / g_sc, g_ah, 1);
  g_f >= 1000 ? sprintf(#g_fl, "%dk", g_f / 1000) : sprintf(#g_fl, "%d", g_f);
  c_faint(); text(#g_fl, an_x(g_f) + 2, g_ay + g_ah - 13, 30, 12, 4);
  g_i += 1;
);
g_live_me ? (
  g_annorm = 20 * log10(4096 / 4);
  an_fft(ANI, SPI, 4096); an_fft(ANO, SPO, 4096);
  setc(0.21, 0.21, 0.25); an_draw(SPI, 4096, 1);
  c_orange(); an_draw(SPO, 4096, 0);
);
g_nr = 0; g_r = 0;
loop(4,
  slider(P_R1 + 3 * g_r) >= 0.5 ? (
    g_nr += 1;
    g_x1 = an_x(min(slider(P_R1 + 3 * g_r + 1), slider(P_R1 + 3 * g_r + 2)));
    g_x2 = an_x(max(slider(P_R1 + 3 * g_r + 1), slider(P_R1 + 3 * g_r + 2)));
    c_purple(); gfx_a = 0.16; rect(g_x1, g_ay, g_x2 - g_x1, g_ah, 1); gfx_a = 1;
    c_purple(); rect(g_x1, g_ay, 1 / g_sc, g_ah, 1); rect(g_x2, g_ay, 1 / g_sc, g_ah, 1);
    sprintf(#g_rl, "%d", g_r + 1); text(#g_rl, g_x1 + 3, g_ay + 3, 12, 12, 4);
  );
  g_r += 1;
);
c_border(); rect(g_ax, g_ay, g_aw, g_ah, 0);
gfx_setfont(3); c_dim();
sprintf(#g_trt, "Trigger: the purple ranges (%s). Drag an edge or a range; right-click to remove.", slider(P_RCMB) >= 0.5 ? "they combine" : "the loudest one counts");
text(g_nr ? #g_trt :
            "Trigger: the whole signal. Double-click here to add a frequency range.", g_ax + 6, g_ay + 4, 640, 14, 4);
// mouse: drag a range's edge or the whole range; double-click to add one; right-click to remove
g_mxd = (g_mx - g_ox) / g_sc; g_myd = (g_my - g_oy) / g_sc;
g_inan = g_mxd >= g_ax && g_mxd < g_ax + g_aw && g_myd >= g_ay && g_myd < g_ay + g_ah;
(g_inan && (g_lclick || g_rclick) && !g_used) ? (
  g_used = 1; g_hitr = -1; g_hite = 0; g_r = 0;
  loop(4,
    slider(P_R1 + 3 * g_r) >= 0.5 ? (
      g_x1 = an_x(min(slider(P_R1 + 3 * g_r + 1), slider(P_R1 + 3 * g_r + 2)));
      g_x2 = an_x(max(slider(P_R1 + 3 * g_r + 1), slider(P_R1 + 3 * g_r + 2)));
      abs(g_mxd - g_x1) < 5 ? (g_hitr = g_r; g_hite = 1;) : (
        abs(g_mxd - g_x2) < 5 ? (g_hitr = g_r; g_hite = 2;) : (
          (g_mxd > g_x1 && g_mxd < g_x2 && g_hite == 0) ? (g_hitr = g_r; g_hite = 3;);
        );
      );
    );
    g_r += 1;
  );
  g_rclick ? (
    g_hitr >= 0 ? (
      gfx_x = g_mx; gfx_y = g_my;
      gfx_showmenu("Remove this range") == 1 ? g_kset(g_key(-1, P_R1 + 3 * g_hitr), 0, 1);
    );
  ) : (
    (g_hitr < 0 && g_now - g_anclk_t < 0.35) ? (
      // double-click: a new range, one octave around here
      g_r = 0; g_fr = -1; loop(4, (g_fr < 0 && slider(P_R1 + 3 * g_r) < 0.5) ? g_fr = g_r; g_r += 1;);
      g_fr >= 0 ? (
        g_f = an_f(g_mxd);
        g_kset(g_key(-1, P_R1 + 3 * g_fr + 1), max(20, g_f / sqrt(2)), 0);
        g_kset(g_key(-1, P_R1 + 3 * g_fr + 2), min(20000, g_f * sqrt(2)), 0);
        g_kset(g_key(-1, P_R1 + 3 * g_fr), 1, 1);
      );
      g_anclk_t = 0;
    ) : (
      g_anclk_t = g_now;
      g_hitr >= 0 ? (
        g_rdrag = g_hitr * 4 + g_hite; g_rdx = g_mxd;
        g_rlo = min(slider(P_R1 + 3 * g_hitr + 1), slider(P_R1 + 3 * g_hitr + 2));
        g_rhi = max(slider(P_R1 + 3 * g_hitr + 1), slider(P_R1 + 3 * g_hitr + 2));
      );
    );
  );
);
(g_rdrag > 0 && (g_cap & 1)) ? (
  g_r = floor(g_rdrag / 4); g_e = g_rdrag - g_r * 4;
  g_f = max(20, min(20000, an_f(g_mxd)));
  g_e == 1 ? g_kset(g_key(-1, P_R1 + 3 * g_r + 1), min(g_f, g_rhi / 1.05), 0);
  g_e == 2 ? g_kset(g_key(-1, P_R1 + 3 * g_r + 2), max(g_f, g_rlo * 1.05), 0);
  g_e == 3 ? (
    g_t = an_f(g_mxd) / an_f(g_rdx);
    g_t = max(20 / g_rlo, min(20000 / g_rhi, g_t));
    g_kset(g_key(-1, P_R1 + 3 * g_r + 1), g_rlo * g_t, 0); g_kset(g_key(-1, P_R1 + 3 * g_r + 2), g_rhi * g_t, 0);
  );
);
(g_rdrag > 0 && !(g_cap & 1)) ? (g_rdrag = 0; sliderchange(-1););

// ---- trigger row: source, detect, + Range, mode, link, then delta and listen on the right; ranges below once there is one ----
g_ty = g_ay + g_ah + 6;
label("Trigger", 12, g_ty - 1, 50);
dropdown(64, g_ty, 128, 20, g_key(-1, P_SC), 410, 2, 1);
cdd(198, g_ty, 96, 20, g_key(-1, P_DET), 380, 3, "Detect:", 1);
g_x = 298;
slider(P_DET) >= 0.5 ? (
  cfmt(#g_cv, P_RMST, slider(P_RMST));
  valbox(g_x, g_ty, 66, 20, g_key(-1, P_RMST), log(2000000) / 140, log(2000000) / 1400, 5, #g_cv, 1);
  g_x += 70;
);
g_fr = -1; g_r = 0; g_nr = 0;
loop(4, (g_fr < 0 && slider(P_R1 + 3 * g_r) < 0.5) ? g_fr = g_r; slider(P_R1 + 3 * g_r) >= 0.5 ? g_nr += 1; g_r += 1;);
button(g_x, g_ty, 64, 20, "+ Range", 0, g_fr >= 0, 0) ? g_kset(g_key(-1, P_R1 + 3 * g_fr), 1, 1);
g_x += 70;
cdd(g_x, g_ty, 138, 20, g_key(-1, P_CMODE), 390, 4, "Mode:", 1);
g_x += 144;
slider(P_CMODE) >= 0.5 ? (
  label("Link", g_x, g_ty - 1, 30);
  cfmt(#g_cv, P_SLINK, slider(P_SLINK));
  valbox(g_x + 32, g_ty, 76, 20, g_key(-1, P_SLINK), 1, 0.1, 6, #g_cv, 1);
);
mtog(732, g_ty, 64, "Delta", P_DELTA, 1);
mtog(800, g_ty, 88, "Listen", P_LISTEN, 1);
g_nr > 0 ? (
  g_ty += 26;
  label("Ranges", 12, g_ty - 1, 50);
  g_k = 0; g_r = 0;
  loop(4,
    slider(P_R1 + 3 * g_r) >= 0.5 ? (
      g_x = 64 + g_k * 132;
      cfmt(#g_cv, P_R1 + 1, slider(P_R1 + 3 * g_r + 1));
      valbox(g_x, g_ty, 52, 20, g_key(-1, P_R1 + 3 * g_r + 1), log(1000) / 140, log(1000) / 1400, 5, #g_cv, 1);
      gfx_setfont(1); c_dim(); text("-", g_x + 52, g_ty, 8, 20, 5);
      cfmt(#g_cv, P_R1 + 2, slider(P_R1 + 3 * g_r + 2));
      valbox(g_x + 60, g_ty, 52, 20, g_key(-1, P_R1 + 3 * g_r + 2), log(1000) / 140, log(1000) / 1400, 5, #g_cv, 1);
      button(g_x + 114, g_ty, 14, 20, "x", 0, 1, 0) ? g_kset(g_key(-1, P_R1 + 3 * g_r), 0, 1);
      g_k += 1;
    );
    g_r += 1;
  );
);

// ---- the controls: column 1 threshold / ratio / knee, column 2 attack / release / hold, column 3 input / range / dry-wet ----
g_ky = g_ty + 28;
g_inact = g_drag_k == g_key(-1, P_IN) || hit(604, g_ky, 284, 20);
g_inact ? g_fine = (g_cap & 8) != 0;
// Ctrl held on Input: its change moves the output the other way (see @block)
c_iol = g_inact && (g_cap & 4) != 0;
cctl("Threshold", 12, g_ky, P_THR, 0, 1); cctl("Attack", 308, g_ky, P_ATT, 1, 1); cctl("Input", 604, g_ky, P_IN, 0, 1);
cctl("Ratio", 12, g_ky + 28, P_RAT, 1, 1); cctl("Hold", 308, g_ky + 28, P_HLD, 0, 1); cctl("Range", 604, g_ky + 28, P_RNG, 0, 1);
cctl("Knee", 12, g_ky + 56, P_KNEE, 0, 1); cctl("Release", 308, g_ky + 56, P_REL, 1, 1); cctl("Dry/wet", 604, g_ky + 56, P_MIX, 0, 1);
g_y = g_ky + 84;
char_dd(12, g_y, 150, 20);
mtog(168, g_y, 96, "Auto makeup", P_AMK, 0);
ctog(268, g_y, 96, "Lookahead", P_LA, 0);
cfmt(#g_cv, P_LAMS, slider(P_LAMS));
valbox(368, g_y, 80, 20, g_key(-1, P_LAMS), 0.1, 0.01, 6, #g_cv, slider(P_LA) >= 0.5);
label("Target GR", 464, g_y - 1, 64);
cfmt(#g_cv, P_TGR, slider(P_TGR));
valbox(530, g_y, 64, 20, g_key(-1, P_TGR), 0.1, 0.01, 6, #g_cv, 1);
dropdown(598, g_y, 100, 20, g_key(-1, P_TTYPE), 400, 2, 1);
c_tgs > 0 ? (c_tgs == 1 ? strcpy(#g_dd, "waiting") : (c_tgs == 2 ? sprintf(#g_dd, "%.1f s", c_tgel) : strcpy(#g_dd, "working")); button(702, g_y, 60, 20, #g_dd, 1, 1, 0);) : dropdown(702, g_y, 60, 20, g_key(-1, P_TTIME), 301, 7, 1);
button(766, g_y, 110, 20, c_tgs > 0 ? "Cancel" : "Set threshold", c_tgs > 0, MYSLOT >= 0, 0) ? (c_tgs > 0 ? (c_uitgc += 1) : (c_uitg += 1););
g_y += 30;

// ---- Custom character: a base template, then envelope, release, curve, feedback and saturation by hand (only shown under Custom) ----
g_chr == 0 ? (
  c_panel(); rect(6, g_y - 4, 888, 28, 1);
  base_dd(12, g_y, 126, 20);
  cdd(142, g_y, 134, 20, g_key(-1, P_ENV), 420, 2, "Envelope:", 1);
  cdd(280, g_y, 134, 20, g_key(-1, P_RELM), 424, 3, "Release:", 1);
  cdd(418, g_y, 134, 20, g_key(-1, P_CURVE), 430, 3, "Curve:", 1);
  label("Feedback", 558, g_y - 1, 62);
  cfmt(#g_cv, P_FB, slider(P_FB));
  valbox(622, g_y, 50, 20, g_key(-1, P_FB), 1, 0.1, 6, #g_cv, slider(P_LA) < 0.5);
  label("Saturation", 680, g_y - 1, 66);
  cfmt(#g_cv, P_SAT, slider(P_SAT));
  valbox(748, g_y, 50, 20, g_key(-1, P_SAT), 1, 0.1, 6, #g_cv, 1);
  dropdown(802, g_y, 80, 20, g_key(-1, P_SATT), 462, 2, 1);
  g_y += 32;
);

// ---- output: the built-in Act, laid out like an Act card in the Gain Stage (the drive link where Auto all's tick and name are) ----
g_ch2 = 38 + 26;
c_card(); rect(6, g_y, 888, g_ch2, 1);
setc(0.20, 0.19, 0.18); rect(6, g_y, 888, g_ch2, 0);
drive_label(#g_dlb, -1);
g_dl = slider(si(P_DRIVE)) >= DRIVE_PARAM; g_don = slider(si(P_DRIVEON)) >= 0.5;
checkbox(16, g_y + 10, g_don && g_dl, g_dl) ? g_kset(g_key(-1, P_DRIVEON), !g_don, 1);
button(38, g_y + 6, 280, 22, #g_dlb, g_dl && g_don, MYSLOT >= 0, 1) ? drive_menu(-1, 38, g_y + 28);
// ... | mode | value | channels | Peak/RMS/LUFS | time | Auto
button(324, g_y + 6, 28, 22, "...", 0, 1, 0) ? act_menu(324, g_y + 28);
mode_ctl(356, g_y + 6, 96, -1, 1, 1);
value_ctl(456, g_y + 6, 130, -1, 1);
auto_mode(-1) != 0 ? src_ctl(590, g_y + 6, 76, 22, -1, 0, 1, 1);
dropdown(666, g_y + 6, 80, 22, g_key(-1, P_MEAS), 310, 3, 1);
auto_time_box(750, g_y + 6, 70, 22, -1, 1);
button(826, g_y + 6, 62, 22, auto_label(-1), auto_busy(-1), MYSLOT >= 0, 0) ? auto_click(-1);
// the gain group: meters, readouts, gain
g_tgt = aim_tick(-1);
gfx_setfont(3); c_dim(); text("1-2", 16, g_y + 36, 36, 20, 4);
meter(54, g_y + 36, 410, 9, MYSLOT, 0, g_tgt, g_live_me);
meter(54, g_y + 47, 410, 9, MYSLOT, 1, g_tgt, g_live_me);
readouts(472, g_y + 36, MYSLOT, 0, 2, g_live_me);
gain_ctl(630, g_y + 36, 168, g_key(-1, P_GAIN), 1);
g_y += g_ch2 + 8;
frame_end(g_y);
