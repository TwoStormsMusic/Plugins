c_uiabn !== c_abseen ? (c_abseen = c_uiabn; c_inlast = c_inv;);
(c_iol && c_uiok && c_inlast > -100 && c_inv !== c_inlast && slider(si(P_GAIN)) > GFLOOR) ?
  a_apply(P_GAIN, max(-99.9, min(60, slider(si(P_GAIN)) - (c_inv - c_inlast))));
