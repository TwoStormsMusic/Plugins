@block
// fold the fast path's meter accumulators (see @sample) into the per-channel ones
BPK[0] = max(BPK[0], a_fp0); BPK[1] = max(BPK[1], a_fp1); BEN[0] += a_fe0; BEN[1] += a_fe1;
a_fp0 = 0; a_fp1 = 0; a_fe0 = 0; a_fe1 = 0;
a_now = time_precise();
a_claim();
MYSLOT >= 0 ? a_dupcheck();
a_pos = 0; a_pf = 0;
a_trk = get_host_placement(a_pos, a_pf);
MYSLOT >= 0 ? (
  a_nmb = NAMEBASE + MYSLOT * NAMESZ;
