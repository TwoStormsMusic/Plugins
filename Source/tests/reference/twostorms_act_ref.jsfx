        a_v3 = a_l2 - tl4b; a_v1 = a_x2a * tl4a + a_x2b * a_v3; a_v2 = tl4b + a_x2b * tl4a + a_x2c * a_v3; tl4a = 2 * a_v1 - tl4a; tl4b = 2 * a_v2 - tl4b; a_b10 = a_v2;
