      a_v3 = a_l1 - tl2b; a_v1 = a_x1a * tl2a + a_x1b * a_v3; a_v2 = tl2b + a_x1b * tl2a + a_x1c * a_v3; tl2a = 2 * a_v1 - tl2a; tl2b = 2 * a_v2 - tl2b; a_lo = a_v2;
