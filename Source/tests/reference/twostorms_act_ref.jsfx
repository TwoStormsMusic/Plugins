  // starting, or the bands changed: the filters and followers start from zero
  (!ts_was || ts_nb !== ts_nbw) ? (
    memset(TSX, 0, 80); memset(TSF, 0, 24); memset(TSS, 0, 24); memset(TSL, 0, 24); memset(TSH, 0, 24);
    a_i = 0; loop(24, TSG[a_i] = 1; a_i += 1;);
