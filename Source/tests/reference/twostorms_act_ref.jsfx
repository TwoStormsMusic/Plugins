ts_ld = (ts_sw && slider(si(P_TSLA)) >= 0.5) ? max(1, min(TSLM, floor(slider(si(P_TSLAMS)) * 0.001 * srate + 0.5))) : 0;
pdc_delay = ts_ld; pdc_bot_ch = 0; pdc_top_ch = 8;
