ts_any = 0; a_i = 0;
loop(3,
  TSA[a_i] = a_i < ts_nb ? slider(si(P_TSATT + 2 * a_i)) * 0.01 : 0;
  TSU[a_i] = a_i < ts_nb ? slider(si(P_TSSUS + 2 * a_i)) * 0.01 : 0;
