    a_q = (ts_lp - ts_ld) & TSLM; a_c = 0;
    loop(a_nchs, a_ln = LAB + (a_c * 4 + 3) * TSLN; a_ln[ts_lp] = spl(a_c); spl(a_c) = a_ln[a_q]; a_c += 1;);
    ts_lp = (ts_lp + 1) & TSLM;
  );
);
a_fast ? (
  // the usual case (one stereo pair, steady gain, nothing measuring): straight-line code
  a_y0 = spl0 * a_g0; a_y1 = spl1 * a_g1;
  spl0 = a_y0; spl1 = a_y1;
  a_ay = abs(a_y0); a_ay > a_fp0 ? a_fp0 = a_ay;
  a_ay = abs(a_y1); a_ay > a_fp1 ? a_fp1 = a_ay;
  a_fe0 += a_y0 * a_y0; a_fe1 += a_y1 * a_y1;
) : (
a_c = 0;
loop(a_nchs,
  USEDA[a_c] ? (
    a_x = spl(a_c);
    a_inm ? (
      // auto stage / match: the input, before the gain
      a_ax = abs(a_x);
      a_ax > IBP[a_c] ? IBP[a_c] = a_ax;
      a_e = a_kin ? sqr(a_kw(a_x, KIN + a_c * 4)) : a_x * a_x;
      IBE[a_c] += a_e;
      a_binon ? (MBACC[a_c] += a_e; a_ax > MPK[a_c] ? MPK[a_c] = a_ax;);
    );
    RAMP[a_c] ? (
      CUR[a_c] += STEP[a_c];
      ((STEP[a_c] > 0 && CUR[a_c] >= RTGT[a_c]) || (STEP[a_c] < 0 && CUR[a_c] <= RTGT[a_c]) || STEP[a_c] === 0) ? (
        CUR[a_c] = RTGT[a_c]; RAMP[a_c] = 0;
      );
      GLIN[a_c] = CUR[a_c] <= GFLOOR ? 0 : 10 ^ (CUR[a_c] / 20);
    );
    a_y = a_x * GLIN[a_c];
    spl(a_c) = a_y;
    a_ay = abs(a_y); a_ay > BPK[a_c] ? BPK[a_c] = a_ay;
    BEN[a_c] += a_y * a_y;
    a_kout ? BKE[a_c] += sqr(a_kw(a_y, KOUT + a_c * 4));
  );
  a_c += 1;
);
a_binon ? (
  AU_NS += 1; AU_BPOS += 1;
  AU_BPOS >= a_lbinlen ? (
    AU_NB < MAXB ? (
      a_c = 0; loop(8, MB[a_c * MAXB + AU_NB] = MBACC[a_c] / AU_BPOS; MBACC[a_c] = 0; a_c += 1;);
      AU_NB += 1;
    );
    AU_BPOS = 0;
  );
);
);
// audio key: hand this plug-in's output samples to a later plug-in that asked for them (the very last thing)
a_wr ? (gmem[a_wr0 + a_wp] = spl0; gmem[a_wr0 + AUD_R + a_wp] = spl1; a_wp = (a_wp + 1) & AUD_MASK;);

@gfx 990 300
frame_begin(900);

// title: OUT: <the plug-in before this point>
MYSLOT >= 0 ? point_title(#g_title, MYSLOT) : strcpy(#g_title, "TwoStorms Act");
gfx_setfont(4); c_orange();
text(#g_title, 12, 8, 640, 24, 4);
gfx_measurestr(#g_title, g_tw, g_th); g_tw = min(640, g_tw / g_sc);
// finale: the last Act in its chain (listed on the Gain Stage's Finales tab); Settings below can change that
fin_compute();
g_fin = MYSLOT >= 0 ? FIN[MYSLOT] : 0;
g_fin ? badge("finale", 24 + g_tw, 11, 2);
button(796, 8, 92, 24, "Settings", g_cset, 1, 0) ? g_cset = !g_cset;
MYSLOT >= 0 ? track_name(#g_tn, MYSLOT) : strcpy(#g_tn, "");
strcpy(#g_sub, #g_tn);
!g_script_ok ? strcat(#g_sub, "    (helper script not running: names and chain order unavailable)");
g_script_old ? strcat(#g_sub, "    (old helper script running: replace it with the new one)");
gfx_setfont(3); c_dim();
text(#g_sub, 12, 34, 876, 16, 4);
g_cy0 = 56;

// ---- settings: meters, zoom, finale, ID ----
g_cset ? (
  g_y = 56;
  c_panel(); rect(6, g_y - 4, 888, 90, 1);
  label("Peak hold", 12, g_y, 64);
  dropdown(78, g_y, 86, 22, g_key(-1, P_HOLD), 320, 6, 1);
  label("Meter range", 178, g_y, 80);
  dropdown(260, g_y, 80, 22, g_key(-1, P_RANGE), 330, 6, 1);
  label("Zoom", 356, g_y, 40);
  dropdown(398, g_y, 80, 22, g_key(-1, P_ZOOM), 360, 6, 1);
  g_y += 30;
  // Finale: Auto (the last Act in the chain is the finale), Always, Never
  label("Finale", 12, g_y, 64);
  dropdown(78, g_y, 86, 22, g_key(-1, P_FINAL), 370, 3, 1);
  g_fm = floor(slider(si(P_FINAL)) + 0.5);
  g_fc = MYSLOT >= 0 ? fin_of_chain(MYSLOT) : -1;
  g_warn = 0;
  g_fm == FIN_NEVER ? strcpy(#g_fs, "Never on the Finales tab.") : (
    g_fin ? (
      fin_tail(MYSLOT) ? (
        strcpy(#g_fs, "Finale, but plug-ins after it change the track's output."); g_warn = 1;
      ) : (
        strcpy(#g_fs, g_fin == 2 ? "Always on the Finales tab." : "This is the finale: the last Act in its chain.");
      );
    ) : (
      g_fc >= 0 ? (point_title(#g_ft, g_fc); sprintf(#g_fs, "Not the finale: %s is.", #g_ft);) : strcpy(#g_fs, "Not the finale.");
    );
  );
  gfx_setfont(3); g_warn ? c_red() : (g_fin ? c_orange() : c_dim());
  text(#g_fs, 176, g_y, 712, 22, 4);
  g_y += 28;
  gfx_setfont(3); c_faint();
  sprintf(#g_idt, "Plugin ID %d", MYID); text(#g_idt, 12, g_y, 876, 16, 4);
  g_cy0 = g_y + 24;
);

// ---- transient shaper: off by default, and nothing runs while it is off. A row for the switch, the crossovers (a
// tick box in front of each: ticked, it splits there and its band's row shows) and lookahead, then one row per band:
// its range, Attack, Sustain and what it is doing now ----
g_y = g_cy0;
g_tson = slider(si(P_TSON)) >= 0.5;
g_nb = 1 + (slider(si(P_TSXO1)) >= 0.5) + (slider(si(P_TSXO2)) >= 0.5);
c_panel(); rect(6, g_y - 4, 888, 30 + g_nb * 26, 1);
button(12, g_y, 150, 22, g_tson ? "Transient shaper: on" : "Transient shaper: off", g_tson, 1, 0) ? g_kset(g_key(-1, P_TSON), !g_tson, 1);
label("Crossovers", 176, g_y, 76);
g_c = 0;
loop(2,
  g_on = slider(si(P_TSXO1 + g_c)) >= 0.5;
  checkbox(256 + g_c * 112, g_y + 4, g_on, 1) ? g_kset(g_key(-1, P_TSXO1 + g_c), !g_on, 1);
  ts_ffmt(#g_tsv, slider(si(P_TSX1 + g_c)));
  valbox(276 + g_c * 112, g_y + 1, 84, 20, g_key(-1, P_TSX1 + g_c), 0.004, 0.0004, 5, #g_tsv, g_on);
  g_c += 1;
);
g_la = slider(si(P_TSLA)) >= 0.5;
button(712, g_y, 96, 22, "Lookahead", g_la, 1, 0) ? g_kset(g_key(-1, P_TSLA), !g_la, 1);
sprintf(#g_tsv, "%.1f ms", slider(si(P_TSLAMS)));
valbox(812, g_y + 1, 76, 20, g_key(-1, P_TSLAMS), 0.02, 0.002, 6, #g_tsv, g_la);
g_y += 28;
// the bands, lowest first (the crossovers in order, whichever box holds which)
g_x1 = slider(si(P_TSX1)); g_x2 = slider(si(P_TSX2));
g_fa = g_nb == 3 ? min(g_x1, g_x2) : (slider(si(P_TSXO1)) >= 0.5 ? g_x1 : g_x2);
g_fb = max(max(g_x1, g_x2), g_fa * 1.26);
ts_ffmt(#g_tf1, g_fa); ts_ffmt(#g_tf2, g_fb);
g_b = 0;
loop(g_nb,
  g_nb == 1 ? strcpy(#g_tbl, "Full band") : (
    g_b == 0 ? sprintf(#g_tbl, "Low  < %s", #g_tf1) : (
      g_b == g_nb - 1 ? sprintf(#g_tbl, "High  > %s", g_nb == 2 ? #g_tf1 : #g_tf2) : sprintf(#g_tbl, "Mid  %s - %s", #g_tf1, #g_tf2)));
  gfx_setfont(3); g_tson ? c_dim() : c_faint(); text(#g_tbl, 14, g_y, 150, 22, 4);
  tsctl("Attack", 176, g_y, P_TSATT + 2 * g_b, g_tson);
  tsctl("Sustain", 470, g_y, P_TSSUS + 2 * g_b, g_tson);
  // what the band is doing now: the most it went up or down lately
  gfx_setfont(3); c_dim(); text("now", 766, g_y, 30, 22, 4);
  c_well(); rect(796, g_y + 4, 92, 14, 1);
  g_tsd = (g_tson && g_live(MYSLOT, g_now)) ? max(-12, min(12, TSMD[g_b])) : 0;
  c_orange(); g_tsd >= 0 ? rect(842, g_y + 5, g_tsd / 12 * 45, 12, 1) : rect(842 + g_tsd / 12 * 45, g_y + 5, -g_tsd / 12 * 45, 12, 1);
  setc(0.36, 0.34, 0.33); rect(842, g_y + 4, 1 / g_sc, 14, 1);
  c_border(); rect(796, g_y + 4, 92, 14, 0);
  g_y += 26;
  g_b += 1;
);
g_y += 8;

// ---- output: laid out like this Act's card in the Gain Stage (the drive link where Auto all's tick and name are) ----
g_live_me = MYSLOT >= 0 && g_live(MYSLOT, g_now);
g_ng = g_groups(-1, GGA, GGN);
g_am = auto_mode(-1);
g_tgt = aim_tick(-1);
g_ch2 = 38 + max(1, g_ng) * 26;
c_card(); rect(6, g_y, 888, g_ch2, 1);
setc(0.20, 0.19, 0.18); rect(6, g_y, 888, g_ch2, 0);
drive_label(#g_dlb, -1);
// drive link: the engage box switches it off without forgetting it
g_dl = slider(si(P_DRIVE)) >= DRIVE_PARAM; g_don = slider(si(P_DRIVEON)) >= 0.5;
checkbox(16, g_y + 10, g_don && g_dl, g_dl) ? g_kset(g_key(-1, P_DRIVEON), !g_don, 1);
button(38, g_y + 6, 280, 22, #g_dlb, g_dl && g_don, MYSLOT >= 0, 1) ? drive_menu(-1, 38, g_y + 28);
// ... | mode | value | channels | Peak/RMS/LUFS | time | Auto
button(324, g_y + 6, 28, 22, "...", 0, 1, 0) ? act_menu(324, g_y + 28);
mode_ctl(356, g_y + 6, 96, -1, 1, 1);
value_ctl(456, g_y + 6, 130, -1, 1);
(g_am != 0 && g_ng == 1) ? src_ctl(590, g_y + 6, 76, 22, -1, GGA[0], 1, 1);
dropdown(666, g_y + 6, 80, 22, g_key(-1, P_MEAS), 310, 3, 1);
auto_time_box(750, g_y + 6, 70, 22, -1, 1);
button(826, g_y + 6, 62, 22, auto_label(-1), auto_busy(-1), MYSLOT >= 0, 0) ? auto_click(-1);
// one row per gain group: meters, (source channels for Match / Reference when there are several groups), readouts, gain
g_gy = g_y + 36;
g_mw = (g_am != 0 && g_ng > 1) ? 316 : 410;
g_g = 0;
loop(g_ng,
  g_a = GGA[g_g]; g_n = GGN[g_g];
  g_n == 2 ? sprintf(#g_lb, "%d-%d", g_a + 1, g_a + 2) : sprintf(#g_lb, "%d", g_a + 1);
  gfx_setfont(3); c_dim(); text(#g_lb, 16, g_gy, 36, 20, 4);
  g_n == 2 ? (
    meter(54, g_gy, g_mw, 9, MYSLOT, g_a, g_tgt, g_live_me);
    meter(54, g_gy + 11, g_mw, 9, MYSLOT, g_a + 1, g_tgt, g_live_me);
  ) : (
    meter(54, g_gy, g_mw, 20, MYSLOT, g_a, g_tgt, g_live_me);
  );
  (g_am != 0 && g_ng > 1) ? src_ctl(376, g_gy, 86, 20, -1, g_a, 1, 1);
  readouts(472, g_gy, MYSLOT, g_a, g_n, g_live_me);
  gain_ctl(630, g_gy, 168, g_key(-1, P_GAIN + g_a), 1);
  g_gy += 26;
  g_g += 1;
);
g_ng == 0 ? (
  gfx_setfont(1); c_dim();
  text("Every channel is switched off (see ...), so everything passes through untouched.", 16, g_gy, 860, 20, 4);
);
g_y += g_ch2 + 10;
gfx_setfont(3); c_faint();
text("Auto modes: Target = output hits Target. Reference = equals the reference. Match = equals the previous plug-in in the chain.", 12, g_y, 876, 14, 4);
text("Drive link: when this Gain changes, the linked Act or plug-in parameter moves the opposite way. Channels, links and the finale: the ... menu.", 12, g_y + 14, 876, 14, 4);
g_y += 34;
frame_end(g_y);
