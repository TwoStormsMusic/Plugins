    m_ms ? (a_t = (a_v0 + a_v1) * 0.5; a_v1 = (a_v0 - a_v1) * 0.5; a_v0 = a_t;);
    a_s0 = MST + m_b * 32;
    m_one ? mb_det(a_s0, m_pwr ? sqrt(0.5 * (a_v0 * a_v0 + a_v1 * a_v1)) : max(abs(a_v0), abs(a_v1))) : (
      mb_det(a_s0, a_v0); mb_det(a_s0 + 16, a_v1);
    );
  );
  m_b += 1;
);
(m_tc -= 1) <= 0 ? (
  m_tc = m_tk;
  m_b = 0;
  loop(m_nb,
    a_s0 = MST + m_b * 32; a_s1 = a_s0 + 16;
    BON[m_b] ? (
      m_one ? (
        a_l0 = mb_db(a_s0);
        BFB[m_b] ? a_l0 -= BFBK[m_b] * a_s0[2];
        a_y0 = mb_gain(a_s0, a_l0); a_y1 = a_y0; a_lv = a_l0;
      ) : (
        a_l0 = mb_db(a_s0); a_l1 = mb_db(a_s1);
        BFB[m_b] ? (a_l0 -= BFBK[m_b] * a_s0[2]; a_l1 -= BFBK[m_b] * a_s1[2];);
        // the stereo link: the louder side (Max) or the power average
        a_ref = m_lkl ? max(a_l0, a_l1) + 10 * log10(0.5 * (1 + 10 ^ (-abs(a_l0 - a_l1) * 0.1))) : max(a_l0, a_l1);
        a_l0 += m_lk * (a_ref - a_l0); a_l1 += m_lk * (a_ref - a_l1);
        a_y0 = mb_gain(a_s0, a_l0); a_y1 = mb_gain(a_s1, a_l1); a_lv = max(a_l0, a_l1);
      );
      BGI[m_b] = ((a_y0 != 0 ? exp(a_y0 * 0.11512925464970229) : 1) - BG[m_b]) * m_tki;
      BGI[4 + m_b] = ((a_y1 != 0 ? exp(a_y1 * 0.11512925464970229) : 1) - BG[4 + m_b]) * m_tki;
      c_uion ? (abs(a_y0) > abs(BGR[m_b]) ? BGR[m_b] = a_y0; abs(a_y1) > abs(BGR[m_b]) ? BGR[m_b] = a_y1;);
      a_lv > -60 ? (BYS[m_b] += (a_y0 + a_y1) * 0.5; BYN[m_b] += 1;);
      // "Set thresholds" is listening: each millisecond's loudest level (Compress) or quietest (Expand)
      c_tgs == 2 ? (BEXP[m_b] ? (a_lv < TGMX[m_b] ? TGMX[m_b] = a_lv;) : (a_lv > TGMX[m_b] ? TGMX[m_b] = a_lv;););
    ) : (BG[m_b] = 1; BG[4 + m_b] = 1; BGI[m_b] = 0; BGI[4 + m_b] = 0;);
    m_b += 1;
  );
);
BG[0] += BGI[0]; BG[1] += BGI[1]; BG[2] += BGI[2]; BG[3] += BGI[3];
BG[4] += BGI[4]; BG[5] += BGI[5]; BG[6] += BGI[6]; BG[7] += BGI[7];
c_tgs == 2 ? (
  (c_tc += 1) >= c_tms ? (
    c_tgn < 30000 ? (a_i = 0; loop(4, TGLV[a_i * 30000 + c_tgn] = TGMX[a_i]; TGMX[a_i] = BEXP[a_i] ? 1000 : -1000; a_i += 1;); c_tgn += 1;);
    c_tc = 0;
  );
);

// ---- the audio and the gains meet: zero latency, the bands wait for the lookahead; linear phase, the gains wait for the
// audio (less the lookahead) ----
m_lin ? (
  a_i = 0; loop(8, GRG[a_i * 16384 + m_gp] = BG[a_i]; a_i += 1;);
  a_q = (m_gp - m_gd) & 16383;
  a_i = 0; loop(8, BGU[a_i] = GRG[a_i * 16384 + a_q]; a_i += 1;);
  m_gp = (m_gp + 1) & 16383;
  m_pa = BAU; m_pg = BGU;
) : (
  m_ld > 0 ? (
    a_q = (m_zp - m_ld) & 2047;
    a_i = 0; loop(m_nb, ZLA[a_i * 2048 + m_zp] = BA[a_i]; BAU[a_i] = ZLA[a_i * 2048 + a_q]; ZLA[(4 + a_i) * 2048 + m_zp] = BA[4 + a_i]; BAU[4 + a_i] = ZLA[(4 + a_i) * 2048 + a_q]; a_i += 1;);
    ZLA[8 * 2048 + m_zp] = c_r0; ZLA[9 * 2048 + m_zp] = c_r1;
    m_rd0 = ZLA[8 * 2048 + a_q]; m_rd1 = ZLA[9 * 2048 + a_q];
    m_zp = (m_zp + 1) & 2047;
    m_pa = BAU;
  ) : (
    m_rd0 = c_r0; m_rd1 = c_r1; m_pa = BA;
  );
  m_pg = BG;
);

// ---- the bands back together: each at its gain (Mid/Side: on its mid and side) and makeup; solo picks bands. Dry is
// the bands untouched (the same phase as the wet, so dry/wet never combs); Delta is what the gains took away ----
a_w0 = 0; a_w1 = 0; a_e0 = 0; a_e1 = 0; a_s0 = 0; a_s1 = 0;
m_b = 0;
loop(m_nb,
  a_a0 = m_pa[m_b]; a_a1 = m_pa[4 + m_b];
  m_ms ? (
    a_t = (a_a0 + a_a1) * 0.5 * m_pg[m_b]; a_u = (a_a0 - a_a1) * 0.5 * m_pg[4 + m_b];
    a_y0 = a_t + a_u; a_y1 = a_t - a_u;
  ) : (a_y0 = a_a0 * m_pg[m_b]; a_y1 = a_a1 * m_pg[4 + m_b];);
  (!m_anysolo || BSOL[m_b]) ? (
    a_e0 += a_a0 - a_y0; a_e1 += a_a1 - a_y1;
    // the band's saturation (its Character), after the gain
    BSATON[m_b] ? (a_y0 = sat_run(a_y0, SATS + m_b * 8); a_y1 = sat_run(a_y1, SATS + m_b * 8 + 4););
    a_w0 += a_y0 * BMK[m_b]; a_w1 += a_y1 * BMK[m_b];
  );
  a_s0 += a_a0; a_s1 += a_a1;
  m_b += 1;
);
c_del ? (spl0 = a_e0; spl1 = a_e1;) : (
  m_anysolo ? (spl0 = a_w0; spl1 = a_w1;) : (
    spl0 = a_s0 * c_dms + a_w0 * c_wms; spl1 = a_s1 * c_dms + a_w1 * c_wms;
  );
);
a_fast ? (
  // the usual case (one stereo pair, steady gain, nothing measuring): straight-line code
  a_y0 = spl0 * a_g0; a_y1 = spl1 * a_g1;
  spl0 = a_y0; spl1 = a_y1;
  a_ay = abs(a_y0); a_ay > a_fp0 ? a_fp0 = a_ay;
  a_ay = abs(a_y1); a_ay > a_fp1 ? a_fp1 = a_ay;
  a_fe0 += a_y0 * a_y0; a_fe1 += a_y1 * a_y1;
) : (
a_c = 0;
loop(a_nchs,
  USEDA[a_c] ? (
    a_x = spl(a_c);
    a_inm ? (
      // auto stage / match: the input, before the gain
      a_ax = abs(a_x);
      a_ax > IBP[a_c] ? IBP[a_c] = a_ax;
      a_e = a_kin ? sqr(a_kw(a_x, KIN + a_c * 4)) : a_x * a_x;
      IBE[a_c] += a_e;
      a_binon ? (MBACC[a_c] += a_e; a_ax > MPK[a_c] ? MPK[a_c] = a_ax;);
    );
    RAMP[a_c] ? (
      CUR[a_c] += STEP[a_c];
      ((STEP[a_c] > 0 && CUR[a_c] >= RTGT[a_c]) || (STEP[a_c] < 0 && CUR[a_c] <= RTGT[a_c]) || STEP[a_c] === 0) ? (
        CUR[a_c] = RTGT[a_c]; RAMP[a_c] = 0;
      );
      GLIN[a_c] = CUR[a_c] <= GFLOOR ? 0 : 10 ^ (CUR[a_c] / 20);
    );
    a_y = a_x * GLIN[a_c];
    spl(a_c) = a_y;
    a_ay = abs(a_y); a_ay > BPK[a_c] ? BPK[a_c] = a_ay;
    BEN[a_c] += a_y * a_y;
    a_kout ? BKE[a_c] += sqr(a_kw(a_y, KOUT + a_c * 4));
  );
  a_c += 1;
);
a_binon ? (
  AU_NS += 1; AU_BPOS += 1;
  AU_BPOS >= a_lbinlen ? (
    AU_NB < MAXB ? (
      a_c = 0; loop(8, MB[a_c * MAXB + AU_NB] = MBACC[a_c] / AU_BPOS; MBACC[a_c] = 0; a_c += 1;);
      AU_NB += 1;
    );
    AU_BPOS = 0;
  );
);
);
// ---------- multiband: after the built-in Act ----------
// meters and level matching are only for the window (and its hold buttons)
c_uion ? (
  c_ei += c_r0 * c_r0 + c_r1 * c_r1; c_eo += spl0 * spl0 + spl1 * spl1;
  a_t = abs(c_x0); a_t > c_ip0 ? c_ip0 = a_t; a_t = abs(c_x1); a_t > c_ip1 ? c_ip1 = a_t;
);
// held Bypass (crossfaded; the raw input, delayed by the latency) and held Swap (its level-matching trim, glided)
(c_bpv > 0 || c_bph || c_tr != 1 || c_trt != 1) ? (
  c_bpv = max(0, min(1, c_bpv + (c_bph ? c_bps : -c_bps)));
  c_tr += (c_trt - c_tr) * c_trk; abs(c_tr - c_trt) < 0.00001 ? c_tr = c_trt;
  spl0 = spl0 * c_tr * (1 - c_bpv) + m_rd0 * c_bpg * c_bpv;
  spl1 = spl1 * c_tr * (1 - c_bpv) + m_rd1 * c_bpg * c_bpv;
);
c_anw ? (ANI[c_ap] = (c_x0 + c_x1) * 0.5; ANO[c_ap] = (spl0 + spl1) * 0.5; c_ap = (c_ap + 1) & 8191;);
// audio key: hand this plug-in's output samples to a later plug-in that asked for them (the very last thing)
a_wr ? (gmem[a_wr0 + a_wp] = spl0; gmem[a_wr0 + AUD_R + a_wp] = spl1; a_wp = (a_wp + 1) & AUD_MASK;);

@gfx 1040 780
frame_begin(900);
fin_compute();
g_fin = MYSLOT >= 0 ? FIN[MYSLOT] : 0;
g_live_me = MYSLOT >= 0 && g_live(MYSLOT, g_now);
g_xo();
g_sb = max(0, min(g_nb - 1, floor(slider(P_SEL) + 0.5)));

// ---- top bar (shared): title, finale, Presets, A/B, Swap, Bypass, Settings ----
top_bar("TWOSTORMS MULTIBAND", 1);
MYSLOT >= 0 ? track_name(#g_tn, MYSLOT) : strcpy(#g_tn, "");
c_ld > 0 ? sprintf(#g_lt, "latency %.1f ms (%s)", c_latms, m_lin ? "linear phase" : "lookahead") : strcpy(#g_lt, "no latency");
sprintf(#g_sub, "%s    %s    playing: %s", #g_tn, #g_lt, c_side ? "B" : "A");
!g_script_ok ? strcat(#g_sub, "    (helper script not running)");
g_script_old ? strcat(#g_sub, "    (old helper script running: replace it)");
gfx_setfont(3); c_dim(); text(#g_sub, 12, 34, 876, 16, 4);
g_y = 56;

// ---- settings: meters, zoom, finale; link law, hybrid share, sidechain trim; how often Set thresholds aims
// for the full range ----
g_cset ? (
  c_panel(); rect(6, g_y - 4, 888, 124, 1);
  label("Peak hold", 12, g_y, 64);
  dropdown(78, g_y, 86, 22, g_key(-1, P_HOLD), 320, 6, 1);
  label("Meter range", 178, g_y, 80);
  dropdown(260, g_y, 80, 22, g_key(-1, P_RANGE), 330, 6, 1);
  label("Zoom", 356, g_y, 40);
  dropdown(398, g_y, 80, 22, g_key(-1, P_ZOOM), 360, 6, 1);
  label("Finale", 494, g_y, 44);
  dropdown(540, g_y, 86, 22, g_key(-1, P_FINAL), 370, 3, 1);
  g_fm = floor(slider(si(P_FINAL)) + 0.5);
  g_fc = MYSLOT >= 0 ? fin_of_chain(MYSLOT) : -1;
  g_warn = 0;
  g_fm == FIN_NEVER ? strcpy(#g_fs, "Never on the Finales tab.") : (
    g_fin ? (
      fin_tail(MYSLOT) ? (strcpy(#g_fs, "Finale, but plug-ins after it change the output."); g_warn = 1;)
                       : strcpy(#g_fs, g_fin == 2 ? "Always on the Finales tab." : "The finale: the last Act in its chain.");
    ) : (
      g_fc >= 0 ? (point_title(#g_ft, g_fc); sprintf(#g_fs, "Not the finale: %s is.", #g_ft);) : strcpy(#g_fs, "Not the finale.");
    );
  );
  gfx_setfont(3); g_warn ? c_red() : (g_fin ? c_orange() : c_dim());
  text(#g_fs, 634, g_y, 254, 22, 4);
  cdd(12, g_y + 28, 160, 20, g_key(-1, P_LKL), 444, 2, "Link law:", slider(P_CMODE) >= 0.5);
  slider(P_DET) >= 1.5 ? (
    label("RMS share", 182, g_y + 27, 64);
    cfmt(#g_cv, P_BLEND, slider(P_BLEND));
    valbox(248, g_y + 28, 64, 20, g_key(-1, P_BLEND), 1, 0.1, 6, #g_cv, 1);
  );
  label("Sidechain trim", 326, g_y + 27, 96);
  cfmt(#g_cv, P_SCT, slider(P_SCT));
  valbox(424, g_y + 28, 76, 20, g_key(-1, P_SCT), 0.1, 0.01, 6, #g_cv, slider(P_SC) >= 0.5);
  gfx_setfont(3); c_faint();
  text("Set thresholds listens, then sets every band's threshold so the band reaches its own Target GR (Peak: what it stays under 95% of the time).", 12, g_y + 56, 876, 20, 4);
  text("Bypass (Lvl Match) plays the input at the same loudness; Swap (Lvl Match) plays the other A/B set at this one's loudness.", 12, g_y + 84, 876, 16, 4);
  text("Click to latch these, A/B, Solo and Delta; Shift + click and hold to use them only while the mouse is held.", 12, g_y + 100, 876, 16, 4);
  sprintf(#g_idt, "Plugin ID %d", MYID); text(#g_idt, 12, g_y + 100, 876, 16, 6);
  g_y += 128;
);

// ---- the display: the spectrum (input filled, output as a line), the bands between the crossovers, each band's gain
// change hanging from the top (red: cut, green: boost; 24 dB is the full height). Click a band to select it, drag a
// crossover line to move it ----
g_ax = 12; g_ay = g_y; g_aw = 796; g_ah = 200;
c_well(); rect(g_ax, g_ay, g_aw, g_ah, 1);
// the selected band, lighter
g_x1 = g_sb == 0 ? g_ax : an_x(GXF[g_sb - 1]); g_x2 = g_sb == g_nb - 1 ? g_ax + g_aw : an_x(GXF[g_sb]);
band_col(g_sb, 0.07); rect(g_x1, g_ay, g_x2 - g_x1, g_ah, 1); gfx_a = 1;
gfx_setfont(3);
g_i = 0;
loop(8,
  g_f = g_i == 0 ? 50 : (g_i == 1 ? 100 : (g_i == 2 ? 200 : (g_i == 3 ? 500 : (g_i == 4 ? 1000 : (g_i == 5 ? 2000 : (g_i == 6 ? 5000 : 10000))))));
  setc(0.15, 0.15, 0.17); rect(an_x(g_f), g_ay, 1 / g_sc, g_ah, 1);
  g_f >= 1000 ? sprintf(#g_fl, "%dk", g_f / 1000) : sprintf(#g_fl, "%d", g_f);
  c_faint(); text(#g_fl, an_x(g_f) + 2, g_ay + g_ah - 13, 30, 12, 4);
  g_i += 1;
);
g_live_me ? (
  g_annorm = 20 * log10(4096 / 4);
  an_fft(ANI, SPI, 4096); an_fft(ANO, SPO, 4096);
  setc(0.21, 0.21, 0.25); an_draw(SPI, 4096, 1);
  c_orange(); an_draw(SPO, 4096, 0);
);
// each band: its gain change and its name
g_b = 0;
loop(g_nb,
  g_x1 = g_b == 0 ? g_ax : an_x(GXF[g_b - 1]); g_x2 = g_b == g_nb - 1 ? g_ax + g_aw : an_x(GXF[g_b]);
  g_gr = g_live_me && slider(bp(g_b, K_ON)) >= 0.5 ? BGRD[g_b] : 0;
  // the shown value falls back slowly (about 20 dB a second), so short moves stay readable
  g_grs = GGRS[g_b]; abs(g_gr) >= abs(g_grs) ? g_grs = g_gr : g_grs += (g_gr - g_grs) * min(1, g_dt * 6); GGRS[g_b] = g_grs;
  g_h = min(1, abs(g_grs) / 24) * g_ah;
  g_grs < 0 ? c_red() : setc(0.30, 0.78, 0.42); gfx_a = 0.55;
  g_h > 0.5 ? rect(g_x1 + 3, g_ay, g_x2 - g_x1 - 6, g_h, 1); gfx_a = 1;
  band_col(g_b, 1); rect(g_x1, g_ay, g_x2 - g_x1, 2, 1);
  band_name(#g_bn, g_b, g_nb);
  slider(bp(g_b, K_ON)) < 0.5 ? strcat(#g_bn, " (off)");
  gfx_setfont(3); text(#g_bn, g_x1 + 6, g_ay + 6, g_x2 - g_x1 - 10, 14, 4);
  sprintf(#g_grt, "%+.1f dB", g_grs); c_dim(); text(#g_grt, g_x1 + 6, g_ay + 20, g_x2 - g_x1 - 10, 14, 4);
  g_b += 1;
);
// the crossover lines
g_i = 0;
loop(g_nb - 1,
  g_x = an_x(GXF[g_i]);
  (g_xdrag == GXI[g_i] + 1 || (abs((g_mx - g_ox) / g_sc - g_x) < 5 && hit(g_ax, g_ay, g_aw, g_ah))) ? setc(1, 1, 1) : setc(0.62, 0.60, 0.58);
  rect(g_x, g_ay, 1 / g_sc, g_ah, 1);
  g_i += 1;
);
c_border(); rect(g_ax, g_ay, g_aw, g_ah, 0);
// mouse: grab a crossover line, or select the band under the pointer
g_mxd = (g_mx - g_ox) / g_sc;
(hit(g_ax, g_ay, g_aw, g_ah) && g_lclick && !g_used) ? (
  g_used = 1; g_hx = -1; g_i = 0;
  loop(g_nb - 1, abs(g_mxd - an_x(GXF[g_i])) < 5 ? g_hx = g_i; g_i += 1;);
  g_hx >= 0 ? (g_xdrag = GXI[g_hx] + 1;) : (
    g_b = 0; g_i = 0; loop(g_nb - 1, g_mxd > an_x(GXF[g_i]) ? g_b = g_i + 1; g_i += 1;);
    g_kset(g_key(-1, P_SEL), g_b, 1);
  );
);
(g_xdrag > 0 && (g_cap & 1)) ? g_kset(g_key(-1, P_X1 + 2 * (g_xdrag - 1)), max(20, min(20000, an_f(g_mxd))), 0);
(g_xdrag > 0 && !(g_cap & 1)) ? (g_xdrag = 0; sliderchange(-1););
// meters: input and output
gfx_setfont(3); c_dim();
text("IN", 816, g_ay, 34, 12, 5); text("OUT", 852, g_ay, 36, 12, 5);
vmeter(818, g_ay + 14, 12, g_ah - 14, c_mi0, g_live_me);
vmeter(832, g_ay + 14, 12, g_ah - 14, c_mi1, g_live_me);
g_b2 = SLOTBASE + MYSLOT * SLOTSZ;
vmeter(860, g_ay + 14, 12, g_ah - 14, MYSLOT >= 0 ? gmem[g_b2 + O_PKD] : -200, g_live_me);
vmeter(874, g_ay + 14, 12, g_ah - 14, MYSLOT >= 0 ? gmem[g_b2 + O_PKD + 1] : -200, g_live_me);
g_y = g_ay + g_ah + 8;

// ---- crossovers: a tick box in front of each (ticked: it splits there); the selected band's Solo, then Delta ----
label("Crossovers", 12, g_y - 1, 76);
g_c = 0;
loop(3,
  g_on = slider(P_X1 + 2 * g_c + 1) >= 0.5;
  checkbox(92 + g_c * 116, g_y + 3, g_on, 1) ? g_kset(g_key(-1, P_X1 + 2 * g_c + 1), !g_on, 1);
  cfmt(#g_cv, P_X1 + 2 * g_c, slider(P_X1 + 2 * g_c));
  valbox(112 + g_c * 116, g_y, 88, 20, g_key(-1, P_X1 + 2 * g_c), 0.004, 0.0004, 5, #g_cv, g_on);
  g_c += 1;
);
mtog(722, g_y, 80, "Solo", bp(g_sb, K_SOLO), 1);
mtog(806, g_y, 82, "Delta", P_DELTA, 1);
g_y += 28;

// ---- the bands: one button per band (select it), then the selected band's On and Compress / Expand, and the Character ----
g_b = 0;
loop(g_nb,
  band_name(#g_bn, g_b, g_nb);
  button(12 + g_b * 100, g_y, 96, 22, #g_bn, g_b == g_sb, 1, 0) ? g_kset(g_key(-1, P_SEL), g_b, 1);
  band_col(g_b, 1); rect(12 + g_b * 100 + 2, g_y + 19, 92, 2, 1);
  g_b += 1;
);
ctog(420, g_y + 1, 44, "On", bp(g_sb, K_ON), 0);
mode_dd(468, g_y + 1, 112, 20, g_sb);
char_dd(584, g_y + 1, 160, 20, g_sb);
// what the band covers
g_nb == 1 ? strcpy(#g_tbr, "the whole signal") : (
  cfmt(#g_tf1, P_X1, g_sb > 0 ? GXF[g_sb - 1] : 20); cfmt(#g_tf2, P_X1, g_sb < g_nb - 1 ? GXF[g_sb] : 20000);
  g_sb == 0 ? sprintf(#g_tbr, "below %s", #g_tf2) : (g_sb == g_nb - 1 ? sprintf(#g_tbr, "above %s", #g_tf1) : sprintf(#g_tbr, "%s to %s", #g_tf1, #g_tf2));
);
gfx_setfont(3); c_dim(); text(#g_tbr, 752, g_y + 1, 136, 20, 6);
g_y += 30;
// the selected band's controls: threshold / ratio / knee, attack / hold / release, range / makeup / what it does now
g_on = slider(bp(g_sb, K_ON)) >= 0.5;
g_amk = slider(bp(g_sb, K_AMK)) >= 0.5;
cctl("Threshold", 12, g_y, bp(g_sb, K_THR), 0, g_on); cctl("Attack", 308, g_y, bp(g_sb, K_ATT), 1, g_on); cctl("Range", 604, g_y, bp(g_sb, K_RNG), 0, g_on);
cctl("Ratio", 12, g_y + 28, bp(g_sb, K_RAT), 1, g_on); cctl("Hold", 308, g_y + 28, bp(g_sb, K_HLD), 0, g_on);
// Makeup: its name is a button: by hand (the bar), or auto (the band's average gain change, turned around)
button(604, g_y + 28, 64, 20, g_amk ? "Auto  v" : "Makeup  v", g_amk, g_on, 0) ? (
  gfx_x = X(604); gfx_y = Y(g_y + 48);
  g_r = gfx_showmenu(g_amk ? "Makeup: set by hand|!Auto makeup (the band's average gain change)" : "!Makeup: set by hand|Auto makeup (the band's average gain change)");
  g_r > 0 ? g_kset(g_key(-1, bp(g_sb, K_AMK)), g_r == 2, 1);
);
g_amk ? (
  // auto: the bar and the box show the makeup it's using now
  c_well(); rect(670, g_y + 28, 138, 20, 1); c_border(); rect(670, g_y + 28, 138, 20, 0);
  g_t = (max(-24, min(24, BMKA[g_sb])) + 24) / 48; setc(0.45, 0.42, 0.40); rect(670 + 138 * g_t - 1.5, g_y + 29, 3, 18, 1);
  sprintf(#g_cv, "auto %+.1f dB", g_live_me ? BMKA[g_sb] : 0);
  c_well(); rect(812, g_y + 28, 76, 20, 1); c_border(); rect(812, g_y + 28, 76, 20, 0);
  gfx_setfont(1); c_faint(); text(#g_cv, 816, g_y + 28, 68, 20, 6);
) : (
  cbar(670, g_y + 28, 138, 20, bp(g_sb, K_MK), 0, g_on);
  cfmt(#g_cv, bp(g_sb, K_MK), slider(bp(g_sb, K_MK)));
  valbox(812, g_y + 28, 76, 20, g_key(-1, bp(g_sb, K_MK)), 48 / 138, 4.8 / 138, 6, #g_cv, g_on);
);
cctl("Knee", 12, g_y + 56, bp(g_sb, K_KNEE), 0, g_on); cctl("Release", 308, g_y + 56, bp(g_sb, K_REL), 1, g_on);
// the band's gain change now (centre: none; left: cut, right: lift; full width 24 dB)
label("Now", 604, g_y + 55, 64);
c_well(); rect(670, g_y + 59, 218, 14, 1);
g_tsd = max(-24, min(24, GGRS[g_sb]));
g_tsd < 0 ? c_red() : setc(0.30, 0.78, 0.42);
g_tsd >= 0 ? rect(779, g_y + 60, g_tsd / 24 * 109, 12, 1) : rect(779 + g_tsd / 24 * 109, g_y + 60, -g_tsd / 24 * 109, 12, 1);
setc(0.36, 0.34, 0.33); rect(779, g_y + 59, 1 / g_sc, 14, 1);
c_border(); rect(670, g_y + 59, 218, 14, 0);
g_y += 90;

// ---- every band: lookahead and the crossover kind, Set thresholds at the right (as on the EQ); then input, dry/wet and
// the trigger: source, detection, channel mode and link ----
ctog(12, g_y, 84, "Lookahead", P_LA, 0);
cfmt(#g_cv, P_LAMS, slider(P_LAMS));
valbox(100, g_y, 62, 20, g_key(-1, P_LAMS), 0.1, 0.01, 6, #g_cv, slider(P_LA) >= 0.5);
dropdown(166, g_y, 130, 20, g_key(-1, P_XM), 474, 2, 1);
label("Target GR", 440, g_y - 1, 68);
cfmt(#g_cv, P_TGR0 + g_sb, slider(P_TGR0 + g_sb));
valbox(510, g_y, 70, 20, g_key(-1, P_TGR0 + g_sb), 0.1, 0.01, 6, #g_cv, g_on);
dropdown(584, g_y, 116, 20, g_key(-1, P_TTYPE), 400, 2, 1);
tg_controls(704, g_y);
g_y += 28;
g_inact = g_drag_k == g_key(-1, P_IN) || hit(12, g_y, 218, 20);
g_inact ? g_fine = (g_cap & 8) != 0;
// Ctrl held on Input: its change moves the output the other way (see @block)
c_iol = g_inact && (g_cap & 4) != 0;
cctlx("Input", 12, g_y, P_IN, 0, 1, 40, 110, 62);
cctlx("Dry/wet", 240, g_y, P_MIX, 0, 1, 50, 60, 52);
dropdown(416, g_y, 120, 20, g_key(-1, P_SC), 410, 2, 1);
cdd(540, g_y, 96, 20, g_key(-1, P_DET), 380, 3, "Detect:", 1);
cfmt(#g_cv, P_RMST, slider(P_RMST));
valbox(640, g_y, 52, 20, g_key(-1, P_RMST), log(2000000) / 140, log(2000000) / 1400, 5, #g_cv, slider(P_DET) >= 0.5);
cdd(696, g_y, 116, 20, g_key(-1, P_CMODE), 390, 4, "Mode:", 1);
cfmt(#g_cv, P_SLINK, slider(P_SLINK)); sprintf(#g_lk, "Link %s", #g_cv);
valbox(816, g_y, 72, 20, g_key(-1, P_SLINK), 1, 0.1, 6, #g_lk, slider(P_CMODE) >= 0.5);
g_y += 30;

// ---- Custom character: a base template, then envelope, release, curve, feedback and saturation by hand ----
floor(slider(bp(g_sb, K_CHAR)) + 0.5) == 0 ? (
  c_panel(); rect(6, g_y - 4, 888, 28, 1);
  base_dd(12, g_y, 126, 20, g_sb);
  cdd(142, g_y, 134, 20, g_key(-1, bp(g_sb, K_ENV)), 420, 2, "Envelope:", 1);
  cdd(280, g_y, 134, 20, g_key(-1, bp(g_sb, K_RELM)), 424, 3, "Release:", 1);
  cdd(418, g_y, 134, 20, g_key(-1, bp(g_sb, K_CURVE)), 430, 3, "Curve:", 1);
  label("Feedback", 558, g_y - 1, 62);
  cfmt(#g_cv, bp(g_sb, K_FB), slider(bp(g_sb, K_FB)));
  valbox(622, g_y, 50, 20, g_key(-1, bp(g_sb, K_FB)), 1, 0.1, 6, #g_cv, slider(P_LA) < 0.5);
  label("Saturation", 680, g_y - 1, 66);
  cfmt(#g_cv, bp(g_sb, K_SAT), slider(bp(g_sb, K_SAT)));
  valbox(748, g_y, 50, 20, g_key(-1, bp(g_sb, K_SAT)), 1, 0.1, 6, #g_cv, 1);
  dropdown(802, g_y, 80, 20, g_key(-1, bp(g_sb, K_SATT)), 462, 2, 1);
  g_y += 32;
);

// ---- output: the built-in Act, laid out like an Act card in the Gain Stage (the drive link where Auto all's tick and name are) ----
g_ch2 = 38 + 26;
c_card(); rect(6, g_y, 888, g_ch2, 1);
setc(0.20, 0.19, 0.18); rect(6, g_y, 888, g_ch2, 0);
drive_label(#g_dlb, -1);
g_dl = slider(si(P_DRIVE)) >= DRIVE_PARAM; g_don = slider(si(P_DRIVEON)) >= 0.5;
checkbox(16, g_y + 10, g_don && g_dl, g_dl) ? g_kset(g_key(-1, P_DRIVEON), !g_don, 1);
button(38, g_y + 6, 280, 22, #g_dlb, g_dl && g_don, MYSLOT >= 0, 1) ? drive_menu(-1, 38, g_y + 28);
// ... | mode | value | channels | Peak/RMS/LUFS | time | Auto
button(324, g_y + 6, 28, 22, "...", 0, 1, 0) ? act_menu(324, g_y + 28);
mode_ctl(356, g_y + 6, 96, -1, 1, 1);
value_ctl(456, g_y + 6, 130, -1, 1);
auto_mode(-1) != 0 ? src_ctl(590, g_y + 6, 76, 22, -1, 0, 1, 1);
dropdown(666, g_y + 6, 80, 22, g_key(-1, P_MEAS), 310, 3, 1);
auto_time_box(750, g_y + 6, 70, 22, -1, 1);
button(826, g_y + 6, 62, 22, auto_label(-1), auto_busy(-1), MYSLOT >= 0, 0) ? auto_click(-1);
// the gain group: meters, readouts, gain
g_tgt = aim_tick(-1);
gfx_setfont(3); c_dim(); text("1-2", 16, g_y + 36, 36, 20, 4);
meter(54, g_y + 36, 410, 9, MYSLOT, 0, g_tgt, g_live_me);
meter(54, g_y + 47, 410, 9, MYSLOT, 1, g_tgt, g_live_me);
readouts(472, g_y + 36, MYSLOT, 0, 2, g_live_me);
gain_ctl(630, g_y + 36, 168, g_key(-1, P_GAIN), 1);
g_y += g_ch2 + 8;
frame_end(g_y);
